GaugeNotebookBuild`addInput["f0[a_, b_] := (Gamma[a + b - 3/2]*Gamma[3/2 - a]*Gamma[3/2 - b])/(Gamma[3 - a - b]*Gamma[a]*Gamma[b]);\nfc[a_, b_] := (1/2)*f0[a + 1/2, b - 1] - (1/2)*f0[a - 1/2, b] - (1/2)*f0[a + 1/2, b];\nfcc[a_, b_] := (1/4)*f0[a + 1, b - 2] + (1/4)*f0[a - 1, b] + (1/4)*f0[a + 1, b] - (1/2)*f0[a, b - 1] - (1/2)*f0[a + 1, b - 1] + (1/2)*f0[a, b];\nf0[a_, b_] := Gamma[a + b - 3/2]*Gamma[3/2 - a]*(Gamma[3/2 - b]/(Gamma[3 - a - b]*Gamma[a]*Gamma[b]));\nJ0[m_, n_, x_] := f0[x - m/2, x + n/2];\nJ1[m_, n_, x_] := (1/2)*(f0[x - m/2 + 1/2, x + n/2 - 1] - f0[x - m/2 - 1/2, x + n/2] - f0[x - m/2 + 1/2, x + n/2]);\nJ2[m_, n_, x_] := (1/4)*(f0[x - m/2 + 1, x + n/2 - 2] - 2*f0[x - m/2, x + n/2 - 1] - 2*f0[x - m/2 + 1, x + n/2 - 1] + f0[x - m/2 - 1, x + n/2] + 2*f0[x - m/2, x + n/2] + f0[x - m/2 + 1, x + n/2]);\nJ3[m_, n_, x_] := (1/8)*(f0[x - m/2 + 3/2, x + n/2 - 3] - 3*f0[x - m/2 + 3/2, x + n/2 - 2] - 3*f0[x - m/2 + 1/2, x + n/2 - 2] + 3*f0[x - m/2 + 3/2, x + n/2 - 1] + 6*f0[x - m/2 + 1/2, x + n/2 - 1] + 3*f0[x - m/2 - 1/2, x + n/2 - 1] - f0[x - m/2 + 3/2, x + n/2] - 3*f0[x - m/2 + 1/2, x + n/2] - 3*f0[x - m/2 - 1/2, x + n/2] - f0[x - m/2 - 3/2, x + n/2]);\nJ4[m_, n_, x_] := (1/16)*(f0[x - m/2 + 2, x + n/2 - 4] - 4*f0[x - m/2 + 2, x + n/2 - 3] - 4*f0[x - m/2 + 1, x + n/2 - 3] + 6*f0[x - m/2 + 2, x + n/2 - 2] + 12*f0[x - m/2 + 1, x + n/2 - 2] + 6*f0[x - m/2, x + n/2 - 2] - 4*f0[x - m/2 + 2, x + n/2 - 1] - 12*f0[x - m/2 + 1, x + n/2 - 1] - 12*f0[x - m/2, x + n/2 - 1] - 4*f0[x - m/2 - 1, x + n/2 - 1] + f0[x - m/2 + 2, x + n/2] + 4*f0[x - m/2 + 1, x + n/2] + 6*f0[x - m/2, x + n/2] + 4*f0[x - m/2 - 1, x + n/2] + f0[x - m/2 - 2, x + n/2]);"];
GaugeNotebookBuild`addInput["gSoft[v_]:=f0[-I v,-I v];\nshiftRatio[j_Integer,k_Integer,x_]:=FunctionExpand[Pochhammer[2 x-3/2,j+k] Pochhammer[3/2-x,-j] Pochhammer[3/2-x,-k]/(Pochhammer[3-2 x,-j-k] Pochhammer[x,j] Pochhammer[x,k])];\ngSoftSimp=FullSimplify[gSoft[nu],assumptions,TimeConstraint->5];\nformGauge[gSoftSimp]"];
GaugeNotebookBuild`addText["Text","For integer shifts j,k, f0(x+j,x+k)/f0(x,x) is shiftRatio[j,k,x]. Applying this recurrence before FullSimplify reduces the loop algebra to rational functions. Define G = f0(-I nu,-I nu), and express all loop factors below in units of G."];
GaugeNotebookBuild`addInput["softResults={{(3*(3*I - 2*nu)^2)/(I - 2*nu)^2, (3*I - 2*nu)^2/(I - 2*nu)^2, (3*I - 2*nu)^2/(I - 2*nu)^2, (((-3*I + 2*nu)*(-16 + nu*(-19*I + 6*nu) + nu*(-I + 2*nu)*(Cos[2*t3] + Cos[2*t1]*(1 + 3*Cos[2*t3]))))/4 + (3*I - 2*nu)^2*(-I + nu)*Cos[2*ph]*Sin[t1]^2*Sin[t3]^2 + 2*nu*(3 + (5*I - 2*nu)*nu)*Cos[ph]*Sin[2*t1]*Sin[2*t3])/(2*(I - 2*nu)^2*(-2*I + nu)), (nu*(-3 + 4*nu*(-2*I + nu))*Cos[2*t1]*(1 + 3*Cos[2*t3]) - (-3*I + 2*nu)*(64 + (75*I - 22*nu)*nu + 2*(3 + (5*I - 2*nu)*nu)*Cos[2*ph]*Sin[t1]^2 + Cos[2*t3]*((I - 2*nu)*nu + 2*(-3 + nu*(-5*I + 2*nu))*Cos[2*ph]*Sin[t1]^2) + 8*nu*(-I + nu)*Cos[ph]*Sin[2*t1]*Sin[2*t3]))/(8*(I - 2*nu)^2*(-2*I + nu)), (-2*nu*(-3 + 4*nu*(-2*I + nu))*Cos[2*t1]*(1 + 3*Cos[2*t3]) + 2*(-3*I + 2*nu)*(-32 + nu*(-37*I + 10*nu) + 2*(3 + (5*I - 2*nu)*nu)*Cos[2*ph]*Sin[t1]^2 + Cos[2*t3]*((I - 2*nu)*nu + 2*(-3 + nu*(-5*I + 2*nu))*Cos[2*ph]*Sin[t1]^2) + 8*nu*(-I + nu)*Cos[ph]*Sin[2*t1]*Sin[2*t3]))/(8*(I - 2*nu)^2*(-2*I + nu))}, {{((-3*I + 2*nu)*(-4 - (5*I)*nu + 2*nu^2))/(2*(-2*I + nu)*(-I + 2*nu)^2), -1/2*(nu*(-3*I + 2*nu))/((-2*I + nu)*(-I + 2*nu)), (3*nu*(-3*I + 2*nu))/(2*(-2*I + nu)*(-I + 2*nu)), -((nu*(-I + nu)*(-3*I + 2*nu))/((-2*I + nu)*(-I + 2*nu)^2)), ((-I + nu)*(-3*I + 2*nu)^2)/(2*(-2*I + nu)*(-I + 2*nu)^2)}, {((-3*I + 2*nu)*(-16 - (19*I)*nu + 6*nu^2))/(2*(-2*I + nu)*(-I + 2*nu)^2), -1/2*(nu*(-3*I + 2*nu))/((-2*I + nu)*(-I + 2*nu)), (3*nu*(-3*I + 2*nu))/(2*(-2*I + nu)*(-I + 2*nu)), -((nu*(-I + nu)*(-3*I + 2*nu))/((-2*I + nu)*(-I + 2*nu)^2)), ((-I + nu)*(-3*I + 2*nu)^2)/(2*(-2*I + nu)*(-I + 2*nu)^2)}, {((-3*I + 2*nu)*(-8 - (9*I)*nu + 2*nu^2))/((-2*I + nu)*(-I + 2*nu)^2), (nu*(-3*I + 2*nu))/((-2*I + nu)*(-I + 2*nu)), (-3*nu*(-3*I + 2*nu))/((-2*I + nu)*(-I + 2*nu)), (2*nu*(-I + nu)*(-3*I + 2*nu))/((-2*I + nu)*(-I + 2*nu)^2), -(((-I + nu)*(-3*I + 2*nu)^2)/((-2*I + nu)*(-I + 2*nu)^2))}}};\nsoftRatios=FullSimplify[softResults[[1]],assumptions && Element[{t1,t3,ph},Reals],TimeConstraint->3];\nloopMatrix=Factor /@ softResults[[2,1]];\nrBubble=Factor[softRatios[[1]]];\nGrid[{{\"I_Bub/G\",formGauge[rBubble]},{\"I_L/G\",formGauge[softRatios[[2]]]},{\"I_+/G = I_-/G\",formGauge[softRatios[[3]]]}},Frame->All]"];
GaugeNotebookBuild`addInput["loopIdentities=FullSimplify[{softRatios[[2]]-rBubble/3,softRatios[[3]]-rBubble/3,softRatios[[5]]-softRatios[[4]]-rBubble/3,softRatios[[6]]+2softRatios[[4]]-2rBubble/3},assumptions,TimeConstraint->5];\nGrid[{{\"I_L-I_Bub/3\",loopIdentities[[1]]},{\"I_T-I_Bub/3\",loopIdentities[[2]]},{\"I_HH-I_LL-I_Bub/3\",loopIdentities[[3]]},{\"I_LH+2 I_LL-2 I_Bub/3\",loopIdentities[[4]]}},Frame->All]"];
GaugeNotebookBuild`addInput["angularBasis={1,Cos[t1]^2+Cos[t3]^2,Cos[t1]^2 Cos[t3]^2,Sin[2t1]Sin[2t3]Cos[ph],Sin[t1]^2 Sin[t3]^2 Cos[2ph]};\nloopReconstruction=FullSimplify[softRatios[[4]]-loopMatrix.angularBasis,assumptions && Element[{t1,t3,ph},Reals],TimeConstraint->5];\nGrid[MapThread[{#1,formGauge[#2]}&,{{\"LL: constant\",\"LL: cos^2 sum\",\"LL: cos^2 product\",\"LL: B basis\",\"LL: D basis\"},loopMatrix}],Frame->All]"];
