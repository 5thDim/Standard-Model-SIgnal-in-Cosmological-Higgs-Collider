GaugeNotebookBuild`addInput["bubbleILL[\:03bd_] := Module[{x = (-I)*\:03bd}, ((-2^(-1) + I*\:03bd)^4/(\:03bd^2 + 1/4)^2)*(1/4)*(f0[x + 1, x + 1] + 2*f0[x - 1, x + 1] + 2*f0[x, x] - 2*f0[x, x + 1] - 2*f0[x + 1, x])];\nbubbleIPP[\:03bd_] := Module[{x = (-I)*\:03bd}, (1/4)*(f0[x, x] + f0[x - 1, x + 1] + fcc[x, x + 1] + 2*f0[x - 1/2, x + 1/2] + 2*fc[x - 1/2, x + 1] + 2*fc[x, x + 1/2])];\nbubbleIPM[\:03bd_] := Module[{x = (-I)*\:03bd}, (1/4)*(f0[x, x] + f0[x - 1, x + 1] + fcc[x, x + 1] - 2*f0[x - 1/2, x + 1/2] + 2*fc[x - 1/2, x + 1] - 2*fc[x, x + 1/2])];\nbubbleILP[\:03bd_] := Module[{x = (-I)*\:03bd}, ((-2^(-1) + I*\:03bd)^2/(\:03bd^2 + 1/4))*(1/2)*(f0[x, x + 1] - fcc[x, x + 1])];\nbubbleIMM[\:03bd_] := bubbleIPP[\:03bd];\nbubbleIMP[\:03bd_] := bubbleIPM[\:03bd];\nbubbleILM[\:03bd_] := bubbleILP[\:03bd];\nbubbleIPL[\:03bd_] := bubbleILP[\:03bd];\nbubbleIML[\:03bd_] := bubbleILP[\:03bd];"];
GaugeNotebookBuild`addInput["bubbleP1[x_] := ((2 + I*x)/(2*I*x))*I*Sinh[Pi*x]*Gamma[2 + 2*I*x];\nbubblePolarizationSum[\:03bd_] := bubbleILL[\:03bd] + bubbleILP[\:03bd] + bubbleILM[\:03bd] + bubbleIPL[\:03bd] + bubbleIPP[\:03bd] + bubbleIPM[\:03bd] + bubbleIML[\:03bd] + bubbleIMP[\:03bd] + bubbleIMM[\:03bd];\nbubbleCoefficient[\:03bd_] := (Gamma[(-I)*\:03bd]^4/(4*Pi)^(7/2))*bubbleP1[\:03bd]^2*bubblePolarizationSum[\:03bd];"];
GaugeNotebookBuild`addInput["ILLL[nu_, theta1_] := Module[{s1 = Sin[theta1], c1 = Cos[theta1], x = (-I)*nu}, ((-2^(-1) + I*nu)^4/(nu^2 + 1/4)^2)*((s1^2/2)*(J0[2, 2, x] + J1[1, 2, x] - J2[2, 2, x] - J3[1, 2, x]) + c1^2*(J2[2, 2, x] + J3[1, 2, x] + J1[1, 2, x] + J2[0, 2, x]))];\nILLP[nu_, theta1_] := Module[{s1 = Sin[theta1], c1 = Cos[theta1], x = (-I)*nu}, ((-2^(-1) + I*nu)^2/(nu^2 + 1/4))*((-(s1^2/4))*(J1[1, 2, x] - J3[1, 2, x]) + (c1^2/2)*(J1[1, 2, x] + J0[0, 2, x] - J3[1, 2, x] - J2[0, 2, x]))];\nILLM[nu_, theta1_] := ILLP[nu, theta1];\nILPL[nu_, theta1_] := Module[{s1 = Sin[theta1], c1 = Cos[theta1], x = (-I)*nu}, ((-2^(-1) + I*nu)^2/(nu^2 + 1/4))*((s1^2/4)*(J1[1, 2, x] + J0[0, 2, x] - J3[1, 2, x] - J2[0, 2, x]) - (c1^2/2)*(J1[1, 2, x] - J3[1, 2, x]))];\nILML[nu_, theta1_] := ILPL[nu, theta1];\nILPP[nu_, theta1_] := Module[{s1 = Sin[theta1], c1 = Cos[theta1], x = (-I)*nu}, (s1^2/8)*(J2[1, 1, x] + J2[2, 2, x] + J3[1, 2, x] + J1[0, 1, x] + J1[1, 2, x] + J2[0, 2, x] + J0[0, 0, x] + J0[1, 1, x] + J1[0, 1, x]) + (c1^2/4)*(J0[1, 1, x] - J2[1, 1, x] + J0[2, 2, x] - J2[2, 2, x] + J1[1, 2, x] - J3[1, 2, x])];\nILMM[nu_, theta1_] := ILPP[nu, theta1];\nILPM[nu_, theta1_] := Module[{s1 = Sin[theta1], c1 = Cos[theta1], x = (-I)*nu}, (s1^2/8)*(J2[2, 2, x] + J3[1, 2, x] - J2[1, 1, x] + J1[1, 2, x] + J2[0, 2, x] - J1[0, 1, x] - J0[1, 1, x] - J1[0, 1, x] + J0[0, 0, x]) + (c1^2/4)*(J0[2, 2, x] - J2[2, 2, x] + J1[1, 2, x] - J3[1, 2, x] - J0[1, 1, x] + J2[1, 1, x])];\nILMP[\:03bd_, \:03b81_] := ILPM[\:03bd, \:03b81];\nIL[\:03bd_, \:03b81_] := ILLL[\:03bd, \:03b81] + ILLP[\:03bd, \:03b81] + ILLM[\:03bd, \:03b81] + ILPL[\:03bd, \:03b81] + ILML[\:03bd, \:03b81] + ILPP[\:03bd, \:03b81] + ILMM[\:03bd, \:03b81] + ILPM[\:03bd, \:03b81] + ILMP[\:03bd, \:03b81];"];
GaugeNotebookBuild`addInput["IPLL[nu_, theta1_] := Module[{s1 = Sin[theta1], c1 = Cos[theta1], x = (-I)*nu}, ((-2^(-1) + I*nu)^4/(nu^2 + 1/4)^2)*(((1 + c1^2)/4)*(J0[2, 2, x] - J2[2, 2, x] + J1[1, 2, x] - J3[1, 2, x]) + (s1^2/2)*(J2[2, 2, x] + J1[1, 2, x] + J3[1, 2, x] + J2[0, 2, x]))];\nIPLPsum[\:03bd_, \:03b81_] := Module[{s1 = Sin[\:03b81], x = (-I)*\:03bd}, ((-2^(-1) + I*\:03bd)^2/(\:03bd^2 + 1/4))*(((2 + s1^2)/4)*(J0[0, 2, x] - J2[0, 2, x]))];\nIPPPsum[\:03bd_, \:03b81_] := Module[{s1 = Sin[\:03b81], c1 = Cos[\:03b81], x = (-I)*\:03bd}, ((1 + c1^2)/4)*(J2[2, 2, x] + J1[1, 2, x] + J3[1, 2, x] + J2[0, 2, x] + J0[0, 0, x]) + (s1^2/2)*(J0[2, 2, x] - J2[2, 2, x] + J1[1, 2, x] - J3[1, 2, x])];\nIP[\:03bd_, \:03b81_] := IPLL[\:03bd, \:03b81] + IPLPsum[\:03bd, \:03b81] + IPPPsum[\:03bd, \:03b81];\nIM[\:03bd_, \:03b81_] := IP[\:03bd, \:03b81];"];
GaugeNotebookBuild`addInput["P1[\:03bd_] := ((2 + I*\:03bd)/(2*I*\:03bd))*I*Sinh[Pi*\:03bd]*Gamma[2 + 2*I*\:03bd];"];
GaugeNotebookBuild`addInput["Mpp[p1_, p2_, \:03bd_] := Module[{p12 = p1 + p2}, (Plus[I])*Exp[(-I)*Pi*(p12/2)]*(Exp[(-Pi)*\:03bd]/2^(5 + p12))*Gamma[5/2 + p1 - I*\:03bd]*Gamma[5/2 + p1 + I*\:03bd]*Gamma[5/2 + p2 - I*\:03bd]*(Gamma[5/2 + p2 + I*\:03bd]/(Gamma[3 + p1]*Gamma[3 + p2])) - (Exp[(-I)*Pi*(p12/2)]/2^(5 + p12))*Gamma[5 + p12]*Gamma[5/2 + p1 + I*\:03bd]*Gamma[5/2 + p2 + I*\:03bd]*HypergeometricPFQRegularized[{5 + p12, 1/2 + I*\:03bd, 1}, {7/2 + p1 + I*\:03bd, 7/2 + p2 + I*\:03bd}, 1]];\nMmm[p1_, p2_, \:03bd_] := Module[{p12 = p1 + p2}, (-I)*Exp[(Plus[I])*Pi*(p12/2)]*(Exp[(-Pi)*\:03bd]/2^(5 + p12))*Gamma[5/2 + p1 + I*\:03bd]*Gamma[5/2 + p1 - I*\:03bd]*Gamma[5/2 + p2 + I*\:03bd]*(Gamma[5/2 + p2 - I*\:03bd]/(Gamma[3 + p1]*Gamma[3 + p2])) - (Exp[(Plus[I])*Pi*(p12/2)]/2^(5 + p12))*Gamma[5 + p12]*Gamma[5/2 + p1 - I*\:03bd]*Gamma[5/2 + p2 - I*\:03bd]*HypergeometricPFQRegularized[{5 + p12, 1/2 - I*\:03bd, 1}, {7/2 + p1 - I*\:03bd, 7/2 + p2 - I*\:03bd}, 1]];\nMpm[p1_, p2_, \:03bd_] := (Exp[(-I)*Pi*((p1 - p2)/2)]/2^(5 + p1 + p2))*Gamma[5/2 + p1 - I*\:03bd]*Gamma[5/2 + p1 + I*\:03bd]*Gamma[5/2 + p2 - I*\:03bd]*(Gamma[5/2 + p2 + I*\:03bd]/(Gamma[3 + p1]*Gamma[3 + p2]));\nMmp[p1_, p2_, \:03bd_] := (Exp[(Plus[I])*Pi*((p1 - p2)/2)]/2^(5 + p1 + p2))*Gamma[5/2 + p1 - I*\:03bd]*Gamma[5/2 + p1 + I*\:03bd]*Gamma[5/2 + p2 - I*\:03bd]*(Gamma[5/2 + p2 + I*\:03bd]/(Gamma[3 + p1]*Gamma[3 + p2]));"];
GaugeNotebookBuild`addInput["P2PM[\:03bd_, regulator_] := 2^(2*I*\:03bd)*((Mpp[-5/2 + regulator + I*\:03bd, -5/2 + regulator + I*\:03bd, \:03bd] + I*(Plus[1])*Mpp[-3/2 + I*\:03bd + regulator, -5/2 + regulator + I*\:03bd, \:03bd] + I*(Plus[1])*Mpp[-5/2 + regulator + I*\:03bd, -3/2 + I*\:03bd + regulator, \:03bd] - ((Plus[1])*(Plus[1]))*Mpp[-3/2 + I*\:03bd + regulator, -3/2 + I*\:03bd + regulator, \:03bd]) + (Mmm[-5/2 + regulator + I*\:03bd, -5/2 + regulator + I*\:03bd, \:03bd] + I*-1*Mmm[-3/2 + I*\:03bd + regulator, -5/2 + regulator + I*\:03bd, \:03bd] + I*-1*Mmm[-5/2 + regulator + I*\:03bd, -3/2 + I*\:03bd + regulator, \:03bd] - (-(-1))*Mmm[-3/2 + I*\:03bd + regulator, -3/2 + I*\:03bd + regulator, \:03bd]) + (Mpm[-5/2 + regulator + I*\:03bd, -5/2 + regulator + I*\:03bd, \:03bd] + I*(Plus[1])*Mpm[-3/2 + I*\:03bd + regulator, -5/2 + regulator + I*\:03bd, \:03bd] + I*-1*Mpm[-5/2 + regulator + I*\:03bd, -3/2 + I*\:03bd + regulator, \:03bd] - ((Plus[1])*-1)*Mpm[-3/2 + I*\:03bd + regulator, -3/2 + I*\:03bd + regulator, \:03bd]) + (Mmp[-5/2 + regulator + I*\:03bd, -5/2 + regulator + I*\:03bd, \:03bd] + I*-1*Mmp[-3/2 + I*\:03bd + regulator, -5/2 + regulator + I*\:03bd, \:03bd] + I*(Plus[1])*Mmp[-5/2 + regulator + I*\:03bd, -3/2 + I*\:03bd + regulator, \:03bd] - (-(Plus[1]))*Mmp[-3/2 + I*\:03bd + regulator, -3/2 + I*\:03bd + regulator, \:03bd]));"];
