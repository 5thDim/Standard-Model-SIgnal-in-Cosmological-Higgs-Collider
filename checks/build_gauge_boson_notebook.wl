GaugeNotebookBuild`addInput["masterExpressions={HypergeometricPFQ[{1, 1/2 + I*nu, (2*I)*nu}, {1 + (2*I)*nu, 1 + (2*I)*nu}, 1], Derivative[{0, 0, 0}, {1, 0}, 0][HypergeometricPFQRegularized][{1 + (2*I)*nu, 1/2 - I*nu, 1}, {1, 2}, 1], Derivative[{0, 0, 0}, {1, 0}, 0][HypergeometricPFQRegularized][{2 + (2*I)*nu, 1/2 - I*nu, 1}, {1, 3}, 1], Derivative[{0, 0, 0}, {1, 1}, 0][HypergeometricPFQRegularized][{(2*I)*nu, 1/2 - I*nu, 1}, {1, 1}, 1]};\nGrid[MapIndexed[{\"F\"<>ToString[First[#2]],formGauge[#1]}&,masterExpressions],Frame->All,Alignment->Left]"];
