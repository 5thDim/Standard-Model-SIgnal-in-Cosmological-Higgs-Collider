(* Append evaluated, self-contained explicit formulas while preserving all existing cells.
   Set Global`selectedTag to "gauge" or "top" before Get of this file. *)
Begin["SignalExplicitBuild`"];
root=DirectoryName[DirectoryName[$InputFileName]];
tmp="\\\\wsl.localhost\\Ubuntu\\tmp";
tag=Global`selectedTag;
stem=If[tag=="gauge","Gauge Boson Signal","Top Quark Signal"];
builder=If[tag=="gauge","build_gauge_boson_notebook.wl","build_top_quark_notebook.wl"];
report=FileNameJoin[{tmp,tag<>"-explicit-report.txt"}];
messageStream=OpenWrite[FileNameJoin[{tmp,tag<>"-explicit-messages.txt"}]];
$Messages={messageStream}; log={}; errors={}; newCells={}; started=AbsoluteTime[];
writeLog[]:=Export[report,StringRiffle[log,"\n"],"Text"];
original=Get[FileNameJoin[{root,stem<>".nb"}]];
existingSection=Position[First[original],Cell[title_String,"Section",___]/;StringStartsQ[title,"Explicit finite coefficients for Appendices "],{1}];
If[existingSection=!={},original=ReplacePart[original,1->Take[First[original],First[First[existingSection]]-1]]];
sourceText=Import[FileNameJoin[{root,"checks",builder}],"Text"];
sourceStrings=ToExpression /@ StringCases[sourceText,RegularExpression["addInput\\[(\"(?:[^\"\\\\]|\\\\.)*\")\\]"]->"$1"];
newSources=Import[FileNameJoin[{root,"checks","explicit_signal_cells.json"}],"RawJSON"][tag];
run[source_String,save_]:=Module[{held,boxes,result,secs,msgs},
 AppendTo[log,If[save,"NEW ","BASE "]<>StringTake[source,UpTo[90]]];writeLog[];
 held=ToExpression["("<>source<>")",InputForm,HoldComplete];
 boxes=held/.HoldComplete[e_]:>MakeBoxes[e,StandardForm];
 Block[{$MessageList={}}, {secs,result}=AbsoluteTiming[TimeConstrained[ReleaseHold[held],1200,$Aborted]];msgs=$MessageList];
 AppendTo[log,"DONE seconds="<>ToString[secs]<>" messages="<>ToString[msgs,InputForm]];writeLog[];
 If[MemberQ[{$Failed,$Aborted},result] || DeleteCases[msgs,HoldForm[FullSimplify::time]|HoldForm[General::stop]]=!={},AppendTo[errors,{StringTake[source,UpTo[60]],msgs}]];
 If[save,AppendTo[newCells,Cell[CellGroupData[If[result===Null,{Cell[BoxData[boxes],"Input"]},{Cell[BoxData[boxes],"Input"],Cell[BoxData[ToBoxes[result,StandardForm]],"Output"]}],Open]]]];
];
End[];
Scan[SignalExplicitBuild`run[#,False]&,SignalExplicitBuild`sourceStrings];
Scan[If[#["type"]=="Input",SignalExplicitBuild`run[#["source"],True],AppendTo[SignalExplicitBuild`newCells,Cell[#["source"],#["type"]]]]&,SignalExplicitBuild`newSources];
Begin["SignalExplicitBuild`"];
checks=If[tag=="gauge",GaugeBosonSignal`gaugeExplicitValidation,TopQuarkSignal`topExplicitValidation];
baselineChecks=If[tag=="gauge",GaugeBosonSignal`validation,TopQuarkSignal`validationTop];
AppendTo[log,"BASELINE CHECKS: "<>ToString[baselineChecks,InputForm]];
AppendTo[log,"NEW CHECKS: "<>ToString[checks,InputForm]];
AppendTo[log,"ERRORS: "<>ToString[errors,InputForm]];writeLog[];
Put[{newCells,checks,baselineChecks},FileNameJoin[{tmp,tag<>"-explicit-checkpoint.wl"}]];
If[!AssociationQ[checks] || !And@@Values[checks] || !And@@Values[baselineChecks] || errors=!={},AppendTo[log,"FAILED"];writeLog[];Close[messageStream];Quit[1]];
updated=ReplacePart[original,1->Join[First[original],newCells]];
output=FileNameJoin[{tmp,tag<>"-explicit-candidate.nb"}];Put[updated,output];
saved=Get[output];preserved=SameQ[Take[First[saved],Length[First[original]]],First[original]];
parsed=And@@Map[FreeQ[Quiet[Check[ToExpression[#,StandardForm,HoldComplete],$Failed]],$Failed]&,Cases[newCells,Cell[BoxData[b_],"Input",___]:>b,Infinity]];
AppendTo[log,"ORIGINAL CELLS PRESERVED: "<>ToString[preserved]];
AppendTo[log,"NEW INPUTS PARSE: "<>ToString[parsed]];
AppendTo[log,"TOTAL SECONDS: "<>ToString[AbsoluteTime[]-started]];
Put[If[tag=="gauge",GaugeBosonSignal`gaugeExplicitChecks,TopQuarkSignal`topExplicitChecks],FileNameJoin[{tmp,tag<>"-explicit-numeric-checks.wl"}]];
Export[FileNameJoin[{tmp,tag<>"-explicit-preview.png"}],Rasterize[Column[{Style["Explicit angular polynomials",Bold],If[tag=="gauge",GaugeBosonSignal`formGauge[GaugeBosonSignal`gaugeAngularPolynomial],TopQuarkSignal`formTop[TopQuarkSignal`topAngularPolynomial]]}],"Image",ImageSize->1400]];
AppendTo[log,If[preserved&&parsed,"COMPLETE","FAILED"]];writeLog[];
Close[messageStream];End[];Quit[];
