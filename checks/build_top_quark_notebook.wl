(* Rebuild the self-contained, evaluated Top Quark Signal.nb using Wolfram 15.
   Every Input/Output cell is generated with native MakeBoxes/ToBoxes.
   The build candidate and previews are written to /tmp; the validated notebook
   is copied to the project only after the build report has been inspected. *)
Begin["TopNotebookBuild`"];
root = DirectoryName[DirectoryName[$InputFileName]];
tmpRoot = "\\\\wsl.localhost\\Ubuntu\\tmp";
outputPath = FileNameJoin[{tmpRoot,"top_quark_complete.nb"}];
reportPath = FileNameJoin[{tmpRoot,"top_quark_build_report.txt"}];
messagePath = FileNameJoin[{tmpRoot,"top_quark_build_messages.txt"}];
cells = {Cell["Top Quark Signal", "Title"], Cell["Analytic angular coefficients and mass dependence", "Subtitle"]};
log = {}; cellIndex = 0; errors = {}; started = AbsoluteTime[];
messageStream = OpenWrite[messagePath]; $Messages = {messageStream};
writeLog[] := Export[reportPath,StringRiffle[log,"\n"],"Text"];
addText[style_,value_] := AppendTo[cells,Cell[value,style]];
addInput[source_String] := Module[{held,boxes,parsed,result,elapsed,messages,group},
 cellIndex++; AppendTo[log,"START "<>ToString[cellIndex]<>" "<>StringTake[source,UpTo[90]]]; writeLog[];
 held=Check[ToExpression["("<>source<>")",InputForm,HoldComplete],$Failed];
 If[held===$Failed,AppendTo[errors,{cellIndex,"InputForm parse"}];Throw[$Failed]];
 boxes=held /. HoldComplete[e_] :> MakeBoxes[e,StandardForm];
 parsed=Check[ToExpression[boxes,StandardForm,HoldComplete],$Failed];
 If[parsed===$Failed,AppendTo[errors,{cellIndex,"Box parse"}];Throw[$Failed]];
 Block[{$MessageList={}},
 {elapsed,result}=AbsoluteTiming[TimeConstrained[ReleaseHold[parsed],900,$Aborted]];
 messages=$MessageList];
 If[result===$Aborted || result===$Failed || DeleteCases[messages,HoldForm[FullSimplify::time]|HoldForm[General::stop]]=!={},AppendTo[errors,{cellIndex,messages,Head[result]}]];
 group={Cell[BoxData[boxes],"Input",CellLabel->"In["<>ToString[cellIndex]<>"]:="]};
 If[result=!=Null,AppendTo[group,Cell[BoxData[ToBoxes[result,StandardForm]],"Output",CellLabel->"Out["<>ToString[cellIndex]<>"]="]]];
 AppendTo[cells,Cell[CellGroupData[group,Open]]];
 AppendTo[log,"DONE "<>ToString[cellIndex]<>" seconds="<>ToString[elapsed]<>" messages="<>ToString[messages,InputForm]];writeLog[];
];
End[];
Catch[
TopNotebookBuild`addText["Section","1. Conventions and scalar soft-loop seeds"];
TopNotebookBuild`addText["Text","The target is the five complex angular coefficients in SMS in CHC, Eq. (65). nu = mt/H > 0. All results below use the positive soft branch and the phase convention (ks^2/(4 k12 k34))^(2 I nu) in Eq. (63). Nc, gt and the overall momentum/H factors in Eq. (63) are excluded. Outputs and native Mathematica plots are saved in this notebook; no external files are needed to inspect or reevaluate it. Evaluate from the beginning in a fresh kernel."];
TopNotebookBuild`addInput["BeginPackage[\"TopQuarkSignal`\"]; ClearAll[\"TopQuarkSignal`*\"];"];
TopNotebookBuild`addInput["wp = 50; massMin = 1/10; massMax = 5; assumptionsTop = nu > 0;\nformTop[expr_] := Apply[TraditionalForm, {expr}];\nnu /: MakeBoxes[nu, TraditionalForm] := \"\\[Nu]\";\npp1 /: MakeBoxes[pp1, TraditionalForm] := SubscriptBox[\"P\", \"1\"];\npp2 /: MakeBoxes[pp2, TraditionalForm] := SubscriptBox[\"P\", \"2\"];\nq00 /: MakeBoxes[q00, TraditionalForm] := SubscriptBox[\"Q\", \"00\"];\ntGamma /: MakeBoxes[tGamma, TraditionalForm] := \"T\";\neEndpoint /: MakeBoxes[eEndpoint, TraditionalForm] := \"E\";\nbb /: MakeBoxes[bb, TraditionalForm] := \"\\[ScriptCapitalB]\";\ngSymbol /: MakeBoxes[gSymbol, TraditionalForm] := \"\\[ScriptCapitalG]\";"];
TopNotebookBuild`addText["Text","Exact rational constants are retained until numerical evaluation. FullSimplify is applied with explicit assumptions and a finite search time; its output need not be a unique shortest form. I and D retain their built-in Mathematica meanings. softBTop denotes the common factor in Eq. (128); BTop denotes the angular coefficient."];
TopNotebookBuild`addInput["f0Top[alpha_, beta_] := Gamma[alpha + beta - 3/2] Gamma[3/2 - alpha] Gamma[3/2 - beta]/(Gamma[3 - alpha - beta] Gamma[alpha] Gamma[beta]);\nrhoTop[v_] := 1/2 - I v;\ngTop[v_] := f0Top[rhoTop[v], rhoTop[v]];\nGrid[{{\"rho(nu)\",formTop[rhoTop[nu]]},{\"f0(alpha,beta)\",formTop[f0Top[alpha,beta]]},{\"soft-line scalar coefficient (eta = +/-1)\",formTop[-4^(-I eta nu) Gamma[1/2-I eta nu]^2/(4 Pi)]}},Frame->All,Alignment->Left]"];
TopNotebookBuild`addText["Text","f0 is the analytically continued convolution of Sec. 2.1. Both f0 and Iij exclude the universal loop factor (4 Pi)^(-3/2), which remains explicit in Ctop. The first saved simplification is the common Gamma factor Gtop in Eq. (115)."];
TopNotebookBuild`addInput["gTopSimp = FullSimplify[gTop[nu], assumptionsTop, TimeConstraint -> 8];\nformTop[gTopSimp]"];
TopNotebookBuild`addInput["gTopPaper[v_] := Gamma[-1/2 - 2 I v] Gamma[1 + I v]^2/(Gamma[2 + 2 I v] Gamma[1/2 - I v]^2);\nsoftGammaCheck = FullSimplify[gTop[nu] - gTopPaper[nu], assumptionsTop];\nsoftGammaCheck"];
TopNotebookBuild`addText["Subsection","Scalar moments and Gamma recurrence"];
TopNotebookBuild`addInput["frTop[ell_Integer, alpha_, beta_] := Sum[Factorial[ell] (-1)^(ell - u)/(2^ell Factorial[u] Factorial[v] Factorial[ell - u - v]) f0Top[alpha + ell/2 - v, beta - u], {u, 0, ell}, {v, 0, ell - u}];\njTop[ell_Integer, m_Integer, n_Integer, x_] := frTop[ell, x - m/2, x + n/2];\nshiftRatioTop[j_Integer, k_Integer, rho_] := Pochhammer[3/2 - rho, j] Pochhammer[3/2 - rho, k] Pochhammer[1 - rho, j] Pochhammer[1 - rho, k]/(Pochhammer[5/2 - 2 rho, j + k] Pochhammer[3 - 2 rho, j + k]);\njRatioTop[ell_Integer, m_Integer, v_] := Sum[Factorial[ell] (-1)^(ell - u)/(2^ell Factorial[u] Factorial[w] Factorial[ell - u - w]) shiftRatioTop[(m + 1 - ell)/2 + w, u, rhoTop[v]], {u, 0, ell}, {w, 0, ell - u}];"];
TopNotebookBuild`addText["Text","shiftRatioTop(j,k,rho) = f0(rho-j,rho-k)/f0(rho,rho), obtained by Gamma recurrence. jRatioTop is J_ell(m,1;-I nu)/f0(rho,rho) for the integer shifts used below. This extracts the common Gamma factor before FullSimplify, leaving rational algebra."];
TopNotebookBuild`addText["Section","2. Soft-loop coefficients I11, I12, I21 and I22"];
TopNotebookBuild`addText["Text","Eq. (114) is reduced in the basis {1, S, TB, TD}, where S = cos(theta1)^2 + cos(theta3)^2 - 3 cos(theta1)^2 cos(theta3)^2, TB = sin(2 theta1) sin(2 theta3) cos(phi3), TD = sin(theta1)^2 sin(theta3)^2 cos(2 phi3). The following five entries are I12 and the four components of I22, divided by Gtop."];
TopNotebookBuild`addInput["loopJExpressions = {\n (jSym[0,3] - jSym[2,3] + jSym[1,2] - jSym[3,2])/2 + (jSym[0,1] - jSym[2,1])/4,\n (2 jSym[4,3] - 3 jSym[2,3] + jSym[0,3] + jSym[3,2] - jSym[1,2])/4,\n (-6 jSym[4,3] + 7 jSym[2,3] - jSym[0,3] + 5 jSym[1,2] - 5 jSym[3,2] + jSym[0,1] - jSym[2,1])/4,\n (-16 jSym[4,3] + 14 jSym[2,3] - 2 jSym[0,3] + 10 jSym[1,2] - 18 jSym[3,2] + 2 jSym[0,1] - 7 jSym[2,1] - jSym[1,0])/16,\n (jSym[4,3] - jSym[2,3] + jSym[3,2] - jSym[1,2])/4};\nloopRatios = Factor /@ FullSimplify[loopJExpressions /. jSym[ell_, m_] :> jRatioTop[ell, m, nu], assumptionsTop, TimeConstraint -> 12];\nGrid[MapThread[{#1, formTop[#2]} &, {{\"I12/G\", \"I22: constant/G\", \"I22: S/G\", \"I22: TB/G\", \"I22: TD/G\"}, loopRatios}], Frame -> All, Alignment -> Left]"];
TopNotebookBuild`addInput["loopCommon = -(1 + I nu)/(4 (5 + 2 I nu) (3 + 2 I nu) (5 + 4 I nu) (3 + 4 I nu));\nloopPaperRatios = {-(1 + I nu) (1 + 2 I nu)/(4 (3 + 2 I nu) (5 + 4 I nu) (3 + 4 I nu)),\n loopCommon (2 + I nu) (1 + 2 I nu), -loopCommon (1 + I nu) (1 + 2 I nu),\n -loopCommon (1 + 2 I nu) (3 + 2 I nu)/2, loopCommon (2 + I nu) (3 + 2 I nu)};\nloopSymbolicCheck = FullSimplify[loopRatios - loopPaperRatios, assumptionsTop];\nloopSymbolicCheck"];
TopNotebookBuild`addInput["i12Top[v_] := gTop[v] (loopRatios[[1]] /. nu -> v);\ni11Top[v_] := 3 i12Top[v]; i21Top[v_] := i12Top[v];\ni22Top[v_, t1_, t3_, ph_] := gTop[v] ((Rest[loopRatios] /. nu -> v).{1, Cos[t1]^2 + Cos[t3]^2 - 3 Cos[t1]^2 Cos[t3]^2, Sin[2 t1] Sin[2 t3] Cos[ph], Sin[t1]^2 Sin[t3]^2 Cos[2 ph]});\nformTop[gSymbol (Rest[loopRatios].{1, sAngular, bAngular, dAngular})]"];
TopNotebookBuild`addText["Text","In the displayed I22 expression, gSymbol = Gtop(nu), sAngular = S, bAngular = TB and dAngular = TD. The functions above retain the full angles. The next check independently evaluates the original shifted Gamma sums, without the recurrence reduction."];
TopNotebookBuild`addInput["loopNumericChecks = Table[Module[{direct, reduced},\n direct = N[(loopJExpressions /. jSym[ell_, m_] :> jTop[ell, m, 1, -I v]), 50];\n reduced = N[gTop[v] (loopRatios /. nu -> v), 50];\n {v, Max[Abs[(direct - reduced)/reduced]]}], {v, {1/5, 73/100, 2, 5}}];\nGrid[Prepend[N[loopNumericChecks, 6], {\"mt/H\", \"max relative Gamma-sum residual\"}], Frame -> All]"];
TopNotebookBuild`addText["Section","3. Whittaker seeds and regulated hard integrals"];
TopNotebookBuild`addText["Text","Eqs. (119)-(125). kappa = +/-1/2, a,b = +/-1. kOppTop and kSameTop use the regularized 3F2; this differs from the ordinary 3F2 used later in QTop. V is the vertex-type sum without a -1/2 prefactor; the hard kernels F and moments H use this same normalization. P_i is normalized to k12^(-2 I nu), so it includes the factor 2^(2 I nu) in Eq. (125). For a general soft branch eta this factor is 2^(2 I eta nu). The integral definition fixes all phases. The finite part is taken only after the full SK and kappa combinations have been assembled."];
TopNotebookBuild`addInput["kOppTop[a_, p_, q_, v_, kap_] := Exp[-I a Pi (p - q)/2 + I Pi kap] 2^(-3 - p - q) Gamma[3/2 + p - I v] Gamma[3/2 + p + I v] Gamma[3/2 + q - I v] Gamma[3/2 + q + I v]/(Gamma[2 + p + a kap] Gamma[2 + q - a kap]);\nkSameTop[a_, p_, q_, v_, kap_] := -a I Exp[-I a Pi (p + q)/2] 2^(-3 - p - q) Gamma[3/2 + p + a I v] Gamma[3/2 + q + a I v] ((Exp[2 I Pi kap] + Exp[-2 Pi v])/(2 Pi) Gamma[3/2 + p - a I v] Gamma[3/2 + q - a I v] Gamma[1/2 + a kap - I v] Gamma[1/2 + a kap + I v]/(Gamma[2 + p + a kap] Gamma[2 + q + a kap]) + a I Gamma[3 + p + q] HypergeometricPFQRegularized[{3 + p + q, 1/2 - a kap + a I v, 1}, {5/2 + p + a I v, 5/2 + q + a I v}, 1]);\nkSeedTop[a_, b_, p_, q_, v_, kap_] := If[a == b, kSameTop[a, p, q, v, kap], kOppTop[a, p, q, v, kap]];"];
TopNotebookBuild`addText["Text","The symbolic H0 and H1 definitions below retain KTop(a,b,kappa,p,q,r,nu) as an unevaluated seed at u=2r/(1+r). At r=1 it is kSeedTop. For the radial derivative, Eq. (124) shifts p or q; the explicit powers of r and the (a +/- r)/r factors must also be differentiated."];
TopNotebookBuild`addInput["h0FormalTop[q1_, q2_, r_, v_] := I Sum[With[{p = q1 - 3/2 + m, q = q2 - 3/2 + n},\n (I a)^m (I b)^n r^(-3-p-q) ((p+3/2+I v)(KTop[a,b,-1/2,p,q,r,v]-KTop[a,b,1/2,p,q,r,v]) + I(a-r)/r KTop[a,b,1/2,p+1,q,r,v] - I(a+r)/r KTop[a,b,-1/2,p+1,q,r,v])], {a,{-1,1}}, {b,{-1,1}}, {m,0,1}, {n,0,1}];\nh1FormalTop[q1_, q2_, r_, v_] := I Sum[With[{p = q1 - 3/2 + m, q = q2 - 3/2 + n},\n (I a)^m (I b)^n r^(-3-p-q) ((p+3/2-I v)(KTop[a,b,-1/2,p,q,r,v]+KTop[a,b,1/2,p,q,r,v]) - I(a-r)/r KTop[a,b,1/2,p+1,q,r,v] - I(a+r)/r KTop[a,b,-1/2,p+1,q,r,v])], {a,{-1,1}}, {b,{-1,1}}, {m,0,1}, {n,0,1}];\nHoldForm[{P1[nu] == 2^(2 I nu) FinitePart[H0[I nu+delta,I nu+delta,1,nu]+2 I/(1+2 I nu) H1[1+I nu+delta,I nu+delta,1,nu],delta,0], P2[nu] == 2^(2 I nu) FinitePart[(D[H0[I nu+delta,I nu+delta,r,nu],r]-H0[I nu+delta,I nu+delta,r,nu]) /. r->1,delta,0]}]"];
TopNotebookBuild`addText["Subsection","Stable numerical evaluation of the regulated definitions"];
TopNotebookBuild`addText["Text","For the independent regulator check, a Thomae transformation is used when it improves the convergence balance of 3F2(1). The representation has the same analytic continuation as the regularized seed. The numerical seed cache includes working precision. The derivative is implemented directly using Eq. (124)."];
TopNotebookBuild`addInput["hyper3RegN[upper_List, lower_List, prec_Integer] := Module[{aa=N[upper,prec], bb=N[lower,prec], balance, choices, best, ii, jj, c, pair, d, e},\n balance=Total[bb]-Total[aa]; choices=Join[{{Re[balance],0,0}}, Flatten[Table[{Re[bb[[j]]-aa[[i]]],i,j},{i,3},{j,2}],1]];\n best=First[MaximalBy[choices,First]];\n If[best[[2]]==0, Return[N[HypergeometricPFQRegularized[aa,bb,1],prec]]];\n {ii,jj}=Rest[best]; c=aa[[ii]]; pair=Delete[aa,ii]; e=bb[[jj]]; d=bb[[3-jj]];\n N[Gamma[balance] HypergeometricPFQ[{d-pair[[1]],d-pair[[2]],c},{d,balance+c},1]/(Gamma[e-c] Gamma[balance+c] Gamma[d]),prec]];\nkSeedN[a_Integer,b_Integer,p_?NumericQ,q_?NumericQ,v_?NumericQ,kap_,prec_Integer] := kSeedN[a,b,p,q,v,kap,prec] = Module[{pp=N[p,prec],qq=N[q,prec],vv=N[v,prec],kk=N[kap,prec],base,hom,part},\n If[a!=b,Return[N[kOppTop[a,pp,qq,vv,kk],prec]]];\n base=-a I Exp[-I a Pi(pp+qq)/2] 2^(-3-pp-qq) Gamma[3/2+pp+a I vv] Gamma[3/2+qq+a I vv];\n hom=(Exp[2 I Pi kk]+Exp[-2 Pi vv])/(2 Pi) Gamma[3/2+pp-a I vv] Gamma[3/2+qq-a I vv] Gamma[1/2+a kk-I vv] Gamma[1/2+a kk+I vv]/(Gamma[2+pp+a kk] Gamma[2+qq+a kk]);\n part=a I Gamma[3+pp+qq] hyper3RegN[{3+pp+qq,1/2-a kk+a I vv,1},{5/2+pp+a I vv,5/2+qq+a I vv},prec];\n N[base(hom+part),prec]];\nkSeedDrN[a_,b_,p_,q_,v_,kap_,prec_] := I a kSeedN[a,b,p+1,q,v,kap,prec]+I b kSeedN[a,b,p,q+1,v,kap,prec];"];
TopNotebookBuild`addInput["hardMomentsN[v_?NumericQ,q1_?NumericQ,q2_?NumericQ,prec_Integer] := Module[{h0=0,h1=0,dh0=0,p,q,kp,km,kps,kms,dkp,dkm,dkps,dkms,w,t0,t1,dt0},\n Do[p=q1-3/2+m; q=q2-3/2+n; w=I (I a)^m (I b)^n;\n kp=kSeedN[a,b,p,q,v,1/2,prec]; km=kSeedN[a,b,p,q,v,-1/2,prec];\n kps=kSeedN[a,b,p+1,q,v,1/2,prec]; kms=kSeedN[a,b,p+1,q,v,-1/2,prec];\n dkp=kSeedDrN[a,b,p,q,v,1/2,prec]; dkm=kSeedDrN[a,b,p,q,v,-1/2,prec];\n dkps=kSeedDrN[a,b,p+1,q,v,1/2,prec]; dkms=kSeedDrN[a,b,p+1,q,v,-1/2,prec];\n t0=(p+3/2+I v)(km-kp)+I(a-1)kps-I(a+1)kms;\n t1=(p+3/2-I v)(km+kp)-I(a-1)kps-I(a+1)kms;\n dt0=-(3+p+q)t0+(p+3/2+I v)(dkm-dkp)+I(a-1)dkps-I(a+1)dkms-I a kps+I a kms;\n h0+=w t0; h1+=w t1; dh0+=w dt0,\n {a,{-1,1}},{b,{-1,1}},{m,0,1},{n,0,1}]; N[{h0,h1,dh0},prec]];\nregulatedHardTop[v_?NumericQ,del_?NumericQ,prec_Integer:50] := regulatedHardTop[v,del,prec] = Module[{base,shift},\n base=hardMomentsN[v,I v+del,I v+del,prec];\n shift=hardMomentsN[v,1+I v+del,I v+del,prec];\n {2^(2 I v)(base[[1]]+2 I/(1+2 I v) shift[[2]]),2^(2 I v)(base[[3]]-base[[1]]),base[[1]],shift[[2]]}];\nregulatorLimitTop[v_,step_,levels_Integer,prec_Integer:50] := Module[{vals},\n vals=Table[regulatedHardTop[v,step/2^j,prec],{j,0,levels-1}];\n Do[vals=Table[(2^ord vals[[j+1]]-vals[[j]])/(2^ord-1),{j,Length[vals]-1}],{ord,1,levels-1}]; First[vals]];"];
TopNotebookBuild`addText["Section","4. Finite analytic hard coefficients and FullSimplify results"];
TopNotebookBuild`addText["Text","A finite representation of the assembled Eq. (125) is expressed through Q_mn. This representation is also present in the source manuscript comments and the existing Whittaker calculation. Its equivalence to the regulated definition is checked numerically below; that check is distinct from a symbolic proof of the regulator limit. Q_mn contains an ordinary 3F2 with convergence balance 1 + I nu. Only Q00 remains nontrivial after the other four functions are reduced."];
TopNotebookBuild`addInput["qTop[m_,n_,v_] := 2^(-1-2 I v-m-n) Gamma[1+2 I v+m+n]/((1+2 I v+m)(1+2 I v+n)) HypergeometricPFQ[{1+2 I v+m+n,1+I v,1},{2+2 I v+m,2+2 I v+n},1];\ntimeGammaTop[v_] := 2^(-1-2 I v) Gamma[1+2 I v];\nendpointTop[v_] := Pi^2 2^(-1-2 I v) (Gamma[1+2 I v]/Gamma[1+I v])^2;\nformTop[qTop[0,0,nu]]"];
TopNotebookBuild`addInput["qPairs={{0,1},{1,1},{0,2},{1,2}};\nqRatioSimp=FullSimplify[Table[qTop[pair[[1]],pair[[2]],nu]/timeGammaTop[nu],{pair,qPairs}],assumptionsTop,TimeConstraint->12];\nGrid[MapThread[{#1,formTop[#2]}&,{{\"Q01/T\",\"Q11/T\",\"Q02/T\",\"Q12/T\"},qRatioSimp}],Frame->All,Alignment->Left]"];
TopNotebookBuild`addInput["qExpectedRatios={1/(2(1+I nu)),(1+2 I nu)/(4(1+I nu)),(3+2 I nu)/(4(2+I nu)),(1+2 I nu)/4};\nqReductionCheck=FullSimplify[qRatioSimp-qExpectedRatios,assumptionsTop,TimeConstraint->10];\nqReductionCheck"];
TopNotebookBuild`addText["Text","For compact output below, q00 denotes Q00(nu), tGamma denotes T(nu)=2^(-1-2 I nu) Gamma(1+2 I nu), and eEndpoint denotes E(nu). H0fin is FP H0(I nu+delta,I nu+delta;1); H1fin is FP H1(1+I nu+delta,I nu+delta;1). Their finite endpoint terms are retained."];
TopNotebookBuild`addInput["qReducedTop[0,0] := q00;\nqReducedTop[0,1] := tGamma/(2(1+I nu)); qReducedTop[1,0] := qReducedTop[0,1];\nqReducedTop[1,1] := tGamma(1+2 I nu)/(4(1+I nu));\nqReducedTop[0,2] := tGamma(3+2 I nu)/(4(2+I nu));\nqReducedTop[1,2] := tGamma(1+2 I nu)/4;\nh0Template=FullSimplify[-4 Cosh[Pi nu](qReducedTop[0,0]+2 qReducedTop[0,1]+qReducedTop[1,1])+2 eEndpoint,assumptionsTop];\nh1Template=FullSimplify[4 I Cosh[Pi nu](qReducedTop[0,2]+qReducedTop[1,2]),assumptionsTop];\nGrid[{{\"H0fin\",formTop[h0Template]},{\"H1fin\",formTop[h1Template]}},Frame->All,Alignment->Left]"];
TopNotebookBuild`addInput["p1Template=FullSimplify[2^(2 I nu)(h0Template+2 I/(1+2 I nu) h1Template),assumptionsTop];\np2Template=FullSimplify[-2^(1+2 I nu)(2 Cosh[Pi nu] Sum[(m(1+2 I nu+m)/(2(1+I nu+m))+n(1+2 I nu+n)/(2(1+I nu+n))-(1+2 I nu+m+n))qReducedTop[m,n],{m,0,1},{n,0,1}]+(1+2 I nu)eEndpoint+tGamma Cosh[Pi nu](4+5 I nu-2 nu^2)/(1+I nu)),assumptionsTop];\ndh0Template=FullSimplify[2^(-2 I nu) p2Template+h0Template,assumptionsTop];\nGrid[{{\"P1\",formTop[p1Template]},{\"P2\",formTop[p2Template]},{\"FP dH0/dr at r=1\",formTop[dh0Template]}},Frame->All,Alignment->Left]"];
TopNotebookBuild`addInput["finiteSubstitutionTop[v_] := {nu->v,q00->qTop[0,0,v],tGamma->timeGammaTop[v],eEndpoint->endpointTop[v]};\nP1Top[v_] := p1Template /. finiteSubstitutionTop[v];\nP2Top[v_] := p2Template /. finiteSubstitutionTop[v];\nH0FiniteTop[v_] := h0Template /. finiteSubstitutionTop[v];\nH1FiniteTop[v_] := h1Template /. finiteSubstitutionTop[v];\np1AnalyticSimp=FullSimplify[P1Top[nu],assumptionsTop,TimeConstraint->8];\np2AnalyticSimp=FullSimplify[P2Top[nu],assumptionsTop,TimeConstraint->8];\nColumn[{Style[\"P1(nu): fully substituted FullSimplify result\",FontWeight->Bold],formTop[p1AnalyticSimp],Style[\"P2(nu): fully substituted FullSimplify result\",FontWeight->Bold],formTop[p2AnalyticSimp]},Spacings->2]"];
TopNotebookBuild`addInput["hardValuesTop[v_?NumericQ,prec_Integer:50] := hardValuesTop[v,prec] = Module[{vv=N[v,prec],qv=N[qTop[0,0,v],prec]},\n N[{p1Template,p2Template,h0Template,h1Template}/.{nu->vv,q00->qv,tGamma->timeGammaTop[vv],eEndpoint->endpointTop[vv]},prec]];\nhardSample=Table[Prepend[N[hardValuesTop[v,50][[1;;2]],12],v],{v,{1/5,73/100,1,2,5}}];\nGrid[Prepend[hardSample,{\"mt/H\",\"P1\",\"P2\"}],Frame->All,Alignment->Left]"];
TopNotebookBuild`addText["Subsection","Regulator convergence and precision checks"];
TopNotebookBuild`addText["Text","The next table compares the finite formulas with the complete regulated SK sum. Richardson extrapolation uses delta = 10^-3/2^j, at four and five levels. A stable ordinary limit is tested here, not assumed for individual seed terms. The comparison includes H0fin and H1fin as well as P1 and P2. This check is slower than the mass scan."];
TopNotebookBuild`addInput["regulatorChecks=Table[Module[{low,high,target,err,stepErr},\n low=regulatorLimitTop[v,1/1000,4,50]; high=regulatorLimitTop[v,1/1000,5,50]; target=hardValuesTop[v,50];\n err=Abs[(high-target)/target]; stepErr=Max[Abs[(low-high)/high]];\n {v,err[[1]],err[[2]],err[[3]],err[[4]],stepErr}],{v,{1/5,73/100,2}}];\nGrid[Prepend[N[regulatorChecks,5],{\"mt/H\",\"P1 rel. error\",\"P2 rel. error\",\"H0 rel. error\",\"H1 rel. error\",\"4 vs 5 levels\"}],Frame->All]"];
TopNotebookBuild`addText["Section","5. Five angular coefficients as functions of mass"];
TopNotebookBuild`addText["Text","Eq. (128) defines the common soft factor. Eq. (129) gives A1, A2, A3, B and D. Products are complex squares P_i P_j, not absolute-value squares. All four s-channel orderings are already included. These are dimensionless coefficients of the oscillatory signal, not the full four-point function."];
TopNotebookBuild`addInput["softBTop[v_] := With[{rho=rhoTop[v]},Gamma[rho]^4 f0Top[rho,rho]/(4 (4 Pi)^(7/2)(rho-3)(rho-2)(4 rho-7)(4 rho-5))];\nsoftBSimp=FullSimplify[softBTop[nu],assumptionsTop,TimeConstraint->10];\nformTop[softBSimp]"];
TopNotebookBuild`addInput["coefficientTemplate=With[{rho=rhoTop[nu]}, {\n bb(rho-1)(2 rho-3)(4(rho-3)(3 pp1^2+2 pp1 pp2)+(2 rho-5)pp2^2),\n -bb pp2^2(rho-1)(2 rho-3)^2,\n 3 bb pp2^2(rho-1)(2 rho-3)^2,\n -2 bb pp2^2(rho-1)(rho-2)(2 rho-3),\n bb pp2^2(rho-2)(2 rho-5)(2 rho-3)}];\ncoefficientSimp=Factor /@ FullSimplify[coefficientTemplate,assumptionsTop];\ncoefficientNames={\"A1\",\"A2\",\"A3\",\"B\",\"D\"};\nGrid[MapThread[{#1,formTop[#2]}&,{coefficientNames,coefficientSimp}],Frame->All,Alignment->Left]"];
TopNotebookBuild`addText["Text","In this factored table bb = softBTop(nu), pp1 = P1Top(nu), pp2 = P2Top(nu). The next saved output writes these mass-dependent functions explicitly. P1Top and P2Top have the fully substituted analytic expressions shown in Section 4."];
TopNotebookBuild`addInput["angularCoefficientsTop[v_] := coefficientSimp /. {nu->v,bb->softBTop[v],pp1->P1Top[v],pp2->P2Top[v]};\nA1Top[v_] := angularCoefficientsTop[v][[1]]; A2Top[v_] := angularCoefficientsTop[v][[2]];\nA3Top[v_] := angularCoefficientsTop[v][[3]]; BTop[v_] := angularCoefficientsTop[v][[4]]; DTop[v_] := angularCoefficientsTop[v][[5]];\nGrid[MapThread[{#1<>\"(nu)\",formTop[#2]}&,{coefficientNames,coefficientSimp/.{bb->Inactive[softBTop][nu],pp1->Inactive[P1Top][nu],pp2->Inactive[P2Top][nu]}}],Frame->All,Alignment->Left]"];
TopNotebookBuild`addText["Subsection","Angular reconstruction and normalization checks"];
TopNotebookBuild`addInput["normalizationRatio=FullSimplify[8 Gamma[1/2-I nu]^4/(4 Pi)^(7/2) gTop[nu]/softBTop[nu],assumptionsTop,TimeConstraint->10];\nassembledFromLoop=normalizationRatio bb ((3 pp1^2+2 pp1 pp2)loopRatios[[1]]+pp2^2 Rest[loopRatios].{1,s1+s3-3 s1 s3,tb,td});\nassembledFromCoefficients=coefficientSimp.{1,s1+s3,s1 s3,tb,td};\nangularSymbolicCheck=FullSimplify[assembledFromLoop-assembledFromCoefficients,assumptionsTop,TimeConstraint->10];\na3Check=FullSimplify[coefficientSimp[[3]]+3 coefficientSimp[[2]],assumptionsTop];\nGrid[{{\"Eq. (64) vs Eq. (129)\",angularSymbolicCheck},{\"A3 + 3 A2\",a3Check}},Frame->All]"];
TopNotebookBuild`addInput["coefficientValuesTop[v_?NumericQ,prec_Integer:50] := Module[{vv=N[v,prec],pv=hardValuesTop[v,prec]},\n N[coefficientSimp/.{nu->vv,bb->softBTop[vv],pp1->pv[[1]],pp2->pv[[2]]},prec]];\nprecisionChecks=Table[{v,Max[Abs[(coefficientValuesTop[v,40]-coefficientValuesTop[v,60])/coefficientValuesTop[v,60]]]}, {v,{1/10,1/5,73/100,2,5}}];\nGrid[Prepend[N[precisionChecks,5],{\"mt/H\",\"max relative error: 40 vs 60 digits\"}],Frame->All]"];
TopNotebookBuild`addInput["cFromLoopTop[v_,t1_,t3_,ph_,prec_Integer:50] := Module[{pv=hardValuesTop[v,prec]},N[8 Gamma[1/2-I v]^4/(4 Pi)^(7/2)((3 pv[[1]]^2+2 pv[[1]]pv[[2]])i12Top[v]+pv[[2]]^2 i22Top[v,t1,t3,ph]),prec]];\nangularNumericChecks=Table[Module[{cv=coefficientValuesTop[v,50],reconstructed,projectedB,projectedD},\n reconstructed=cv.{1,Cos[2/5]^2+Cos[7/10]^2,Cos[2/5]^2 Cos[7/10]^2,Sin[4/5]Sin[7/5]Cos[9/10],Sin[2/5]^2 Sin[7/10]^2 Cos[9/5]};\n projectedB=(cFromLoopTop[v,Pi/4,Pi/4,0]-cFromLoopTop[v,Pi/4,Pi/4,Pi])/2;\n projectedD=(cFromLoopTop[v,Pi/2,Pi/2,0]-cFromLoopTop[v,Pi/2,Pi/2,Pi/2])/2;\n {v,Abs[(cFromLoopTop[v,2/5,7/10,9/10]-reconstructed)/reconstructed],Abs[(projectedB-cv[[4]])/cv[[4]]],Abs[(projectedD-cv[[5]])/cv[[5]]]}],{v,{1/5,73/100,2}}];\nGrid[Prepend[N[angularNumericChecks,5],{\"mt/H\",\"angular reconstruction\",\"B projection\",\"D projection\"}],Frame->All]"];
TopNotebookBuild`addText["Section","6. Mass scan and saved plots"];
TopNotebookBuild`addText["Text","The scan covers 0.1 <= mt/H <= 5, with spacing 0.01 up to 1 and 0.05 above 1. The massless endpoint is excluded because the separated soft branches require a separate limiting treatment. Raw complex coefficients are retained in massDataTop. Each coefficient has a natural-log magnitude plot and a principal-phase plot in radians; phase branches are disconnected at jumps exceeding Pi. No Boltzmann factor is removed."];
TopNotebookBuild`addInput["massGridTop=Join[Range[massMin,1,1/100],Range[21/20,massMax,1/20]];\nmassDataTop=Table[Prepend[coefficientValuesTop[v,wp],v],{v,massGridTop}];\nscanValidTop=And@@(VectorQ[#,NumericQ]& /@ massDataTop) && FreeQ[massDataTop,Indeterminate|ComplexInfinity|DirectedInfinity[_]];\n{Length[massDataTop],scanValidTop}"];
TopNotebookBuild`addInput["sampleRowsTop=Select[massDataTop,MemberQ[{1/10,1/5,1/2,1,2,3,4,5},First[#]]&];\nGrid[Prepend[N[sampleRowsTop,8],Prepend[coefficientNames,\"mt/H\"]],Frame->All,Alignment->Left]"];
TopNotebookBuild`addInput["plotColorsTop={RGBColor[0.75,0.12,0.12],RGBColor[0.12,0.32,0.78],RGBColor[0.12,0.55,0.30],RGBColor[0.60,0.22,0.72],RGBColor[0.88,0.47,0.08]};\nlogMagnitudeDataTop[j_Integer] := ({N[#[[1]]],N[Log[Abs[#[[j+1]]]]]}& /@ massDataTop);\nphaseDataTop[j_Integer] := ({N[#[[1]]],N[Arg[#[[j+1]]]]}& /@ massDataTop);\nphaseSegmentsTop[j_Integer] := Split[phaseDataTop[j],Abs[Last[#1]-Last[#2]]<=Pi&];\nmagnitudePlotTop[j_Integer] := ListLinePlot[logMagnitudeDataTop[j],Frame->True,Axes->False,FrameLabel->{\"mt/H\", \"ln |\"<>coefficientNames[[j]]<>\"|\"},PlotLabel->Style[coefficientNames[[j]]<>\" : magnitude\",14],PlotStyle->Directive[plotColorsTop[[j]],Thick],PlotRange->All,ImageSize->430,BaseStyle->{FontFamily->\"Times\",FontSize->13},GridLines->Automatic,GridLinesStyle->Directive[GrayLevel[0.9]]];\nphasePlotTop[j_Integer] := ListLinePlot[phaseSegmentsTop[j],Frame->True,Axes->False,FrameLabel->{\"mt/H\",\"Arg \"<>coefficientNames[[j]]<>\" [rad]\"},PlotLabel->Style[coefficientNames[[j]]<>\" : phase\",14],PlotStyle->Directive[plotColorsTop[[j]],Thick],PlotRange->{{N[massMin],N[massMax]},{-Pi,Pi}},FrameTicks->{{{-Pi,-Pi/2,0,Pi/2,Pi},None},{Automatic,None}},ImageSize->430,BaseStyle->{FontFamily->\"Times\",FontSize->13},GridLines->{Automatic,{-Pi,0,Pi}},GridLinesStyle->Directive[GrayLevel[0.9]]];"];
TopNotebookBuild`addInput["overviewPlotTop=ListLinePlot[Table[logMagnitudeDataTop[j],{j,5}],Frame->True,Axes->False,FrameLabel->{\"mt/H\",\"ln |coefficient|\"},PlotLabel->\"Top-quark angular coefficients - Eq. (65)\",PlotLegends->Placed[coefficientNames,Right],PlotStyle->(Directive[#,Thick]& /@ plotColorsTop),PlotRange->All,ImageSize->850,BaseStyle->{FontFamily->\"Times\",FontSize->14},GridLines->Automatic,GridLinesStyle->Directive[GrayLevel[0.9]]];\noverviewPlotTop"];
TopNotebookBuild`addText["Subsection","A1 mass dependence"];
TopNotebookBuild`addInput["coefficientPlotTop[1]=GraphicsRow[{magnitudePlotTop[1],phasePlotTop[1]},ImageSize->900,Spacings->15];\ncoefficientPlotTop[1]"];
TopNotebookBuild`addText["Subsection","A2 mass dependence"];
TopNotebookBuild`addInput["coefficientPlotTop[2]=GraphicsRow[{magnitudePlotTop[2],phasePlotTop[2]},ImageSize->900,Spacings->15];\ncoefficientPlotTop[2]"];
TopNotebookBuild`addText["Subsection","A3 mass dependence"];
TopNotebookBuild`addInput["coefficientPlotTop[3]=GraphicsRow[{magnitudePlotTop[3],phasePlotTop[3]},ImageSize->900,Spacings->15];\ncoefficientPlotTop[3]"];
TopNotebookBuild`addText["Subsection","B mass dependence"];
TopNotebookBuild`addInput["coefficientPlotTop[4]=GraphicsRow[{magnitudePlotTop[4],phasePlotTop[4]},ImageSize->900,Spacings->15];\ncoefficientPlotTop[4]"];
TopNotebookBuild`addText["Subsection","D mass dependence"];
TopNotebookBuild`addInput["coefficientPlotTop[5]=GraphicsRow[{magnitudePlotTop[5],phasePlotTop[5]},ImageSize->900,Spacings->15];\ncoefficientPlotTop[5]"];
TopNotebookBuild`addText["Text","A3 = -3 A2 implies ln|A3| - ln|A2| = ln(3) and a phase difference of Pi modulo 2 Pi. The phase shown is that of each coefficient in the convention of Eq. (64); the phase of the full signal at fixed angles is Arg[Ctop], which also depends on the angular combination."];
TopNotebookBuild`addText["Section","7. Validation summary"];
TopNotebookBuild`addText["Text","These checks validate the implementation of the stated leading collapsed formulas, their algebraic relations, and numerical stability. The regulator comparison is numerical evidence for the finite representation, not a full symbolic proof of that limit or an independent validation of the complete unexpanded fermion box."];
TopNotebookBuild`addInput["validationTop=<|\n \"Soft Gamma normalization\"->TrueQ[softGammaCheck==0],\n \"Loop coefficients: symbolic Gamma recurrence\"->TrueQ[loopSymbolicCheck==ConstantArray[0,5]],\n \"Loop coefficients: direct Gamma sums\"->TrueQ[Max[loopNumericChecks[[All,2]]]<10^-35],\n \"Four Q reductions\"->TrueQ[qReductionCheck==ConstantArray[0,4]],\n \"Regulated SK sum vs finite P and H\"->TrueQ[Max[Flatten[regulatorChecks[[All,2;;5]]]]<10^-9],\n \"Regulator convergence: four vs five levels\"->TrueQ[Max[regulatorChecks[[All,6]]]<10^-9],\n \"Eq. (64) vs angular coefficients\"->TrueQ[angularSymbolicCheck==0],\n \"A3 = -3 A2\"->TrueQ[a3Check==0],\n \"Precision stability\"->TrueQ[Max[precisionChecks[[All,2]]]<10^-25],\n \"Independent angle projections\"->TrueQ[Max[Flatten[angularNumericChecks[[All,2;;4]]]]<10^-35],\n \"Mass scan contains finite numeric values\"->TrueQ[scanValidTop]|>;\nGrid[Prepend[KeyValueMap[{#1,If[#2,Style[\"PASS\",Darker[Green]],Style[\"FAIL\",Red]]}&,validationTop],{\"Check\",\"Result\"}],Frame->All,Alignment->Left]"];
TopNotebookBuild`addInput["EndPackage[];"];
TopNotebookBuild`explicitCells=Import[FileNameJoin[{TopNotebookBuild`root,"checks","explicit_signal_cells.json"}],"RawJSON"]["top"];
Scan[If[#["type"]=="Input",TopNotebookBuild`addInput[#["source"]],TopNotebookBuild`addText[#["type"],#["source"]]]&,TopNotebookBuild`explicitCells];
];
Begin["TopNotebookBuild`"];
allPassed=AssociationQ[TopQuarkSignal`validationTop] && And@@Values[TopQuarkSignal`validationTop] && AssociationQ[TopQuarkSignal`topExplicitValidation] && And@@Values[TopQuarkSignal`topExplicitValidation];
AppendTo[log,"VALIDATION: "<>ToString[TopQuarkSignal`validationTop,InputForm]];
AppendTo[log,"ERRORS: "<>ToString[errors,InputForm]];
If[!TrueQ[allPassed] || errors=!={},AppendTo[log,"BUILD FAILED"];writeLog[];Close[messageStream];Quit[1]];
nb=Notebook[cells,WindowTitle->"Top Quark Signal",WindowSize->{1250,900},StyleDefinitions->"Default.nb",TaggingRules->{"Source"->"SMS in CHC: Eqs. (59)-(65), (109), (112)-(131)","Evaluated"->True},Magnification->1.0];
Put[nb,outputPath];
saved=Get[outputPath];
inputBoxes=Cases[saved,Cell[BoxData[b_],"Input",___]:>b,Infinity];
syntaxValid=And@@(MatchQ[Quiet[Check[ToExpression[#,StandardForm,HoldComplete],$Failed]],_HoldComplete]& /@ inputBoxes);
AppendTo[log,"SAVED INPUT CELLS: "<>ToString[Length[inputBoxes]]];
AppendTo[log,"SAVED OUTPUT CELLS: "<>ToString[Length[Cases[saved,Cell[_,"Output",___],Infinity]]]];
AppendTo[log,"SAVED GRAPHICS BOXES: "<>ToString[Length[Cases[saved,_GraphicsBox,Infinity]]]];
Put[saved,FileNameJoin[{tmpRoot,"top_quark_roundtrip.nb"}]];
serializationStable=SameQ[saved,Get[FileNameJoin[{tmpRoot,"top_quark_roundtrip.nb"}]]];
AppendTo[log,"SAVED NOTEBOOK SERIALIZATION STABLE: "<>ToString[serializationStable]];
AppendTo[log,"SAVED INPUT SYNTAX VALID: "<>ToString[syntaxValid]];
AppendTo[log,"DURATION SECONDS: "<>ToString[AbsoluteTime[]-started]];writeLog[];
Export[FileNameJoin[{tmpRoot,"top_quark_overview.png"}],TopQuarkSignal`overviewPlotTop,ImageResolution->110];
Do[Export[FileNameJoin[{tmpRoot,"top_quark_"<>ToString[j]<>".png"}],TopQuarkSignal`coefficientPlotTop[j],ImageResolution->110],{j,5}];
Export[FileNameJoin[{tmpRoot,"top_quark_validation.json"}],<|"Checks"->TopQuarkSignal`validationTop,"RegulatorChecks"->N[TopQuarkSignal`regulatorChecks],"PrecisionChecks"->N[TopQuarkSignal`precisionChecks],"AngularChecks"->N[TopQuarkSignal`angularNumericChecks],"MassPoints"->Length[TopQuarkSignal`massDataTop]|>,"RawJSON"];
Put[TopQuarkSignal`massDataTop,FileNameJoin[{tmpRoot,"top_quark_mass_data.wl"}]];
Put[Table[{v,TopQuarkSignal`hardValuesTop[v,50]},{v,{1/5,73/100,1,2,5}}],FileNameJoin[{tmpRoot,"top_quark_hard_data.wl"}]];
