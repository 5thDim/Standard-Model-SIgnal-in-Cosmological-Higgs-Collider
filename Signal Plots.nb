   Cell["Export the two preview PNGs to plots/previews. The manuscript and figure PDFs are unchanged.",
    "Text"],
   Cell[BoxData[RowBox[{RowBox[{"Export", "[", RowBox[{RowBox[{"FileNameJoin", "[",
             RowBox[{"{", RowBox[{"plotRoot", ",", "\"previews\"", ",", "\"clock_tnl_vs_mass.png\""}], "}"}],
             "]"}], ",", RowBox[{"Rasterize", "[", RowBox[{"clockMassAmplitudePlot", ",", "\"Image\"", ",",
               RowBox[{"Background", "\:f522", "White"}], ",", RowBox[{"ImageResolution", "\:f522", "144"}]}],
             "]"}], ",", "\"PNG\"", ",", RowBox[{"ImageResolution", "\:f522", "144"}]}], "]"}], ";",
       RowBox[{"Export", "[", RowBox[{RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"plotRoot", ",",
                 "\"previews\"", ",", "\"clock_phase_vs_mass.png\""}], "}"}], "]"}], ",",
           RowBox[{"Rasterize", "[", RowBox[{"clockMassPhasePlot", ",", "\"Image\"", ",", RowBox[
                {"Background", "\:f522", "White"}], ",", RowBox[{"ImageResolution", "\:f522", "144"}]}], "]"}],
           ",", "\"PNG\"", ",", RowBox[{"ImageResolution", "\:f522", "144"}]}], "]"}], ";"}]], "Input",
    CellTags -> "clock-mass-export"]}, Open]]
,
Cell[CellGroupData[{Cell["8. Collapsed trispectrum: T and T/E", "Section", CellTags -> "clock-shape-maps"],
   Cell["Use r1=ks/k12 and r2=ks/k34, where k12=k1+k2 and k34=k3+k4. The coordinates are x=-log10(r1), \
y=-log10(r2), both from 0 to 2. T denotes the leading oscillatory nonlocal collapsed s-channel template, with \
all three species summed as signed real signals.", "Text"],
   Cell[BoxData[RowBox[{RowBox[{"clockShapeParameters", "=",
         RowBox[{"Join", "[", RowBox[{"clockParameters", ",", RowBox[{"Association", "[", RowBox[
                {"\"lambda\"", "\:f522", FractionBox["1", "100"]}], "]"}]}], "]"}]}], ";",
       RowBox[{"clockShapeAngles", "=", RowBox[{"{", RowBox[{FractionBox["\:03c0", "2"], ",",
             FractionBox["\:03c0", "2"], ",", "0"}], "}"}]}], ";", RowBox[{"clockShapePrecision", "=", "60"}],
       ";", RowBox[{"clockShapeLogGrid", "=", RowBox[{"Subdivide", "[", RowBox[{"0", ",", "2", ",", "200"}],
           "]"}]}], ";", RowBox[{"clockShapeBandCount", "=", "20"}], ";"}]], "Input",
    CellTags -> "clock-shape-parameters"], Cell["Fix theta1=theta3=Pi/2 and phi3=0. Lu (2019), Eqs. \
(11),(45), gives mH^2/H^2=Sqrt[6 lambda/Pi^3] and the loop-dominated masses mW^2/H^2=3 g^2/(8 Pi^2 mH^2/H^2), \
mZ=mW/cW. The top mass is mt=yt h0/Sqrt[2]. The remaining parameters are taken from clockParameters in \
Section 1. Raw coefficients are evaluated once per species at these benchmark masses.", "Text"],
   Cell[CellGroupData[
     {Cell[BoxData[RowBox[{RowBox[{"clockShapeBenchmark", "=", RowBox[{"Lu2019MassBenchmark", "[",
              "clockShapeParameters", "]"}]}], ";", RowBox[{"clockShapeAssemblies", "=",
            RowBox[{"AssociationMap", "[", RowBox[{RowBox[{"Function", "[", RowBox[{"s", ",",
                    RowBox[{"ClockCoefficients", "[", RowBox[{"s", ",", RowBox[{RowBox[
                           {"clockShapeBenchmark", "[", "\"Nu\"", "]"}], "[", "s", "]"}], ",",
                        "clockShapePrecision", ",", "clockShapeParameters"}], "]"}]}], "]"}], ",",
                RowBox[{"{", RowBox[{"\"W\"", ",", "\"Z\"", ",", "\"t\""}], "}"}]}], "]"}]}], ";",
          RowBox[{"clockCollapsedShape", "=", RowBox[{"AssembleClockShape", "[",
              RowBox[{"clockShapeAssemblies", ",", "clockShapeAngles"}], "]"}]}], ";",
          RowBox[{"clockShapeBenchmarkTable", "=", RowBox[{"Grid", "[", RowBox[{RowBox[{"Prepend", "[",
                  RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[
                               {"o", "=", RowBox[{RowBox[{"clockCollapsedShape", "[", "\"Oscillators\"",
                                    "]"}], "[", "s", "]"}]}], "}"}], ",", RowBox[{"{", RowBox[{"s", ",",
                                RowBox[{"N", "[", RowBox[{RowBox[{"o", "[", "\"MassOverH\"", "]"}], ",",
                                    "6"}], "]"}], ",", RowBox[{"N", "[", RowBox[{RowBox[{"o", "[", "\"Nu\"",
                                    "]"}], ",", "6"}], "]"}], ",", RowBox[{"N", "[", RowBox[{RowBox[{"o",
                                    "[", "\"tNL\"", "]"}], ",", "6"}], "]"}], ",", RowBox[{"N", "[",
                                  RowBox[{RowBox[{"o", "[", "\"Phase\"", "]"}], ",", "6"}], "]"}]}], "}"}]}],
                          "]"}], ",", RowBox[{"{", RowBox[{"s", ",", RowBox[{"{", RowBox[{"\"W\"", ",",
                                "\"Z\"", ",", "\"t\""}], "}"}]}], "}"}]}], "]"}], ",", RowBox[
                     {"{", RowBox[{"\"Species\"", ",", "\"m/H\"", ",", "\"nu\"", ",", "\"tNL\"", ",",
                        "\"phase (rad)\""}], "}"}]}], "]"}], ",", RowBox[{"Frame", "\:f522", "All"}]}],
              "]"}]}]}]], "Input", CellTags -> "clock-shape-benchmark-input"],
      Cell[BoxData[TagBox[GridBox[{{"\"Species\"", "\"m/H\"", "\"nu\"", "\"tNL\"", "\"phase (rad)\""},
           {"\"W\"", "0.5576241875351193294`6.", "0.2468698736666787605`6.", "1.1275854146376913191`6.",
            "2.7623517065175841018`6."}, {"\"Z\"", "0.6336638494717265107`6.", "0.389268383159134662`6.",
            "0.1162708938652480971`6.", "2.6216290676924458624`6."}, {"\"t\"", "0.7071067811865475244`6.",
            "0.7071067811865475244`6.", "0.0933517727853700592`6.", "0.5390171700592129518`6."}},
          AutoDelete -> False, GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}},
          GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Grid"]], "Output",
       CellTags -> "clock-shape-benchmark-output"]}, Open]], Cell["The common envelope is E=(ks/kt)^3=(r1 \
r2/(r1+r2))^3. T/E retains the top extra factor r1 r2. The stored data include E, T, T/E and the three \
species contributions to T/E, using 60-digit arithmetic. Both colorbars are linear and symmetric about zero, \
with independent numerical ranges. The signed signals are displayed without taking an absolute value or \
normalizing their amplitudes.", "Text"],
   Cell[BoxData[RowBox[{RowBox[{"clockShapeData", "=", RowBox[{"CachedClockShapeData", "[",
           RowBox[{RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"plotRoot", ",", "\"data\"", ",",
                   "\"clock_shape_log_grid.wxf\""}], "}"}], "]"}], ",", "clockCollapsedShape", ",",
             "clockShapeLogGrid", ",", "clockShapePrecision", ",", "recomputeData"}], "]"}]}], ";"}]],
    "Input", CellTags -> "clock-shape-data"], Cell["The full 0..2 window is an exploratory extrapolation of \
the leading collapsed template. Points near r1=1 or r2=1 are outside the controlled soft limit. Use the \
deep-soft region to interpret the collapsed signal.", "Text"],
   Cell[CellGroupData[{Cell[BoxData[RowBox[{"clockTrispectrumPlot", "=",
          RowBox[{"ClockShapeMapPlot", "[", RowBox[{"clockShapeData", ",", "\"T\"", ",",
              RowBox[{"\"BandCount\"", "\:f522", "clockShapeBandCount"}]}], "]"}]}]], "Input",
       CellTags -> "clock-shape-raw-input"],
