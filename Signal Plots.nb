AxHE6YQ=="], {{0, 350.}, {560., 0}}, {0, 255},
     ColorFunction -> RGBColor, ImageResolution -> {144, 144}], BoxForm`ImageTag["Byte", ColorSpace -> "RGB",
     Interleaving -> True, MetaInformation ->
      <|"Comments" -> {"Software" -> "Created with the Wolfram Language : www.wolfram.com",
         "Creation Time" -> DateObject[{2026, 11, 14, 13, 33, 10}, "Instant", "Gregorian", 8.]}|>],
    Selectable -> False], DefaultBaseStyle -> "ImageGraphics", ImageSizeRaw -> {560., 350.},
   PlotRange -> {{0, 560.}, {0, 350.}}]], "Output", CellTags -> "clock-mass-phase-output"]},
     Open]],
   Cell["Export the two preview PNGs to plots/previews. The manuscript and figure PDFs are unchanged.",
    "Text"],
   Cell[BoxData[RowBox[{RowBox[{"Export", "[", RowBox[{RowBox[{"FileNameJoin", "[",
             RowBox[{"{", RowBox[{"plotRoot", ",", "\"previews\"", ",", "\"clock_tnl_vs_mass.png\""}], "}"}],
             "]"}], ",", RowBox[{"Rasterize", "[", RowBox[{"clockMassAmplitudePlot", ",", "\"Image\"", ",",
               RowBox[{"Background", "\:f522", "White"}], ",", RowBox[{"ImageResolution", "\:f522", "144"}]}],
             "]"}], ",", "\"PNG\"", ",", RowBox[{"ImageResolution", "\:f522", "144"}]}], "]"}], ";",
       RowBox[{"Export", "[", RowBox[{RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"plotRoot", ",",
                 "\"previews\"", ",", "\"clock_phase_vs_mass.png\""}], "}"}], "]"}], ",",
           RowBox[{"Rasterize", "[", RowBox[{"clockMassPhasePlot", ",", "\"Image\"", ",", RowBox[
                {"Background", "\:f522", "White"}], ",", RowBox[{"ImageResolution", "\:f522", "144"}]}], "]"}],
           ",", "\"PNG\"", ",", RowBox[{"ImageResolution", "\:f522", "144"}]}], "]"}], ";"}]], "Input",
    CellTags -> "clock-mass-export"]}, Open]]
,
Cell[CellGroupData[{Cell["8. Collapsed trispectrum benchmark", "Section", CellTags -> "clock-shape-maps"],
   Cell["Use r1=ks/k12 and r2=ks/k34, where k12=k1+k2 and k34=k3+k4. Assemble the masses and complex clock amplitudes for the T/E map in Section 9.", "Text"],
   Cell[BoxData[RowBox[{RowBox[{"clockShapeParameters", "=",
         RowBox[{"Join", "[", RowBox[{"clockParameters", ",", RowBox[{"Association", "[", RowBox[
                {"\"lambda\"", "\:f522", FractionBox["1", "100"]}], "]"}]}], "]"}]}], ";",
       RowBox[{"clockShapeAngles", "=", RowBox[{"{", RowBox[{FractionBox["\:03c0", "2"], ",",
             FractionBox["\:03c0", "2"], ",", "0"}], "}"}]}], ";", RowBox[{"clockShapePrecision", "=", "60"}],
       ";"}]], "Input",
    CellTags -> "clock-shape-parameters"], Cell["Fix theta1=theta3=Pi/2 and phi3=0. Lu (2019), Eqs. \
(11),(45), gives mH^2/H^2=Sqrt[6 lambda/Pi^3] and the loop-dominated masses mW^2/H^2=3 g^2/(8 Pi^2 mH^2/H^2), \
mZ=mW/cW. The top mass is mt=yt h0/Sqrt[2]. The remaining parameters are taken from clockParameters in \
Section 1. Raw coefficients are evaluated once per species at these benchmark masses.", "Text"],
   Cell[CellGroupData[
     {Cell[BoxData[RowBox[{RowBox[{"clockShapeBenchmark", "=", RowBox[{"Lu2019MassBenchmark", "[",
              "clockShapeParameters", "]"}]}], ";", RowBox[{"clockShapeAssemblies", "=",
            RowBox[{"AssociationMap", "[", RowBox[{RowBox[{"Function", "[", RowBox[{"s", ",",
                    RowBox[{"ClockCoefficients", "[", RowBox[{"s", ",", RowBox[{RowBox[
                           {"clockShapeBenchmark", "[", "\"Nu\"", "]"}], "[", "s", "]"}], ",",
                        "clockShapePrecision", ",", "clockShapeParameters"}], "]"}]}], "]"}], ",",
                RowBox[{"{", RowBox[{"\"W\"", ",", "\"Z\"", ",", "\"t\""}], "}"}]}], "]"}]}], ";",
          RowBox[{"clockCollapsedShape", "=", RowBox[{"AssembleClockShape", "[",
              RowBox[{"clockShapeAssemblies", ",", "clockShapeAngles"}], "]"}]}], ";",
          RowBox[{"clockShapeBenchmarkTable", "=", RowBox[{"Grid", "[", RowBox[{RowBox[{"Prepend", "[",
                  RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[
                               {"o", "=", RowBox[{RowBox[{"clockCollapsedShape", "[", "\"Oscillators\"",
                                    "]"}], "[", "s", "]"}]}], "}"}], ",", RowBox[{"{", RowBox[{"s", ",",
                                RowBox[{"N", "[", RowBox[{RowBox[{"o", "[", "\"MassOverH\"", "]"}], ",",
                                    "6"}], "]"}], ",", RowBox[{"N", "[", RowBox[{RowBox[{"o", "[", "\"Nu\"",
                                    "]"}], ",", "6"}], "]"}], ",", RowBox[{"N", "[", RowBox[{RowBox[{"o",
                                    "[", "\"tNL\"", "]"}], ",", "6"}], "]"}], ",", RowBox[{"N", "[",
                                  RowBox[{RowBox[{"o", "[", "\"Phase\"", "]"}], ",", "6"}], "]"}]}], "}"}]}],
                          "]"}], ",", RowBox[{"{", RowBox[{"s", ",", RowBox[{"{", RowBox[{"\"W\"", ",",
                                "\"Z\"", ",", "\"t\""}], "}"}]}], "}"}]}], "]"}], ",", RowBox[
                     {"{", RowBox[{"\"Species\"", ",", "\"m/H\"", ",", "\"nu\"", ",", "\"tNL\"", ",",
                        "\"phase (rad)\""}], "}"}]}], "]"}], ",", RowBox[{"Frame", "\:f522", "All"}]}],
              "]"}]}]}]], "Input", CellTags -> "clock-shape-benchmark-input"],
      Cell[BoxData[TagBox[GridBox[{{"\"Species\"", "\"m/H\"", "\"nu\"", "\"tNL\"", "\"phase (rad)\""},
           {"\"W\"", "0.5576241875351193294`6.", "0.2468698736666787605`6.", "1.1275854146376913191`6.",
            "2.7623517065175841018`6."}, {"\"Z\"", "0.6336638494717265107`6.", "0.389268383159134662`6.",
            "0.1162708938652480971`6.", "2.6216290676924458624`6."}, {"\"t\"", "0.7071067811865475244`6.",
            "0.7071067811865475244`6.", "0.0933517727853700592`6.", "0.5390171700592129518`6."}},
          AutoDelete -> False, GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}},
          GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Grid"]], "Output",
       CellTags -> "clock-shape-benchmark-output"]}, Open]],
   Cell["The common envelope is E=(ks/kt)^3=(r1 r2/(r1+r2))^3. T/E retains the top extra factor r1 r2 and the signs of all three species contributions.", "Text"]}, Open]]
,
Cell[CellGroupData[{Cell["9. Extended T/E map: log ratios from 0 to 5", "Section",
    CellTags -> "clock-shape-wide"], Cell["Extend both x=-log10(r1) and y=-log10(r2) to 0..5, retaining 201 \
points per axis. Reuse the same masses, couplings, fixed angles and complex amplitudes as Section 8. Only the \
signed T/E map is computed and plotted; no new raw T or envelope grid is generated.", "Text"],
   Cell[BoxData[RowBox[{RowBox[{"clockWideLogGrid", "=", RowBox[{"Subdivide", "[",
           RowBox[{"0", ",", "5", ",", "200"}], "]"}]}], ";", RowBox[{"clockWidePrecision", "=", "60"}], ";",
       RowBox[{"clockWideBandCount", "=", "20"}], ";"}]], "Input",
    CellTags -> "clock-shape-wide-parameters"], Cell["Use clockCollapsedShape if Section 8 has been run in \
this kernel; otherwise load the stored Shape from the previous 0..2 data file. At fixed angles the reduced \
signal depends only on x+y, so 401 distinct sums suffice to fill the 201x201 grid. The top extra r1 r2 factor \
is retained.", "Text"],
   Cell[BoxData[RowBox[{RowBox[{"clockWideShape", "=",
         RowBox[{"If", "[", RowBox[{RowBox[{"AssociationQ", "[", "clockCollapsedShape", "]"}], ",",
             "clockCollapsedShape", ",", RowBox[{RowBox[{"LoadPlotData", "[", RowBox[{"FileNameJoin", "[",
                   RowBox[{"{", RowBox[{"plotRoot", ",", "\"data\"", ",", "\"clock_shape_reduced_log_grid_0_to_5.wxf\""}],
                     "}"}], "]"}], "]"}], "[", "\"Shape\"", "]"}]}], "]"}]}], ";",
       RowBox[{"clockWideData", "=", RowBox[{"CachedReducedClockShapeData", "[",
           RowBox[{RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"plotRoot", ",", "\"data\"", ",",
                   "\"clock_shape_reduced_log_grid_0_to_5.wxf\""}], "}"}], "]"}], ",", "clockWideShape", ",",
             "clockWideLogGrid", ",", "clockWidePrecision", ",", "recomputeData"}], "]"}]}], ";"}]], "Input",
    CellTags -> "clock-shape-wide-data"], Cell["The colorbar remains linear, signed and centered on zero. The \
vicinity of r_i=1 is an extrapolation of the collapsed template. The earlier plots and data are preserved.",
    "Text"], Cell[CellGroupData[
     {Cell[BoxData[RowBox[{"clockWideReducedPlot", "=", RowBox[{"ClockShapeMapPlot", "[",
      RowBox[{"clockWideData", ",", "\"TOverE\"", ",", RowBox[{"\"BandCount\"", "\:f522",
          "clockWideBandCount"}], ",", RowBox[{"\"ShowParameters\"", "\:f522", "False"}]}], "]"}]}]], "Input",
 CellTags -> "clock-shape-wide-plot"],
      Cell[BoxData[GraphicsBox[TagBox[RasterBox[CompressedData["1:eJzsvQl8VOW9/+9W27rV3lqtt/betmprK7Z1R3FfWRQxhH1ToJW/SAKCCAiEbCzJZCFAFrKSjRCyELYJa4CALLKIC1XxXq2tdas/sC1uCP\
