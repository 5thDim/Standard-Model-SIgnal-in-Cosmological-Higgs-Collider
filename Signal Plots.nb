Cell["Curvature clock observables", "Subsection", CellTags -> "clock-observables"],
Cell["Lu et al. (2019), arXiv:1907.07390, Section 2 and Fig. 4: g=0.6, cW=0.88, yt=1, lambda=0.01, Rh=0.14, \
Pzeta=2*10^-9. Here h0/H=1. Exact parameter values are provided by Lu2019Parameters[]. Lambda records the \
benchmark; it does not enter the present conversion formulas. Nu remains a function input.", "Text"],
Cell[BoxData[RowBox[{RowBox[{"clockParameters", "=", RowBox[{"Lu2019Parameters", "[", "]"}]}], ";"}]],
 "Input", CellTags -> "clock-parameters"],
Cell["At fixed nu, compute the raw coefficients once and reuse the assembled angular coefficients. W and Z \
share the raw gauge coefficients when their nu inputs are equal. ClockObservables takes theta1, theta3, phi3 \
in radians and returns C, tNL, and Phase. ComplexAmplitude=tNL*Exp[I*Phase], including the top-loop minus \
sign.", "Text"],
Cell[
 BoxData[RowBox[{RowBox[{"zClockCoefficients", "=", RowBox[{"ClockCoefficients", "[",
        RowBox[{"\"Z\"", ",", "angularNu", ",", "angularPrecision", ",", "clockParameters"}], "]"}]}], ";",
    RowBox[{"topClockCoefficients", "=", RowBox[{"ClockCoefficients", "[",
        RowBox[{"\"t\"", ",", "angularNu", ",", "angularPrecision", ",", "clockParameters"}], "]"}]}], ";",
    RowBox[{"clockAssemblies", "=", RowBox[{"Association", "[",
        RowBox[{RowBox[{"\"W\"", "\:f522", RowBox[{"AssembleClockCoefficients", "[", RowBox[{"\"W\"", ",",
                RowBox[{"zClockCoefficients", "[", "\"RawCoefficients\"", "]"}], ",", "clockParameters"}],
              "]"}]}], ",", RowBox[{"\"Z\"", "\:f522", "zClockCoefficients"}], ",",
          RowBox[{"\"t\"", "\:f522", "topClockCoefficients"}]}], "]"}]}], ";"}]], "Input",
 CellTags -> "clock-coefficient-assembly"],
Cell["Reference evaluation: theta1=theta3=Pi/2, with nu=angularNu and the existing phi3 parameter. Angular \
maximization is a later step.", "Text"],
Cell[CellGroupData[
  {Cell[BoxData[RowBox[{RowBox[{"clockReference", "=", RowBox[{"AssociationMap", "[",
           RowBox[{RowBox[{RowBox[{"ClockObservables", "[", RowBox[{RowBox[{"clockAssemblies", "[", "#1",
                     "]"}], ",", FractionBox["\:03c0", "2"], ",", FractionBox["\:03c0", "2"], ",", "phi3"}], "]"}],
               "&"}], ",", RowBox[{"{", RowBox[{"\"W\"", ",", "\"Z\"", ",", "\"t\""}], "}"}]}], "]"}]}], ";",
       RowBox[{"Grid", "[", RowBox[{RowBox[{"Prepend", "[", RowBox[{RowBox[{"Table", "[",
                 RowBox[{RowBox[{"{", RowBox[{"species", ",", RowBox[{"N", "[", RowBox[{RowBox[
                            {RowBox[{"clockReference", "[", "species", "]"}], "[", "\"C\"", "]"}], ",",
                           "8"}], "]"}], ",", RowBox[{"N", "[", RowBox[{RowBox[{RowBox[{"clockReference",
                               "[", "species", "]"}], "[", "\"tNL\"", "]"}], ",", "8"}], "]"}], ",",
                       RowBox[{"N", "[", RowBox[{RowBox[{RowBox[{"clockReference", "[", "species", "]"}],
                             "[", "\"Phase\"", "]"}], ",", "8"}], "]"}]}], "}"}], ",", RowBox[
                    {"{", RowBox[{"species", ",", RowBox[{"{", RowBox[{"\"W\"", ",", "\"Z\"", ",", "\"t\""}],
                         "}"}]}], "}"}]}], "]"}], ",", RowBox[{"{", RowBox[{"\"Species\"", ",", "\"C\"", ",",
                   "\"tNL\"", ",", "\"Phase (rad)\""}], "}"}]}], "]"}], ",", RowBox[{"Frame", "\:f522", "All"}],
           ",", RowBox[{"Alignment", "\:f522", "Left"}]}], "]"}]}]], "Input",
    CellTags -> "clock-reference-input"],
   Cell[BoxData[TagBox[GridBox[{{"\"Species\"", "\"C\"", "\"tNL\"", "\"Phase (rad)\""},
        {"\"W\"", RowBox[{RowBox[{"-", "0.00002669132109592501640820719938068961`8.090917828822468"}], "+",
