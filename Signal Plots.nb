Cell[CellGroupData[{Cell["7. Curvature clock amplitude and phase versus mass", "Section",
    CellTags -> "clock-mass-scans"], Cell["Fix theta1=theta3=Pi/2 and phi3=0, using the configuration \
selected from the angular maps. Hold this direction fixed throughout the mass scan. Use m/H as the horizontal \
coordinate: gauge nu=Sqrt[(m/H)^2-1/4], while top nu=m/H. Couplings and h0/H remain at clockParameters as \
masses are scanned independently.", "Text"],
   Cell[BoxData[RowBox[{RowBox[{"clockMassAngles", "=",
         RowBox[{"{", RowBox[{FractionBox["\:03c0", "2"], ",", FractionBox["\:03c0", "2"], ",", "0"}], "}"}]}], ";",
       RowBox[{"clockMassPrecision", "=", "60"}], ";", RowBox[{"clockGaugeMassGrid", "=",
         RowBox[{"Join", "[", RowBox[{RowBox[{"Range", "[", RowBox[{FractionBox["51", "100"], ",", "1", ",",
                 FractionBox["1", "100"]}], "]"}], ",", RowBox[{"Range", "[", RowBox[
                {FractionBox["41", "40"], ",", "3", ",", FractionBox["1", "40"]}], "]"}]}], "]"}]}], ";",
       RowBox[{"clockTopMassGrid", "=", RowBox[{"Join", "[",
           RowBox[{RowBox[{"Range", "[", RowBox[{FractionBox["1", "10"], ",", "1", ",", FractionBox["1",
                  "100"]}], "]"}], ",", RowBox[{"Range", "[", RowBox[{FractionBox["41", "40"], ",", "3", ",",
                 FractionBox["1", "40"]}], "]"}]}], "]"}]}], ";"}]], "Input",
    CellTags -> "clock-mass-parameters"], Cell["Gauge masses start at m/H=0.51 to stay inside the oscillatory \
region nu>0. W and Z reuse one raw gauge scan. These caches are separate from the earlier coefficient scans \
and angular maps. Changing only the fixed angles or physical parameters requires reassembly, not new \
special-function evaluations.", "Text"],
   Cell[BoxData[RowBox[{RowBox[{"clockGaugeMassNuGrid", "=",
         RowBox[{RowBox[{"(", RowBox[{SqrtBox[RowBox[{SuperscriptBox["#1", "2"], "-", FractionBox["1",
                   "4"]}]], "&"}], ")"}], "/@", "clockGaugeMassGrid"}]}], ";",
       RowBox[{"clockRawGaugeMassScan", "=", RowBox[{"CachedNuScan", "[",
           RowBox[{RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"plotRoot", ",", "\"data\"", ",",
                   "\"gauge_clock_mass_scan.wxf\""}], "}"}], "]"}], ",", "\"Gauge\"", ",",
             "clockGaugeMassNuGrid", ",", "clockMassPrecision", ",", "recomputeData"}], "]"}]}], ";",
       RowBox[{"clockRawTopMassScan", "=", RowBox[{"CachedNuScan", "[",
           RowBox[{RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"plotRoot", ",", "\"data\"", ",",
                   "\"top_clock_mass_scan.wxf\""}], "}"}], "]"}], ",", "\"Top\"", ",", "clockTopMassGrid",
             ",", "clockMassPrecision", ",", "recomputeData"}], "]"}]}], ";",
       RowBox[{"clockMassData", "=", RowBox[{"Association", "[",
           RowBox[{RowBox[{"\"W\"", "\:f522", RowBox[{"AssembleClockMassScan", "[", RowBox[{"\"W\"", ",",
                   "clockRawGaugeMassScan", ",", "clockMassAngles", ",", "clockParameters"}], "]"}]}], ",",
             RowBox[{"\"Z\"", "\:f522", RowBox[{"AssembleClockMassScan", "[", RowBox[{"\"Z\"", ",",
                   "clockRawGaugeMassScan", ",", "clockMassAngles", ",", "clockParameters"}], "]"}]}], ",",
             RowBox[{"\"t\"", "\:f522", RowBox[{"AssembleClockMassScan", "[", RowBox[{"\"t\"", ",",
                   "clockRawTopMassScan", ",", "clockMassAngles", ",", "clockParameters"}], "]"}]}]}],
           "]"}]}], ";", RowBox[{"SavePlotData", "[",
         RowBox[{RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"plotRoot", ",", "\"data\"", ",",
                 "\"clock_mass_observables.wxf\""}], "}"}], "]"}], ",",
           RowBox[{"Association", "[", RowBox[{RowBox[{"\"Kind\"", "\:f522", "\"ClockMassCollection\""}], ",",
               RowBox[{"\"SpeciesScans\"", "\:f522", "clockMassData"}]}], "]"}]}], "]"}], ";"}]], "Input",
    CellTags -> "clock-mass-data"], Cell["The amplitude plot displays actual dimensionless tNL on a \
logarithmic vertical axis. Phases are principal values in (-Pi,Pi], including the minus sign in the top \
coefficient; curves are split at the branch jumps. W, Z and top have consistent colors in both plots.",
    "Text"], Cell[CellGroupData[
     {Cell[BoxData[RowBox[{"clockMassAmplitudePlot", "=", RowBox[{"ClockMassScanPlot", "[",
            RowBox[{"clockMassData", ",", "\"Magnitude\""}], "]"}]}]], "Input",
       CellTags -> "clock-mass-amplitude-input"],
