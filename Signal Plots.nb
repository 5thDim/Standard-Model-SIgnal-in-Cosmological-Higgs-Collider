          Open]]}, Open]], Cell[CellGroupData[{Cell["6. Curvature tNL angular previews", "Section", CellTags -> "tnl-angular-previews"],
   Cell["Z and top at fixed angularNu, using clockParameters and clockAssemblies from Section 1. Coordinates \
are theta1 and theta3, not their cosines. Each species uses a common color range across the three phi3 \
slices. Colorbars show actual dimensionless tNL.", "Text"],
   Cell[BoxData[RowBox[{RowBox[{"clockPhiCases", "=",
         RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", "\"0\""}], "}"}], ",",
             RowBox[{"{", RowBox[{FractionBox["\:03c0", "2"], ",", "\"pi_over_2\""}], "}"}], ",",
             RowBox[{"{", RowBox[{"\:03c0", ",", "\"pi\""}], "}"}]}], "}"}]}], ";",
       RowBox[{"clockThetaGrid", "=", RowBox[{"Subdivide", "[", RowBox[{"0", ",", "\:03c0", ",", "200"}],
           "]"}]}], ";", RowBox[{"clockMapSpecies", "=", RowBox[{"{", RowBox[{"\"Z\"", ",", "\"t\""}],
           "}"}]}], ";", RowBox[{"clockBandCount", "=", "16"}], ";"}]], "Input",
    CellTags -> "tnl-angular-parameters"], Cell["Complex grid data are cached separately from the original \
coefficient maps. Physical parameters, nu, angles, grid, precision, and assembly/source signatures are \
checked before reusing a cache. Changing only styles requires rerunning the plot and export inputs.",
    "Text"],
   Cell[BoxData[RowBox[{RowBox[{"clockAngularData", "=", RowBox[{"AssociationMap", "[",
           RowBox[{RowBox[{"Function", "[", RowBox[{"species", ",", RowBox[{"Table", "[",
                   RowBox[{RowBox[{"CachedClockAngularData", "[", RowBox[{RowBox[{"FileNameJoin", "[",
                           RowBox[{"{", RowBox[{"plotRoot", ",", "\"data\"", ",", RowBox[{RowBox[
                                  {"ToLowerCase", "[", "species", "]"}], "<>", "\"_tnl_angular_phi_\"", "<>",
                                 RowBox[{"clockPhiCases", "\:301a", RowBox[{"j", ",", "2"}], "\:301b"}], "<>",
                                 "\".wxf\""}]}], "}"}], "]"}], ",", RowBox[{"clockAssemblies", "[",
                           "species", "]"}], ",", "angularNu", ",", RowBox[{"clockPhiCases", "\:301a",
                           RowBox[{"j", ",", "1"}], "\:301b"}], ",", "clockThetaGrid", ",", "angularPrecision",
                         ",", "recomputeData"}], "]"}], ",", RowBox[{"{", RowBox[{"j", ",", RowBox[
                          {"Length", "[", "clockPhiCases", "]"}]}], "}"}]}], "]"}]}], "]"}], ",",
             "clockMapSpecies"}], "]"}]}], ";", RowBox[{"clockAngularEdges", "=",
         RowBox[{"AssociationMap", "[", RowBox[{RowBox[{"Function", "[", RowBox[{"species", ",",
                 RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{"range", "=", RowBox[{"MinMax", "[",
                           RowBox[{"Flatten", "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{"Abs", "[", RowBox[
                                    {RowBox[{"#1", "[", "\"Rows\"", "]"}], "\:301a", RowBox[{"All", ",", "3"}],
                                    "\:301b"}], "]"}], "&"}], ")"}], "/@", RowBox[{"clockAngularData", "[",
                                 "species", "]"}]}], "]"}], "]"}]}], "}"}], ",", RowBox[{"Subdivide", "[",
                       RowBox[{RowBox[{"First", "[", "range", "]"}], ",", RowBox[{"Last", "[", "range",
                           "]"}], ",", "clockBandCount"}], "]"}]}], "]"}]}], "]"}], ",", "clockMapSpecies"}],
           "]"}]}], ";"}]], "Input", CellTags -> "tnl-angular-data"],
   Cell[BoxData[RowBox[{RowBox[{"clockAngularPlots", "=", RowBox[{"AssociationMap", "[",
           RowBox[{RowBox[{"Function", "[", RowBox[{"species", ",", RowBox[{"Table", "[",
                   RowBox[{RowBox[{RowBox[{"Print", "[", RowBox[{"\"Plotting \"", ",", "species", ",",
                           "\" phi3=\"", ",", RowBox[{"clockPhiCases", "\:301a", RowBox[{"j", ",", "1"}],
                             "\:301b"}]}], "]"}], ";", RowBox[{"ClockAngularMapPlot", "[", RowBox[
                          {RowBox[{RowBox[{"clockAngularData", "[", "species", "]"}], "\:301a", "j", "\:301b"}],
                           ",", RowBox[{"\"BandEdges\"", "\:f522", RowBox[{"clockAngularEdges", "[", "species",
                               "]"}]}]}], "]"}]}], ",", RowBox[{"{", RowBox[{"j", ",", RowBox[{"Length", "[",
                           "clockPhiCases", "]"}]}], "}"}]}], "]"}]}], "]"}], ",", "clockMapSpecies"}],
           "]"}]}], ";"}]], "Input", CellTags -> "tnl-angular-plots"],
   Cell["Preview PNGs are saved under plots/previews. In the overview, columns are phi3=0, Pi/2, Pi; the \
first row is Z and the second is top. The manuscript and figure PDFs are not updated at this stage.",
    "Text"], Cell[CellGroupData[
     {Cell[BoxData[RowBox[{RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{"Print", "[", RowBox[{"\"Exporting \"",
                    ",", "species", ",", "\" phi3=\"", ",", RowBox[{"clockPhiCases", "\:301a", RowBox[
                       {"j", ",", "1"}], "\:301b"}]}], "]"}], ";", RowBox[{"Export", "[",
                  RowBox[{RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"plotRoot", ",", "\"previews\"",
                          ",", RowBox[{RowBox[{"ToLowerCase", "[", "species", "]"}], "<>", "\"_tnl_phi_\"",
                            "<>", RowBox[{"clockPhiCases", "\:301a", RowBox[{"j", ",", "2"}], "\:301b"}], "<>",
                            "\".png\""}]}], "}"}], "]"}], ",", RowBox[{"Rasterize", "[", RowBox[
                       {RowBox[{RowBox[{"clockAngularPlots", "[", "species", "]"}], "\:301a", "j", "\:301b"}], ",",
                        "\"Image\"", ",", RowBox[{"Background", "\:f522", "White"}], ",", RowBox[
                         {"ImageResolution", "\:f522", "144"}]}], "]"}], ",", "\"PNG\"", ",",
                    RowBox[{"ImageResolution", "\:f522", "144"}]}], "]"}]}], ",", RowBox[{"{",
                RowBox[{"species", ",", "clockMapSpecies"}], "}"}], ",", RowBox[{"{",
                RowBox[{"j", ",", RowBox[{"Length", "[", "clockPhiCases", "]"}]}], "}"}]}], "]"}], ";",
          RowBox[{"clockPreviewFiles", "=", RowBox[{"Flatten", "[", RowBox[{RowBox[{"Table", "[",
                  RowBox[{RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"plotRoot", ",", "\"previews\"",
                          ",", RowBox[{RowBox[{"ToLowerCase", "[", "species", "]"}], "<>", "\"_tnl_phi_\"",
                            "<>", RowBox[{"clockPhiCases", "\:301a", RowBox[{"j", ",", "2"}], "\:301b"}], "<>",
                            "\".png\""}]}], "}"}], "]"}], ",", RowBox[{"{", RowBox[{"species", ",",
                        "clockMapSpecies"}], "}"}], ",", RowBox[{"{", RowBox[{"j", ",", RowBox[{"Length",
                          "[", "clockPhiCases", "]"}]}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";",
          RowBox[{"clockPreviewImages", "=", RowBox[{"Import", "/@", "clockPreviewFiles"}]}], ";",
          RowBox[{"clockPreviewSize", "=", RowBox[{"Max", "/@", TemplateBox[{RowBox[
                 {"(", RowBox[{"ImageDimensions", "/@", "clockPreviewImages"}], ")"}]}, "Transpose",
               SyntaxForm -> SuperscriptBox]}]}], ";", RowBox[{"clockPreviewTiles", "=",
            RowBox[{RowBox[{"Function", "[", RowBox[{"im", ",", RowBox[{"With", "[", RowBox[
                     {RowBox[{"{", RowBox[{"d", "=", RowBox[{"clockPreviewSize", "-", RowBox[
                             {"ImageDimensions", "[", "im", "]"}]}]}], "}"}], ",", RowBox[{"ImagePad", "[",
                        RowBox[{"im", ",", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{RowBox[{"Floor",
                                    "[", FractionBox[RowBox[{"d", "\:301a", "1", "\:301b"}], "2"], "]"}], "+",
                                    "12"}], ",", RowBox[{RowBox[{"Ceiling", "[", FractionBox[RowBox[{"d",
                                    "\:301a", "1", "\:301b"}], "2"], "]"}], "+", "12"}]}], "}"}], ",", RowBox[
                               {"{", RowBox[{RowBox[{RowBox[{"Floor", "[", FractionBox[RowBox[{"d", "\:301a",
                                    "2", "\:301b"}], "2"], "]"}], "+", "12"}], ",", RowBox[{RowBox[{"Ceiling",
                                    "[", FractionBox[RowBox[{"d", "\:301a", "2", "\:301b"}], "2"], "]"}], "+",
                                    "12"}]}], "}"}]}], "}"}], ",", "White"}], "]"}]}], "]"}]}], "]"}], "/@",
              "clockPreviewImages"}]}], ";", RowBox[{"clockAngularPanel", "=",
            RowBox[{"ImageAssemble", "[", RowBox[{"Partition", "[", RowBox[{"clockPreviewTiles", ",",
                  RowBox[{"Length", "[", "clockPhiCases", "]"}]}], "]"}], "]"}]}], ";",
          RowBox[{"Export", "[", RowBox[{RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"plotRoot", ",",
                    "\"previews\"", ",", "\"tnl_angular_2x3.png\""}], "}"}], "]"}], ",", "clockAngularPanel",
              ",", "\"PNG\"", ",", RowBox[{"ImageResolution", "\:f522", "144"}]}], "]"}], ";",
          RowBox[{"Import", "[", RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"plotRoot", ",",
                  "\"previews\"", ",", "\"tnl_angular_2x3.png\""}], "}"}], "]"}], "]"}]}]], "Input",
       CellTags -> "tnl-angular-export"],
