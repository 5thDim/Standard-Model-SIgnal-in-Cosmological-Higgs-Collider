Cell["9. Mass scan and figures", "Section"],

Cell["These cells have not been evaluated. The mass axis is nu=mt/H; choose hardRatio before evaluating the scan. All curves use the explicitly displayed finite bounds and damping. For a dimensional mass axis multiply nu by a chosen H. Real, imaginary, magnitude and principal-phase plots are separate for each amplitude; AP is plotted as the exact zero predicted by the paper. The raw AP residual is displayed separately.", "Text"],

Cell[BoxData[RowBox[{"massData", " ", "=", " ", "massScan", "[", "massGrid", ",", " ", "hardRatio", ",", " ", "defaultSettings", "]", ";"}]], "Input", CellTags -> "MassScanRun"],

Cell[BoxData[RowBox[{"plotAmplitudes", "[", "data_List", "]", " ", ":=", " ", "Module", "[", "{", "records", ",", " ", "curves", ",", " ", "panel", ",", " ", "cfg", ",", " ", "ratio", ",", " ", "caption", "}", ",", "\n  ", "records", " ", "=", " ", "Select", "[", "data", ",", " ", "AssociationQ", "[", "#", "]", " ", "&&", " ", "KeyExistsQ", "[", "#", ",", " ", "\"Amplitudes\"", "]", " ", "&", "]", ";", "\n  ", "If", "[", "Length", "[", "records", "]", " ", "<", " ", "2", ",", " ", "Return", "[", "Failure", "[", "\"InsufficientData\"", ",", " ", "<|", "\"MessageTemplate\"", " ", "->", " ", "\"At least two valid mass points are required.\"", "|>", "]]", "]", ";", "\n  ", "cfg", " ", "=", " ", "records", "[[", "1", "]]", "[", "\"Settings\"", "]", ";", " ", "ratio", " ", "=", " ", "records", "[[", "1", "]]", "[", "\"Ratio\"", "]", ";", "\n  ", "caption", " ", "=", " ", "Row", "[", "{", "\"r = \"", ",", " ", "ratio", ",", " ", "\"; eta = \"", ",", " ", "cfg", "[", "\"Damping\"", "]", ",", "\n    ", "\"; z in [\"", ",", " ", "cfg", "[", "\"ZMin\"", "]", ",", " ", "\", \"", ",", " ", "cfg", "[", "\"ZMax\"", "]", ",", " ", "\"]; regulated\"", "}", "]", ";", "\n  ", "curves", "[", "key_", ",", " ", "f_", "]", " ", ":=", " ", "(", "{", "#", "[", "\"Mass\"", "]", ",", " ", "f", "[", "#", "[", "\"Amplitudes\"", "]", "[", "key", "]]", "}", " ", "&", " ", "/@", " ", "records", ")", ";", "\n  ", "panel", "[", "key_", "]", " ", ":=", " ", "Module", "[", "{", "nonzero", ",", " ", "magnitudes", ",", " ", "phases", "}", ",", "\n    ", "nonzero", " ", "=", " ", "Select", "[", "curves", "[", "key", ",", " ", "Identity", "]", ",", " ", "TrueQ", "[", "Abs", "[", "Last", "[", "#", "]]", " ", ">", " ", "0", "]", " ", "&", "]", ";", "\n    ", "magnitudes", " ", "=", " ", "(", "{", "First", "[", "#", "]", ",", " ", "Abs", "[", "Last", "[", "#", "]]", "}", " ", "&", " ", "/@", " ", "nonzero", ")", ";", "\n    ", "phases", " ", "=", " ", "(", "{", "First", "[", "#", "]", ",", " ", "Arg", "[", "