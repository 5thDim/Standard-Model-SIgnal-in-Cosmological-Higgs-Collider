Cell[BoxData[RowBox[{"algebraChecks", " ", "=", " ", "<|", "\n  ", "\"All16Rows\"", " ", "->", " ", "(", "Sort", "[", "Join", "[", "gAA", ",", " ", "gAN", ",", " ", "gNA", ",", " ", "gNN", "]]", " ", "==", " ", "Range", "[", "16", "]", ")", ",", "\n  ", "\"XiMinusPlus\"", " ", "->", " ", "(", "xi", "[", "-", "1", ",", " ", "1", ",", " ", "delta", "]", " ", "==", " ", "1", ")", ",", "\n  ", "\"XiPlusMinus\"", " ", "->", " ", "(", "xi", "[", "1", ",", " ", "-", "1", ",", " ", "delta", "]", " ", "==", " ", "-", "1", ")", ",", "\n  ", "\"TensorTrace\"", " ", "->", " ", "Simplify", "[", "2", " ", "jt", "[", "x", "]", " ", "+", " ", "jl", "[", "x", "]", " ", "-", " ", "j0", "[", "x", "]]", ",", "\n  ", "\"VectorOpposite\"", " ", "->", " ", "Simplify", "[", "vq", "[", "x", "]", " ", "+", " ", "vk", "[", "x", "]]", ",", "\n  ", "\"AL_A13_relation\"", " ", "->", " ", "Simplify", "[", "\n    ", "jl", "[", "-", "I", " ", "nu", "]", " ", "angularAmplitudes", "[", "\"AL\"", "]", " ", "+", "\n    ", "2", " ", "(", "jl", "[", "-", "I", " ", "nu", "]", " ", "-", " ", "jt", "[", "-", "I", " ", "nu", "]", ")", " ", "angularAmplitudes", "[", "\"A13\"", "]]", "|>", ";", "\n", "algebraChecks"}]], "Input", CellTags -> "AlgebraChecks"],

Cell["Optional, potentially slow: evaluate one mass and then perform controlled refinements. No numerical values are stored as certified physical results in this notebook.", "Text"],

Cell[BoxData[RowBox[{"singleMass", " ", "=", " ", "antiAtMass", "[", "3", "/", "5", ",", " ", "hardRatio", ",", " ", "defaultSettings", "]", ";", "\n", "singleMass"}]], "Input", CellTags -> "SinglePoint"],

