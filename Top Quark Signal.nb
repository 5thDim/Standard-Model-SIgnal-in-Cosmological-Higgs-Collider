           RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]}]]}], ",", "delta", 
        ",", "0"}], "]"}]}]}], ",", 
    RowBox[{
     RowBox[{"P2", "[", "nu", "]"}], "\[Equal]", 
     RowBox[{
      SuperscriptBox["2", 
       RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]], " ", 
