Cell[BoxData[
 RowBox[{
  RowBox[{"plotColorsTop", "=", 
   RowBox[{"{", 
    RowBox[{
     TemplateBox[<|"color" -> RGBColor[0.75, 0.12, 0.12]|>,
      "RGBColorSwatchTemplate"], ",", 
     TemplateBox[<|"color" -> RGBColor[0.12, 0.32, 0.78]|>,
      "RGBColorSwatchTemplate"], ",", 
     TemplateBox[<|"color" -> RGBColor[0.12, 0.55, 0.3]|>,
      "RGBColorSwatchTemplate"], ",", 
     TemplateBox[<|"color" -> RGBColor[0.6, 0.22, 0.72]|>,
      "RGBColorSwatchTemplate"], ",", 
     TemplateBox[<|"color" -> RGBColor[0.88, 0.47, 0.08]|>,
      "RGBColorSwatchTemplate"]}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"logMagnitudeDataTop", "[", "j_Integer", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"N", "[", 
         RowBox[{"#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
          "]"}], ",", 
        RowBox[{"N", "[", 
         RowBox[{"Log", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"#1", "\[LeftDoubleBracket]", 
            RowBox[{"j", "+", "1"}], "\[RightDoubleBracket]"}], "]"}], "]"}], 
         "]"}]}], "}"}], "&"}], ")"}], "/@", "massDataTop"}]}], ";", 
  RowBox[{
   RowBox[{"phaseDataTop", "[", "j_Integer", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"N", "[", 
         RowBox[{"#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
          "]"}], ",", 
        RowBox[{"N", "[", 
         RowBox[{"Arg", "[", 
          RowBox[{"#1", "\[LeftDoubleBracket]", 
           RowBox[{"j", "+", "1"}], "\[RightDoubleBracket]"}], "]"}], "]"}]}],
        "}"}], "&"}], ")"}], "/@", "massDataTop"}]}], ";", 
  RowBox[{
   RowBox[{"phaseSegmentsTop", "[", "j_Integer", "]"}], ":=", 
   RowBox[{"Split", "[", 
    RowBox[{
     RowBox[{"phaseDataTop", "[", "j", "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"Last", "[", "#1", "]"}], "-", 
         RowBox[{"Last", "[", "#2", "]"}]}], "]"}], "\[LessEqual]", "\[Pi]"}],
       "&"}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"magnitudePlotTop", "[", "j_Integer", "]"}], ":=", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"logMagnitudeDataTop", "[", "j", "]"}], ",", 
     RowBox[{"Frame", "\[Rule]", "True"}], ",", 
     RowBox[{"Axes", "\[Rule]", "False"}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<mt/H\>\"", ",", 
        RowBox[{"\"\<ln |\>\"", "<>", 
         RowBox[{
         "coefficientNames", "\[LeftDoubleBracket]", "j", 
          "\[RightDoubleBracket]"}], "<>", "\"\<|\>\""}]}], "}"}]}], ",", 
     RowBox[{"PlotLabel", "\[Rule]", 
      StyleBox[
       RowBox[{
        RowBox[{
        "coefficientNames", "\[LeftDoubleBracket]", "j", 
         "\[RightDoubleBracket]"}], "<>", "\"\< : magnitude\>\""}],
       StripOnInput->False,
       FontSize->14]}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{
        "plotColorsTop", "\[LeftDoubleBracket]", "j", 
         "\[RightDoubleBracket]"}], ",", "Thick"}], "]"}]}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "430"}], ",", 
     RowBox[{"BaseStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}], ",", 
        RowBox[{"FontSize", "\[Rule]", "13"}]}], "}"}]}], ",", 
     RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", 
     RowBox[{"GridLinesStyle", "\[Rule]", 
      RowBox[{"Directive", "[", 
       TemplateBox[<|"color" -> GrayLevel[0.9]|>,
        "GrayLevelColorSwatchTemplate"], "]"}]}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"phasePlotTop", "[", "j_Integer", "]"}], ":=", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"phaseSegmentsTop", "[", "j", "]"}], ",", 
     RowBox[{"Frame", "\[Rule]", "True"}], ",", 
     RowBox[{"Axes", "\[Rule]", "False"}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<mt/H\>\"", ",", 
        RowBox[{"\"\<Arg \>\"", "<>", 
         RowBox[{
         "coefficientNames", "\[LeftDoubleBracket]", "j", 
          "\[RightDoubleBracket]"}], "<>", "\"\< [rad]\>\""}]}], "}"}]}], ",", 
     RowBox[{"PlotLabel", "\[Rule]", 
      StyleBox[
       RowBox[{
        RowBox[{
        "coefficientNames", "\[LeftDoubleBracket]", "j", 
         "\[RightDoubleBracket]"}], "<>", "\"\< : phase\>\""}],
       StripOnInput->False,
       FontSize->14]}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{
        "plotColorsTop", "\[LeftDoubleBracket]", "j", 
         "\[RightDoubleBracket]"}], ",", "Thick"}], "]"}]}], ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"N", "[", "massMin", "]"}], ",", 
          RowBox[{"N", "[", "massMax", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"FrameTicks", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "\[Pi]"}], ",", 
            RowBox[{"-", 
             FractionBox["\[Pi]", "2"]}], ",", "0", ",", 
            FractionBox["\[Pi]", "2"], ",", "\[Pi]"}], "}"}], ",", "None"}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", "None"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "430"}], ",", 
     RowBox[{"BaseStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}], ",", 
        RowBox[{"FontSize", "\[Rule]", "13"}]}], "}"}]}], ",", 
     RowBox[{"GridLines", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "\[Pi]"}], ",", "0", ",", "\[Pi]"}], "}"}]}], "}"}]}], 
     ",", 
     RowBox[{"GridLinesStyle", "\[Rule]", 
      RowBox[{"Directive", "[", 
       TemplateBox[<|"color" -> GrayLevel[0.9]|>,
        "GrayLevelColorSwatchTemplate"], "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"e9d8141f-ba9a-c24f-8d63-1e88173e6f10"],

