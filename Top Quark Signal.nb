    RowBox[{"Gamma", "[", 
     RowBox[{"1", "+", 
      RowBox[{"2", " ", "\[ImaginaryI]", " ", "v"}]}], "]"}]}]}], ";", 
  RowBox[{"topPReduced", "=", 
