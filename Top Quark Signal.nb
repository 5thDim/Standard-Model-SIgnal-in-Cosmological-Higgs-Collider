Cell["\<\
The symbolic H0 and H1 definitions below retain KTop(a,b,kappa,p,q,r,nu) as \
an unevaluated seed at u=2r/(1+r). At r=1 it is kSeedTop. For the radial \
derivative, Eq. (124) shifts p or q; the explicit powers of r and the (a +/- \
r)/r factors must also be differentiated.\
\>", "Text",ExpressionUUID->"0008cab2-372f-fa4b-92f9-f80d454d2b65"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"h0FormalTop", "[", 
    RowBox[{"q1_", ",", "q2_", ",", "r_", ",", "v_"}], "]"}], ":=", 
   RowBox[{"\[ImaginaryI]", " ", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"p", "=", 
           RowBox[{"q1", "-", 
            FractionBox["3", "2"], "+", "m"}]}], ",", 
          RowBox[{"q", "=", 
           RowBox[{"q2", "-", 
            FractionBox["3", "2"], "+", "n"}]}]}], "}"}], ",", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[ImaginaryI]", " ", "a"}], ")"}], "m"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[ImaginaryI]", " ", "b"}], ")"}], "n"], " ", 
         SuperscriptBox["r", 
          RowBox[{
           RowBox[{"-", "3"}], "-", "p", "-", "q"}]], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"p", "+", 
              FractionBox["3", "2"], "+", 
              RowBox[{"\[ImaginaryI]", " ", "v"}]}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"KTop", "[", 
               RowBox[{"a", ",", "b", ",", 
                RowBox[{"-", 
                 FractionBox["1", "2"]}], ",", "p", ",", "q", ",", "r", ",", 
                "v"}], "]"}], "-", 
              RowBox[{"KTop", "[", 
               RowBox[{"a", ",", "b", ",", 
                FractionBox["1", "2"], ",", "p", ",", "q", ",", "r", ",", 
                "v"}], "]"}]}], ")"}]}], "+", 
           FractionBox[
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"(", 
              RowBox[{"a", "-", "r"}], ")"}], " ", 
             RowBox[{"KTop", "[", 
              RowBox[{"a", ",", "b", ",", 
               FractionBox["1", "2"], ",", 
               RowBox[{"p", "+", "1"}], ",", "q", ",", "r", ",", "v"}], 
              "]"}]}], "r"], "-", 
           FractionBox[
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"(", 
              RowBox[{"a", "+", "r"}], ")"}], " ", 
             RowBox[{"KTop", "[", 
              RowBox[{"a", ",", "b", ",", 
               RowBox[{"-", 
                FractionBox["1", "2"]}], ",", 
               RowBox[{"p", "+", "1"}], ",", "q", ",", "r", ",", "v"}], 
              "]"}]}], "r"]}], ")"}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"b", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], ";", 
  RowBox[{
   RowBox[{"h1FormalTop", "[", 
    RowBox[{"q1_", ",", "q2_", ",", "r_", ",", "v_"}], "]"}], ":=", 
   RowBox[{"\[ImaginaryI]", " ", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"p", "=", 
           RowBox[{"q1", "-", 
            FractionBox["3", "2"], "+", "m"}]}], ",", 
          RowBox[{"q", "=", 
           RowBox[{"q2", "-", 
            FractionBox["3", "2"], "+", "n"}]}]}], "}"}], ",", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[ImaginaryI]", " ", "a"}], ")"}], "m"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[ImaginaryI]", " ", "b"}], ")"}], "n"], " ", 
         SuperscriptBox["r", 
          RowBox[{
           RowBox[{"-", "3"}], "-", "p", "-", "q"}]], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"p", "+", 
              FractionBox["3", "2"], "-", 
              RowBox[{"\[ImaginaryI]", " ", "v"}]}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"KTop", "[", 
               RowBox[{"a", ",", "b", ",", 
                RowBox[{"-", 
                 FractionBox["1", "2"]}], ",", "p", ",", "q", ",", "r", ",", 
                "v"}], "]"}], "+", 
              RowBox[{"KTop", "[", 
               RowBox[{"a", ",", "b", ",", 
                FractionBox["1", "2"], ",", "p", ",", "q", ",", "r", ",", 
                "v"}], "]"}]}], ")"}]}], "-", 
           FractionBox[
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"(", 
              RowBox[{"a", "-", "r"}], ")"}], " ", 
             RowBox[{"KTop", "[", 
              RowBox[{"a", ",", "b", ",", 
               FractionBox["1", "2"], ",", 
               RowBox[{"p", "+", "1"}], ",", "q", ",", "r", ",", "v"}], 
              "]"}]}], "r"], "-", 
           FractionBox[
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"(", 
              RowBox[{"a", "+", "r"}], ")"}], " ", 
             RowBox[{"KTop", "[", 
              RowBox[{"a", ",", "b", ",", 
               RowBox[{"-", 
                FractionBox["1", "2"]}], ",", 
               RowBox[{"p", "+", "1"}], ",", "q", ",", "r", ",", "v"}], 
              "]"}]}], "r"]}], ")"}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"b", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], ";", 
  TagBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"P1", "[", "nu", "]"}], "\[Equal]", 
      RowBox[{
       SuperscriptBox["2", 
        RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]], " ", 
       RowBox[{"FinitePart", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"H0", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", 
            RowBox[{
             RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", "1", ",",
             "nu"}], "]"}], "+", 
          FractionBox[
           RowBox[{"2", " ", "\[ImaginaryI]", " ", 
            RowBox[{"H1", "[", 
             RowBox[{
              RowBox[{"1", "+", 
               RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", 
              RowBox[{
               RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", "1",
               ",", "nu"}], "]"}]}], 
           RowBox[{"1", "+", 
            RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]}]]}], ",", "delta",
          ",", "0"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"P2", "[", "nu", "]"}], "\[Equal]", 
      RowBox[{
       SuperscriptBox["2", 
        RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]], " ", 
       RowBox[{"FinitePart", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            SubscriptBox["\[PartialD]", "r"], 
            RowBox[{"H0", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", 
              RowBox[{
               RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", "r",
               ",", "nu"}], "]"}]}], "-", 
           RowBox[{"H0", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", 
             RowBox[{
              RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", "r", 
             ",", "nu"}], "]"}]}], "/.", "\[VeryThinSpace]", 
          RowBox[{"r", "\[Rule]", "1"}]}], ",", "delta", ",", "0"}], 
        "]"}]}]}]}], "}"}],
   HoldForm]}]], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"20920e1c-1744-dc42-b8bf-11dabb3b8168"],

Cell[BoxData[
 TagBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"P1", "[", "nu", "]"}], "\[Equal]", 
