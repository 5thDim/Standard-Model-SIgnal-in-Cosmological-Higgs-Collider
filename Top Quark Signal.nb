      RowBox[{"{", 
       RowBox[{"\"\<mt/H\>\"", 
        ",", "\"\<max relative Gamma-sum residual\>\""}], "}"}]}], "]"}], ",", 
    RowBox[{"Frame", "\[Rule]", "All"}]}], "]"}]}]], "Input",
