          RowBox[{"kap", ",", "prec"}], "]"}]}], ",", "base", ",", "hom", ",",
         "part"}], "}"}], ",", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"a", "\[NotEqual]", "b"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"kOppTop", "[", 
             RowBox[{"a", ",", "pp", ",", "qq", ",", "vv", ",", "kk"}], "]"}],
             ",", "prec"}], "]"}], "]"}]}], "]"}], ";", 
       RowBox[{"base", "=", 
        RowBox[{
         RowBox[{"-", "a"}], " ", "\[ImaginaryI]", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"-", "\[ImaginaryI]"}], ")"}], " ", "a", " ", "\[Pi]", " ", 
           RowBox[{"(", 
            RowBox[{"pp", "+", "qq"}], ")"}]}], "]"}], " ", 
         SuperscriptBox["2", 
          RowBox[{
           RowBox[{"-", "3"}], "-", "pp", "-", "qq"}]], " ", 
         RowBox[{"Gamma", "[", 
          RowBox[{
           FractionBox["3", "2"], "+", "pp", "+", 
           RowBox[{"a", " ", "\[ImaginaryI]", " ", "vv"}]}], "]"}], " ", 
         RowBox[{"Gamma", "[", 
          RowBox[{
           FractionBox["3", "2"], "+", "qq", "+", 
           RowBox[{"a", " ", "\[ImaginaryI]", " ", "vv"}]}], "]"}]}]}], ";", 
       RowBox[{"hom", "=", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{"2", " ", "\[ImaginaryI]", " ", "\[Pi]", " ", "kk"}], 
             "]"}], "+", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "2"}], " ", "\[Pi]", " ", "vv"}], "]"}]}], ")"}], " ", 
          RowBox[{"Gamma", "[", 
           RowBox[{
            FractionBox["3", "2"], "+", "pp", "-", 
            RowBox[{"a", " ", "\[ImaginaryI]", " ", "vv"}]}], "]"}], " ", 
          RowBox[{"Gamma", "[", 
           RowBox[{
            FractionBox["3", "2"], "+", "qq", "-", 
            RowBox[{"a", " ", "\[ImaginaryI]", " ", "vv"}]}], "]"}], " ", 
          RowBox[{"Gamma", "[", 
           RowBox[{
            FractionBox["1", "2"], "+", 
