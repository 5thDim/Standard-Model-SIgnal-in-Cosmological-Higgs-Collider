        RowBox[{
         RowBox[{"3", " ", 
          SuperscriptBox["pp1", "2"]}], "+", 
         RowBox[{"2", " ", "pp1", " ", "pp2"}]}], ")"}], " ", 
       RowBox[{
       "loopRatios", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
       "+", 
      RowBox[{
       SuperscriptBox["pp2", "2"], " ", 
       RowBox[{
        RowBox[{"Rest", "[", "loopRatios", "]"}], ".", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"s1", "+", "s3", "-", 
           RowBox[{"3", " ", "s1", " ", "s3"}]}], ",", "tb", ",", "td"}], 
         "}"}]}]}]}], ")"}]}]}], ";", 
  RowBox[{"assembledFromCoefficients", "=", 
   RowBox[{"coefficientSimp", ".", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{"s1", "+", "s3"}], ",", 
      RowBox[{"s1", " ", "s3"}], ",", "tb", ",", "td"}], "}"}]}]}], ";", 
  RowBox[{"angularSymbolicCheck", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
