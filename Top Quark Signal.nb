       RowBox[{"\"\<mt/H\>\"", ",", "\"\<ln |coefficient|\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", 
      "\[Rule]", "\"\<Top-quark angular coefficients - Eq. (65)\>\""}], ",", 
     RowBox[{"PlotLegends", "\[Rule]", 
      RowBox[{"Placed", "[", 
       RowBox[{"coefficientNames", ",", "Right"}], "]"}]}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Directive", "[", 
          RowBox[{"#1", ",", "Thick"}], "]"}], "&"}], ")"}], "/@", 
       "plotColorsTop"}]}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "850"}], ",", 
     RowBox[{"BaseStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}], ",", 
        RowBox[{"FontSize", "\[Rule]", "14"}]}], "}"}]}], ",", 
     RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", 
     RowBox[{"GridLinesStyle", "\[Rule]", 
      RowBox[{"Directive", "[", 
       TemplateBox[<|"color" -> GrayLevel[0.9]|>,
        "GrayLevelColorSwatchTemplate"], "]"}]}]}], "]"}]}], ";", 
  "overviewPlotTop"}]], "Input",
