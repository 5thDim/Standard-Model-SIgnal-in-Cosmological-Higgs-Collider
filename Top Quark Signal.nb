              RowBox[{"v", ",", 
               FractionBox["2", "5"], ",", 
               FractionBox["7", "10"], ",", 
               FractionBox["9", "10"]}], "]"}], "-", "reconstructed"}], 
            "reconstructed"], "]"}], ",", 
          RowBox[{"Abs", "[", 
           FractionBox[
