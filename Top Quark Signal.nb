Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"coefficientValuesTop", "[", 
    RowBox[{
     RowBox[{"v_", "?", "NumericQ"}], ",", 
     RowBox[{"prec_Integer", ":", "50"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"vv", "=", 
        RowBox[{"N", "[", 
         RowBox[{"v", ",", "prec"}], "]"}]}], ",", 
       RowBox[{"pv", "=", 
        RowBox[{"hardValuesTop", "[", 
         RowBox[{"v", ",", "prec"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"coefficientSimp", "/.", "\[VeryThinSpace]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"nu", "\[Rule]", "vv"}], ",", 
          RowBox[{"bb", "\[Rule]", 
           RowBox[{"softBTop", "[", "vv", "]"}]}], ",", 
          RowBox[{"pp1", "\[Rule]", 
           RowBox[{
           "pv", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ",", 
          RowBox[{"pp2", "\[Rule]", 
           RowBox[{
           "pv", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], 
         "}"}]}], ",", "prec"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"precisionChecks", "=", 
