Cell[CellGroupData[{

Cell["3. Whittaker seeds and regulated hard integrals", "Section",ExpressionUUID->"29529dc0-9f20-e84a-b65e-96f053a612c3"],

Cell["\<\
Eqs. (119)-(125). kappa = +/-1/2, a,b = +/-1. kOppTop and kSameTop use the \
regularized 3F2; this differs from the ordinary 3F2 used later in QTop. V is \
the vertex-type sum without a -1/2 prefactor; the hard kernels F and moments \
H use this same normalization. P_i is normalized to k12^(-2 I nu), so it \
includes the factor 2^(2 I nu) in Eq. (125). For a general soft branch eta \
this factor is 2^(2 I eta nu). The integral definition fixes all phases. The \
finite part is taken only after the full SK and kappa combinations have been \
assembled.\
\>", "Text",ExpressionUUID->"a9fccce9-3715-244a-bcc9-6e9cf32f2767"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"kOppTop", "[", 
    RowBox[{"a_", ",", "p_", ",", "q_", ",", "v_", ",", "kap_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"-", "\[ImaginaryI]"}], ")"}], " ", "a", " ", "\[Pi]", " ", 
        RowBox[{"(", 
         RowBox[{"p", "-", "q"}], ")"}]}], "+", 
       RowBox[{"\[ImaginaryI]", " ", "\[Pi]", " ", "kap"}]}], "]"}], " ", 
     SuperscriptBox["2", 
      RowBox[{
       RowBox[{"-", "3"}], "-", "p", "-", "q"}]], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{
       FractionBox["3", "2"], "+", "p", "-", 
       RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{
       FractionBox["3", "2"], "+", "p", "+", 
       RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{
       FractionBox["3", "2"], "+", "q", "-", 
       RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{
       FractionBox["3", "2"], "+", "q", "+", 
       RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}]}], 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"2", "+", "p", "+", 
       RowBox[{"a", " ", "kap"}]}], "]"}], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{"2", "+", "q", "-", 
       RowBox[{"a", " ", "kap"}]}], "]"}]}]]}], ";", 
  RowBox[{
   RowBox[{"kSameTop", "[", 
    RowBox[{"a_", ",", "p_", ",", "q_", ",", "v_", ",", "kap_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "a"}], " ", "\[ImaginaryI]", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"-", "\[ImaginaryI]"}], ")"}], " ", "a", " ", "\[Pi]", " ", 
      RowBox[{"(", 
       RowBox[{"p", "+", "q"}], ")"}]}], "]"}], " ", 
    SuperscriptBox["2", 
     RowBox[{
      RowBox[{"-", "3"}], "-", "p", "-", "q"}]], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{
      FractionBox["3", "2"], "+", "p", "+", 
      RowBox[{"a", " ", "\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{
      FractionBox["3", "2"], "+", "q", "+", 
