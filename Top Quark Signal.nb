Cell["\<\
A3 = -3 A2 implies ln|A3| - ln|A2| = ln(3) and a phase difference of Pi \
modulo 2 Pi. The phase shown is that of each coefficient in the convention of \
Eq. (64); the phase of the full signal at fixed angles is Arg[Ctop], which \
also depends on the angular combination.\
\>", "Text",ExpressionUUID->"dff53a05-10b2-6a4b-90ed-024ef98e82d7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Five coefficients: magnitude and phase", "Subsection",
 CellTags->
  "TopFiveCoefficients-group",ExpressionUUID->"f0d82707-c5c6-4f68-b770-\
9ddc4fc8d8ad"],

Cell["\<\
The five coefficients are ordered A1, A2, A3, B and D. These two figures use \
the existing top-quark data over 0.1 <= nu <= 5 and the same plotting \
parameters as the gauge-boson summary: background grid, framed in-plot \
legends, Latin Modern Roman fonts, and a blue-to-orange gradient. Magnitude \
is ln|C|; phase is the principal argument in radians. Phase curves are \
disconnected at jumps exceeding Pi.\
\>", "Text",
 CellTags->
  "TopFiveCoefficients-note",ExpressionUUID->"1769c09b-f078-416e-8853-\
fe47d68e8e4d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "fiveCoefficientTopFont", " ", "=", " ", "\"\<Latin Modern Roman\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fiveCoefficientTopNames", " ", "=", " ", 
   RowBox[{"{", "\[IndentingNewLine]", " ", 
    RowBox[{
     RowBox[{"Subscript", "[", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\<A\>\"", ",", " ", "Italic"}], "]"}], ",", " ", "1"}], 
      "]"}], ",", " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\<A\>\"", ",", " ", "Italic"}], "]"}], ",", " ", "2"}], 
      "]"}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\<A\>\"", ",", " ", "Italic"}], "]"}], ",", " ", "3"}], 
      "]"}], ",", " ", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<B\>\"", ",", " ", "Italic"}], "]"}], ",", " ", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<D\>\"", ",", " ", "Italic"}], "]"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fiveCoefficientTopColors", " ", "=", " ", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", " ", 
    RowBox[{
     RowBox[{"Blend", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"RGBColor", "[", 
          RowBox[{"0.12", ",", " ", "0.30", ",", " ", "0.65"}], "]"}], ",", 
         " ", 
         RowBox[{"RGBColor", "[", 
          RowBox[{"0.48", ",", " ", "0.23", ",", " ", "0.72"}], "]"}], ",", 
