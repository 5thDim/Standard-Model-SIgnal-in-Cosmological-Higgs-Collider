Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"cFromLoopTop", "[", 
    RowBox[{"v_", ",", "t1_", ",", "t3_", ",", "ph_", ",", 
     RowBox[{"prec_Integer", ":", "50"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pv", "=", 
       RowBox[{"hardValuesTop", "[", 
        RowBox[{"v", ",", "prec"}], "]"}]}], "}"}], ",", 
     RowBox[{"N", "[", 
      RowBox[{
       FractionBox[
        RowBox[{"8", " ", 
         SuperscriptBox[
          RowBox[{"Gamma", "[", 
           RowBox[{
            FractionBox["1", "2"], "-", 
            RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}], "4"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"3", " ", 
               SuperscriptBox[
                RowBox[{
                "pv", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
                "2"]}], "+", 
              RowBox[{"2", " ", 
               RowBox[{
               "pv", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], " ", 
               RowBox[{
               "pv", "\[LeftDoubleBracket]", "2", 
                "\[RightDoubleBracket]"}]}]}], ")"}], " ", 
            RowBox[{"i12Top", "[", "v", "]"}]}], "+", 
           RowBox[{
            SuperscriptBox[
             RowBox[{
             "pv", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
             "2"], " ", 
            RowBox[{"i22Top", "[", 
             RowBox[{"v", ",", "t1", ",", "t3", ",", "ph"}], "]"}]}]}], 
          ")"}]}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"4", " ", "\[Pi]"}], ")"}], 
         RowBox[{"7", "/", "2"}]]], ",", "prec"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"angularNumericChecks", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"cv", "=", 
          RowBox[{"coefficientValuesTop", "[", 
           RowBox[{"v", ",", "50"}], "]"}]}], ",", "reconstructed", ",", 
         "projectedB", ",", "projectedD"}], "}"}], ",", 
       RowBox[{
        RowBox[{"reconstructed", "=", 
         RowBox[{"cv", ".", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"Cos", "[", 
               FractionBox["2", "5"], "]"}], "2"], "+", 
             SuperscriptBox[
              RowBox[{"Cos", "[", 
               FractionBox["7", "10"], "]"}], "2"]}], ",", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"Cos", "[", 
