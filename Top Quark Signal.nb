       RowBox[{"f0Top", "[", 
        RowBox[{"rho", ",", "rho"}], "]"}]}], 
      RowBox[{"32", " ", 
       SuperscriptBox["\[Pi]", "2"], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"4", " ", "\[Pi]"}], ")"}], 
        RowBox[{"3", "/", "2"}]], " ", 
