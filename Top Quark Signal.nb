Cell[CellGroupData[{

Cell["\<\
4. Finite analytic hard coefficients and FullSimplify results\
\>", "Section",ExpressionUUID->"0e6fb695-3f57-b644-b297-749837bb45ef"],

Cell["\<\
A finite representation of the assembled Eq. (118) is expressed through Q_mn. \
This representation is also present in the source manuscript comments and the \
existing Whittaker calculation. Its equivalence to the regulated definition \
is checked numerically below; that check is distinct from a symbolic proof of \
the regulator limit. Q_mn contains an ordinary 3F2 with convergence balance 1 \
+ I nu. Only Q00 remains nontrivial after the other four functions are \
reduced.\
\>", "Text",ExpressionUUID->"59a4ebb3-d5c1-e447-8cc6-0a6bb836d92e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qTop", "[", 
    RowBox[{"m_", ",", "n_", ",", "v_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{
     SuperscriptBox["2", 
      RowBox[{
       RowBox[{"-", "1"}], "-", 
       RowBox[{"2", " ", "\[ImaginaryI]", " ", "v"}], "-", "m", "-", "n"}]], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{"1", "+", 
       RowBox[{"2", " ", "\[ImaginaryI]", " ", "v"}], "+", "m", "+", "n"}], 
      "]"}], " ", 
     RowBox[{"HypergeometricPFQ", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "+", 
          RowBox[{"2", " ", "\[ImaginaryI]", " ", "v"}], "+", "m", "+", "n"}],
          ",", 
         RowBox[{"1", "+", 
          RowBox[{"\[ImaginaryI]", " ", "v"}]}], ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"2", "+", 
          RowBox[{"2", " ", "\[ImaginaryI]", " ", "v"}], "+", "m"}], ",", 
         RowBox[{"2", "+", 
          RowBox[{"2", " ", "\[ImaginaryI]", " ", "v"}], "+", "n"}]}], "}"}], 
       ",", "1"}], "]"}]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"2", " ", "\[ImaginaryI]", " ", "v"}], "+", "m"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"2", " ", "\[ImaginaryI]", " ", "v"}], "+", "n"}], ")"}]}]]}], 
  ";", 
  RowBox[{
   RowBox[{"timeGammaTop", "[", "v_", "]"}], ":=", 
   RowBox[{
    SuperscriptBox["2", 
     RowBox[{
      RowBox[{"-", "1"}], "-", 
      RowBox[{"2", " ", "\[ImaginaryI]", " ", "v"}]}]], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"1", "+", 
      RowBox[{"2", " ", "\[ImaginaryI]", " ", "v"}]}], "]"}]}]}], ";", 
  RowBox[{
   RowBox[{"endpointTop", "[", "v_", "]"}], ":=", 
   RowBox[{
    SuperscriptBox["\[Pi]", "2"], " ", 
    SuperscriptBox["2", 
     RowBox[{
      RowBox[{"-", "1"}], "-", 
      RowBox[{"2", " ", "\[ImaginaryI]", " ", "v"}]}]], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"Gamma", "[", 
        RowBox[{"1", "+", 
         RowBox[{"2", " ", "\[ImaginaryI]", " ", "v"}]}], "]"}], 
       RowBox[{"Gamma", "[", 
        RowBox[{"1", "+", 
         RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}]], ")"}], "2"]}]}], ";", 
  RowBox[{"formTop", "[", 
   RowBox[{"qTop", "[", 
    RowBox[{"0", ",", "0", ",", "nu"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"cb8a7d2d-8415-7d40-a539-075f0b5ff12d"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{
    SuperscriptBox["2", 
     RowBox[{
      RowBox[{"-", "1"}], "-", 
      RowBox[{"2", " ", "\[ImaginaryI]", " ", "\[Nu]"}]}]], " ", 
    TemplateBox[{
      RowBox[{
        RowBox[{"2", " ", "\[ImaginaryI]", " ", "\[Nu]"}], "+", "1"}]},
     "Gamma"], " ", 
    TagBox[
     TagBox[
      RowBox[{
       RowBox[{
        SubscriptBox["\[InvisiblePrefixScriptBase]", "3"], 
        SubscriptBox["F", "2"]}], "\[InvisibleApplication]", 
       RowBox[{"(", 
        RowBox[{
         TagBox[
          TagBox[
           RowBox[{
            TagBox["1",
             HypergeometricPFQ,
             Editable->True,
             Selectable->True], ",", 
            TagBox[
             RowBox[{
              RowBox[{"\[ImaginaryI]", " ", "\[Nu]"}], "+", "1"}],
             HypergeometricPFQ,
             Editable->True,
             Selectable->True], ",", 
