Cell[CellGroupData[{

Cell["6. Mass scan and saved plots", "Section",ExpressionUUID->"63814ed0-92e0-3f40-b610-0a5982b8642a"],

Cell["\<\
The scan covers 0.1 <= mt/H <= 5, with spacing 0.01 up to 1 and 0.05 above 1. \
The massless endpoint is excluded because the separated soft branches require \
a separate limiting treatment. Raw complex coefficients are retained in \
massDataTop. Each coefficient has a natural-log magnitude plot and a \
principal-phase plot in radians; phase branches are disconnected at jumps \
exceeding Pi. No Boltzmann factor is removed.\
\>", "Text",ExpressionUUID->"bcba5f26-ac82-de45-be54-90b3dccfb0f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"massGridTop", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{"massMin", ",", "1", ",", 
       FractionBox["1", "100"]}], "]"}], ",", 
     RowBox[{"Range", "[", 
      RowBox[{
       FractionBox["21", "20"], ",", "massMax", ",", 
       FractionBox["1", "20"]}], "]"}]}], "]"}]}], ";", 
  RowBox[{"massDataTop", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"coefficientValuesTop", "[", 
        RowBox[{"v", ",", "wp"}], "]"}], ",", "v"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"v", ",", "massGridTop"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"scanValidTop", "=", 
   RowBox[{
    RowBox[{"And", "@@", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"VectorQ", "[", 
         RowBox[{"#1", ",", "NumericQ"}], "]"}], "&"}], ")"}], "/@", 
      "massDataTop"}]}], "&&", 
    RowBox[{"FreeQ", "[", 
     RowBox[{"massDataTop", ",", 
      RowBox[{"Indeterminate", "|", "ComplexInfinity", "|", 
       RowBox[{"DirectedInfinity", "[", "_", "]"}]}]}], "]"}]}]}], ";", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Length", "[", "massDataTop", "]"}], ",", "scanValidTop"}], 
   "}"}]}]], "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"835b49a0-7550-d947-8c4a-c861fe248a5b"],

