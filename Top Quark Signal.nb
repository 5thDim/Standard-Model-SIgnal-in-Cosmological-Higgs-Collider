Cell[CellGroupData[{

Cell["\<\
A.7. Independent numerical check of the original regulated expression\
\>", "Subsection",ExpressionUUID->"7ed354b3-2325-4c52-96fb-4c15adfa4027"],

Cell["\<\
The exact proof above uses rational certificates, the stated hypergeometric \
transformations, and Gamma identities. The following additional check \
evaluates the ORIGINAL raw Eq. (146) at nonzero del and compares it with the \
reduced regulated expression, before taking a limit. A convergent Thomae \
representation is selected for each 3F2 to avoid evaluating a divergent \
defining series at unit argument. This is a numerical check of the \
derivation, not a replacement for the exact residuals.\
\>", "Text",ExpressionUUID->"5951eb29-97b9-44a6-a5b7-37610643ef80"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"reg3N", "[", 
    RowBox[{"upper_List", ",", "lower_List", ",", "prec_Integer"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"aa", "=", 
        RowBox[{"N", "[", 
         RowBox[{"upper", ",", "prec"}], "]"}]}], ",", 
       RowBox[{"bb", "=", 
        RowBox[{"N", "[", 
         RowBox[{"lower", ",", "prec"}], "]"}]}], ",", "balance", ",", 
       "choices", ",", "best", ",", "ii", ",", "jj", ",", "c", ",", "pair", ",",
        "d", ",", "e"}], "}"}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{
      RowBox[{"balance", "=", 
       RowBox[{
        RowBox[{"Total", "[", "bb", "]"}], "-", 
        RowBox[{"Total", "[", "aa", "]"}]}]}], ";", "\[IndentingNewLine]", 
      " ", 
      RowBox[{"choices", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Re", "[", "balance", "]"}], ",", "0", ",", "0"}], "}"}], 
          "}"}], ",", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Re", "[", 
                RowBox[{
                 RowBox[{"bb", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "-", 
                 RowBox[{"aa", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", "i", ",", 
               "j"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "3"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "2"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", " ", 
      RowBox[{"best", "=", 
       RowBox[{"First", "[", 
        RowBox[{"MaximalBy", "[", 
         RowBox[{"choices", ",", "First"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"best", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "==", "0"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"HypergeometricPFQRegularized", "[", 
            RowBox[{"aa", ",", "bb", ",", "1"}], "]"}], ",", "prec"}], "]"}], 
         "]"}]}], "]"}], ";", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ii", ",", "jj"}], "}"}], "=", 
       RowBox[{"Rest", "[", "best", "]"}]}], ";", 
      RowBox[{"c", "=", 
       RowBox[{"aa", "[", 
        RowBox[{"[", "ii", "]"}], "]"}]}], ";", 
      RowBox[{"pair", "=", 
       RowBox[{"Delete", "[", 
        RowBox[{"aa", ",", "ii"}], "]"}]}], ";", 
      RowBox[{"e", "=", 
       RowBox[{"bb", "[", 
        RowBox[{"[", "jj", "]"}], "]"}]}], ";", 
      RowBox[{"d", "=", 
       RowBox[{"bb", "[", 
        RowBox[{"[", 
         RowBox[{"3", "-", "jj"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]",
       " ", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Gamma", "[", "balance", "]"}], 
         RowBox[{
          RowBox[{"HypergeometricPFQRegularized", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"d", "-", 
               RowBox[{"pair", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ",", 
              RowBox[{"d", "-", 
               RowBox[{"pair", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ",", "c"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"d", ",", 
              RowBox[{"balance", "+", "c"}]}], "}"}], ",", "1"}], "]"}], "/", 
          RowBox[{"Gamma", "[", 
           RowBox[{"e", "-", "c"}], "]"}]}]}], ",", "prec"}], "]"}]}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rawForN", "=", 
   RowBox[{"raw", "/.", 
    RowBox[{"HypergeometricPFQRegularized", "->", "heldReg3"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rawN", "[", 
    RowBox[{"v_", ",", "eps_", ",", "prec_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"rawForN", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"nu", "->", 
           RowBox[{"N", "[", 
            RowBox[{"v", ",", "prec"}], "]"}]}], ",", 
          RowBox[{"del", "->", 
           RowBox[{"N", "[", 
            RowBox[{"eps", ",", "prec"}], "]"}]}]}], "}"}]}], ")"}], "/.", 
      "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{"heldReg3", "[", 
        RowBox[{"aa_", ",", "bb_", ",", "1"}], "]"}], " ", ":>", " ", 
       RowBox[{"reg3N", "[", 
        RowBox[{"aa", ",", "bb", ",", "prec"}], "]"}]}]}], ",", 
     RowBox[{"prec", "-", "10"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"reducedN", "[", 
    RowBox[{"v_", ",", "eps_", ",", "prec_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"vv", "=", 
        RowBox[{"N", "[", 
         RowBox[{"v", ",", "prec"}], "]"}]}], ",", 
       RowBox[{"dd", "=", 
        RowBox[{"N", "[", 
         RowBox[{"eps", ",", "prec"}], "]"}]}], ",", "uu", ",", "tt", ",", 
       "ww", ",", "hv", ",", "regv", ",", "bcv", ",", "hcv"}], "}"}], ",", 
     "\[IndentingNewLine]", " ", 
     RowBox[{
      RowBox[{"uu", "=", 
       RowBox[{"I", " ", "vv"}]}], ";", 
      RowBox[{"tt", "=", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", "Pi", " ", "dd"}], "]"}]}], ";", 
      RowBox[{"ww", "=", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", "Pi", " ", "uu"}], "]"}]}], ";", 
      "\[IndentingNewLine]", " ", 
      RowBox[{"hv", "=", 
       RowBox[{
        RowBox[{"Gamma", "[", 
         RowBox[{"2", "+", "uu"}], "]"}], 
        RowBox[{"Gamma", "[", 
         RowBox[{"1", "+", 
          RowBox[{"2", "uu"}], "+", "dd"}], "]"}], 
        RowBox[{"reg3N", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"1", "+", "uu", "+", "dd"}], ",", 
            RowBox[{"1", "-", "dd"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"2", "+", "uu"}], ",", 
            RowBox[{"1", "+", 
             RowBox[{"2", "uu"}], "+", "dd"}]}], "}"}], ",", "prec"}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", " ", 
      RowBox[{"regv", "=", 
       RowBox[{"regularFactor", "/.", 
        RowBox[{"{", 
         RowBox[{
