Cell["\<\
A3 = -3 A2 implies ln|A3| - ln|A2| = ln(3) and a phase difference of Pi \
modulo 2 Pi. The phase shown is that of each coefficient in the convention of \
Eq. (64); the phase of the full signal at fixed angles is Arg[Ctop], which \
also depends on the angular combination.\
\>", "Text",ExpressionUUID->"dff53a05-10b2-6a4b-90ed-024ef98e82d7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Validation summary", "Section",ExpressionUUID->"2615bdf8-cbcd-c146-becf-dc1290a98b8a"],

Cell["\<\
These checks validate the implementation of the stated leading collapsed \
formulas, their algebraic relations, and numerical stability. The regulator \
comparison is numerical evidence for the finite representation, not a full \
symbolic proof of that limit or an independent validation of the complete \
unexpanded fermion box.\
\>", "Text",ExpressionUUID->"d68d1fea-4ed0-a74d-a7c3-b900d496ec45"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"validationTop", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<Soft Gamma normalization\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"softGammaCheck", "\[Equal]", "0"}], "]"}]}], ",", 
     RowBox[{"\"\<Loop coefficients: symbolic Gamma recurrence\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"loopSymbolicCheck", "\[Equal]", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", "5"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"\"\<Loop coefficients: direct Gamma sums\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"loopNumericChecks", "\[LeftDoubleBracket]", 
          RowBox[{"All", ",", "2"}], "\[RightDoubleBracket]"}], "]"}], "<", 
        FractionBox["1", 
         SuperscriptBox["10", "35"]]}], "]"}]}], ",", 
     RowBox[{"\"\<Four Q reductions\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"qReductionCheck", "\[Equal]", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", "4"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"\"\<Regulated SK sum vs finite P and H\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"regulatorChecks", "\[LeftDoubleBracket]", 
           RowBox[{"All", ",", 
            RowBox[{"2", ";;", "5"}]}], "\[RightDoubleBracket]"}], "]"}], 
         "]"}], "<", 
        FractionBox["1", 
         SuperscriptBox["10", "9"]]}], "]"}]}], ",", 
     RowBox[{"\"\<Regulator convergence: four vs five levels\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"regulatorChecks", "\[LeftDoubleBracket]", 
          RowBox[{"All", ",", "6"}], "\[RightDoubleBracket]"}], "]"}], "<", 
        FractionBox["1", 
         SuperscriptBox["10", "9"]]}], "]"}]}], ",", 
     RowBox[{"\"\<Eq. (64) vs angular coefficients\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"angularSymbolicCheck", "\[Equal]", "0"}], "]"}]}], ",", 
     RowBox[{"\"\<A3 = -3 A2\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"a3Check", "\[Equal]", "0"}], "]"}]}], ",", 
     RowBox[{"\"\<Precision stability\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"Max", "[", 
