            RowBox[{"nu", "\[Rule]", "vv"}]}], ",", "45"}], "]"}]}], ";", 
        RowBox[{"pold", "=", 
         RowBox[{
          RowBox[{"hardValuesTop", "[", 
           RowBox[{"v", ",", "50"}], "]"}], "\[LeftDoubleBracket]", 
          RowBox[{"1", ";;", "2"}], "\[RightDoubleBracket]"}]}], ";", 
        RowBox[{"cnew", "=", 
