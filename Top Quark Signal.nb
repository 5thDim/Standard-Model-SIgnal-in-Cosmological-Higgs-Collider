       RowBox[{"\[ImaginaryI]", " ", "v"}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"2", "+", 
       RowBox[{"\[ImaginaryI]", " ", "v"}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"2", " ", "\[ImaginaryI]", " ", "v"}]}], ")"}]}]]}], ";", 
  RowBox[{
   RowBox[{"topR2", "[", "v_", "]"}], ":=", 
   FractionBox[
    RowBox[{"\[ImaginaryI]", " ", "v", " ", 
     RowBox[{"(", 
      RowBox[{"5", "+", 
       RowBox[{"2", " ", "\[ImaginaryI]", " ", "v"}]}], ")"}]}], 
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"\[ImaginaryI]", " ", "v"}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"2", "+", 
       RowBox[{"\[ImaginaryI]", " ", "v"}]}], ")"}]}]]}], ";", 
  RowBox[{
   RowBox[{"topEPaper", "[", "v_", "]"}], ":=", 
   FractionBox[
    RowBox[{
     SuperscriptBox["\[Pi]", "2"], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{"1", "+", 
       RowBox[{"2", " ", "\[ImaginaryI]", " ", "v"}]}], "]"}]}], 
    RowBox[{
     RowBox[{"Cosh", "[", 
      RowBox[{"\[Pi]", " ", "v"}], "]"}], " ", 
     SuperscriptBox[
      RowBox[{"Gamma", "[", 
       RowBox[{"1", "+", 
        RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}], "2"]}]]}], ";", 
  RowBox[{
   RowBox[{"topTPaper", "[", "v_", "]"}], ":=", 
