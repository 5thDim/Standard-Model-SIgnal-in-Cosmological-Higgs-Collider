       RowBox[{"nu", ">", "0"}], ",", 
       RowBox[{"TimeConstraint", "\[Rule]", "20"}]}], "]"}], ",", "30", ",", 
     RowBox[{"topMaster", "[", "nu", "]"}]}], "]"}]}], ";", 
  RowBox[{"formTop", "[", "topMasterReduction", "]"}]}]], "Input",
 CellLabel->"In[41]:=",ExpressionUUID->"b4d8794d-88ad-c848-ae79-5e7076d3d812"],

