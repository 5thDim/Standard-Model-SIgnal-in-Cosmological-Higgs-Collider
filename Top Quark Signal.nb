    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"2", " ", "\[ImaginaryI]", " ", "\[Pi]", " ", "kap"}], 
           "]"}], "+", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "2"}], " ", "\[Pi]", " ", "v"}], "]"}]}], ")"}], " ", 
        RowBox[{"Gamma", "[", 
         RowBox[{
          FractionBox["3", "2"], "+", "p", "-", 
          RowBox[{"a", " ", "\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
        RowBox[{"Gamma", "[", 
         RowBox[{
          FractionBox["3", "2"], "+", "q", "-", 
          RowBox[{"a", " ", "\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
        RowBox[{"Gamma", "[", 
         RowBox[{
          FractionBox["1", "2"], "+", 
          RowBox[{"a", " ", "kap"}], "-", 
          RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
        RowBox[{"Gamma", "[", 
         RowBox[{
          FractionBox["1", "2"], "+", 
          RowBox[{"a", " ", "kap"}], "+", 
          RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}]}], 
       RowBox[{
        RowBox[{"(", 
