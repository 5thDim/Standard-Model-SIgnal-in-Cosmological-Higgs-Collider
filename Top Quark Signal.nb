Cell[CellGroupData[{

Cell["Regulator convergence and precision checks", "Subsection",ExpressionUUID->"c4ce11c1-1ce5-9c40-990a-0f4364d59a24"],

Cell["\<\
The next table compares the finite formulas with the complete regulated SK \
sum. Richardson extrapolation uses delta = 10^-3/2^j, at four and five \
levels. A stable ordinary limit is tested here, not assumed for individual \
seed terms. The comparison includes H0fin and H1fin as well as P1 and P2. \
This check is slower than the mass scan.\
\>", "Text",ExpressionUUID->"2e1de400-7220-754c-bb9d-d3befc269c21"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"regulatorChecks", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "low", ",", "high", ",", "target", ",", "err", ",", "stepErr"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"low", "=", 
         RowBox[{"regulatorLimitTop", "[", 
          RowBox[{"v", ",", 
           FractionBox["1", "1000"], ",", "4", ",", "50"}], "]"}]}], ";", 
        RowBox[{"high", "=", 
         RowBox[{"regulatorLimitTop", "[", 
          RowBox[{"v", ",", 
           FractionBox["1", "1000"], ",", "5", ",", "50"}], "]"}]}], ";", 
        RowBox[{"target", "=", 
         RowBox[{"hardValuesTop", "[", 
          RowBox[{"v", ",", "50"}], "]"}]}], ";", 
        RowBox[{"err", "=", 
         RowBox[{"Abs", "[", 
          FractionBox[
           RowBox[{"high", "-", "target"}], "target"], "]"}]}], ";", 
        RowBox[{"stepErr", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           FractionBox[
            RowBox[{"low", "-", "high"}], "high"], "]"}], "]"}]}], ";", 
        RowBox[{"{", 
         RowBox[{"v", ",", 
          RowBox[{
          "err", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
          RowBox[{
          "err", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
          RowBox[{
          "err", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], ",", 
          RowBox[{
          "err", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}], ",", 
          "stepErr"}], "}"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"v", ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", "5"], ",", 
         FractionBox["73", "100"], ",", "2"}], "}"}]}], "}"}]}], "]"}]}], ";", 
  RowBox[{"Grid", "[", 
   RowBox[{
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"N", "[", 
       RowBox[{"regulatorChecks", ",", "5"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<mt/H\>\"", ",", "\"\<P1 rel. error\>\"", 
        ",", "\"\<P2 rel. error\>\"", ",", "\"\<H0 rel. error\>\"", 
        ",", "\"\<H1 rel. error\>\"", ",", "\"\<4 vs 5 levels\>\""}], "}"}]}],
      "]"}], ",", 
    RowBox[{"Frame", "\[Rule]", "All"}]}], "]"}]}]], "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"c83f0c2d-8250-8a43-bdcd-ab9a7274623f"],

