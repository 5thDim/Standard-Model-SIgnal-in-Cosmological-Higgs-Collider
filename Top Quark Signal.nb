Cell[CellGroupData[{

Cell["6. Mass scan and saved plots", "Section",ExpressionUUID->"7d39f2ba-4f89-1749-aa53-6f48c81cb5bd"],

Cell["\<\
The scan covers 0.1 <= mt/H <= 5, with spacing 0.01 up to 1 and 0.05 above 1. \
The massless endpoint is excluded because the separated soft branches require \
a separate limiting treatment. Raw complex coefficients are retained in \
massDataTop. Each coefficient has a natural-log magnitude plot and a \
principal-phase plot in radians; phase branches are disconnected at jumps \
exceeding Pi. No Boltzmann factor is removed.\
\>", "Text",ExpressionUUID->"836edd86-4a4c-9c4a-a2b1-ddaacdb09584"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"massGridTop", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{"massMin", ",", "1", ",", 
       FractionBox["1", "100"]}], "]"}], ",", 
     RowBox[{"Range", "[", 
      RowBox[{
       FractionBox["21", "20"], ",", "massMax", ",", 
       FractionBox["1", "20"]}], "]"}]}], "]"}]}], ";", 
  RowBox[{"massDataTop", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"coefficientValuesTop", "[", 
        RowBox[{"v", ",", "wp"}], "]"}], ",", "v"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"v", ",", "massGridTop"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"scanValidTop", "=", 
   RowBox[{
    RowBox[{"And", "@@", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"VectorQ", "[", 
         RowBox[{"#1", ",", "NumericQ"}], "]"}], "&"}], ")"}], "/@", 
      "massDataTop"}]}], "&&", 
    RowBox[{"FreeQ", "[", 
     RowBox[{"massDataTop", ",", 
      RowBox[{"Indeterminate", "|", "ComplexInfinity", "|", 
       RowBox[{"DirectedInfinity", "[", "_", "]"}]}]}], "]"}]}]}], ";", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Length", "[", "massDataTop", "]"}], ",", "scanValidTop"}], 
   "}"}]}]], "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"11e6ae0b-4ec7-7749-9830-66a1345eb457"],

