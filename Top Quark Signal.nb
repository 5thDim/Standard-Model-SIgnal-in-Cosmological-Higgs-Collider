          RowBox[{"1", "+", 
           RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]}], ")"}], "2"]], "-", 
       RowBox[{"topR1", "[", "nu", "]"}]}], ",", 
      RowBox[{
