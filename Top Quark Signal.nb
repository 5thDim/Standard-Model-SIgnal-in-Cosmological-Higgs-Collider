                Editable->True,
                Selectable->True]}], ")"}]}],
            InterpretTemplate[HypergeometricPFQ[#, #2, #3]& ],
            Editable->False,
            Selectable->False],
           HypergeometricPFQ]}], 
         RowBox[{"\[Delta]", "+", 
          RowBox[{"2", " ", "u"}]}]]}],
       TraditionalForm],
      TraditionalForm,
      Editable->True]},
    {"\<\"F_plus\"\>", 
     TagBox[
      FormBox[
       RowBox[{
        FractionBox[
         RowBox[{
          TemplateBox[{"\[Delta]"},
           "Gamma"], " ", 
          TemplateBox[{
            RowBox[{"u", "+", "1"}]},
           "Gamma"], " ", 
          TemplateBox[{
            RowBox[{
              RowBox[{"-", "\[Delta]"}], "-", "u"}]},
