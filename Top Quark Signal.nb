Cell[CellGroupData[{

Cell["A.5. Derive the single master Ft in Eq. (147)", "Subsection",ExpressionUUID->"18e374ce-d6a6-481a-8cde-ad1bcbdaf263"],

Cell["\<\
At del=0, H0=3F2(1,1+u,1;2+u,1+2u;1). Introduce J=3F2(1,1,1+u;2+u,2+2u;1). \
Thomae\[CloseCurlyQuote]s two-term transformation of Ft (DLMF 16.4.11) gives \
Ft=(1+2u)J/(1+u). For C=1+2u, set S(k)=k!/(C+1)_k. The J summand is \
(1+u)S(k)/(k+1+u), and the H0/J summand ratio is (k+C)/C. Thus H0=J+theta \
J/C. The elementary sum of S is C/(C-1), as verified by the certificate \
below. It follows that theta J=(1+u)(C/(C-1)-J), giving \
H0=(1+u)/(2u)+u(1+u)Ft/(1+2u)^2. These identities are continued from their \
convergence domains to u=I nu. The code does not directly numerically sum the \
zero-real-balance H0 series.\
\>", "Text",ExpressionUUID->"86e251b9-5bce-4387-b397-45cf39adad9a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"cSum", "=", 
   RowBox[{"1", "+", 
    RowBox[{"2", "u"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rhoSum", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"k", "+", "1"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"k", "+", "cSum", "+", "1"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vSum", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"k", "+", "cSum"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"cSum", "-", "1"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sumCertificateResidual", "=", 
   RowBox[{"Factor", "[", 
    RowBox[{"Together", "[", 
     RowBox[{"1", "+", 
      RowBox[{"rhoSum", 
       RowBox[{"(", 
        RowBox[{"vSum", "/.", 
         RowBox[{"k", "->", 
          RowBox[{"k", "+", "1"}]}]}], ")"}]}], "-", "vSum"}], "]"}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"contiguityTermResidual", "=", 
   RowBox[{"Factor", "[", 
    RowBox[{"Together", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", "u"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1", "+", "u"}], ")"}]}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"k", "+", "cSum"}], ")"}], "/", "cSum"}]}], 
      "\[IndentingNewLine]", " ", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", "u"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"k", "+", "1", "+", "u"}], ")"}]}], "-", 
      RowBox[{"k", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", "u"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"cSum", 
          RowBox[{"(", 
           RowBox[{"k", "+", "1", "+", "u"}], ")"}]}], ")"}]}]}]}], "]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"thomaePrefactor", "=", 
   RowBox[{
    RowBox[{"Gamma", "[", 
     RowBox[{"2", "+", 
      RowBox[{"2", "u"}]}], "]"}], " ", 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"1", "+", "u"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Gamma", "[", 
        RowBox[{"1", "+", 
         RowBox[{"2", "u"}]}], "]"}], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{"2", "+", "u"}], "]"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"thomaePrefactorResidual", "=", 
   RowBox[{"normalize", "[", 
    RowBox[{"thomaePrefactor", "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"2", "u"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"1", "+", "u"}], ")"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hZero", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", "u"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", "u"}], ")"}]}], "+", 
    RowBox[{"u", 
     RowBox[{"(", 
      RowBox[{"1", "+", "u"}], ")"}], 
     RowBox[{"ft", "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"2", "u"}]}], ")"}], "^", "2"}]}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"finitePair", "=", 
   RowBox[{"Factor", " ", "/@", " ", 
    RowBox[{"Together", "[", 
     RowBox[{
      RowBox[{"finiteComponents", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "+", 
      RowBox[{"finiteComponents", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "+", 
      RowBox[{
       RowBox[{"finiteComponents", "[", 
        RowBox[{"[", "3", "]"}], "]"}], "hZero"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Elementary-sum certificate\>\"", ",", 
       "sumCertificateResidual"}], "}"}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<H0 vs J: summand residual\>\"", ",", 
       "contiguityTermResidual"}], "}"}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Thomae prefactor residual\>\"", ",", 
       "thomaePrefactorResidual"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<H0\>\"", ",", 
       RowBox[{"fmt", "[", "hZero", "]"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"Frame", "->", "All"}], ",", 
   RowBox[{"Alignment", "->", "Left"}]}], "]"}]}], "Input",
 ShowCellLabel->False,
 CellTags->
  "Top146-15-input",ExpressionUUID->"21d2c532-8349-4b35-96f8-6d208c5cae7c"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Elementary-sum certificate\"\>", "0"},
    {"\<\"H0 vs J: summand residual\"\>", "0"},
    {"\<\"Thomae prefactor residual\"\>", "0"},
    {"\<\"H0\"\>", 
     TagBox[
      FormBox[
       RowBox[{
        FractionBox[
         RowBox[{"u", " ", 
          RowBox[{"(", 
           RowBox[{"u", "+", "1"}], ")"}], " ", 
          SubscriptBox["\[ScriptCapitalF]", "t"]}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "u"}], "+", "1"}], ")"}], "2"]], "+", 
        FractionBox[
         RowBox[{"u", "+", "1"}], 
         RowBox[{"2", " ", "u"}]]}],
       TraditionalForm],
      TraditionalForm,
      Editable->True]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
