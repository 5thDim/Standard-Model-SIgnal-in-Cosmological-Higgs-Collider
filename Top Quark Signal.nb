  "2", " ", "+", " ", "q", " ", "-", " ", "a", "*", "kap", "]", ")", ";", " ",
   "kSame", "[", "a_", ",", " ", "p_", ",", " ", "q_", ",", " ", "v_", ",", 
  " ", "kap_", "]", " ", ":=", " ", "(", "-", "a", ")", "*", "I", "*", "Exp", 
  "[", "(", "1", "/", "2", ")", "*", "(", "-", "I", ")", "*", "a", "*", "Pi", 
  "*", "(", "p", " ", "+", " ", "q", ")", "]", "*", "2", "^", "(", "-", "3", 
  " ", "-", " ", "p", " ", "-", " ", "q", ")", "*", "Gamma", "[", "3", "/", 
