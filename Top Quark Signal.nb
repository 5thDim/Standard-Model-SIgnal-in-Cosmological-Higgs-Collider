Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"hardMomentsN", "[", 
    RowBox[{
     RowBox[{"v_", "?", "NumericQ"}], ",", 
     RowBox[{"q1_", "?", "NumericQ"}], ",", 
     RowBox[{"q2_", "?", "NumericQ"}], ",", "prec_Integer"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"h0", "=", "0"}], ",", 
       RowBox[{"h1", "=", "0"}], ",", 
       RowBox[{"dh0", "=", "0"}], ",", "p", ",", "q", ",", "kp", ",", "km", ",",
        "kps", ",", "kms", ",", "dkp", ",", "dkm", ",", "dkps", ",", "dkms", ",",
        "w", ",", "t0", ",", "t1", ",", "dt0"}], "}"}], ",", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"p", "=", 
          RowBox[{"q1", "-", 
           FractionBox["3", "2"], "+", "m"}]}], ";", 
         RowBox[{"q", "=", 
          RowBox[{"q2", "-", 
           FractionBox["3", "2"], "+", "n"}]}], ";", 
         RowBox[{"w", "=", 
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"-", "\[ImaginaryI]"}], ")"}], " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"\[ImaginaryI]", " ", "a"}], ")"}], "m"], " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"\[ImaginaryI]", " ", "b"}], ")"}], "n"]}]}], ";", 
         RowBox[{"kp", "=", 
          RowBox[{"kSeedN", "[", 
           RowBox[{"a", ",", "b", ",", "p", ",", "q", ",", "v", ",", 
            FractionBox["1", "2"], ",", "prec"}], "]"}]}], ";", 
         RowBox[{"km", "=", 
          RowBox[{"kSeedN", "[", 
           RowBox[{"a", ",", "b", ",", "p", ",", "q", ",", "v", ",", 
            RowBox[{"-", 
             FractionBox["1", "2"]}], ",", "prec"}], "]"}]}], ";", 
         RowBox[{"kps", "=", 
          RowBox[{"kSeedN", "[", 
           RowBox[{"a", ",", "b", ",", 
            RowBox[{"p", "+", "1"}], ",", "q", ",", "v", ",", 
            FractionBox["1", "2"], ",", "prec"}], "]"}]}], ";", 
         RowBox[{"kms", "=", 
          RowBox[{"kSeedN", "[", 
           RowBox[{"a", ",", "b", ",", 
            RowBox[{"p", "+", "1"}], ",", "q", ",", "v", ",", 
            RowBox[{"-", 
             FractionBox["1", "2"]}], ",", "prec"}], "]"}]}], ";", 
         RowBox[{"dkp", "=", 
          RowBox[{"kSeedDrN", "[", 
           RowBox[{"a", ",", "b", ",", "p", ",", "q", ",", "v", ",", 
            FractionBox["1", "2"], ",", "prec"}], "]"}]}], ";", 
         RowBox[{"dkm", "=", 
          RowBox[{"kSeedDrN", "[", 
           RowBox[{"a", ",", "b", ",", "p", ",", "q", ",", "v", ",", 
            RowBox[{"-", 
             FractionBox["1", "2"]}], ",", "prec"}], "]"}]}], ";", 
         RowBox[{"dkps", "=", 
          RowBox[{"kSeedDrN", "[", 
           RowBox[{"a", ",", "b", ",", 
            RowBox[{"p", "+", "1"}], ",", "q", ",", "v", ",", 
            FractionBox["1", "2"], ",", "prec"}], "]"}]}], ";", 
         RowBox[{"dkms", "=", 
          RowBox[{"kSeedDrN", "[", 
           RowBox[{"a", ",", "b", ",", 
            RowBox[{"p", "+", "1"}], ",", "q", ",", "v", ",", 
            RowBox[{"-", 
             FractionBox["1", "2"]}], ",", "prec"}], "]"}]}], ";", 
         RowBox[{"t0", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"p", "+", 
              FractionBox["3", "2"], "+", 
              RowBox[{"\[ImaginaryI]", " ", "v"}]}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{"km", "-", "kp"}], ")"}]}], "+", 
           RowBox[{"\[ImaginaryI]", " ", 
            RowBox[{"(", 
             RowBox[{"a", "-", "1"}], ")"}], " ", "kps"}], "-", 
           RowBox[{"\[ImaginaryI]", " ", 
            RowBox[{"(", 
             RowBox[{"a", "+", "1"}], ")"}], " ", "kms"}]}]}], ";", 
         RowBox[{"t1", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"p", "+", 
              FractionBox["3", "2"], "-", 
              RowBox[{"\[ImaginaryI]", " ", "v"}]}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{"km", "+", "kp"}], ")"}]}], "-", 
           RowBox[{"\[ImaginaryI]", " ", 
            RowBox[{"(", 
             RowBox[{"a", "-", "1"}], ")"}], " ", "kps"}], "-", 
           RowBox[{"\[ImaginaryI]", " ", 
            RowBox[{"(", 
             RowBox[{"a", "+", "1"}], ")"}], " ", "kms"}]}]}], ";", 
         RowBox[{"dt0", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"3", "+", "p", "+", "q"}], ")"}]}], " ", "t0"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"p", "+", 
              FractionBox["3", "2"], "+", 
              RowBox[{"\[ImaginaryI]", " ", "v"}]}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{"dkm", "-", "dkp"}], ")"}]}], "+", 
           RowBox[{"\[ImaginaryI]", " ", 
            RowBox[{"(", 
             RowBox[{"a", "-", "1"}], ")"}], " ", "dkps"}], "-", 
           RowBox[{"\[ImaginaryI]", " ", 
            RowBox[{"(", 
             RowBox[{"a", "+", "1"}], ")"}], " ", "dkms"}], "-", 
           RowBox[{"\[ImaginaryI]", " ", "a", " ", "kps"}], "+", 
           RowBox[{"\[ImaginaryI]", " ", "a", " ", "kms"}]}]}], ";", 
         RowBox[{"h0", "+=", 
          RowBox[{"w", " ", "t0"}]}], ";", 
         RowBox[{"h1", "+=", 
          RowBox[{"w", " ", "t1"}]}], ";", 
         RowBox[{"dh0", "+=", 
          RowBox[{"w", " ", "dt0"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"b", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "0", ",", "1"}], "}"}]}], "]"}], ";", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"h0", ",", "h1", ",", "dh0"}], "}"}], ",", "prec"}], 
       "]"}]}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"regulatedHardTop", "[", 
    RowBox[{
     RowBox[{"v_", "?", "NumericQ"}], ",", 
     RowBox[{"del_", "?", "NumericQ"}], ",", 
     RowBox[{"prec_Integer", ":", "50"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"regulatedHardTop", "[", 
     RowBox[{"v", ",", "del", ",", "prec"}], "]"}], "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"base", ",", "shift"}], "}"}], ",", 
      RowBox[{
       RowBox[{"base", "=", 
        RowBox[{"hardMomentsN", "[", 
         RowBox[{"v", ",", 
          RowBox[{
           RowBox[{"\[ImaginaryI]", " ", "v"}], "+", "del"}], ",", 
          RowBox[{
           RowBox[{"\[ImaginaryI]", " ", "v"}], "+", "del"}], ",", "prec"}], 
         "]"}]}], ";", 
       RowBox[{"shift", "=", 
        RowBox[{"hardMomentsN", "[", 
         RowBox[{"v", ",", 
          RowBox[{"1", "+", 
           RowBox[{"\[ImaginaryI]", " ", "v"}], "+", "del"}], ",", 
          RowBox[{
           RowBox[{"\[ImaginaryI]", " ", "v"}], "+", "del"}], ",", "prec"}], 
         "]"}]}], ";", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
          "base", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "+", 
          FractionBox[
           RowBox[{"2", " ", "\[ImaginaryI]", " ", 
            RowBox[{
            "shift", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
           RowBox[{"1", "+", 
            RowBox[{"2", " ", "\[ImaginaryI]", " ", "v"}]}]]}], ",", 
         RowBox[{
          RowBox[{
          "base", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "-", 
          RowBox[{
          "base", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ",", 
         RowBox[{
         "base", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
         RowBox[{
         "shift", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
        "}"}]}]}], "]"}]}]}], ";", 
  RowBox[{
   RowBox[{"regulatorLimitTop", "[", 
    RowBox[{"v_", ",", "step_", ",", "levels_Integer", ",", 
     RowBox[{"prec_Integer", ":", "50"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "vals", "}"}], ",", 
     RowBox[{
      RowBox[{"vals", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"regulatedHardTop", "[", 
          RowBox[{"v", ",", 
           FractionBox["step", 
            SuperscriptBox["2", "j"]], ",", "prec"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "0", ",", 
           RowBox[{"levels", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"vals", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           FractionBox[
            RowBox[{
             RowBox[{
              SuperscriptBox["2", "ord"], " ", 
              RowBox[{"vals", "\[LeftDoubleBracket]", 
               RowBox[{"j", "+", "1"}], "\[RightDoubleBracket]"}]}], "-", 
             RowBox[{
             "vals", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]}], 
            RowBox[{
             SuperscriptBox["2", "ord"], "-", "1"}]], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{
              RowBox[{"Length", "[", "vals", "]"}], "-", "1"}]}], "}"}]}], 
          "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"ord", ",", "1", ",", 
          RowBox[{"levels", "-", "1"}]}], "}"}]}], "]"}], ";", 
      RowBox[{"First", "[", "vals", "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"7b4f4531-7934-dd46-9ffe-e165274e4b5a"]
