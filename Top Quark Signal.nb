         "projectedB", ",", "projectedD"}], "}"}], ",", 
       RowBox[{
        RowBox[{"reconstructed", "=", 
         RowBox[{"cv", ".", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"Cos", "[", 
               FractionBox["2", "5"], "]"}], "2"], "+", 
