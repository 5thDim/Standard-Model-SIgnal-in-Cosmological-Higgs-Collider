       RowBox[{"8", " ", 
        SuperscriptBox[
         RowBox[{"cPlusTop", "[", "v", "]"}], "2"], " ", 
        SuperscriptBox["16", 
         RowBox[{"2", " ", "\[ImaginaryI]", " ", "v"}]], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"3", " ", 
              SuperscriptBox[
               RowBox[{
               "pv", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
               "2"]}], "+", 
             RowBox[{"2", " ", 
              RowBox[{
              "pv", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], " ", 
              RowBox[{
              "pv", "\[LeftDoubleBracket]", "2", 
               "\[RightDoubleBracket]"}]}]}], ")"}], " ", 
