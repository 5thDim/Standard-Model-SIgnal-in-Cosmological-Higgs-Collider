             RowBox[{"a", ",", "pp", ",", "qq", ",", "vv", ",", "kk"}], "]"}],
             ",", "prec"}], "]"}], "]"}]}], "]"}], ";", 
       RowBox[{"base", "=", 
        RowBox[{
         RowBox[{"-", "a"}], " ", "\[ImaginaryI]", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"-", "\[ImaginaryI]"}], ")"}], " ", "a", " ", "\[Pi]", " ", 
           RowBox[{"(", 
            RowBox[{"pp", "+", "qq"}], ")"}]}], "]"}], " ", 
         SuperscriptBox["2", 
          RowBox[{
