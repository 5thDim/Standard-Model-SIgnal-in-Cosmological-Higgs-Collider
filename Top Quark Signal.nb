                          "\[RightDoubleBracket]"}], "/.", 
                          "\[VeryThinSpace]", RowBox[{RowBox[{"{", RowBox[
                          {"x_", ",", "y_"}], "}"}], "\[RuleDelayed]", 
                          RowBox[{"{", RowBox[{"x", ",", RowBox[{"Re", "[", 
                          "y", "]"}]}], "}"}]}]}], ",", RowBox[{RowBox[
                          {"data", "\[LeftDoubleBracket]", RowBox[{"All", 
                          ",", RowBox[{"{", RowBox[{"1", ",", "2"}], "}"}]}], 
                          "\[RightDoubleBracket]"}], "/.", 
                          "\[VeryThinSpace]", RowBox[{RowBox[{"{", RowBox[
