         FractionBox[
          RowBox[{
           RowBox[{"coefficientValuesTop", "[", 
            RowBox[{"v", ",", "40"}], "]"}], "-", 
           RowBox[{"coefficientValuesTop", "[", 
            RowBox[{"v", ",", "60"}], "]"}]}], 
          RowBox[{"coefficientValuesTop", "[", 
           RowBox[{"v", ",", "60"}], "]"}]], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"v", ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", "10"], ",", 
         FractionBox["1", "5"], ",", 
         FractionBox["73", "100"], ",", "2", ",", "5"}], "}"}]}], "}"}]}], 
    "]"}]}], ";", 
  RowBox[{"Grid", "[", 
   RowBox[{
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"N", "[", 
       RowBox[{"precisionChecks", ",", "5"}], "]"}], ",", 
