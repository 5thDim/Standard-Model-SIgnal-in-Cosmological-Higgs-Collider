Cell["Angular reconstruction and normalization checks", "Subsection",ExpressionUUID->"5bdb652b-6e53-8c44-88b1-6a90115e549c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"normalizationRatio", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"8", " ", 
       SuperscriptBox[
        RowBox[{"Gamma", "[", 
         RowBox[{
          FractionBox["1", "2"], "-", 
          RowBox[{"\[ImaginaryI]", " ", "nu"}]}], "]"}], "4"], " ", 
       RowBox[{"gTop", "[", "nu", "]"}]}], 
      RowBox[{
       SuperscriptBox[
