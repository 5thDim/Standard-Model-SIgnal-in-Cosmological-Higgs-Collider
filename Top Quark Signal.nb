            "cv", "\[LeftDoubleBracket]", "5", "\[RightDoubleBracket]"}]], 
           "]"}]}], "}"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"v", ",", 
       RowBox[{"{", 
        RowBox[{
