          RowBox[{"q", ",", "prec"}], "]"}]}], ",", 
        RowBox[{"vv", "=", 
         RowBox[{"N", "[", 
          RowBox[{"v", ",", "prec"}], "]"}]}], ",", 
        RowBox[{"kk", "=", 
