                          "\[VeryThinSpace]", RowBox[{RowBox[{"{", RowBox[
                          {"x_", ",", "y_"}], "}"}], "\[RuleDelayed]", 
                          RowBox[{"{", RowBox[{"x", ",", RowBox[{"Abs", "[", 
                          "y", "]"}]}], "}"}]}]}]}], "}"}], ",", RowBox[
                     {"Joined", "\[Rule]", "True"}], ",", RowBox[{"Frame", 
                      "\[Rule]", "True"}], ",", RowBox[{"FrameLabel", 
                      "\[Rule]", RowBox[{"{", RowBox[{StyleBox[
