Cell["\<\
In the displayed I22 expression, gSymbol = Gtop(nu), sAngular = S, bAngular = \
TB and dAngular = TD. The functions above retain the full angles. The next \
check independently evaluates the original shifted Gamma sums, without the \
recurrence reduction.\
\>", "Text",ExpressionUUID->"5e06f952-3d77-9a4e-8e6d-b48931dee849"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"loopNumericChecks", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"direct", ",", "reduced"}], "}"}], ",", 
       RowBox[{
        RowBox[{"direct", "=", 
         RowBox[{"N", "[", 
          RowBox[{
           FractionBox[
            RowBox[{"loopJExpressions", "/.", "\[VeryThinSpace]", 
             RowBox[{
              RowBox[{"jSym", "[", 
               RowBox[{"ell_", ",", "m_"}], "]"}], "\[RuleDelayed]", 
              RowBox[{"jTop", "[", 
               RowBox[{"ell", ",", "m", ",", "1", ",", 
                RowBox[{
                 RowBox[{"-", "\[ImaginaryI]"}], " ", "v"}]}], "]"}]}]}], 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"4", " ", "\[Pi]"}], ")"}], 
             RowBox[{"3", "/", "2"}]]], ",", "50"}], "]"}]}], ";", 
        RowBox[{"reduced", "=", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"gTop", "[", "v", "]"}], " ", 
            RowBox[{"(", 
             RowBox[{"loopRatios", "/.", "\[VeryThinSpace]", 
              RowBox[{"nu", "\[Rule]", "v"}]}], ")"}]}], ",", "50"}], "]"}]}],
         ";", 
        RowBox[{"{", 
         RowBox[{"v", ",", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            FractionBox[
             RowBox[{"direct", "-", "reduced"}], "reduced"], "]"}], "]"}]}], 
         "}"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"v", ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", "5"], ",", 
         FractionBox["73", "100"], ",", "2", ",", "5"}], "}"}]}], "}"}]}], 
    "]"}]}], ";", 
  RowBox[{"Grid", "[", 
   RowBox[{
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"N", "[", 
       RowBox[{"loopNumericChecks", ",", "6"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<mt/H\>\"", 
        ",", "\"\<max relative Gamma-sum residual\>\""}], "}"}]}], "]"}], ",", 
    RowBox[{"Frame", "\[Rule]", "All"}]}], "]"}]}]], "Input",
