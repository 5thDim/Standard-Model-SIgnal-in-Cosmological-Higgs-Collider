Cell[CellGroupData[{

Cell["\<\
A.3. Eliminate parameter derivatives with an explicit three-term identity\
\>", "Subsection",ExpressionUUID->"1b26b94c-78e3-42d2-975a-b86dfe726f69"],

Cell["\<\
Use the following ordinary (not regularized) 3F2 identity, with K defined \
explicitly below: F(1,b,c;d,e)=K(b,c,d,e)+(1-d)/(1+c-d) F(1,c,e-b;2+c-d,e). \
It is the a=1 specialization of the classical three-term transformation, \
followed by Gauss summation of the first term. A source for the general \
identity is Coffey and Lettington, Mellin transforms with only critical \
zeros: Legendre functions, Appendix A, Eq. (A.2), \
https://orca.cardiff.ac.uk/id/eprint/66831/1/Mellin%20transforms%20Legendre%\
20June%202014.pdf . The identity is written here in full, so no external file \
or downloaded rule is required.\
\>", "Text",ExpressionUUID->"17660d08-014c-4096-960d-985a8349825e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f3", "[", 
    RowBox[{"aa_", ",", "bb_", ",", "cc_", ",", "dd_", ",", "ee_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"HypergeometricPFQ", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"aa", ",", "bb", ",", "cc"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"dd", ",", "ee"}], "}"}], ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kConnection", "[", 
   RowBox[{"b_", ",", "c_", ",", "d_", ",", "e_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"Gamma", "[", "d", "]"}], " ", 
   RowBox[{"Gamma", "[", "e", "]"}], " ", 
   RowBox[{"Gamma", "[", 
    RowBox[{"1", "+", "b", "-", "d"}], "]"}], " ", 
   RowBox[{"Gamma", "[", 
    RowBox[{"1", "+", "c", "-", "d"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"Gamma", "[", 
     RowBox[{"d", "+", "e", "-", "b", "-", "c", "-", "1"}], "]"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Gamma", "[", "b", "]"}], " ", 
      RowBox[{"Gamma", "[", "c", "]"}], " ", 
      RowBox[{"Gamma", "[", 
       RowBox[{"e", "-", "b"}], "]"}], " ", 
      RowBox[{"Gamma", "[", 
       RowBox[{"e", "-", "c"}], "]"}]}], ")"}]}], ";"}]}], "\[IndentingNewLine]", 
 RowBox[{"HoldForm", "[", 
  RowBox[{
   RowBox[{"f3", "[", 
    RowBox[{"1", ",", "b", ",", "c", ",", "d", ",", "e"}], "]"}], " ", "==", 
   " ", 
   RowBox[{
    RowBox[{"kConnection", "[", 
     RowBox[{"b", ",", "c", ",", "d", ",", "e"}], "]"}], "+", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "d"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"1", "+", "c", "-", "d"}], ")"}]}], " ", 
     RowBox[{"f3", "[", 
      RowBox[{"1", ",", "c", ",", 
       RowBox[{"e", "-", "b"}], ",", 
       RowBox[{"2", "+", "c", "-", "d"}], ",", "e"}], "]"}]}]}]}], 
  "]"}]}], "Input",
 ShowCellLabel->False,
 CellTags->
  "Top146-8-input",ExpressionUUID->"46e21587-2c7d-44f0-96bb-fa8e90d3918a"],

Cell[BoxData[
 TagBox[
  RowBox[{
   RowBox[{"f3", "[", 
    RowBox[{"1", ",", "b", ",", "c", ",", "d", ",", "e"}], "]"}], "\[Equal]", 
   RowBox[{
    RowBox[{"kConnection", "[", 
     RowBox[{"b", ",", "c", ",", "d", ",", "e"}], "]"}], "+", 
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "d"}], ")"}], " ", 
      RowBox[{"f3", "[", 
       RowBox[{"1", ",", "c", ",", 
        RowBox[{"e", "-", "b"}], ",", 
        RowBox[{"2", "+", "c", "-", "d"}], ",", "e"}], "]"}]}], 
     RowBox[{"1", "+", "c", "-", "d"}]]}]}],
  HoldForm]], "Output",
 ShowCellLabel->False,
 CellTags->
  "Top146-8-output",ExpressionUUID->"d6b54b7e-7748-44a2-8451-ede35fdd41f3"]
}, Open  ]],

Cell["\<\
Apply this identity first to F_minus and F_plus. Both give the SAME \
Gdel=F(1,A,1+u+del;1+del,1+2u+del), with coefficients -del/(2u+del) and \
-(2u+del)/del. Apply it once more to Gdel: Gdel=K_G-del Hdel/(1+u), where \
Hdel=F(1,1+u+del,1-del;2+u,1+2u+del). This last function has no parameter \
pole at del=0 for u=I nu, nu>0. These are exact identities before taking the \
finite part.\
\>", "Text",ExpressionUUID->"8f9a9dd5-79d6-44b3-8562-0639635bd2ae"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"aMaster", "=", 
   RowBox[{
    RowBox[{"2", "u"}], "+", 
    RowBox[{"2", "del"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kMinus", "=", 
   RowBox[{"kConnection", "[", 
    RowBox[{
     RowBox[{"-", "u"}], ",", "aMaster", ",", 
     RowBox[{"1", "+", "del"}], ",", 
     RowBox[{"1", "+", "del"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kPlus", "=", 
   RowBox[{"kConnection", "[", 
    RowBox[{"u", ",", "aMaster", ",", 
     RowBox[{"1", "+", 
      RowBox[{"2", "u"}], "+", "del"}], ",", 
     RowBox[{"1", "+", 
      RowBox[{"2", "u"}], "+", "del"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kG", "=", 
   RowBox[{"kConnection", "[", 
    RowBox[{"aMaster", ",", 
     RowBox[{"1", "+", "u", "+", "del"}], ",", 
     RowBox[{"1", "+", "del"}], ",", 
     RowBox[{"1", "+", 
      RowBox[{"2", "u"}], "+", "del"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fMinus", "=", 
   RowBox[{"f3", "[", 
    RowBox[{"1", ",", "aMaster", ",", 
     RowBox[{"-", "u"}], ",", 
     RowBox[{"1", "+", "del"}], ",", 
     RowBox[{"1", "+", "del"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fPlus", "=", 
   RowBox[{"f3", "[", 
    RowBox[{"1", ",", "aMaster", ",", "u", ",", 
     RowBox[{"1", "+", 
      RowBox[{"2", "u"}], "+", "del"}], ",", 
     RowBox[{"1", "+", 
      RowBox[{"2", "u"}], "+", "del"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gDel", "=", 
   RowBox[{"f3", "[", 
    RowBox[{"1", ",", "aMaster", ",", 
     RowBox[{"1", "+", "u", "+", "del"}], ",", 
     RowBox[{"1", "+", "del"}], ",", 
     RowBox[{"1", "+", 
      RowBox[{"2", "u"}], "+", "del"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hDel", "=", 
   RowBox[{"f3", "[", 
    RowBox[{"1", ",", 
     RowBox[{"1", "+", "u", "+", "del"}], ",", 
     RowBox[{"1", "-", "del"}], ",", 
     RowBox[{"2", "+", "u"}], ",", 
     RowBox[{"1", "+", 
      RowBox[{"2", "u"}], "+", "del"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"connectionRows", "=", 
   RowBox[{"{", "\[IndentingNewLine]", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<F_minus\>\"", ",", 
       RowBox[{"fmt", "[", 
        RowBox[{"kMinus", "-", 
         RowBox[{"del", " ", 
          RowBox[{"gDel", "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "u"}], "+", "del"}], ")"}]}]}]}], "]"}]}], "}"}], ",",
      "\[IndentingNewLine]", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<F_plus\>\"", ",", 
       RowBox[{"fmt", "[", 
        RowBox[{"kPlus", "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "u"}], "+", "del"}], ")"}], " ", 
          RowBox[{"gDel", "/", "del"}]}]}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Gdel\>\"", ",", 
       RowBox[{"fmt", "[", 
        RowBox[{"kG", "-", 
         RowBox[{"del", " ", 
          RowBox[{"hDel", "/", 
           RowBox[{"(", 
            RowBox[{"1", "+", "u"}], ")"}]}]}]}], "]"}]}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{"connectionRows", ",", 
   RowBox[{"Frame", "->", "All"}], ",", 
   RowBox[{"Alignment", "->", "Left"}]}], "]"}]}], "Input",
 ShowCellLabel->False,
 CellTags->
  "Top146-9-input",ExpressionUUID->"1efa57c7-c5f0-414a-859e-460e96ad62df"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"F_minus\"\>", 
     TagBox[
      FormBox[
       RowBox[{
        FractionBox[
         RowBox[{
          SuperscriptBox[
           TemplateBox[{
             RowBox[{"\[Delta]", "+", "1"}]},
            "Gamma"], "2"], " ", 
