Notebook[{

Cell[CellGroupData[{
Cell["Top Quark Signal", "Title",ExpressionUUID->"72df7d78-61d6-6749-b2d1-343d6d0483df"],

Cell["Analytic angular coefficients and mass dependence", "Subtitle",ExpressionUUID->"b68e75b6-bd75-2a4f-b390-eef7d6cf71c0"],

Cell[CellGroupData[{

Cell["1. Conventions and scalar soft-loop seeds", "Section",ExpressionUUID->"a8e15524-4c58-cd4a-b85c-5d7dad7f56c0"],

Cell["\<\
The target is the five complex angular coefficients in SMS in CHC, Eq. (59). \
nu = mt/H > 0. All results below use the positive soft branch and the phase \
convention 16^(2 I nu) in Eq. (58). Nc, gt and the overall momentum/H factors \
in Eq. (57) are excluded. Outputs and native Mathematica plots are saved in \
this notebook; no external files are needed to inspect or reevaluate it. \
Evaluate from the beginning in a fresh kernel.\
\>", "Text",ExpressionUUID->"2b17fb9d-726b-6047-b900-f79b9e641c40"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BeginPackage", "[", "\"\<TopQuarkSignal`\>\"", "]"}], ";", 
  RowBox[{"ClearAll", "[", "\"\<TopQuarkSignal`*\>\"", "]"}], ";"}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"a2a88ac0-81f1-5d4b-a72b-03382bc8ea31"],

Cell[BoxData[
 RowBox[{
  RowBox[{"wp", "=", "50"}], ";", 
  RowBox[{"massMin", "=", 
   FractionBox["1", "10"]}], ";", 
  RowBox[{"massMax", "=", "5"}], ";", 
  RowBox[{"assumptionsTop", "=", 
   RowBox[{"nu", ">", "0"}]}], ";", 
  RowBox[{
   RowBox[{"formTop", "[", "expr_", "]"}], ":=", 
   RowBox[{"TraditionalForm", "@@", 
    RowBox[{"{", "expr", "}"}]}]}], ";", 
  RowBox[{"nu", "/:", 
   RowBox[{"MakeBoxes", "[", 
    RowBox[{"nu", ",", "TraditionalForm"}], "]"}], ":=", "\"\<\[Nu]\>\""}], ";", 
  RowBox[{"pp1", "/:", 
   RowBox[{"MakeBoxes", "[", 
    RowBox[{"pp1", ",", "TraditionalForm"}], "]"}], ":=", 
   RowBox[{"SubscriptBox", "[", 
    RowBox[{"\"\<P\>\"", ",", "\"\<1\>\""}], "]"}]}], ";", 
  RowBox[{"pp2", "/:", 
   RowBox[{"MakeBoxes", "[", 
    RowBox[{"pp2", ",", "TraditionalForm"}], "]"}], ":=", 
   RowBox[{"SubscriptBox", "[", 
    RowBox[{"\"\<P\>\"", ",", "\"\<2\>\""}], "]"}]}], ";", 
  RowBox[{"q00", "/:", 
   RowBox[{"MakeBoxes", "[", 
    RowBox[{"q00", ",", "TraditionalForm"}], "]"}], ":=", 
   RowBox[{"SubscriptBox", "[", 
    RowBox[{"\"\<Q\>\"", ",", "\"\<00\>\""}], "]"}]}], ";", 
  RowBox[{"tGamma", "/:", 
   RowBox[{"MakeBoxes", "[", 
    RowBox[{"tGamma", ",", "TraditionalForm"}], "]"}], ":=", "\"\<T\>\""}], ";", 
  RowBox[{"eEndpoint", "/:", 
   RowBox[{"MakeBoxes", "[", 
    RowBox[{"eEndpoint", ",", "TraditionalForm"}], "]"}], ":=", "\"\<E\>\""}],
   ";", 
  RowBox[{"bb", "/:", 
   RowBox[{"MakeBoxes", "[", 
    RowBox[{"bb", ",", "TraditionalForm"}], "]"}], 
   ":=", "\"\<\[ScriptCapitalB]\>\""}], ";", 
  RowBox[{"gSymbol", "/:", 
   RowBox[{"MakeBoxes", "[", 
    RowBox[{"gSymbol", ",", "TraditionalForm"}], "]"}], 
   ":=", "\"\<\[ScriptCapitalG]\>\""}], ";"}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"bc66223e-a4ba-004a-a536-f5264e073406"],

Cell["\<\
Exact rational constants are retained until numerical evaluation. \
FullSimplify is applied with explicit assumptions and a finite search time; \
its output need not be a unique shortest form. I and D retain their built-in \
Mathematica meanings. softBTop denotes the common factor in Eq. (119); BTop \
denotes the angular coefficient.\
\>", "Text",ExpressionUUID->"ef821329-ebe8-5b4e-b157-3953208f60c9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f0Top", "[", 
    RowBox[{"alpha_", ",", "beta_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"alpha", "+", "beta", "-", 
       FractionBox["3", "2"]}], "]"}], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{
       FractionBox["3", "2"], "-", "alpha"}], "]"}], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{
       FractionBox["3", "2"], "-", "beta"}], "]"}]}], 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"3", "-", "alpha", "-", "beta"}], "]"}], " ", 
     RowBox[{"Gamma", "[", "alpha", "]"}], " ", 
     RowBox[{"Gamma", "[", "beta", "]"}]}]]}], ";", 
  RowBox[{
   RowBox[{"rhoTop", "[", "v_", "]"}], ":=", 
   RowBox[{
    FractionBox["1", "2"], "-", 
    RowBox[{"\[ImaginaryI]", " ", "v"}]}]}], ";", 
  RowBox[{
   RowBox[{"gTop", "[", "v_", "]"}], ":=", 
   FractionBox[
    RowBox[{"f0Top", "[", 
     RowBox[{
      RowBox[{"rhoTop", "[", "v", "]"}], ",", 
      RowBox[{"rhoTop", "[", "v", "]"}]}], "]"}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"4", " ", "\[Pi]"}], ")"}], 
     RowBox[{"3", "/", "2"}]]]}], ";", 
  RowBox[{
   RowBox[{"cPlusTop", "[", "v_", "]"}], ":=", 
   FractionBox[
    RowBox[{
     SuperscriptBox["2", 
      RowBox[{
       RowBox[{"-", "1"}], "-", 
       RowBox[{"2", " ", "\[ImaginaryI]", " ", "v"}]}]], " ", 
     SuperscriptBox[
      RowBox[{"Gamma", "[", 
       RowBox[{
        FractionBox["1", "2"], "-", 
        RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}], "2"]}], "\[Pi]"]}], ";", 
  TagBox[GridBox[{
     {"\"\<rho(nu)\>\"", 
      RowBox[{"formTop", "[", 
       RowBox[{"rhoTop", "[", "nu", "]"}], "]"}]},
     {"\"\<f0(alpha,beta)\>\"", 
      RowBox[{"formTop", "[", 
       RowBox[{"f0Top", "[", 
        RowBox[{"alpha", ",", "beta"}], "]"}], "]"}]},
     {"\"\<c+(nu)\>\"", 
      RowBox[{"formTop", "[", 
       RowBox[{"cPlusTop", "[", "nu", "]"}], "]"}]}
    },
    AutoDelete->False,
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
   "Grid"]}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"61bc0d3b-9caf-bf42-93c4-d114ab8e8ce5"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"rho(nu)\"\>", 
     TagBox[
      FormBox[
       RowBox[{
        FractionBox["1", "2"], "-", 
        RowBox[{"\[ImaginaryI]", " ", "\[Nu]"}]}],
       TraditionalForm],
      TraditionalForm,
      Editable->True]},
    {"\<\"f0(alpha,beta)\"\>", 
     TagBox[
      FormBox[
       FractionBox[
        RowBox[{
         TemplateBox[{
           RowBox[{
             FractionBox["3", "2"], "-", "alpha"}]},
          "Gamma"], " ", 
         TemplateBox[{
           RowBox[{
             FractionBox["3", "2"], "-", "beta"}]},
          "Gamma"], " ", 
         TemplateBox[{
           RowBox[{"alpha", "+", "beta", "-", 
             FractionBox["3", "2"]}]},
          "Gamma"]}], 
        RowBox[{
         TemplateBox[{"alpha"},
          "Gamma"], " ", 
         TemplateBox[{"beta"},
          "Gamma"], " ", 
         TemplateBox[{
           RowBox[{
             RowBox[{"-", "alpha"}], "-", "beta", "+", "3"}]},
          "Gamma"]}]],
       TraditionalForm],
      TraditionalForm,
      Editable->True]},
    {"\<\"c+(nu)\"\>", 
     TagBox[
      FormBox[
       FractionBox[
        RowBox[{
         SuperscriptBox["2", 
          RowBox[{
           RowBox[{"-", "1"}], "-", 
           RowBox[{"2", " ", "\[ImaginaryI]", " ", "\[Nu]"}]}]], " ", 
         SuperscriptBox[
          TemplateBox[{
            RowBox[{
              FractionBox["1", "2"], "-", 
              RowBox[{"\[ImaginaryI]", " ", "\[Nu]"}]}]},
           "Gamma"], "2"]}], "\[Pi]"],
       TraditionalForm],
      TraditionalForm,
      Editable->True]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellChangeTimes->{4.0017244804264774`*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"aa8b2a7f-5ea2-c147-aeb8-99f806ca5d51"]
}, Open  ]],

Cell["\<\
f0 is the analytically continued convolution of Sec. 2.1. Its definition \
excludes (4 Pi)^(3/2). The first saved simplification is the common Gamma \
factor Gtop in Eq. (108).\
\>", "Text",ExpressionUUID->"0b3e8886-4191-6749-80ce-953d7b1b3c74"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"gTopSimp", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"gTop", "[", "nu", "]"}], ",", "assumptionsTop", ",", 
     RowBox[{"TimeConstraint", "\[Rule]", "8"}]}], "]"}]}], ";", 
  RowBox[{"formTop", "[", "gTopSimp", "]"}]}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"51576e6c-c202-9345-b0e3-a420cd8b89fb"],

Cell[BoxData[
 FormBox[
  RowBox[{"-", 
   FractionBox[
    RowBox[{
     SuperscriptBox["2", 
      RowBox[{
       RowBox[{"-", "3"}], "-", 
       RowBox[{"4", " ", "\[ImaginaryI]", " ", "\[Nu]"}]}]], " ", 
     RowBox[{
      SuperscriptBox["cosh", "2"], "(", 
      RowBox[{"\[Pi]", " ", "\[Nu]"}], ")"}], " ", 
     TemplateBox[{
       RowBox[{
         RowBox[{
           RowBox[{"-", "2"}], " ", "\[ImaginaryI]", " ", "\[Nu]"}], "-", 
         FractionBox["1", "2"]}]},
      "Gamma"], " ", 
     TemplateBox[{
       RowBox[{
         RowBox[{"2", " ", "\[ImaginaryI]", " ", "\[Nu]"}], "+", "2"}]},
      "Gamma"]}], 
    RowBox[{
     SuperscriptBox["\[Pi]", 
      RowBox[{"5", "/", "2"}]], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"2", " ", "\[Nu]"}]}], "+", "\[ImaginaryI]"}], ")"}], 
      "2"]}]]}], TraditionalForm]], "Output",
 CellChangeTimes->{4.0017244872089844`*^9},
 CellLabel->
  "Out[4]//TraditionalForm=",ExpressionUUID->"4834e9a5-1072-764b-989f-\
02f41d49d9ca"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gTopPaper", "[", "v_", "]"}], ":=", 
   FractionBox[
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], "-", 
       RowBox[{"2", " ", "\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
     SuperscriptBox[
      RowBox[{"Gamma", "[", 
       RowBox[{"1", "+", 
        RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}], "2"]}], 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"4", " ", "\[Pi]"}], ")"}], 
      RowBox[{"3", "/", "2"}]], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{"2", "+", 
       RowBox[{"2", " ", "\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
     SuperscriptBox[
      RowBox[{"Gamma", "[", 
       RowBox[{
        FractionBox["1", "2"], "-", 
        RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}], "2"]}]]}], ";", 
  RowBox[{"softGammaCheck", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"gTop", "[", "nu", "]"}], "-", 
      RowBox[{"gTopPaper", "[", "nu", "]"}]}], ",", "assumptionsTop"}], 
    "]"}]}], ";", "softGammaCheck"}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"62a1e01e-8f41-7c48-a794-f117747f7a09"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{4.0017245148282013`*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"4848a2d4-fb95-0c43-b4f3-75fd2ae85ecb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Scalar moments and Gamma recurrence", "Subsection",ExpressionUUID->"ee85f8ad-3df1-6e44-99f0-94b2d5f8966d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"frTop", "[", 
    RowBox[{"ell_Integer", ",", "alpha_", ",", "beta_"}], "]"}], ":=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"u", "=", "0"}], "ell"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"v", "=", "0"}], 
      RowBox[{"ell", "-", "u"}]], 
     FractionBox[
      RowBox[{
       RowBox[{"ell", "!"}], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{"ell", "-", "u"}]], " ", 
       RowBox[{"f0Top", "[", 
        RowBox[{
         RowBox[{"alpha", "+", 
          FractionBox["ell", "2"], "-", "v"}], ",", 
         RowBox[{"beta", "-", "u"}]}], "]"}]}], 
      RowBox[{
       SuperscriptBox["2", "ell"], " ", 
       RowBox[{"u", "!"}], " ", 
       RowBox[{"v", "!"}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"ell", "-", "u", "-", "v"}], ")"}], "!"}]}]]}]}]}], ";", 
  RowBox[{
   RowBox[{"jTop", "[", 
    RowBox[{"ell_Integer", ",", "m_Integer", ",", "n_Integer", ",", "x_"}], 
    "]"}], ":=", 
   RowBox[{"frTop", "[", 
    RowBox[{"ell", ",", 
     RowBox[{"x", "-", 
      FractionBox["m", "2"]}], ",", 
     RowBox[{"x", "+", 
      FractionBox["n", "2"]}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"shiftRatioTop", "[", 
    RowBox[{"j_Integer", ",", "k_Integer", ",", "rho_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{
     RowBox[{"Pochhammer", "[", 
      RowBox[{
       RowBox[{
        FractionBox["3", "2"], "-", "rho"}], ",", "j"}], "]"}], " ", 
     RowBox[{"Pochhammer", "[", 
      RowBox[{
       RowBox[{
        FractionBox["3", "2"], "-", "rho"}], ",", "k"}], "]"}], " ", 
     RowBox[{"Pochhammer", "[", 
      RowBox[{
       RowBox[{"1", "-", "rho"}], ",", "j"}], "]"}], " ", 
     RowBox[{"Pochhammer", "[", 
      RowBox[{
       RowBox[{"1", "-", "rho"}], ",", "k"}], "]"}]}], 
    RowBox[{
     RowBox[{"Pochhammer", "[", 
      RowBox[{
       RowBox[{
        FractionBox["5", "2"], "-", 
        RowBox[{"2", " ", "rho"}]}], ",", 
       RowBox[{"j", "+", "k"}]}], "]"}], " ", 
     RowBox[{"Pochhammer", "[", 
      RowBox[{
       RowBox[{"3", "-", 
        RowBox[{"2", " ", "rho"}]}], ",", 
       RowBox[{"j", "+", "k"}]}], "]"}]}]]}], ";", 
  RowBox[{
   RowBox[{"jRatioTop", "[", 
    RowBox[{"ell_Integer", ",", "m_Integer", ",", "v_"}], "]"}], ":=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"u", "=", "0"}], "ell"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"w", "=", "0"}], 
      RowBox[{"ell", "-", "u"}]], 
     FractionBox[
      RowBox[{
       RowBox[{"ell", "!"}], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{"ell", "-", "u"}]], " ", 
       RowBox[{"shiftRatioTop", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"m", "+", "1", "-", "ell"}], ")"}]}], "+", "w"}], ",", 
         "u", ",", 
         RowBox[{"rhoTop", "[", "v", "]"}]}], "]"}]}], 
      RowBox[{
       SuperscriptBox["2", "ell"], " ", 
       RowBox[{"u", "!"}], " ", 
       RowBox[{"w", "!"}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"ell", "-", "u", "-", "w"}], ")"}], "!"}]}]]}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"2898eb5a-a6a9-b748-9b5e-1dcaa848eadc"],

Cell["\<\
shiftRatioTop(j,k,rho) = f0(rho-j,rho-k)/f0(rho,rho), obtained by Gamma \
recurrence. jRatioTop is J_ell(m,1;-I nu)/f0(rho,rho) for the integer shifts \
used below. This extracts the common Gamma factor before FullSimplify, \
leaving rational algebra.\
\>", "Text",ExpressionUUID->"dba2c00a-5032-d343-8d6c-856fab5a0c16"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Soft-loop coefficients I11, I12, I21 and I22", "Section",ExpressionUUID->"1ca699ea-648a-ae4e-bac8-69440f950270"],

Cell["\<\
Eq. (107) is reduced in the basis {1, S, TB, TD}, where S = cos(theta1)^2 + \
cos(theta3)^2 - 3 cos(theta1)^2 cos(theta3)^2, TB = sin(2 theta1) sin(2 \
theta3) cos(phi3), TD = sin(theta1)^2 sin(theta3)^2 cos(2 phi3). The \
following five entries are I12 and the four components of I22, divided by \
Gtop.\
\>", "Text",ExpressionUUID->"a3473308-1200-3141-b545-f86a0a70aa0e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"loopJExpressions", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"jSym", "[", 
          RowBox[{"0", ",", "3"}], "]"}], "-", 
         RowBox[{"jSym", "[", 
          RowBox[{"2", ",", "3"}], "]"}], "+", 
         RowBox[{"jSym", "[", 
          RowBox[{"1", ",", "2"}], "]"}], "-", 
         RowBox[{"jSym", "[", 
          RowBox[{"3", ",", "2"}], "]"}]}], ")"}]}], "+", 
      RowBox[{
       FractionBox["1", "4"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"jSym", "[", 
          RowBox[{"0", ",", "1"}], "]"}], "-", 
         RowBox[{"jSym", "[", 
          RowBox[{"2", ",", "1"}], "]"}]}], ")"}]}]}], ",", 
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"4", ",", "3"}], "]"}]}], "-", 
        RowBox[{"3", " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"2", ",", "3"}], "]"}]}], "+", 
        RowBox[{"jSym", "[", 
         RowBox[{"0", ",", "3"}], "]"}], "+", 
        RowBox[{"jSym", "[", 
         RowBox[{"3", ",", "2"}], "]"}], "-", 
        RowBox[{"jSym", "[", 
         RowBox[{"1", ",", "2"}], "]"}]}], ")"}]}], ",", 
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "6"}], " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"4", ",", "3"}], "]"}]}], "+", 
        RowBox[{"7", " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"2", ",", "3"}], "]"}]}], "-", 
        RowBox[{"jSym", "[", 
         RowBox[{"0", ",", "3"}], "]"}], "+", 
        RowBox[{"5", " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"1", ",", "2"}], "]"}]}], "-", 
        RowBox[{"5", " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"3", ",", "2"}], "]"}]}], "+", 
        RowBox[{"jSym", "[", 
         RowBox[{"0", ",", "1"}], "]"}], "-", 
        RowBox[{"jSym", "[", 
         RowBox[{"2", ",", "1"}], "]"}]}], ")"}]}], ",", 
     RowBox[{
      FractionBox["1", "16"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "16"}], " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"4", ",", "3"}], "]"}]}], "+", 
        RowBox[{"14", " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"2", ",", "3"}], "]"}]}], "-", 
        RowBox[{"2", " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"0", ",", "3"}], "]"}]}], "+", 
        RowBox[{"10", " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"1", ",", "2"}], "]"}]}], "-", 
        RowBox[{"18", " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"3", ",", "2"}], "]"}]}], "+", 
        RowBox[{"2", " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"0", ",", "1"}], "]"}]}], "-", 
        RowBox[{"7", " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"2", ",", "1"}], "]"}]}], "-", 
        RowBox[{"jSym", "[", 
         RowBox[{"1", ",", "0"}], "]"}]}], ")"}]}], ",", 
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"jSym", "[", 
         RowBox[{"4", ",", "3"}], "]"}], "-", 
        RowBox[{"jSym", "[", 
         RowBox[{"2", ",", "3"}], "]"}], "+", 
        RowBox[{"jSym", "[", 
