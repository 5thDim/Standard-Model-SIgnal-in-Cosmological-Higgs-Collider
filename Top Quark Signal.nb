Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"cFromLoopTop", "[", 
    RowBox[{"v_", ",", "t1_", ",", "t3_", ",", "ph_", ",", 
     RowBox[{"prec_Integer", ":", "50"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pv", "=", 
       RowBox[{"hardValuesTop", "[", 
        RowBox[{"v", ",", "prec"}], "]"}]}], "}"}], ",", 
     RowBox[{"N", "[", 
      RowBox[{
       FractionBox[
        RowBox[{"8", " ", 
         SuperscriptBox[
          RowBox[{"Gamma", "[", 
           RowBox[{
            FractionBox["1", "2"], "-", 
            RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}], "4"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"3", " ", 
               SuperscriptBox[
                RowBox[{
                "pv", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
                "2"]}], "+", 
              RowBox[{"2", " ", 
               RowBox[{
               "pv", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], " ", 
               RowBox[{
               "pv", "\[LeftDoubleBracket]", "2", 
                "\[RightDoubleBracket]"}]}]}], ")"}], " ", 
            RowBox[{"i12Top", "[", "v", "]"}]}], "+", 
           RowBox[{
            SuperscriptBox[
             RowBox[{
             "pv", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
             "2"], " ", 
            RowBox[{"i22Top", "[", 
             RowBox[{"v", ",", "t1", ",", "t3", ",", "ph"}], "]"}]}]}], 
          ")"}]}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"4", " ", "\[Pi]"}], ")"}], 
         RowBox[{"7", "/", "2"}]]], ",", "prec"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"angularNumericChecks", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"cv", "=", 
          RowBox[{"coefficientValuesTop", "[", 
           RowBox[{"v", ",", "50"}], "]"}]}], ",", "reconstructed", ",", 
         "projectedB", ",", "projectedD"}], "}"}], ",", 
       RowBox[{
        RowBox[{"reconstructed", "=", 
         RowBox[{"cv", ".", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"Cos", "[", 
               FractionBox["2", "5"], "]"}], "2"], "+", 
             SuperscriptBox[
              RowBox[{"Cos", "[", 
               FractionBox["7", "10"], "]"}], "2"]}], ",", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"Cos", "[", 
               FractionBox["2", "5"], "]"}], "2"], " ", 
             SuperscriptBox[
              RowBox[{"Cos", "[", 
               FractionBox["7", "10"], "]"}], "2"]}], ",", 
            RowBox[{
             RowBox[{"Sin", "[", 
              FractionBox["4", "5"], "]"}], " ", 
             RowBox[{"Sin", "[", 
              FractionBox["7", "5"], "]"}], " ", 
             RowBox[{"Cos", "[", 
              FractionBox["9", "10"], "]"}]}], ",", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"Sin", "[", 
               FractionBox["2", "5"], "]"}], "2"], " ", 
             SuperscriptBox[
              RowBox[{"Sin", "[", 
               FractionBox["7", "10"], "]"}], "2"], " ", 
             RowBox[{"Cos", "[", 
              FractionBox["9", "5"], "]"}]}]}], "}"}]}]}], ";", 
        RowBox[{"projectedB", "=", 
         RowBox[{
          FractionBox["1", "2"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"cFromLoopTop", "[", 
             RowBox[{"v", ",", 
              FractionBox["\[Pi]", "4"], ",", 
              FractionBox["\[Pi]", "4"], ",", "0"}], "]"}], "-", 
            RowBox[{"cFromLoopTop", "[", 
             RowBox[{"v", ",", 
              FractionBox["\[Pi]", "4"], ",", 
              FractionBox["\[Pi]", "4"], ",", "\[Pi]"}], "]"}]}], ")"}]}]}], ";", 
        RowBox[{"projectedD", "=", 
         RowBox[{
          FractionBox["1", "2"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"cFromLoopTop", "[", 
             RowBox[{"v", ",", 
              FractionBox["\[Pi]", "2"], ",", 
              FractionBox["\[Pi]", "2"], ",", "0"}], "]"}], "-", 
            RowBox[{"cFromLoopTop", "[", 
             RowBox[{"v", ",", 
              FractionBox["\[Pi]", "2"], ",", 
              FractionBox["\[Pi]", "2"], ",", 
              FractionBox["\[Pi]", "2"]}], "]"}]}], ")"}]}]}], ";", 
        RowBox[{"{", 
         RowBox[{"v", ",", 
          RowBox[{"Abs", "[", 
           FractionBox[
            RowBox[{
             RowBox[{"cFromLoopTop", "[", 
              RowBox[{"v", ",", 
               FractionBox["2", "5"], ",", 
               FractionBox["7", "10"], ",", 
               FractionBox["9", "10"]}], "]"}], "-", "reconstructed"}], 
            "reconstructed"], "]"}], ",", 
          RowBox[{"Abs", "[", 
           FractionBox[
            RowBox[{"projectedB", "-", 
             RowBox[{
             "cv", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}]}], 
            RowBox[{
            "cv", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}]], 
           "]"}], ",", 
          RowBox[{"Abs", "[", 
           FractionBox[
            RowBox[{"projectedD", "-", 
             RowBox[{
             "cv", "\[LeftDoubleBracket]", "5", "\[RightDoubleBracket]"}]}], 
            RowBox[{
            "cv", "\[LeftDoubleBracket]", "5", "\[RightDoubleBracket]"}]], 
           "]"}]}], "}"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"v", ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", "5"], ",", 
         FractionBox["73", "100"], ",", "2"}], "}"}]}], "}"}]}], "]"}]}], ";", 
  RowBox[{"Grid", "[", 
   RowBox[{
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"N", "[", 
       RowBox[{"angularNumericChecks", ",", "5"}], "]"}], ",", 
