Cell[CellGroupData[{

Cell["3. Whittaker seeds and regulated hard integrals", "Section",ExpressionUUID->"48712535-7289-7b45-9b5f-6bc0b702e0e9"],

Cell["\<\
Eqs. (112)-(118). kappa = +/-1/2, a,b = +/-1. kOppTop and kSameTop use the \
regularized 3F2; this differs from the ordinary 3F2 used later in QTop. The \
integral definition fixes all phases. The finite part is taken only after the \
full SK and kappa combinations have been assembled.\
\>", "Text",ExpressionUUID->"056787cd-3b04-fd42-8e22-bcc4bf8b594b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"kOppTop", "[", 
    RowBox[{"a_", ",", "p_", ",", "q_", ",", "v_", ",", "kap_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"-", "\[ImaginaryI]"}], ")"}], " ", "a", " ", "\[Pi]", " ", 
        RowBox[{"(", 
         RowBox[{"p", "-", "q"}], ")"}]}], "+", 
       RowBox[{"\[ImaginaryI]", " ", "\[Pi]", " ", "kap"}]}], "]"}], " ", 
     SuperscriptBox["2", 
      RowBox[{
       RowBox[{"-", "3"}], "-", "p", "-", "q"}]], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{
       FractionBox["3", "2"], "+", "p", "-", 
       RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{
       FractionBox["3", "2"], "+", "p", "+", 
       RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{
       FractionBox["3", "2"], "+", "q", "-", 
       RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{
       FractionBox["3", "2"], "+", "q", "+", 
       RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}]}], 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"2", "+", "p", "+", 
       RowBox[{"a", " ", "kap"}]}], "]"}], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{"2", "+", "q", "-", 
       RowBox[{"a", " ", "kap"}]}], "]"}]}]]}], ";", 
  RowBox[{
   RowBox[{"kSameTop", "[", 
    RowBox[{"a_", ",", "p_", ",", "q_", ",", "v_", ",", "kap_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "a"}], " ", "\[ImaginaryI]", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"-", "\[ImaginaryI]"}], ")"}], " ", "a", " ", "\[Pi]", " ", 
      RowBox[{"(", 
       RowBox[{"p", "+", "q"}], ")"}]}], "]"}], " ", 
    SuperscriptBox["2", 
     RowBox[{
      RowBox[{"-", "3"}], "-", "p", "-", "q"}]], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{
      FractionBox["3", "2"], "+", "p", "+", 
      RowBox[{"a", " ", "\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{
      FractionBox["3", "2"], "+", "q", "+", 
      RowBox[{"a", " ", "\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"2", " ", "\[ImaginaryI]", " ", "\[Pi]", " ", "kap"}], 
           "]"}], "+", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "2"}], " ", "\[Pi]", " ", "v"}], "]"}]}], ")"}], " ", 
        RowBox[{"Gamma", "[", 
         RowBox[{
          FractionBox["3", "2"], "+", "p", "-", 
          RowBox[{"a", " ", "\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
        RowBox[{"Gamma", "[", 
         RowBox[{
          FractionBox["3", "2"], "+", "q", "-", 
          RowBox[{"a", " ", "\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
        RowBox[{"Gamma", "[", 
         RowBox[{
          FractionBox["1", "2"], "+", 
          RowBox[{"a", " ", "kap"}], "-", 
          RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
        RowBox[{"Gamma", "[", 
         RowBox[{
          FractionBox["1", "2"], "+", 
          RowBox[{"a", " ", "kap"}], "+", 
          RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}]}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", " ", "\[Pi]"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Gamma", "[", 
           RowBox[{"2", "+", "p", "+", 
            RowBox[{"a", " ", "kap"}]}], "]"}], " ", 
          RowBox[{"Gamma", "[", 
           RowBox[{"2", "+", "q", "+", 
            RowBox[{"a", " ", "kap"}]}], "]"}]}], ")"}]}]], "+", 
      RowBox[{"a", " ", "\[ImaginaryI]", " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{"3", "+", "p", "+", "q"}], "]"}], " ", 
       RowBox[{"HypergeometricPFQRegularized", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"3", "+", "p", "+", "q"}], ",", 
           RowBox[{
            FractionBox["1", "2"], "-", 
            RowBox[{"a", " ", "kap"}], "+", 
            RowBox[{"a", " ", "\[ImaginaryI]", " ", "v"}]}], ",", "1"}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            FractionBox["5", "2"], "+", "p", "+", 
            RowBox[{"a", " ", "\[ImaginaryI]", " ", "v"}]}], ",", 
           RowBox[{
            FractionBox["5", "2"], "+", "q", "+", 
            RowBox[{"a", " ", "\[ImaginaryI]", " ", "v"}]}]}], "}"}], ",", 
         "1"}], "]"}]}]}], ")"}]}]}], ";", 
  RowBox[{
   RowBox[{"kSeedTop", "[", 
    RowBox[{"a_", ",", "b_", ",", "p_", ",", "q_", ",", "v_", ",", "kap_"}], 
    "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"a", "\[Equal]", "b"}], ",", 
     RowBox[{"kSameTop", "[", 
      RowBox[{"a", ",", "p", ",", "q", ",", "v", ",", "kap"}], "]"}], ",", 
     RowBox[{"kOppTop", "[", 
      RowBox[{"a", ",", "p", ",", "q", ",", "v", ",", "kap"}], "]"}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"31ef2898-5a60-dd47-8748-13e3ba0e0a76"],

Cell["\<\
The symbolic H0 and H1 definitions below retain KTop(a,b,kappa,p,q,r,nu) as \
an unevaluated seed at u=2r/(1+r). At r=1 it is kSeedTop. For the radial \
derivative, Eq. (117) shifts p or q; the explicit powers of r and the (a +/- \
r)/r factors must also be differentiated.\
\>", "Text",ExpressionUUID->"8faf3b36-4f8e-fe42-937e-6167aedcd9fd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"h0FormalTop", "[", 
    RowBox[{"q1_", ",", "q2_", ",", "r_", ",", "v_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{"-", "\[ImaginaryI]"}], ")"}], " ", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"p", "=", 
           RowBox[{"q1", "-", 
            FractionBox["3", "2"], "+", "m"}]}], ",", 
          RowBox[{"q", "=", 
           RowBox[{"q2", "-", 
            FractionBox["3", "2"], "+", "n"}]}]}], "}"}], ",", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[ImaginaryI]", " ", "a"}], ")"}], "m"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[ImaginaryI]", " ", "b"}], ")"}], "n"], " ", 
         SuperscriptBox["r", 
          RowBox[{
           RowBox[{"-", "3"}], "-", "p", "-", "q"}]], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"p", "+", 
              FractionBox["3", "2"], "+", 
              RowBox[{"\[ImaginaryI]", " ", "v"}]}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"KTop", "[", 
               RowBox[{"a", ",", "b", ",", 
                RowBox[{"-", 
                 FractionBox["1", "2"]}], ",", "p", ",", "q", ",", "r", ",", 
                "v"}], "]"}], "-", 
              RowBox[{"KTop", "[", 
               RowBox[{"a", ",", "b", ",", 
                FractionBox["1", "2"], ",", "p", ",", "q", ",", "r", ",", 
                "v"}], "]"}]}], ")"}]}], "+", 
           FractionBox[
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"(", 
              RowBox[{"a", "-", "r"}], ")"}], " ", 
             RowBox[{"KTop", "[", 
              RowBox[{"a", ",", "b", ",", 
               FractionBox["1", "2"], ",", 
               RowBox[{"p", "+", "1"}], ",", "q", ",", "r", ",", "v"}], 
              "]"}]}], "r"], "-", 
           FractionBox[
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"(", 
              RowBox[{"a", "+", "r"}], ")"}], " ", 
             RowBox[{"KTop", "[", 
              RowBox[{"a", ",", "b", ",", 
               RowBox[{"-", 
                FractionBox["1", "2"]}], ",", 
               RowBox[{"p", "+", "1"}], ",", "q", ",", "r", ",", "v"}], 
              "]"}]}], "r"]}], ")"}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"b", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], ";", 
  RowBox[{
   RowBox[{"h1FormalTop", "[", 
    RowBox[{"q1_", ",", "q2_", ",", "r_", ",", "v_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{"-", "\[ImaginaryI]"}], ")"}], " ", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"p", "=", 
           RowBox[{"q1", "-", 
            FractionBox["3", "2"], "+", "m"}]}], ",", 
          RowBox[{"q", "=", 
           RowBox[{"q2", "-", 
            FractionBox["3", "2"], "+", "n"}]}]}], "}"}], ",", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[ImaginaryI]", " ", "a"}], ")"}], "m"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[ImaginaryI]", " ", "b"}], ")"}], "n"], " ", 
         SuperscriptBox["r", 
          RowBox[{
           RowBox[{"-", "3"}], "-", "p", "-", "q"}]], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"p", "+", 
              FractionBox["3", "2"], "-", 
              RowBox[{"\[ImaginaryI]", " ", "v"}]}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"KTop", "[", 
               RowBox[{"a", ",", "b", ",", 
                RowBox[{"-", 
                 FractionBox["1", "2"]}], ",", "p", ",", "q", ",", "r", ",", 
                "v"}], "]"}], "+", 
              RowBox[{"KTop", "[", 
               RowBox[{"a", ",", "b", ",", 
                FractionBox["1", "2"], ",", "p", ",", "q", ",", "r", ",", 
                "v"}], "]"}]}], ")"}]}], "-", 
           FractionBox[
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"(", 
              RowBox[{"a", "-", "r"}], ")"}], " ", 
             RowBox[{"KTop", "[", 
              RowBox[{"a", ",", "b", ",", 
               FractionBox["1", "2"], ",", 
               RowBox[{"p", "+", "1"}], ",", "q", ",", "r", ",", "v"}], 
              "]"}]}], "r"], "-", 
           FractionBox[
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"(", 
              RowBox[{"a", "+", "r"}], ")"}], " ", 
             RowBox[{"KTop", "[", 
              RowBox[{"a", ",", "b", ",", 
               RowBox[{"-", 
                FractionBox["1", "2"]}], ",", 
               RowBox[{"p", "+", "1"}], ",", "q", ",", "r", ",", "v"}], 
              "]"}]}], "r"]}], ")"}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"b", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], ";", 
  TagBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"P1", "[", "nu", "]"}], "\[Equal]", 
      RowBox[{"FinitePart", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"H0", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", 
           RowBox[{
            RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", "1", ",",
            "nu"}], "]"}], "+", 
         FractionBox[
          RowBox[{"2", " ", "\[ImaginaryI]", " ", 
           RowBox[{"H1", "[", 
            RowBox[{
             RowBox[{"1", "+", 
              RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", 
             RowBox[{
              RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", "1", 
             ",", "nu"}], "]"}]}], 
          RowBox[{"1", "+", 
           RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]}]]}], ",", "delta", 
        ",", "0"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"P2", "[", "nu", "]"}], "\[Equal]", 
      RowBox[{"FinitePart", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           SubscriptBox["\[PartialD]", "r"], 
           RowBox[{"H0", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", 
             RowBox[{
              RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", "r", 
             ",", "nu"}], "]"}]}], "-", 
          RowBox[{"H0", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", 
            RowBox[{
             RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", "r", ",",
             "nu"}], "]"}]}], "/.", "\[VeryThinSpace]", 
         RowBox[{"r", "\[Rule]", "1"}]}], ",", "delta", ",", "0"}], "]"}]}]}],
     "}"}],
   HoldForm]}]], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"a020b321-c08f-6f47-9e7b-2381a142ea50"],

Cell[BoxData[
 TagBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"P1", "[", "nu", "]"}], "\[Equal]", 
     RowBox[{"FinitePart", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"H0", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", 
          RowBox[{
           RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", "1", ",",
           "nu"}], "]"}], "+", 
        FractionBox[
         RowBox[{"2", " ", "\[ImaginaryI]", " ", 
          RowBox[{"H1", "[", 
           RowBox[{
            RowBox[{"1", "+", 
             RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", 
            RowBox[{
             RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", "1", ",",
             "nu"}], "]"}]}], 
         RowBox[{"1", "+", 
          RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]}]]}], ",", "delta", ",",
        "0"}], "]"}]}], ",", 
    RowBox[{
     RowBox[{"P2", "[", "nu", "]"}], "\[Equal]", 
     RowBox[{"FinitePart", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          SubscriptBox["\[PartialD]", "r"], 
          RowBox[{"H0", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", 
            RowBox[{
             RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", "r", ",",
             "nu"}], "]"}]}], "-", 
         RowBox[{"H0", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", 
           RowBox[{
            RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", "r", ",",
            "nu"}], "]"}]}], "/.", "\[VeryThinSpace]", 
        RowBox[{"r", "\[Rule]", "1"}]}], ",", "delta", ",", "0"}], "]"}]}]}], 
   "}"}],
  HoldForm]], "Output",
 CellChangeTimes->{4.0017246058177433`*^9},
