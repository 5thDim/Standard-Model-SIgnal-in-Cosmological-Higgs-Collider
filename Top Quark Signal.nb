          RowBox[{"All", ",", "2"}], "\[RightDoubleBracket]"}], "]"}], "<", 
        FractionBox["1", 
         SuperscriptBox["10", "35"]]}], "]"}]}], ",", 
     RowBox[{"\"\<Numerical angular coefficients\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{
