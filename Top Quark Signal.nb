Cell[CellGroupData[{

Cell["A.6. Obtain Eq. (148) and compare exactly with the PDF", "Subsection",ExpressionUUID->"2cd74cc0-b11b-42ea-b84b-1741dc227326"],

Cell["\<\
The Gamma endpoint contribution becomes Gamma[1+2u] Cos[Pi u] Et times \
{1,-(1+2u)}, where Et=Pi^2 Gamma[1+2u]/(Cos[Pi u] Gamma[1+u]^2). The \
remaining H0 and certificate-boundary terms give Ft and the rational terms. \
Only at this final comparison are the target expressions from Eq. (148) \
entered.\
\>", "Text",ExpressionUUID->"4d214708-ca36-4d1e-ae43-247589d3fd5e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"commonPaper", "=", 
   RowBox[{
    RowBox[{"Gamma", "[", 
     RowBox[{"1", "+", 
      RowBox[{"2", "u"}]}], "]"}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"w", "+", 
       RowBox[{"1", "/", "w"}]}], ")"}], "/", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
