  Cell["Mass scan (no plot)", "Subsection"], 
  Cell[BoxData[RowBox[{RowBox[{"workingPrecision", "=", "60"}], ";", "\n", 
      RowBox[{"regulatorScale", "=", FractionBox["1", "1000"]}], ";", "\n", 
      RowBox[{"massMin", "=", FractionBox["1", "10"]}], ";", "\n", 
      RowBox[{"massMax", "=", "10"}], ";", "\n", 
      RowBox[{"massIntervals", "=", "80"}], ";", "\n", 
      RowBox[{"massGrid", "=", RowBox[{"N", "[", 
          RowBox[{RowBox[{"Subdivide", "[", RowBox[{"massMin", ",", 
                "massMax", ",", "massIntervals"}], "]"}], ",", 
            "workingPrecision"}], "]"}]}], ";", "\n", 
      RowBox[{"massData", "=", RowBox[{"massDependenceTable", "[", 
          RowBox[{"massGrid", ",", "workingPrecision", ",", 
            "regulatorScale"}], "]"}]}], ";", "\n", 
      TagBox[RowBox[{"Take", "[", RowBox[{"massData", ",", 
