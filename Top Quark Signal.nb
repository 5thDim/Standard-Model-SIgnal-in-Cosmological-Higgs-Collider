Cell[CellGroupData[{

Cell["Appendix: explicit derivation of Eqs. (146)\[Dash](148)", "Section",
 CellTags->
  "Top146-appendix",ExpressionUUID->"98eeb0b7-dd91-4dcd-8fba-d1c16ff0278b"],

Cell["\<\
This appendix starts from the Whittaker seeds and the complete regulated SK \
sum in the current SMS in CHC.pdf, Eqs. (141)\[Dash](146). It derives the \
finite part without using h0Template, h1Template, p1Template, p2Template, or \
the Qmn finite-part ansatz. All definitions and evaluated outputs are \
included below. Evaluate this appendix from its first Input cell; it is \
self-contained and uses an isolated context. Here nu denotes the paper\
\[CloseCurlyQuote]s tilde-nu > 0, u = I nu, and del denotes delta. \
Intermediate identities are meromorphic continuations in their parameters.\
\>", "Text",ExpressionUUID->"020801a0-414b-4e5c-a5d0-d6e409f84c7e"],

Cell[BoxData[
 RowBox[{"BeginPackage", "[", "\"\<Top146Appendix`\>\"", "]", ";", " ", 
  "Begin", "[", "\"\<`Private`\>\"", "]", ";", " ", "ClearAll", 
  "[", "\"\<Top146Appendix`Private`*\>\"", "]", ";"}]], "Input",
 ShowCellLabel->False,
 CellTags->
  "Top146-1-input",ExpressionUUID->"96ca6bf1-9bfa-46a4-8e5a-2ae31196423a"],

