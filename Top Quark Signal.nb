          RowBox[{
           RowBox[{"topAngularFullySubstituted", "/.", "\[VeryThinSpace]", 
            RowBox[{"nu", "\[Rule]", "vv"}]}], ",", "45"}], "]"}]}], ";", 
        RowBox[{"cold", "=", 
         RowBox[{"coefficientValuesTop", "[", 
          RowBox[{"v", ",", "50"}], "]"}]}], ";", 
        RowBox[{"{", 
         RowBox[{"v", ",", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            FractionBox[
             RowBox[{"pnew", "-", "pold"}], "pold"], "]"}], "]"}], ",", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            FractionBox[
             RowBox[{"cnew", "-", "cold"}], "cold"], "]"}], "]"}], ",", 
          RowBox[{"Abs", "[", 
           FractionBox[
            RowBox[{
             RowBox[{"topNPaper", "[", "vv", "]"}], "-", 
             RowBox[{
              RowBox[{"softBTop", "[", "vv", "]"}], " ", 
              SuperscriptBox[
               RowBox[{"topTPaper", "[", "vv", "]"}], "2"]}]}], 
            RowBox[{"topNPaper", "[", "vv", "]"}]], "]"}]}], "}"}]}]}], "]"}],
      ",", 
     RowBox[{"{", 
      RowBox[{"v", ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", "10"], ",", 
         FractionBox["1", "5"], ",", 
         FractionBox["73", "100"], ",", "1", ",", "2", ",", "5"}], "}"}]}], 
      "}"}]}], "]"}]}], ";", 
  RowBox[{"topExplicitValidation", "=", 
