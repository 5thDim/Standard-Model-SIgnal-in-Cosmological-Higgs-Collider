Cell["\<\
Because Gamma[del](exp[I Pi del]-1)=Gamma[1+del](exp[I Pi del]-1)/del, the \
combined expression is regular at del=0. Its potentially singular scalar \
factor has Laurent coefficients {0,0,-Pi^2} at orders {-2,-1,0}. The finite \
part in Eq. (146) is therefore the ordinary limit of the COMBINED SK \
expression, although individual seed terms have poles.\
\>", "Text",ExpressionUUID->"d18a7aa9-5d36-45de-8865-cd035f3862c6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"poleScalar", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Gamma", "[", "del", "]"}], "^", "2"}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", "Pi", " ", "del"}], "]"}], "-", "1"}], ")"}], "^", 
     "2"}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], " ", "Pi", " ", "del"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"poleScalarCoefficients", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"SeriesCoefficient", "[", 
      RowBox[{"poleScalar", ",", 
       RowBox[{"{", 
        RowBox[{"del", ",", "0", ",", "j"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", 
       RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"finiteComponents", "=", 
   RowBox[{"{", "\[IndentingNewLine]", " ", 
    RowBox[{
     RowBox[{"Factor", " ", "/@", " ", 
      RowBox[{"Together", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Pi", "^", "2"}]}], " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Gamma", "[", 
           RowBox[{"2", "u"}], "]"}], "^", "2"}], "/", 
         RowBox[{
          RowBox[{"Gamma", "[", "u", "]"}], "^", "2"}]}], 
        RowBox[{"(", 
         RowBox[{"regularFactor", "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"del", "->", "0"}], ",", 
            RowBox[{"t", "->", "1"}]}], "}"}]}], ")"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", " ", 
     RowBox[{"Factor", " ", "/@", " ", 
      RowBox[{"Together", "[", 
       RowBox[{
        RowBox[{"Gamma", "[", 
         RowBox[{"2", "u"}], "]"}], 
        RowBox[{"(", 
         RowBox[{"boundaryCoefficient", "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"del", "->", "0"}], ",", 
            RowBox[{"t", "->", "1"}]}], "}"}]}], ")"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", " ", 
     RowBox[{"Factor", " ", "/@", " ", 
      RowBox[{"Together", "[", 
       RowBox[{
        RowBox[{"Gamma", "[", 
         RowBox[{"2", "u"}], "]"}], 
        RowBox[{"(", 
         RowBox[{"hCoefficient", "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"del", "->", "0"}], ",", 
            RowBox[{"t", "->", "1"}]}], "}"}]}], ")"}]}], "]"}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Laurent coefficients: orders -2,-1,0\>\"", ",", 
       "poleScalarCoefficients"}], "}"}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Gamma endpoint contribution\>\"", ",", 
       RowBox[{"fmt", "[", 
        RowBox[{"finiteComponents", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Certificate-boundary contribution\>\"", ",", 
       RowBox[{"fmt", "[", 
        RowBox[{"finiteComponents", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Coefficient of H0\>\"", ",", 
       RowBox[{"fmt", "[", 
        RowBox[{"finiteComponents", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "]"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"Frame", "->", "All"}], ",", 
   RowBox[{"Alignment", "->", "Left"}]}], "]"}]}], "Input",
 ShowCellLabel->False,
 CellTags->
  "Top146-14-input",ExpressionUUID->"4e79b5c7-0dc8-441c-ab71-d8d53b997840"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Laurent coefficients: orders -2,-1,0\"\>", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       RowBox[{"-", 
        SuperscriptBox["\[Pi]", "2"]}]}], "}"}]},
    {"\<\"Gamma endpoint contribution\"\>", 
     TagBox[
      FormBox[
       RowBox[{"{", 
        RowBox[{
         FractionBox[
          RowBox[{"4", " ", 
           SuperscriptBox["\[Pi]", "2"], " ", 
           SuperscriptBox[
            TemplateBox[{
              RowBox[{"2", " ", "u"}]},
             "Gamma"], "2"]}], 
          SuperscriptBox[
           TemplateBox[{"u"},
            "Gamma"], "2"]], ",", 
         RowBox[{"-", 
          FractionBox[
           RowBox[{"4", " ", 
            SuperscriptBox["\[Pi]", "2"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", "u"}], "+", "1"}], ")"}], " ", 
            SuperscriptBox[
             TemplateBox[{
               RowBox[{"2", " ", "u"}]},
              "Gamma"], "2"]}], 
           SuperscriptBox[
            TemplateBox[{"u"},
             "Gamma"], "2"]]}]}], "}"}],
       TraditionalForm],
      TraditionalForm,
      Editable->True]},
    {"\<\"Certificate-boundary contribution\"\>", 
     TagBox[
      FormBox[
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"8", " ", 
               SuperscriptBox["u", "5"]}], "+", 
              RowBox[{"38", " ", 
               SuperscriptBox["u", "4"]}], "+", 
              RowBox[{"49", " ", 
               SuperscriptBox["u", "3"]}], "+", 
              RowBox[{"6", " ", 
               SuperscriptBox["u", "2"]}], "-", 
              RowBox[{"14", " ", "u"}], "-", "4"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["w", "2"], "+", "1"}], ")"}], " ", 
            TemplateBox[{
              RowBox[{"2", " ", "u"}]},
             "Gamma"]}], 
           RowBox[{"2", " ", "u", " ", 
            RowBox[{"(", 
             RowBox[{"u", "+", "1"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{"u", "+", "2"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", "u"}], "+", "1"}], ")"}], " ", "w"}]]}], ",", 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", 
              SuperscriptBox["u", "4"]}], "+", 
             SuperscriptBox["u", "3"], "-", 
             RowBox[{"14", " ", 
              SuperscriptBox["u", "2"]}], "-", 
             RowBox[{"14", " ", "u"}], "-", "4"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["w", "2"], "+", "1"}], ")"}], " ", 
           TemplateBox[{
             RowBox[{"2", " ", "u"}]},
            "Gamma"]}], 
          RowBox[{"2", " ", "u", " ", 
           RowBox[{"(", 
            RowBox[{"u", "+", "1"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{"u", "+", "2"}], ")"}], " ", "w"}]]}], "}"}],
       TraditionalForm],
      TraditionalForm,
      Editable->True]},
    {"\<\"Coefficient of H0\"\>", 
     TagBox[
      FormBox[
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["w", "2"], "+", "1"}], ")"}], " ", 
            TemplateBox[{
              RowBox[{"2", " ", "u"}]},
             "Gamma"]}], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"u", "+", "1"}], ")"}], " ", "w"}]]}], ",", 
         FractionBox[
          RowBox[{"2", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "u"}], "+", "1"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["w", "2"], "+", "1"}], ")"}], " ", 
           TemplateBox[{
             RowBox[{"2", " ", "u"}]},
            "Gamma"]}], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"u", "+", "1"}], ")"}], " ", "w"}]]}], "}"}],
       TraditionalForm],
      TraditionalForm,
      Editable->True]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 ShowCellLabel->False,
 CellTags->
  "Top146-14-output",ExpressionUUID->"18eec652-d58f-4117-b4f6-3a9f0197c744"]
