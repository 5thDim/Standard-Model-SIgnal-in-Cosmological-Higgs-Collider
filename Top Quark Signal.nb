                      "[", "key", "]"}], "]"}]}], "]"}], ";", 
              RowBox[{"result", "=", RowBox[{"Module", "[", RowBox[
                   {RowBox[{"{", RowBox[{"nuValue", ",", "amplitudes"}], 
