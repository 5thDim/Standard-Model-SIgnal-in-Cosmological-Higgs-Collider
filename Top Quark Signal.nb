Cell["Angular reconstruction and normalization checks", "Subsection",ExpressionUUID->"5bdb652b-6e53-8c44-88b1-6a90115e549c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"normalizationRatio", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"8", " ", 
       SuperscriptBox[
        RowBox[{"Gamma", "[", 
         RowBox[{
          FractionBox["1", "2"], "-", 
          RowBox[{"\[ImaginaryI]", " ", "nu"}]}], "]"}], "4"], " ", 
       RowBox[{"gTop", "[", "nu", "]"}]}], 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"4", " ", "\[Pi]"}], ")"}], 
        RowBox[{"7", "/", "2"}]], " ", 
       RowBox[{"softBTop", "[", "nu", "]"}]}]], ",", "assumptionsTop", ",", 
     RowBox[{"TimeConstraint", "\[Rule]", "10"}]}], "]"}]}], ";", 
  RowBox[{"assembledFromLoop", "=", 
   RowBox[{"normalizationRatio", " ", "bb", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"3", " ", 
          SuperscriptBox["pp1", "2"]}], "+", 
         RowBox[{"2", " ", "pp1", " ", "pp2"}]}], ")"}], " ", 
       RowBox[{
       "loopRatios", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
       "+", 
      RowBox[{
       SuperscriptBox["pp2", "2"], " ", 
       RowBox[{
        RowBox[{"Rest", "[", "loopRatios", "]"}], ".", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"s1", "+", "s3", "-", 
           RowBox[{"3", " ", "s1", " ", "s3"}]}], ",", "tb", ",", "td"}], 
         "}"}]}]}]}], ")"}]}]}], ";", 
  RowBox[{"assembledFromCoefficients", "=", 
   RowBox[{"coefficientSimp", ".", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{"s1", "+", "s3"}], ",", 
      RowBox[{"s1", " ", "s3"}], ",", "tb", ",", "td"}], "}"}]}]}], ";", 
  RowBox[{"angularSymbolicCheck", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"assembledFromLoop", "-", "assembledFromCoefficients"}], ",", 
     "assumptionsTop", ",", 
     RowBox[{"TimeConstraint", "\[Rule]", "10"}]}], "]"}]}], ";", 
  RowBox[{"a3Check", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
      "coefficientSimp", "\[LeftDoubleBracket]", "3", 
       "\[RightDoubleBracket]"}], "+", 
      RowBox[{"3", " ", 
       RowBox[{
       "coefficientSimp", "\[LeftDoubleBracket]", "2", 
        "\[RightDoubleBracket]"}]}]}], ",", "assumptionsTop"}], "]"}]}], ";", 
  TagBox[GridBox[{
     {"\"\<Eq. (64) vs Eq. (129)\>\"", "angularSymbolicCheck"},
     {"\"\<A3 + 3 A2\>\"", "a3Check"}
    },
    AutoDelete->False,
    GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
   "Grid"]}]], "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"6563f8ae-0c00-9d4d-8b1f-d2080b2b92ab"],

