Cell[CellGroupData[{

Cell["3. Whittaker seeds and regulated hard integrals", "Section",ExpressionUUID->"29529dc0-9f20-e84a-b65e-96f053a612c3"],

Cell["\<\
Eqs. (112)-(118). kappa = +/-1/2, a,b = +/-1. kOppTop and kSameTop use the \
regularized 3F2; this differs from the ordinary 3F2 used later in QTop. V is \
the vertex-type sum without a -1/2 prefactor; the hard kernels F and moments \
H use this same normalization. P_i is normalized to k12^(-2 I nu), so it \
includes the factor 2^(2 I nu) in Eq. (118). For a general soft branch eta \
this factor is 2^(2 I eta nu). The integral definition fixes all phases. The \
finite part is taken only after the full SK and kappa combinations have been \
assembled.\
\>", "Text",ExpressionUUID->"a9fccce9-3715-244a-bcc9-6e9cf32f2767"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"kOppTop", "[", 
    RowBox[{"a_", ",", "p_", ",", "q_", ",", "v_", ",", "kap_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"-", "\[ImaginaryI]"}], ")"}], " ", "a", " ", "\[Pi]", " ", 
        RowBox[{"(", 
         RowBox[{"p", "-", "q"}], ")"}]}], "+", 
       RowBox[{"\[ImaginaryI]", " ", "\[Pi]", " ", "kap"}]}], "]"}], " ", 
     SuperscriptBox["2", 
      RowBox[{
       RowBox[{"-", "3"}], "-", "p", "-", "q"}]], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{
       FractionBox["3", "2"], "+", "p", "-", 
       RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{
       FractionBox["3", "2"], "+", "p", "+", 
       RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{
       FractionBox["3", "2"], "+", "q", "-", 
       RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{
       FractionBox["3", "2"], "+", "q", "+", 
       RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}]}], 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"2", "+", "p", "+", 
       RowBox[{"a", " ", "kap"}]}], "]"}], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{"2", "+", "q", "-", 
       RowBox[{"a", " ", "kap"}]}], "]"}]}]]}], ";", 
  RowBox[{
   RowBox[{"kSameTop", "[", 
    RowBox[{"a_", ",", "p_", ",", "q_", ",", "v_", ",", "kap_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "a"}], " ", "\[ImaginaryI]", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"-", "\[ImaginaryI]"}], ")"}], " ", "a", " ", "\[Pi]", " ", 
      RowBox[{"(", 
       RowBox[{"p", "+", "q"}], ")"}]}], "]"}], " ", 
    SuperscriptBox["2", 
     RowBox[{
      RowBox[{"-", "3"}], "-", "p", "-", "q"}]], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{
      FractionBox["3", "2"], "+", "p", "+", 
      RowBox[{"a", " ", "\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{
      FractionBox["3", "2"], "+", "q", "+", 
      RowBox[{"a", " ", "\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"2", " ", "\[ImaginaryI]", " ", "\[Pi]", " ", "kap"}], 
           "]"}], "+", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "2"}], " ", "\[Pi]", " ", "v"}], "]"}]}], ")"}], " ", 
        RowBox[{"Gamma", "[", 
         RowBox[{
          FractionBox["3", "2"], "+", "p", "-", 
          RowBox[{"a", " ", "\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
        RowBox[{"Gamma", "[", 
         RowBox[{
          FractionBox["3", "2"], "+", "q", "-", 
          RowBox[{"a", " ", "\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
        RowBox[{"Gamma", "[", 
         RowBox[{
          FractionBox["1", "2"], "+", 
          RowBox[{"a", " ", "kap"}], "-", 
          RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
        RowBox[{"Gamma", "[", 
         RowBox[{
          FractionBox["1", "2"], "+", 
          RowBox[{"a", " ", "kap"}], "+", 
          RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}]}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", " ", "\[Pi]"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Gamma", "[", 
           RowBox[{"2", "+", "p", "+", 
            RowBox[{"a", " ", "kap"}]}], "]"}], " ", 
          RowBox[{"Gamma", "[", 
           RowBox[{"2", "+", "q", "+", 
            RowBox[{"a", " ", "kap"}]}], "]"}]}], ")"}]}]], "+", 
      RowBox[{"a", " ", "\[ImaginaryI]", " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{"3", "+", "p", "+", "q"}], "]"}], " ", 
       RowBox[{"HypergeometricPFQRegularized", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"3", "+", "p", "+", "q"}], ",", 
           RowBox[{
            FractionBox["1", "2"], "-", 
            RowBox[{"a", " ", "kap"}], "+", 
            RowBox[{"a", " ", "\[ImaginaryI]", " ", "v"}]}], ",", "1"}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            FractionBox["5", "2"], "+", "p", "+", 
            RowBox[{"a", " ", "\[ImaginaryI]", " ", "v"}]}], ",", 
           RowBox[{
            FractionBox["5", "2"], "+", "q", "+", 
            RowBox[{"a", " ", "\[ImaginaryI]", " ", "v"}]}]}], "}"}], ",", 
         "1"}], "]"}]}]}], ")"}]}]}], ";", 
  RowBox[{
   RowBox[{"kSeedTop", "[", 
    RowBox[{"a_", ",", "b_", ",", "p_", ",", "q_", ",", "v_", ",", "kap_"}], 
    "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"a", "\[Equal]", "b"}], ",", 
     RowBox[{"kSameTop", "[", 
      RowBox[{"a", ",", "p", ",", "q", ",", "v", ",", "kap"}], "]"}], ",", 
     RowBox[{"kOppTop", "[", 
      RowBox[{"a", ",", "p", ",", "q", ",", "v", ",", "kap"}], "]"}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"b4029e66-1c2d-7342-af9d-d04484d94f6c"],

Cell["\<\
The symbolic H0 and H1 definitions below retain KTop(a,b,kappa,p,q,r,nu) as \
an unevaluated seed at u=2r/(1+r). At r=1 it is kSeedTop. For the radial \
derivative, Eq. (117) shifts p or q; the explicit powers of r and the (a +/- \
r)/r factors must also be differentiated.\
\>", "Text",ExpressionUUID->"0008cab2-372f-fa4b-92f9-f80d454d2b65"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"h0FormalTop", "[", 
    RowBox[{"q1_", ",", "q2_", ",", "r_", ",", "v_"}], "]"}], ":=", 
   RowBox[{"\[ImaginaryI]", " ", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"p", "=", 
           RowBox[{"q1", "-", 
            FractionBox["3", "2"], "+", "m"}]}], ",", 
          RowBox[{"q", "=", 
           RowBox[{"q2", "-", 
            FractionBox["3", "2"], "+", "n"}]}]}], "}"}], ",", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[ImaginaryI]", " ", "a"}], ")"}], "m"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[ImaginaryI]", " ", "b"}], ")"}], "n"], " ", 
         SuperscriptBox["r", 
          RowBox[{
           RowBox[{"-", "3"}], "-", "p", "-", "q"}]], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"p", "+", 
              FractionBox["3", "2"], "+", 
              RowBox[{"\[ImaginaryI]", " ", "v"}]}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"KTop", "[", 
               RowBox[{"a", ",", "b", ",", 
                RowBox[{"-", 
                 FractionBox["1", "2"]}], ",", "p", ",", "q", ",", "r", ",", 
                "v"}], "]"}], "-", 
              RowBox[{"KTop", "[", 
               RowBox[{"a", ",", "b", ",", 
                FractionBox["1", "2"], ",", "p", ",", "q", ",", "r", ",", 
                "v"}], "]"}]}], ")"}]}], "+", 
           FractionBox[
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"(", 
              RowBox[{"a", "-", "r"}], ")"}], " ", 
             RowBox[{"KTop", "[", 
              RowBox[{"a", ",", "b", ",", 
               FractionBox["1", "2"], ",", 
               RowBox[{"p", "+", "1"}], ",", "q", ",", "r", ",", "v"}], 
              "]"}]}], "r"], "-", 
           FractionBox[
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"(", 
              RowBox[{"a", "+", "r"}], ")"}], " ", 
             RowBox[{"KTop", "[", 
              RowBox[{"a", ",", "b", ",", 
               RowBox[{"-", 
                FractionBox["1", "2"]}], ",", 
               RowBox[{"p", "+", "1"}], ",", "q", ",", "r", ",", "v"}], 
              "]"}]}], "r"]}], ")"}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"b", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], ";", 
  RowBox[{
   RowBox[{"h1FormalTop", "[", 
    RowBox[{"q1_", ",", "q2_", ",", "r_", ",", "v_"}], "]"}], ":=", 
   RowBox[{"\[ImaginaryI]", " ", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"p", "=", 
           RowBox[{"q1", "-", 
            FractionBox["3", "2"], "+", "m"}]}], ",", 
          RowBox[{"q", "=", 
           RowBox[{"q2", "-", 
            FractionBox["3", "2"], "+", "n"}]}]}], "}"}], ",", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[ImaginaryI]", " ", "a"}], ")"}], "m"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[ImaginaryI]", " ", "b"}], ")"}], "n"], " ", 
         SuperscriptBox["r", 
          RowBox[{
           RowBox[{"-", "3"}], "-", "p", "-", "q"}]], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"p", "+", 
              FractionBox["3", "2"], "-", 
              RowBox[{"\[ImaginaryI]", " ", "v"}]}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"KTop", "[", 
               RowBox[{"a", ",", "b", ",", 
                RowBox[{"-", 
                 FractionBox["1", "2"]}], ",", "p", ",", "q", ",", "r", ",", 
                "v"}], "]"}], "+", 
              RowBox[{"KTop", "[", 
               RowBox[{"a", ",", "b", ",", 
                FractionBox["1", "2"], ",", "p", ",", "q", ",", "r", ",", 
                "v"}], "]"}]}], ")"}]}], "-", 
           FractionBox[
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"(", 
              RowBox[{"a", "-", "r"}], ")"}], " ", 
             RowBox[{"KTop", "[", 
              RowBox[{"a", ",", "b", ",", 
               FractionBox["1", "2"], ",", 
               RowBox[{"p", "+", "1"}], ",", "q", ",", "r", ",", "v"}], 
              "]"}]}], "r"], "-", 
           FractionBox[
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"(", 
              RowBox[{"a", "+", "r"}], ")"}], " ", 
             RowBox[{"KTop", "[", 
              RowBox[{"a", ",", "b", ",", 
               RowBox[{"-", 
                FractionBox["1", "2"]}], ",", 
               RowBox[{"p", "+", "1"}], ",", "q", ",", "r", ",", "v"}], 
              "]"}]}], "r"]}], ")"}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"b", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], ";", 
  TagBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"P1", "[", "nu", "]"}], "\[Equal]", 
      RowBox[{
       SuperscriptBox["2", 
        RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]], " ", 
       RowBox[{"FinitePart", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"H0", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", 
            RowBox[{
             RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", "1", ",",
             "nu"}], "]"}], "+", 
          FractionBox[
           RowBox[{"2", " ", "\[ImaginaryI]", " ", 
            RowBox[{"H1", "[", 
             RowBox[{
              RowBox[{"1", "+", 
               RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", 
              RowBox[{
               RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", "1",
               ",", "nu"}], "]"}]}], 
           RowBox[{"1", "+", 
            RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]}]]}], ",", "delta",
          ",", "0"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"P2", "[", "nu", "]"}], "\[Equal]", 
      RowBox[{
       SuperscriptBox["2", 
        RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]], " ", 
       RowBox[{"FinitePart", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            SubscriptBox["\[PartialD]", "r"], 
            RowBox[{"H0", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", 
              RowBox[{
               RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", "r",
               ",", "nu"}], "]"}]}], "-", 
           RowBox[{"H0", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", 
             RowBox[{
              RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", "delta"}], ",", "r", 
             ",", "nu"}], "]"}]}], "/.", "\[VeryThinSpace]", 
          RowBox[{"r", "\[Rule]", "1"}]}], ",", "delta", ",", "0"}], 
        "]"}]}]}]}], "}"}],
   HoldForm]}]], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"20920e1c-1744-dc42-b8bf-11dabb3b8168"],

Cell[BoxData[
 TagBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"P1", "[", "nu", "]"}], "\[Equal]", 
     RowBox[{
      SuperscriptBox["2", 
       RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]], " ", 
