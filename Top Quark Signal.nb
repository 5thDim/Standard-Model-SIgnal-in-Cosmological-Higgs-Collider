Cell[CellGroupData[{

Cell["A.4. Combine every SK term before taking del=0", "Subsection",ExpressionUUID->"6ae35034-662e-4e1a-b855-dad23a57b85b"],

Cell["\<\
The normalizer below uses only integer Gamma recurrence, Gamma reflection, \
and elementary exponential algebra. gd,g1,g2,ga are temporary independent \
symbols for Gamma[del], Gamma[u+del], Gamma[2u+del], Gamma[2u+2del]. Keeping \
them independent makes the cancellation an exact rational calculation, rather \
than a numerical fit or a FullSimplify assumption.\
\>", "Text",ExpressionUUID->"1dd126b7-4004-4fc0-b1cd-f559e44bb4fb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"normalize", "[", "expr_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", "=", 
       RowBox[{"Expand", "[", 
        RowBox[{"expr", "/.", 
         RowBox[{"nu", "->", 
          RowBox[{
           RowBox[{"-", "I"}], " ", "u"}]}]}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", " ", 
     RowBox[{
      RowBox[{"p", "=", 
       RowBox[{"p", "/.", 
        RowBox[{
         RowBox[{"Gamma", "[", "arg_", "]"}], " ", ":>", " ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"z", "=", 
             RowBox[{"Expand", "[", "arg", "]"}]}], "}"}], ",", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"n", "=", 
               RowBox[{"z", "/.", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"u", "->", "0"}], ",", 
                  RowBox[{"del", "->", "0"}]}], "}"}]}]}], "}"}], ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"IntegerQ", "[", "n", "]"}], ",", 
               RowBox[{
                RowBox[{"Gamma", "[", 
                 RowBox[{"z", "-", "n"}], "]"}], " ", 
                RowBox[{"rf", "[", 
                 RowBox[{
                  RowBox[{"z", "-", "n"}], ",", "n"}], "]"}]}], ",", 
               RowBox[{"Gamma", "[", "z", "]"}]}], "]"}]}], "]"}]}], 
          "]"}]}]}]}], ";", "\[IndentingNewLine]", " ", 
      RowBox[{"p", "=", 
       RowBox[{"p", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Gamma", "[", 
            RowBox[{"-", "u"}], "]"}], "->", 
           RowBox[{
            RowBox[{"-", "Pi"}], "/", 
            RowBox[{"(", 
             RowBox[{"u", " ", 
              RowBox[{"Sin", "[", 
               RowBox[{"Pi", " ", "u"}], "]"}], 
              RowBox[{"Gamma", "[", "u", "]"}]}], ")"}]}]}], ",", 
          RowBox[{
           RowBox[{"Gamma", "[", 
            RowBox[{
             RowBox[{"-", "2"}], "u"}], "]"}], "->", 
           RowBox[{
            RowBox[{"-", "Pi"}], "/", 
            RowBox[{"(", 
             RowBox[{"2", "u", " ", 
              RowBox[{"Sin", "[", 
               RowBox[{"2", "Pi", " ", "u"}], "]"}], 
              RowBox[{"Gamma", "[", 
               RowBox[{"2", "u"}], "]"}]}], ")"}]}]}], ",", 
          "\[IndentingNewLine]", " ", " ", 
          RowBox[{
           RowBox[{"Gamma", "[", 
            RowBox[{
             RowBox[{"-", "u"}], "-", "del"}], "]"}], "->", 
           RowBox[{
            RowBox[{"-", "Pi"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"u", "+", "del"}], ")"}], 
              RowBox[{"Sin", "[", 
               RowBox[{"Pi", 
                RowBox[{"(", 
                 RowBox[{"u", "+", "del"}], ")"}]}], "]"}], 
              RowBox[{"Gamma", "[", 
               RowBox[{"u", "+", "del"}], "]"}]}], ")"}]}]}], ",", 
          "\[IndentingNewLine]", " ", " ", 
          RowBox[{
           RowBox[{"Gamma", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "2"}], "u"}], "-", "del"}], "]"}], "->", 
           RowBox[{
            RowBox[{"-", "Pi"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", "u"}], "+", "del"}], ")"}], 
              RowBox[{"Sin", "[", 
               RowBox[{"Pi", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"2", "u"}], "+", "del"}], ")"}]}], "]"}], 
              RowBox[{"Gamma", "[", 
               RowBox[{
                RowBox[{"2", "u"}], "+", "del"}], "]"}]}], ")"}]}]}], ",", 
          "\[IndentingNewLine]", " ", " ", 
          RowBox[{
           RowBox[{"Gamma", "[", 
            RowBox[{"-", "del"}], "]"}], "->", 
           RowBox[{
            RowBox[{"-", "Pi"}], "/", 
            RowBox[{"(", 
             RowBox[{"del", " ", 
              RowBox[{"Sin", "[", 
               RowBox[{"Pi", " ", "del"}], "]"}], 
              RowBox[{"Gamma", "[", "del", "]"}]}], ")"}]}]}]}], "}"}]}]}], ";",
       "\[IndentingNewLine]", " ", 
      RowBox[{"p", "=", 
       RowBox[{"TrigToExp", "[", "p", "]"}]}], ";", "\[IndentingNewLine]", 
      " ", 
      RowBox[{"p", "=", 
       RowBox[{"p", "/.", 
        RowBox[{
         RowBox[{"Power", "[", 
          RowBox[{"E", ",", "ex_"}], "]"}], " ", ":>", " ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"z", "=", 
             RowBox[{"Expand", "[", "ex", "]"}]}], "}"}], ",", 
           RowBox[{
            RowBox[{"w", "^", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Coefficient", "[", 
                RowBox[{"z", ",", "u"}], "]"}], "/", 
               RowBox[{"(", 
                RowBox[{"I", " ", "Pi"}], ")"}]}], ")"}]}], " ", 
            RowBox[{"t", "^", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Coefficient", "[", 
                RowBox[{"z", ",", "del"}], "]"}], "/", 
               RowBox[{"(", 
                RowBox[{"I", " ", "Pi"}], ")"}]}], ")"}]}], " ", 
            RowBox[{"Exp", "[", 
             RowBox[{"z", "/.", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"u", "->", "0"}], ",", 
                RowBox[{"del", "->", "0"}]}], "}"}]}], "]"}]}]}], "]"}]}]}]}],
       ";", "\[IndentingNewLine]", " ", 
      RowBox[{"p", "=", 
       RowBox[{"p", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Gamma", "[", "del", "]"}], "->", "gd"}], ",", 
          RowBox[{
           RowBox[{"Gamma", "[", 
            RowBox[{"u", "+", "del"}], "]"}], "->", "g1"}], ",", 
          RowBox[{
           RowBox[{"Gamma", "[", 
            RowBox[{
             RowBox[{"2", "u"}], "+", "del"}], "]"}], "->", "g2"}], ",", 
          RowBox[{
           RowBox[{"Gamma", "[", "u", "]"}], "->", "g0"}], ",", 
          RowBox[{
           RowBox[{"Gamma", "[", 
            RowBox[{"2", "u"}], "]"}], "->", "g00"}], ",", 
          RowBox[{
           RowBox[{"Gamma", "[", 
            RowBox[{
             RowBox[{"2", "u"}], "+", 
             RowBox[{"2", "del"}]}], "]"}], "->", "ga"}]}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", " ", 
      RowBox[{"Factor", "[", 
       RowBox[{"Together", "[", "p", "]"}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"connectionGammaResiduals", "=", 
   RowBox[{"normalize", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"kMinus", ",", "kPlus", ",", "kG"}], "}"}], "-", "kReduced"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"masterGammaResidual", "=", 
   RowBox[{"normalize", "[", 
    RowBox[{
     RowBox[{"I", " ", 
      RowBox[{"2", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "2"}], "del"}], ")"}]}], " ", 
      RowBox[{"Gamma", "[", "aMaster", "]"}], "\[IndentingNewLine]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", "Pi", 
           RowBox[{"(", 
            RowBox[{"u", "+", "del"}], ")"}]}], "]"}], 
         RowBox[{
          RowBox[{"kReduced", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "/", 
          RowBox[{"del", "^", "2"}]}]}], "+", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "I"}], " ", "Pi", 
           RowBox[{"(", 
            RowBox[{"u", "+", "del"}], ")"}]}], "]"}], 
         RowBox[{
          RowBox[{"kReduced", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "/", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "u"}], "+", "del"}], ")"}], "^", "2"}]}]}], 
        "\[IndentingNewLine]", " ", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"I", " ", "Pi", 
             RowBox[{"(", 
              RowBox[{"u", "+", "del"}], ")"}]}], "]"}], "+", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "I"}], " ", "Pi", 
