              RowBox[{"-", "2"}], " ", "\[Pi]", " ", "vv"}], "]"}]}], ")"}], " ", 
          RowBox[{"Gamma", "[", 
           RowBox[{
            FractionBox["3", "2"], "+", "pp", "-", 
