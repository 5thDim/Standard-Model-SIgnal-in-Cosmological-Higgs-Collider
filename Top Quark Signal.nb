        RowBox[{"a", ",", "b", ",", "kap", ",", 
         RowBox[{"p", "+", "1"}], ",", "q", ",", "rr"}], "]"}]}], "+", 
      RowBox[{"I", " ", "b", " ", 
       RowBox[{"ks", "[", 
        RowBox[{"a", ",", "b", ",", "kap", ",", "p", ",", 
         RowBox[{"q", "+", "1"}], ",", "rr"}], "]"}]}]}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"formal", "=", 
    RowBox[{"Expand", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{"2", "I", " ", "nu"}], ")"}]}], 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"base", "+", 
           RowBox[{"2", 
            RowBox[{"I", "/", 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"2", "I", " ", "nu"}]}], ")"}]}], "shift"}]}], ",", 
          RowBox[{"dr", "-", "base"}]}], "}"}]}], "/.", 
       RowBox[{"rr", "->", "1"}]}], "/.", 
      RowBox[{
       RowBox[{"ks", "[", 
        RowBox[{
        "a_", ",", "b_", ",", "kap_", ",", "p_", ",", "q_", ",", "1"}], "]"}],
        ":>", 
       RowBox[{"kk", "[", 
        RowBox[{"a", ",", "b", ",", "kap", ",", "p", ",", "q"}], "]"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"raw", " ", "=", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{"formal", " ", "/.", " ", 
     RowBox[{
      RowBox[{"kk", "[", 
       RowBox[{"a_", ",", "b_", ",", "kap_", ",", "p_", ",", "q_"}], "]"}], 
      " ", ":>", " ", 
      RowBox[{"kSeed", "[", 
       RowBox[{"a", ",", "b", ",", "p", ",", "q", ",", "nu", ",", "kap"}], 
       "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
