Cell["\<\
A3 = -3 A2 implies ln|A3| - ln|A2| = ln(3) and a phase difference of Pi \
modulo 2 Pi. The phase shown is that of each coefficient in the convention of \
Eq. (58); the phase of the full signal at fixed angles is Arg[Ctop], which \
also depends on the angular combination.\
\>", "Text",ExpressionUUID->"9a299838-a7f6-9b4a-93d6-79a1306da96b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Validation summary", "Section",ExpressionUUID->"7c17c3c2-48ba-1b43-844a-ceb405fc2c67"],

Cell["\<\
These checks validate the implementation of the stated leading collapsed \
formulas, their algebraic relations, and numerical stability. The regulator \
comparison is numerical evidence for the finite representation, not a full \
symbolic proof of that limit or an independent validation of the complete \
unexpanded fermion box.\
\>", "Text",ExpressionUUID->"13f27c24-63bb-d14c-87e3-0383262aecaf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"validationTop", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<Soft Gamma normalization\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"softGammaCheck", "\[Equal]", "0"}], "]"}]}], ",", 
     RowBox[{"\"\<Loop coefficients: symbolic Gamma recurrence\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"loopSymbolicCheck", "\[Equal]", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", "5"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"\"\<Loop coefficients: direct Gamma sums\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"loopNumericChecks", "\[LeftDoubleBracket]", 
          RowBox[{"All", ",", "2"}], "\[RightDoubleBracket]"}], "]"}], "<", 
        FractionBox["1", 
         SuperscriptBox["10", "35"]]}], "]"}]}], ",", 
     RowBox[{"\"\<Four Q reductions\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"qReductionCheck", "\[Equal]", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", "4"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"\"\<Regulated SK sum vs finite P and H\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"regulatorChecks", "\[LeftDoubleBracket]", 
           RowBox[{"All", ",", 
            RowBox[{"2", ";;", "5"}]}], "\[RightDoubleBracket]"}], "]"}], 
         "]"}], "<", 
        FractionBox["1", 
         SuperscriptBox["10", "9"]]}], "]"}]}], ",", 
     RowBox[{"\"\<Regulator convergence: four vs five levels\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"regulatorChecks", "\[LeftDoubleBracket]", 
          RowBox[{"All", ",", "6"}], "\[RightDoubleBracket]"}], "]"}], "<", 
        FractionBox["1", 
         SuperscriptBox["10", "9"]]}], "]"}]}], ",", 
     RowBox[{"\"\<Eq. (58) vs angular coefficients\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"angularSymbolicCheck", "\[Equal]", "0"}], "]"}]}], ",", 
     RowBox[{"\"\<A3 = -3 A2\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"a3Check", "\[Equal]", "0"}], "]"}]}], ",", 
     RowBox[{"\"\<Precision stability\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"precisionChecks", "\[LeftDoubleBracket]", 
          RowBox[{"All", ",", "2"}], "\[RightDoubleBracket]"}], "]"}], "<", 
        FractionBox["1", 
         SuperscriptBox["10", "25"]]}], "]"}]}], ",", 
     RowBox[{"\"\<Independent angle projections\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"angularNumericChecks", "\[LeftDoubleBracket]", 
           RowBox[{"All", ",", 
            RowBox[{"2", ";;", "4"}]}], "\[RightDoubleBracket]"}], "]"}], 
         "]"}], "<", 
        FractionBox["1", 
         SuperscriptBox["10", "35"]]}], "]"}]}], ",", 
     RowBox[{"\"\<Mass scan contains finite numeric values\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", "scanValidTop", "]"}]}]}], "]"}]}], ";", 
  RowBox[{"Grid", "[", 
   RowBox[{
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"KeyValueMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"#1", ",", 
           RowBox[{"If", "[", 
            RowBox[{"#2", ",", 
             RowBox[{"Style", "[", 
              RowBox[{"\"\<PASS\>\"", ",", 
               RowBox[{"Darker", "[", "Green", "]"}]}], "]"}], ",", 
             RowBox[{"Style", "[", 
              RowBox[{"\"\<FAIL\>\"", ",", "Red"}], "]"}]}], "]"}]}], "}"}], 
         "&"}], ",", "validationTop"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Check\>\"", ",", "\"\<Result\>\""}], "}"}]}], "]"}], ",", 
    RowBox[{"Frame", "\[Rule]", "All"}], ",", 
    RowBox[{"Alignment", "\[Rule]", "Left"}]}], "]"}]}]], "Input",
 CellLabel->"In[38]:=",ExpressionUUID->"e1b62c81-c4d4-ee4a-ba2a-b0017fe8e136"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Check\"\>", "\<\"Result\"\>"},
    {"\<\"Soft Gamma normalization\"\>", 
     StyleBox["\<\"PASS\"\>",
      StripOnInput->False,
      LineColor->RGBColor[0, 2/3, 0],
      FrontFaceColor->RGBColor[0, 2/3, 0],
      BackFaceColor->RGBColor[0, 2/3, 0],
      GraphicsColor->RGBColor[0, 2/3, 0],
      FontColor->RGBColor[0, 2/3, 0]]},
    {"\<\"Loop coefficients: symbolic Gamma recurrence\"\>", 
     StyleBox["\<\"PASS\"\>",
      StripOnInput->False,
      LineColor->RGBColor[0, 2/3, 0],
      FrontFaceColor->RGBColor[0, 2/3, 0],
      BackFaceColor->RGBColor[0, 2/3, 0],
      GraphicsColor->RGBColor[0, 2/3, 0],
      FontColor->RGBColor[0, 2/3, 0]]},
    {"\<\"Loop coefficients: direct Gamma sums\"\>", 
     StyleBox["\<\"PASS\"\>",
      StripOnInput->False,
      LineColor->RGBColor[0, 2/3, 0],
      FrontFaceColor->RGBColor[0, 2/3, 0],
