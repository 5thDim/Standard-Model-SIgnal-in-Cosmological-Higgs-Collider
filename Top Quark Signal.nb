          RowBox[{"TimeConstraint", "\[Rule]", "15"}]}], "]"}], ",", "25", ",",
         "#1"}], "]"}], "&"}], ")"}], "/@", "topPExplicit"}]}], ";", 
  TagBox[GridBox[{
     {"\"\<P1\>\"", 
      RowBox[{"formTop", "[", 
       RowBox[{
