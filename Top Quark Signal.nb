Cell[CellGroupData[{

Cell["\<\
A.2. Reduce all shifted particular seeds to two regulated masters\
\>", "Subsection",ExpressionUUID->"5b92014e-0b20-4191-bd2e-3671c5cb39ff"],

Cell["\<\
For a same-sign branch a, set A=2u+2del, M=(1+a)u+del, C=1+M, B=a u. Its \
common series is S_a(k)=(A)_k (B)_k/(C)_k^2, and its seed prefactor is \
O_a=exp[-I a Pi(-3+A)/2] 2^(-A) Gamma[A]/M^2. Integer shifts m,n and kappa \
only multiply this series by a rational function. The following replacement \
is that exact term ratio; it is applied to the original formal SK sum, rather \
than to an assumed finite answer.\
\>", "Text",ExpressionUUID->"dcee1057-ca09-42e5-b4cb-1949e79cb838"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"formalU", " ", "=", " ", 
   RowBox[{"formal", " ", "/.", " ", 
    RowBox[{"nu", " ", "->", " ", 
     RowBox[{
      RowBox[{"-", "I"}], " ", "u"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"seedRatio", "[", 
    RowBox[{
    "a_", ",", "b_", ",", "kap_", ",", "p_", ",", "q_", ",", "sector_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"a", " ", "!=", " ", "b"}], " ", "||", " ", 
      RowBox[{"a", " ", "!=", " ", "sector"}]}], ",", " ", "0", ",", 
     "\[IndentingNewLine]", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"m", "=", 
          RowBox[{"Expand", "[", 
           RowBox[{"p", "+", 
            RowBox[{"3", "/", "2"}], "-", "u", "-", "del"}], "]"}]}], ",", 
         RowBox[{"n", "=", 
          RowBox[{"Expand", "[", 
           RowBox[{"q", "+", 
            RowBox[{"3", "/", "2"}], "-", "u", "-", "del"}], "]"}]}], ",", 
         RowBox[{"mm", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", "a"}], ")"}], "u"}], "+", "del"}]}], ",", 
         RowBox[{"tt", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"2", "a", " ", "kap"}]}], ")"}], "/", "2"}]}]}], "}"}], ",",
        "\[IndentingNewLine]", " ", " ", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", "a", " ", "Pi", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"m", "+", "n"}], ")"}], "/", "2"}]}], "]"}], " ", 
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "m"}], "-", "n"}], ")"}]}], " ", 
        RowBox[{"Pochhammer", "[", 
         RowBox[{"mm", ",", "m"}], "]"}], " ", 
        RowBox[{"Pochhammer", "[", 
         RowBox[{"mm", ",", "n"}], "]"}], "\[IndentingNewLine]", " ", " ", 
        " ", 
        RowBox[{"Pochhammer", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"2", "u"}], "+", 
           RowBox[{"2", "del"}], "+", "k"}], ",", 
          RowBox[{"m", "+", "n"}]}], "]"}], " ", 
        RowBox[{
         RowBox[{"Pochhammer", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"a", " ", "u"}], "+", "k"}], ",", "tt"}], "]"}], "/", 
         "\[IndentingNewLine]", " ", " ", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Pochhammer", "[", 
            RowBox[{
             RowBox[{"1", "+", "mm", "+", "k"}], ",", "m"}], "]"}], " ", 
           RowBox[{"Pochhammer", "[", 
            RowBox[{
             RowBox[{"1", "+", "mm", "+", "k"}], ",", "n"}], "]"}], " ", 
           RowBox[{"Pochhammer", "[", 
            RowBox[{
             RowBox[{"a", " ", "u"}], ",", "tt"}], "]"}]}], ")"}]}]}]}], 
      "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ratios", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Factor", "[", 
      RowBox[{
       RowBox[{"Together", "[", 
        RowBox[{"formalU", " ", "/.", " ", 
         RowBox[{
          RowBox[{"kk", "[", 
           RowBox[{"a_", ",", "b_", ",", "kap_", ",", "p_", ",", "q_"}], 
           "]"}], " ", ":>", " ", 
          RowBox[{"seedRatio", "[", 
           RowBox[{
           "a", ",", "b", ",", "kap", ",", "p", ",", "q", ",", "sector"}], 
           "]"}]}]}], "]"}], "/", 
       RowBox[{"2", "^", 
        RowBox[{"(", 
         RowBox[{"2", "u"}], ")"}]}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"sector", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Dimensions", "[", "ratios", "]"}]}], "Input",
 ShowCellLabel->False,
 CellTags->
  "Top146-5-input",ExpressionUUID->"776a7b3d-61e3-4533-bdcb-63f47bcc1b39"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "2"}], "}"}]], "Output",
 ShowCellLabel->False,
 CellTags->
  "Top146-5-output",ExpressionUUID->"85815a2f-7412-4801-815a-9e40795a4830"]
}, Open  ]],

Cell["\<\
Find c and a rational certificate r(k) such that R(k)=c+rho(k)r(k+1)-r(k), \
with rho=S(k+1)/S(k). Summing gives sum S(k)R(k)=c F_a-r(0), where \
F_a=3F2(1,A,B;C,C;1). The upper boundary vanishes in each branch\
\[CloseCurlyQuote]s convergence half-plane separately; the resulting identity \
is then analytically continued. The code solves polynomial coefficient \
equations and checks every rational identity exactly. Thus all contiguity \
reductions used here have explicit certificates.\
\>", "Text",ExpressionUUID->"7a9e6785-cce6-48c0-9a57-1de6b6318ce3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"telescopes", " ", "=", " ", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", " ", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"sector", "=", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}], "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], ",", 
         RowBox[{"aa", "=", 
          RowBox[{
           RowBox[{"2", "u"}], "+", 
           RowBox[{"2", "del"}]}]}], ",", "bb", ",", "cc", ",", "rho", ",", 
         "unknown", ",", "poly", ",", "certificate", ",", "numerator", ",", 
         "solution", ",", "residual"}], "}"}], ",", "\[IndentingNewLine]", 
       " ", " ", 
       RowBox[{
        RowBox[{"bb", "=", 
         RowBox[{"sector", " ", "u"}]}], ";", " ", 
        RowBox[{"cc", "=", 
         RowBox[{"1", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", "sector"}], ")"}], "u"}], "+", "del"}]}], ";", 
        "\[IndentingNewLine]", " ", " ", 
        RowBox[{"rho", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"k", "+", "aa"}], ")"}], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"k", "+", "bb"}], ")"}], "/", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"k", "+", "cc"}], ")"}], "^", "2"}]}]}]}], ";", 
        "\[IndentingNewLine]", " ", " ", 
        RowBox[{"unknown", "=", 
         RowBox[{"Array", "[", 
          RowBox[{"zc", ",", "7"}], "]"}]}], ";", " ", 
        RowBox[{"poly", "=", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"unknown", "[", 
             RowBox[{"[", 
              RowBox[{"ell", "+", "1"}], "]"}], "]"}], " ", 
            RowBox[{"k", "^", "ell"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"ell", ",", "0", ",", "6"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", " ", " ", 
        RowBox[{"certificate", "=", 
         RowBox[{"poly", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"k", "+", "cc"}], ")"}], "^", "2"}], 
            RowBox[{"(", 
             RowBox[{"k", "+", "cc", "+", "1"}], ")"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", " ", " ", 
        RowBox[{"numerator", "=", 
         RowBox[{"Numerator", "[", 
          RowBox[{"Together", "[", 
           RowBox[{
            RowBox[{"ratios", "[", 
             RowBox[{"[", 
              RowBox[{"j", ",", "i"}], "]"}], "]"}], "-", "masterCoefficient",
             "-", 
            RowBox[{"rho", 
             RowBox[{"(", 
              RowBox[{"certificate", "/.", 
               RowBox[{"k", "->", 
                RowBox[{"k", "+", "1"}]}]}], ")"}]}], "+", "certificate"}], 
           "]"}], "]"}]}], ";", "\[IndentingNewLine]", " ", " ", 
        RowBox[{"solution", "=", 
         RowBox[{"First", "[", 
          RowBox[{"Solve", "[", 
           RowBox[{
            RowBox[{"Thread", "[", 
             RowBox[{
              RowBox[{"CoefficientList", "[", 
               RowBox[{"numerator", ",", "k"}], "]"}], "==", "0"}], "]"}], ",", 
            RowBox[{"Append", "[", 
             RowBox[{"unknown", ",", "masterCoefficient"}], "]"}]}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", " ", " ", 
        RowBox[{"certificate", "=", 
         RowBox[{"Factor", "[", 
          RowBox[{"certificate", "/.", "solution"}], "]"}]}], ";", 
        "\[IndentingNewLine]", " ", " ", 
        RowBox[{"residual", "=", 
         RowBox[{"Factor", "[", 
          RowBox[{"Together", "[", 
           RowBox[{
            RowBox[{"ratios", "[", 
             RowBox[{"[", 
              RowBox[{"j", ",", "i"}], "]"}], "]"}], "-", 
            RowBox[{"(", 
             RowBox[{"masterCoefficient", "/.", "solution"}], ")"}], "-", 
            RowBox[{"rho", 
             RowBox[{"(", 
              RowBox[{"certificate", "/.", 
               RowBox[{"k", "->", 
                RowBox[{"k", "+", "1"}]}]}], ")"}]}], "+", "certificate"}], 
           "]"}], "]"}]}], ";", "\[IndentingNewLine]", " ", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Factor", "[", 
           RowBox[{"masterCoefficient", "/.", "solution"}], "]"}], ",", 
          "certificate", ",", 
          RowBox[{"Factor", "[", 
           RowBox[{"certificate", "/.", 
            RowBox[{"k", "->", "0"}]}], "]"}], ",", "residual"}], "}"}]}]}], 
      "]"}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cm", "=", 
   RowBox[{"telescopes", "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "All", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"certificates", "=", 
   RowBox[{"telescopes", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"telescopeResiduals", "=", 
   RowBox[{"telescopes", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "All", ",", "4"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"masterSignResidual", "=", 
   RowBox[{"Factor", " ", "/@", " ", 
    RowBox[{"Together", "[", 
     RowBox[{"cm", "+", 
      RowBox[{"telescopes", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", "All", ",", "1"}], "]"}], "]"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Four exact certificate residuals\>\"", ",", 
       "telescopeResiduals"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<c_plus + c_minus\>\"", ",", "masterSignResidual"}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"\"\<c_minus, P1\>\"", ",", 
       RowBox[{"fmt", "[", 
        RowBox[{"cm", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<c_minus, P2\>\"", ",", 
       RowBox[{"fmt", "[", 
        RowBox[{"cm", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"Frame", "->", "All"}], ",", 
   RowBox[{"Alignment", "->", "Left"}]}], "]"}]}], "Input",
 ShowCellLabel->False,
 CellTags->
  "Top146-6-input",ExpressionUUID->"aa3885c4-d4de-46d3-9a66-3e775d967ae7"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Four exact certificate residuals\"\>", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "}"}]},
    {"\<\"c_plus + c_minus\"\>", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]},
    {"\<\"c_minus, P1\"\>", 
     TagBox[
      FormBox[
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[Delta]", "+", "1"}], ")"}], "2"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[Delta]", "+", 
            RowBox[{"2", " ", "u"}]}], ")"}], "2"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[Delta]", "+", 
            RowBox[{"2", " ", "u"}], "+", "2"}], ")"}], "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            SuperscriptBox["\[Delta]", "2"]}], "-", 
           RowBox[{"2", " ", "\[Delta]"}], "+", 
           RowBox[{"2", " ", 
            SuperscriptBox["u", "2"]}], "+", 
           RowBox[{"2", " ", "\[Delta]", " ", "u"}], "+", 
           RowBox[{"5", " ", "u"}], "+", "2"}], ")"}]}], 
        RowBox[{"4", " ", "u", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "u"}], "+", "1"}], ")"}], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[Delta]", "+", "u", "+", "1"}], ")"}], "2"], " ", 
         RowBox[{"(", 
          RowBox[{"\[Delta]", "+", "u", "+", "2"}], ")"}]}]],
       TraditionalForm],
      TraditionalForm,
      Editable->True]},
    {"\<\"c_minus, P2\"\>", 
     TagBox[
      FormBox[
       RowBox[{"-", 
        FractionBox[
         RowBox[{"\[ImaginaryI]", " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"\[Delta]", "+", "1"}], ")"}], "2"], " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"\[Delta]", "+", 
             RowBox[{"2", " ", "u"}]}], ")"}], "2"], " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"\[Delta]", "+", 
             RowBox[{"2", " ", "u"}], "+", "2"}], ")"}], "2"], " ", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["\[Delta]", "2"], "+", 
            RowBox[{"4", " ", "\[Delta]"}], "+", 
            RowBox[{"2", " ", 
             SuperscriptBox["u", "2"]}], "+", 
            RowBox[{"2", " ", "\[Delta]", " ", "u"}], "+", 
            RowBox[{"5", " ", "u"}], "+", "2"}], ")"}]}], 
         RowBox[{"4", " ", "u", " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"\[Delta]", "+", "u", "+", "1"}], ")"}], "2"], " ", 
          RowBox[{"(", 
           RowBox[{"\[Delta]", "+", "u", "+", "2"}], ")"}]}]]}],
       TraditionalForm],
      TraditionalForm,
      Editable->True]}
   },
