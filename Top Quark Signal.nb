          RowBox[{
           FractionBox["3", "2"], "+", "pp", "+", 
           RowBox[{"a", " ", "\[ImaginaryI]", " ", "vv"}]}], "]"}], " ", 
         RowBox[{"Gamma", "[", 
          RowBox[{
