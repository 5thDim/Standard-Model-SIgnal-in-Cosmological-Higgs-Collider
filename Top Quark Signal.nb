      RowBox[{"TrueQ", "[", 
       RowBox[{"topAngularCheck", "\[Equal]", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", "5"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"\"\<Common Gamma normalization\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"topNormalizationCheck", "\[Equal]", "1"}], "]"}]}], ",", 
     RowBox[{"\"\<Numerical finite P\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"Max", "[", 
