       RowBox[{"gTop", "[", "nu", "]"}]}], 
      RowBox[{"softBTop", "[", "nu", "]"}]], ",", "assumptionsTop", ",", 
     RowBox[{"TimeConstraint", "\[Rule]", "10"}]}], "]"}]}], ";", 
  RowBox[{"assembledFromLoop", "=", 
   RowBox[{"normalizationRatio", " ", "bb", " ", 
    RowBox[{"(", 
     RowBox[{
