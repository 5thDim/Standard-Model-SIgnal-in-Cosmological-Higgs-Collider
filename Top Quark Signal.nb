Cell[CellGroupData[{

Cell["5. Five angular coefficients as functions of mass", "Section",ExpressionUUID->"6e2bdb83-7ae2-6e48-9fe0-a2b549c41cd9"],

Cell["\<\
Eq. (128) defines the common soft factor. Eq. (129) gives A1, A2, A3, B and \
D. Products are complex squares P_i P_j, not absolute-value squares. All four \
s-channel orderings are already included. These are dimensionless \
coefficients of the oscillatory signal, not the full four-point function.\
\>", "Text",ExpressionUUID->"4a019397-895f-ab40-968d-ec0da16edcbd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"softBTop", "[", "v_", "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rho", "=", 
       RowBox[{"rhoTop", "[", "v", "]"}]}], "}"}], ",", 
     FractionBox[
      RowBox[{
       SuperscriptBox[
        RowBox[{"Gamma", "[", "rho", "]"}], "4"], " ", 
       RowBox[{"f0Top", "[", 
        RowBox[{"rho", ",", "rho"}], "]"}]}], 
      RowBox[{"4", " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"4", " ", "\[Pi]"}], ")"}], 
        RowBox[{"7", "/", "2"}]], " ", 
       RowBox[{"(", 
        RowBox[{"rho", "-", "3"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"rho", "-", "2"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"4", " ", "rho"}], "-", "7"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"4", " ", "rho"}], "-", "5"}], ")"}]}]]}], "]"}]}], ";", 
  RowBox[{"softBSimp", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"softBTop", "[", "nu", "]"}], ",", "assumptionsTop", ",", 
     RowBox[{"TimeConstraint", "\[Rule]", "10"}]}], "]"}]}], ";", 
  RowBox[{"formTop", "[", "softBSimp", "]"}]}]], "Input",
 CellLabel->"In[23]:=",ExpressionUUID->"e7afe037-d434-ac4f-af01-85ae6853dc1c"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{
    SuperscriptBox["4", 
     RowBox[{
      RowBox[{"-", "6"}], "-", 
      RowBox[{"\[ImaginaryI]", " ", "\[Nu]"}]}]], " ", 
    SuperscriptBox[
     TemplateBox[{
       RowBox[{
         FractionBox["1", "2"], "-", 
         RowBox[{"\[ImaginaryI]", " ", "\[Nu]"}]}]},
      "Gamma"], "2"], " ", 
    TemplateBox[{
      RowBox[{
        RowBox[{"\[ImaginaryI]", " ", "\[Nu]"}], "+", "1"}]},
     "Gamma"], " ", 
    TemplateBox[{
      RowBox[{
        RowBox[{
          RowBox[{"-", "2"}], " ", "\[ImaginaryI]", " ", "\[Nu]"}], "-", 
        FractionBox["5", "2"]}]},
     "Gamma"]}], 
   RowBox[{
    SuperscriptBox["\[Pi]", "3"], " ", 
    TemplateBox[{
      RowBox[{
        RowBox[{"\[ImaginaryI]", " ", "\[Nu]"}], "+", 
        FractionBox["7", "2"]}]},
     "Gamma"]}]], TraditionalForm]], "Output",
 CellChangeTimes->{4.001754311251602*^9, 4.001819579110201*^9},
 CellLabel->
  "Out[23]//TraditionalForm=",ExpressionUUID->"173d442d-fe2b-304f-ba70-\
26f20935377a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"coefficientTemplate", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rho", "=", 
       RowBox[{"rhoTop", "[", "nu", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"bb", " ", 
        RowBox[{"(", 
         RowBox[{"rho", "-", "1"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "rho"}], "-", "3"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"4", " ", 
           RowBox[{"(", 
            RowBox[{"rho", "-", "3"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"3", " ", 
              SuperscriptBox["pp1", "2"]}], "+", 
             RowBox[{"2", " ", "pp1", " ", "pp2"}]}], ")"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "rho"}], "-", "5"}], ")"}], " ", 
           SuperscriptBox["pp2", "2"]}]}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"-", "bb"}], " ", 
        SuperscriptBox["pp2", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"rho", "-", "1"}], ")"}], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "rho"}], "-", "3"}], ")"}], "2"]}], ",", 
       RowBox[{"3", " ", "bb", " ", 
        SuperscriptBox["pp2", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"rho", "-", "1"}], ")"}], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "rho"}], "-", "3"}], ")"}], "2"]}], ",", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "bb", " ", 
        SuperscriptBox["pp2", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"rho", "-", "1"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"rho", "-", "2"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "rho"}], "-", "3"}], ")"}]}], ",", 
       RowBox[{"bb", " ", 
        SuperscriptBox["pp2", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"rho", "-", "2"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "rho"}], "-", "5"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "rho"}], "-", "3"}], ")"}]}]}], "}"}]}], "]"}]}], 
  ";", 
  RowBox[{"coefficientSimp", "=", 
   RowBox[{"Factor", "/@", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"coefficientTemplate", ",", "assumptionsTop"}], "]"}]}]}], ";", 
  RowBox[{"coefficientNames", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<A1\>\"", ",", "\"\<A2\>\"", ",", "\"\<A3\>\"", 
     ",", "\"\<B\>\"", ",", "\"\<D\>\""}], "}"}]}], ";", 
  RowBox[{"Grid", "[", 
   RowBox[{
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#1", ",", 
         RowBox[{"formTop", "[", "#2", "]"}]}], "}"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"coefficientNames", ",", "coefficientSimp"}], "}"}]}], "]"}], ",", 
    RowBox[{"Frame", "\[Rule]", "All"}], ",", 
    RowBox[{"Alignment", "\[Rule]", "Left"}]}], "]"}]}]], "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"df9cc151-d11d-7148-ba2b-74ed43c1796d"],

