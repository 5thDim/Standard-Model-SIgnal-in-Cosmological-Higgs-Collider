Cell[BoxData[
 InterpretationBox[
  StyleBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "1"}], "/", "4"}], "*", "I"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "16"}], "*", 
             RowBox[{"del", "^", "2"}]}], " ", "-", " ", 
            RowBox[{"56", "*", 
             RowBox[{"del", "^", "3"}]}], " ", "-", " ", 
