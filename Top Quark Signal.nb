                          "\[LeftDoubleBracket]", "2", 
                          "\[RightDoubleBracket]"}]}]}], "]"}]}]}], "]"}]}], 
              ";", RowBox[{"AssociateTo", "[", RowBox[
                 {"topQuarkNumericalCache", ",", RowBox[{"key", "\[Rule]", 
                    "result"}]}], "]"}], ";", "result"}]}], "]"}]}], ";", 
      "\n", RowBox[{RowBox[{"clearNumericalCache", "[", "]"}], ":=", 
