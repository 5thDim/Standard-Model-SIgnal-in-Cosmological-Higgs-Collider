          "]"}]}]}], "}"}], ",", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "p1Template", ",", "p2Template", ",", "h0Template", ",", 
           "h1Template"}], "}"}], "/.", "\[VeryThinSpace]", 
         RowBox[{"{", 
