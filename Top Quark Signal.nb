             RowBox[{"v", ",", 
              FractionBox["\[Pi]", "2"], ",", 
              FractionBox["\[Pi]", "2"], ",", "0"}], "]"}], "-", 
            RowBox[{"cFromLoopTop", "[", 
             RowBox[{"v", ",", 
              FractionBox["\[Pi]", "2"], ",", 
