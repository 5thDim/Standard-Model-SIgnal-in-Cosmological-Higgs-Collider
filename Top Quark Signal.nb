Cell[CellGroupData[{

Cell["Stable numerical evaluation of the regulated definitions", "Subsection",ExpressionUUID->"93b2d643-fe99-b949-a09a-aa1fbb1c94e7"],

Cell["\<\
For the independent regulator check, a Thomae transformation is used when it \
improves the convergence balance of 3F2(1). The representation has the same \
analytic continuation as the regularized seed. The numerical seed cache \
includes working precision. The derivative is implemented directly using Eq. \
(117).\
\>", "Text",ExpressionUUID->"03ff83d5-0199-cc4e-8267-e4b74e64a1e0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"hyper3RegN", "[", 
    RowBox[{"upper_List", ",", "lower_List", ",", "prec_Integer"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"aa", "=", 
        RowBox[{"N", "[", 
         RowBox[{"upper", ",", "prec"}], "]"}]}], ",", 
       RowBox[{"bb", "=", 
        RowBox[{"N", "[", 
         RowBox[{"lower", ",", "prec"}], "]"}]}], ",", "balance", ",", 
       "choices", ",", "best", ",", "ii", ",", "jj", ",", "c", ",", "pair", ",",
        "d", ",", "e"}], "}"}], ",", 
     RowBox[{
      RowBox[{"balance", "=", 
       RowBox[{
        RowBox[{"Total", "[", "bb", "]"}], "-", 
        RowBox[{"Total", "[", "aa", "]"}]}]}], ";", 
      RowBox[{"choices", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Re", "[", "balance", "]"}], ",", "0", ",", "0"}], "}"}], 
          "}"}], ",", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Re", "[", 
                RowBox[{
                 RowBox[{
                 "bb", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}],
                  "-", 
                 RowBox[{
                 "aa", "\[LeftDoubleBracket]", "i", 
                  "\[RightDoubleBracket]"}]}], "]"}], ",", "i", ",", "j"}], 
              "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "3"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "2"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
        "]"}]}], ";", 
      RowBox[{"best", "=", 
       RowBox[{"First", "[", 
        RowBox[{"MaximalBy", "[", 
         RowBox[{"choices", ",", "First"}], "]"}], "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
         "best", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "\[Equal]",
          "0"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"HypergeometricPFQRegularized", "[", 
            RowBox[{"aa", ",", "bb", ",", "1"}], "]"}], ",", "prec"}], "]"}], 
         "]"}]}], "]"}], ";", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ii", ",", "jj"}], "}"}], "=", 
       RowBox[{"Rest", "[", "best", "]"}]}], ";", 
      RowBox[{"c", "=", 
       RowBox[{
       "aa", "\[LeftDoubleBracket]", "ii", "\[RightDoubleBracket]"}]}], ";", 
      RowBox[{"pair", "=", 
       RowBox[{"Delete", "[", 
        RowBox[{"aa", ",", "ii"}], "]"}]}], ";", 
      RowBox[{"e", "=", 
       RowBox[{
       "bb", "\[LeftDoubleBracket]", "jj", "\[RightDoubleBracket]"}]}], ";", 
      RowBox[{"d", "=", 
       RowBox[{"bb", "\[LeftDoubleBracket]", 
        RowBox[{"3", "-", "jj"}], "\[RightDoubleBracket]"}]}], ";", 
      RowBox[{"N", "[", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"Gamma", "[", "balance", "]"}], " ", 
          RowBox[{"HypergeometricPFQ", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"d", "-", 
               RowBox[{
               "pair", "\[LeftDoubleBracket]", "1", 
                "\[RightDoubleBracket]"}]}], ",", 
              RowBox[{"d", "-", 
               RowBox[{
               "pair", "\[LeftDoubleBracket]", "2", 
                "\[RightDoubleBracket]"}]}], ",", "c"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"d", ",", 
              RowBox[{"balance", "+", "c"}]}], "}"}], ",", "1"}], "]"}]}], 
         RowBox[{
          RowBox[{"Gamma", "[", 
           RowBox[{"e", "-", "c"}], "]"}], " ", 
          RowBox[{"Gamma", "[", 
           RowBox[{"balance", "+", "c"}], "]"}], " ", 
          RowBox[{"Gamma", "[", "d", "]"}]}]], ",", "prec"}], "]"}]}]}], 
    "]"}]}], ";", 
  RowBox[{
   RowBox[{"kSeedN", "[", 
    RowBox[{"a_Integer", ",", "b_Integer", ",", 
     RowBox[{"p_", "?", "NumericQ"}], ",", 
     RowBox[{"q_", "?", "NumericQ"}], ",", 
     RowBox[{"v_", "?", "NumericQ"}], ",", "kap_", ",", "prec_Integer"}], 
    "]"}], ":=", 
   RowBox[{
    RowBox[{"kSeedN", "[", 
     RowBox[{
     "a", ",", "b", ",", "p", ",", "q", ",", "v", ",", "kap", ",", "prec"}], 
     "]"}], "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"pp", "=", 
