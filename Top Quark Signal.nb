Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"softBTop", "[", "v_", "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rho", "=", 
       RowBox[{"rhoTop", "[", "v", "]"}]}], "}"}], ",", 
