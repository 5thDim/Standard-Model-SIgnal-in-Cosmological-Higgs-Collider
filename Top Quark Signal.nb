Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"homogeneous", "=", 
   RowBox[{"Expand", "[", 
    RowBox[{"raw", "/.", 
     RowBox[{
      RowBox[{"HypergeometricPFQRegularized", "[", 
       RowBox[{"_", ",", "_", ",", "1"}], "]"}], "->", "0"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"homCoefficient", "=", 
   RowBox[{"Factor", " ", "/@", " ", 
    RowBox[{"Together", "[", 
     RowBox[{
      RowBox[{"normalize", "[", 
       RowBox[{
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{"2", "del"}], ")"}]}], " ", "homogeneous"}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"gd", "^", "2"}], " ", 
