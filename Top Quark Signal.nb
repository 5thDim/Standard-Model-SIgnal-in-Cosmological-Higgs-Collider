            RowBox[{RowBox[{"frameLabel", "=", RowBox[{"{", RowBox[
                   {StyleBox["\"mass ratio  nu = m_t/H\"", 13, 
                     StripOnInput -> False], ",", "None"}], "}"}]}], ";", 
              RowBox[{"a0ReIm", "=", RowBox[{"ListLinePlot", "[", 
                  RowBox[{RowBox[{"{", RowBox[{RowBox[{RowBox[{"data", 
