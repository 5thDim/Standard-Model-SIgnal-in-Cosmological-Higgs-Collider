Notebook[{

Cell[CellGroupData[{
Cell["Top Quark Signal", "Title",ExpressionUUID->"62338acd-c25a-0d4a-a279-a46cb12edd08"],

Cell["Analytic angular coefficients and mass dependence", "Subtitle",ExpressionUUID->"f7f653db-140a-8745-ade7-5200f0e1303b"],

Cell[CellGroupData[{

Cell["1. Conventions and scalar soft-loop seeds", "Section",ExpressionUUID->"ea5346b7-1db7-4544-bbfd-47da94e9505c"],

Cell["\<\
The target is the five complex angular coefficients in SMS in CHC, Eq. (65). \
nu = mt/H > 0. All results below use the positive soft branch and the phase \
convention (ks^2/(4 k12 k34))^(2 I nu) in Eq. (63). Nc, gt and the overall \
momentum/H factors in Eq. (63) are excluded. Outputs and native Mathematica \
plots are saved in this notebook; no external files are needed to inspect or \
reevaluate it. Evaluate from the beginning in a fresh kernel.\
\>", "Text",ExpressionUUID->"855eb147-a5ad-2d4a-b63e-d8a1ea2ceb39"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BeginPackage", "[", "\"\<TopQuarkSignal`\>\"", "]"}], ";", 
  RowBox[{"ClearAll", "[", "\"\<TopQuarkSignal`*\>\"", "]"}], ";"}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"90dabbca-c9ec-f248-abf5-560fad0f4694"],

Cell[BoxData[
 RowBox[{
  RowBox[{"wp", "=", "50"}], ";", 
  RowBox[{"massMin", "=", 
   FractionBox["1", "10"]}], ";", 
  RowBox[{"massMax", "=", "5"}], ";", 
  RowBox[{"assumptionsTop", "=", 
   RowBox[{"nu", ">", "0"}]}], ";", 
  RowBox[{
   RowBox[{"formTop", "[", "expr_", "]"}], ":=", 
   RowBox[{"TraditionalForm", "@@", 
    RowBox[{"{", "expr", "}"}]}]}], ";", 
  RowBox[{"nu", "/:", 
   RowBox[{"MakeBoxes", "[", 
    RowBox[{"nu", ",", "TraditionalForm"}], "]"}], ":=", "\"\<\[Nu]\>\""}], ";", 
  RowBox[{"pp1", "/:", 
   RowBox[{"MakeBoxes", "[", 
    RowBox[{"pp1", ",", "TraditionalForm"}], "]"}], ":=", 
   RowBox[{"SubscriptBox", "[", 
    RowBox[{"\"\<P\>\"", ",", "\"\<1\>\""}], "]"}]}], ";", 
  RowBox[{"pp2", "/:", 
   RowBox[{"MakeBoxes", "[", 
    RowBox[{"pp2", ",", "TraditionalForm"}], "]"}], ":=", 
   RowBox[{"SubscriptBox", "[", 
    RowBox[{"\"\<P\>\"", ",", "\"\<2\>\""}], "]"}]}], ";", 
  RowBox[{"q00", "/:", 
   RowBox[{"MakeBoxes", "[", 
    RowBox[{"q00", ",", "TraditionalForm"}], "]"}], ":=", 
   RowBox[{"SubscriptBox", "[", 
    RowBox[{"\"\<Q\>\"", ",", "\"\<00\>\""}], "]"}]}], ";", 
  RowBox[{"tGamma", "/:", 
   RowBox[{"MakeBoxes", "[", 
    RowBox[{"tGamma", ",", "TraditionalForm"}], "]"}], ":=", "\"\<T\>\""}], ";", 
  RowBox[{"eEndpoint", "/:", 
   RowBox[{"MakeBoxes", "[", 
    RowBox[{"eEndpoint", ",", "TraditionalForm"}], "]"}], ":=", "\"\<E\>\""}],
   ";", 
  RowBox[{"bb", "/:", 
   RowBox[{"MakeBoxes", "[", 
    RowBox[{"bb", ",", "TraditionalForm"}], "]"}], 
   ":=", "\"\<\[ScriptCapitalB]\>\""}], ";", 
  RowBox[{"gSymbol", "/:", 
   RowBox[{"MakeBoxes", "[", 
    RowBox[{"gSymbol", ",", "TraditionalForm"}], "]"}], 
   ":=", "\"\<\[ScriptCapitalG]\>\""}], ";"}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"a01b745e-71c1-544c-b3c0-7f73e82aa308"],

Cell["\<\
Exact rational constants are retained until numerical evaluation. \
FullSimplify is applied with explicit assumptions and a finite search time; \
its output need not be a unique shortest form. I and D retain their built-in \
Mathematica meanings. softBTop denotes the common factor in Eq. (119); BTop \
denotes the angular coefficient.\
\>", "Text",ExpressionUUID->"7cf2b2d6-c62a-1743-99ce-5e2ffdf77561"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f0Top", "[", 
    RowBox[{"alpha_", ",", "beta_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"alpha", "+", "beta", "-", 
       FractionBox["3", "2"]}], "]"}], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{
       FractionBox["3", "2"], "-", "alpha"}], "]"}], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{
       FractionBox["3", "2"], "-", "beta"}], "]"}]}], 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"3", "-", "alpha", "-", "beta"}], "]"}], " ", 
     RowBox[{"Gamma", "[", "alpha", "]"}], " ", 
     RowBox[{"Gamma", "[", "beta", "]"}]}]]}], ";", 
  RowBox[{
   RowBox[{"rhoTop", "[", "v_", "]"}], ":=", 
   RowBox[{
    FractionBox["1", "2"], "-", 
    RowBox[{"\[ImaginaryI]", " ", "v"}]}]}], ";", 
  RowBox[{
   RowBox[{"gTop", "[", "v_", "]"}], ":=", 
   RowBox[{"f0Top", "[", 
    RowBox[{
     RowBox[{"rhoTop", "[", "v", "]"}], ",", 
     RowBox[{"rhoTop", "[", "v", "]"}]}], "]"}]}], ";", 
  TagBox[GridBox[{
     {"\"\<rho(nu)\>\"", 
      RowBox[{"formTop", "[", 
       RowBox[{"rhoTop", "[", "nu", "]"}], "]"}]},
     {"\"\<f0(alpha,beta)\>\"", 
      RowBox[{"formTop", "[", 
       RowBox[{"f0Top", "[", 
        RowBox[{"alpha", ",", "beta"}], "]"}], "]"}]},
     {"\"\<soft-line scalar coefficient (eta = +/-1)\>\"", 
      RowBox[{"formTop", "[", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{
          SuperscriptBox["4", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", "eta", " ", "nu"}]], " ", 
          SuperscriptBox[
           RowBox[{"Gamma", "[", 
            RowBox[{
             FractionBox["1", "2"], "-", 
             RowBox[{"\[ImaginaryI]", " ", "eta", " ", "nu"}]}], "]"}], 
           "2"]}], 
         RowBox[{"4", " ", "\[Pi]"}]]}], "]"}]}
    },
    AutoDelete->False,
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
   "Grid"]}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"3656286c-9533-f54f-aa58-37412ef7f6b2"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"rho(nu)\"\>", 
     TagBox[
      FormBox[
       RowBox[{
        FractionBox["1", "2"], "-", 
        RowBox[{"\[ImaginaryI]", " ", "\[Nu]"}]}],
       TraditionalForm],
      TraditionalForm,
      Editable->True]},
    {"\<\"f0(alpha,beta)\"\>", 
     TagBox[
      FormBox[
       FractionBox[
        RowBox[{
         TemplateBox[{
           RowBox[{
             FractionBox["3", "2"], "-", "alpha"}]},
          "Gamma"], " ", 
         TemplateBox[{
           RowBox[{
             FractionBox["3", "2"], "-", "beta"}]},
          "Gamma"], " ", 
         TemplateBox[{
           RowBox[{"alpha", "+", "beta", "-", 
             FractionBox["3", "2"]}]},
          "Gamma"]}], 
        RowBox[{
         TemplateBox[{"alpha"},
          "Gamma"], " ", 
         TemplateBox[{"beta"},
          "Gamma"], " ", 
         TemplateBox[{
           RowBox[{
             RowBox[{"-", "alpha"}], "-", "beta", "+", "3"}]},
          "Gamma"]}]],
       TraditionalForm],
      TraditionalForm,
      Editable->True]},
    {"\<\"soft-line scalar coefficient (eta = +/-1)\"\>", 
     TagBox[
      FormBox[
       RowBox[{"-", 
        FractionBox[
         RowBox[{
          SuperscriptBox["4", 
           RowBox[{
            RowBox[{"-", "1"}], "-", 
            RowBox[{"\[ImaginaryI]", " ", "eta", " ", "\[Nu]"}]}]], " ", 
          SuperscriptBox[
           TemplateBox[{
             RowBox[{
               FractionBox["1", "2"], "-", 
               RowBox[{"\[ImaginaryI]", " ", "eta", " ", "\[Nu]"}]}]},
            "Gamma"], "2"]}], "\[Pi]"]}],
       TraditionalForm],
      TraditionalForm,
      Editable->True]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellChangeTimes->{4.001754271267769*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"abeda191-2463-ad49-9ee7-98f0ee8efab6"]
}, Open  ]],

Cell["\<\
f0 is the analytically continued convolution of Sec. 2.1. Both f0 and Iij \
exclude the universal loop factor (4 Pi)^(-3/2), which remains explicit in \
Ctop. The first saved simplification is the common Gamma factor Gtop in Eq. \
(108).\
\>", "Text",ExpressionUUID->"094252be-f821-dd49-a9d4-6a52549f8b9d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"gTopSimp", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"gTop", "[", "nu", "]"}], ",", "assumptionsTop", ",", 
     RowBox[{"TimeConstraint", "\[Rule]", "8"}]}], "]"}]}], ";", 
  RowBox[{"formTop", "[", "gTopSimp", "]"}]}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"57bd1646-8ded-5c45-8547-5b48cb29d565"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{
    SuperscriptBox[
     TemplateBox[{
       RowBox[{
         RowBox[{"\[ImaginaryI]", " ", "\[Nu]"}], "+", "1"}]},
      "Gamma"], "2"], " ", 
    TemplateBox[{
      RowBox[{
        RowBox[{
          RowBox[{"-", "2"}], " ", "\[ImaginaryI]", " ", "\[Nu]"}], "-", 
        FractionBox["1", "2"]}]},
     "Gamma"]}], 
   RowBox[{
    SuperscriptBox[
     TemplateBox[{
       RowBox[{
         FractionBox["1", "2"], "-", 
         RowBox[{"\[ImaginaryI]", " ", "\[Nu]"}]}]},
      "Gamma"], "2"], " ", 
    TemplateBox[{
      RowBox[{
        RowBox[{"2", " ", "\[ImaginaryI]", " ", "\[Nu]"}], "+", "2"}]},
     "Gamma"]}]], TraditionalForm]], "Output",
 CellChangeTimes->{4.001754271430372*^9},
 CellLabel->
  "Out[4]//TraditionalForm=",ExpressionUUID->"d5666231-d892-8046-8fd1-\
56cc117243e2"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gTopPaper", "[", "v_", "]"}], ":=", 
   FractionBox[
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], "-", 
       RowBox[{"2", " ", "\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
     SuperscriptBox[
      RowBox[{"Gamma", "[", 
       RowBox[{"1", "+", 
        RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}], "2"]}], 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"2", "+", 
       RowBox[{"2", " ", "\[ImaginaryI]", " ", "v"}]}], "]"}], " ", 
     SuperscriptBox[
      RowBox[{"Gamma", "[", 
       RowBox[{
        FractionBox["1", "2"], "-", 
        RowBox[{"\[ImaginaryI]", " ", "v"}]}], "]"}], "2"]}]]}], ";", 
  RowBox[{"softGammaCheck", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"gTop", "[", "nu", "]"}], "-", 
      RowBox[{"gTopPaper", "[", "nu", "]"}]}], ",", "assumptionsTop"}], 
    "]"}]}], ";", "softGammaCheck"}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"db346ec8-bcfc-9e44-a544-ece7523733ce"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{4.0017542714651337`*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"1e1feead-e65e-2943-88de-c9317b0d04ac"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Scalar moments and Gamma recurrence", "Subsection",ExpressionUUID->"37da789e-2890-4943-aecf-f78ced4216ce"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"frTop", "[", 
    RowBox[{"ell_Integer", ",", "alpha_", ",", "beta_"}], "]"}], ":=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"u", "=", "0"}], "ell"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"v", "=", "0"}], 
      RowBox[{"ell", "-", "u"}]], 
     FractionBox[
      RowBox[{
       RowBox[{"ell", "!"}], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{"ell", "-", "u"}]], " ", 
       RowBox[{"f0Top", "[", 
        RowBox[{
         RowBox[{"alpha", "+", 
          FractionBox["ell", "2"], "-", "v"}], ",", 
         RowBox[{"beta", "-", "u"}]}], "]"}]}], 
      RowBox[{
       SuperscriptBox["2", "ell"], " ", 
       RowBox[{"u", "!"}], " ", 
       RowBox[{"v", "!"}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"ell", "-", "u", "-", "v"}], ")"}], "!"}]}]]}]}]}], ";", 
  RowBox[{
   RowBox[{"jTop", "[", 
    RowBox[{"ell_Integer", ",", "m_Integer", ",", "n_Integer", ",", "x_"}], 
    "]"}], ":=", 
   RowBox[{"frTop", "[", 
    RowBox[{"ell", ",", 
     RowBox[{"x", "-", 
      FractionBox["m", "2"]}], ",", 
     RowBox[{"x", "+", 
      FractionBox["n", "2"]}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"shiftRatioTop", "[", 
    RowBox[{"j_Integer", ",", "k_Integer", ",", "rho_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{
     RowBox[{"Pochhammer", "[", 
      RowBox[{
       RowBox[{
        FractionBox["3", "2"], "-", "rho"}], ",", "j"}], "]"}], " ", 
     RowBox[{"Pochhammer", "[", 
      RowBox[{
       RowBox[{
        FractionBox["3", "2"], "-", "rho"}], ",", "k"}], "]"}], " ", 
     RowBox[{"Pochhammer", "[", 
      RowBox[{
       RowBox[{"1", "-", "rho"}], ",", "j"}], "]"}], " ", 
     RowBox[{"Pochhammer", "[", 
      RowBox[{
       RowBox[{"1", "-", "rho"}], ",", "k"}], "]"}]}], 
    RowBox[{
     RowBox[{"Pochhammer", "[", 
      RowBox[{
       RowBox[{
        FractionBox["5", "2"], "-", 
        RowBox[{"2", " ", "rho"}]}], ",", 
       RowBox[{"j", "+", "k"}]}], "]"}], " ", 
     RowBox[{"Pochhammer", "[", 
      RowBox[{
       RowBox[{"3", "-", 
        RowBox[{"2", " ", "rho"}]}], ",", 
       RowBox[{"j", "+", "k"}]}], "]"}]}]]}], ";", 
  RowBox[{
   RowBox[{"jRatioTop", "[", 
    RowBox[{"ell_Integer", ",", "m_Integer", ",", "v_"}], "]"}], ":=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"u", "=", "0"}], "ell"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"w", "=", "0"}], 
      RowBox[{"ell", "-", "u"}]], 
     FractionBox[
      RowBox[{
       RowBox[{"ell", "!"}], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{"ell", "-", "u"}]], " ", 
       RowBox[{"shiftRatioTop", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"m", "+", "1", "-", "ell"}], ")"}]}], "+", "w"}], ",", 
         "u", ",", 
         RowBox[{"rhoTop", "[", "v", "]"}]}], "]"}]}], 
      RowBox[{
       SuperscriptBox["2", "ell"], " ", 
       RowBox[{"u", "!"}], " ", 
       RowBox[{"w", "!"}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"ell", "-", "u", "-", "w"}], ")"}], "!"}]}]]}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"5f87b9e4-450c-ff48-8f17-2079d0ac58bb"],

Cell["\<\
shiftRatioTop(j,k,rho) = f0(rho-j,rho-k)/f0(rho,rho), obtained by Gamma \
recurrence. jRatioTop is J_ell(m,1;-I nu)/f0(rho,rho) for the integer shifts \
used below. This extracts the common Gamma factor before FullSimplify, \
leaving rational algebra.\
\>", "Text",ExpressionUUID->"6680c050-ccf3-b743-8c6d-2cecbfda4db4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Soft-loop coefficients I11, I12, I21 and I22", "Section",ExpressionUUID->"20c618d4-2d2d-9344-a394-416e264bea83"],

Cell["\<\
Eq. (107) is reduced in the basis {1, S, TB, TD}, where S = cos(theta1)^2 + \
cos(theta3)^2 - 3 cos(theta1)^2 cos(theta3)^2, TB = sin(2 theta1) sin(2 \
theta3) cos(phi3), TD = sin(theta1)^2 sin(theta3)^2 cos(2 phi3). The \
following five entries are I12 and the four components of I22, divided by \
Gtop.\
\>", "Text",ExpressionUUID->"0dc8a26a-e459-d847-ba5f-cf7d9dc69a33"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"loopJExpressions", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"jSym", "[", 
          RowBox[{"0", ",", "3"}], "]"}], "-", 
         RowBox[{"jSym", "[", 
          RowBox[{"2", ",", "3"}], "]"}], "+", 
         RowBox[{"jSym", "[", 
          RowBox[{"1", ",", "2"}], "]"}], "-", 
         RowBox[{"jSym", "[", 
          RowBox[{"3", ",", "2"}], "]"}]}], ")"}]}], "+", 
      RowBox[{
       FractionBox["1", "4"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"jSym", "[", 
          RowBox[{"0", ",", "1"}], "]"}], "-", 
         RowBox[{"jSym", "[", 
          RowBox[{"2", ",", "1"}], "]"}]}], ")"}]}]}], ",", 
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"4", ",", "3"}], "]"}]}], "-", 
        RowBox[{"3", " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"2", ",", "3"}], "]"}]}], "+", 
        RowBox[{"jSym", "[", 
         RowBox[{"0", ",", "3"}], "]"}], "+", 
        RowBox[{"jSym", "[", 
         RowBox[{"3", ",", "2"}], "]"}], "-", 
        RowBox[{"jSym", "[", 
         RowBox[{"1", ",", "2"}], "]"}]}], ")"}]}], ",", 
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "6"}], " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"4", ",", "3"}], "]"}]}], "+", 
        RowBox[{"7", " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"2", ",", "3"}], "]"}]}], "-", 
        RowBox[{"jSym", "[", 
         RowBox[{"0", ",", "3"}], "]"}], "+", 
        RowBox[{"5", " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"1", ",", "2"}], "]"}]}], "-", 
        RowBox[{"5", " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"3", ",", "2"}], "]"}]}], "+", 
        RowBox[{"jSym", "[", 
         RowBox[{"0", ",", "1"}], "]"}], "-", 
        RowBox[{"jSym", "[", 
         RowBox[{"2", ",", "1"}], "]"}]}], ")"}]}], ",", 
     RowBox[{
      FractionBox["1", "16"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "16"}], " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"4", ",", "3"}], "]"}]}], "+", 
        RowBox[{"14", " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"2", ",", "3"}], "]"}]}], "-", 
        RowBox[{"2", " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"0", ",", "3"}], "]"}]}], "+", 
        RowBox[{"10", " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"1", ",", "2"}], "]"}]}], "-", 
        RowBox[{"18", " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"3", ",", "2"}], "]"}]}], "+", 
        RowBox[{"2", " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"0", ",", "1"}], "]"}]}], "-", 
        RowBox[{"7", " ", 
         RowBox[{"jSym", "[", 
          RowBox[{"2", ",", "1"}], "]"}]}], "-", 
        RowBox[{"jSym", "[", 
         RowBox[{"1", ",", "0"}], "]"}]}], ")"}]}], ",", 
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"jSym", "[", 
         RowBox[{"4", ",", "3"}], "]"}], "-", 
        RowBox[{"jSym", "[", 
         RowBox[{"2", ",", "3"}], "]"}], "+", 
        RowBox[{"jSym", "[", 
         RowBox[{"3", ",", "2"}], "]"}], "-", 
        RowBox[{"jSym", "[", 
         RowBox[{"1", ",", "2"}], "]"}]}], ")"}]}]}], "}"}]}], ";", 
  RowBox[{"loopRatios", "=", 
   RowBox[{"Factor", "/@", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"loopJExpressions", "/.", "\[VeryThinSpace]", 
       RowBox[{
        RowBox[{"jSym", "[", 
         RowBox[{"ell_", ",", "m_"}], "]"}], "\[RuleDelayed]", 
        RowBox[{"jRatioTop", "[", 
