                     {"PlotLabel", "\[Rule]", 
                      "\"Magnitude versus mass\""}]}], "]"}]}], ";", 
              RowBox[{"phases", "=", RowBox[{"ListLinePlot", "[", 
                  RowBox[{RowBox[{"{", RowBox[{RowBox[{RowBox[{"data", 
                          "\[LeftDoubleBracket]", RowBox[{"All", ",", RowBox[
                          {"{", RowBox[{"1", ",", "2"}], "}"}]}], 
                          "\[RightDoubleBracket]"}], "/.", 
                          "\[VeryThinSpace]", RowBox[{RowBox[{"{", RowBox[
