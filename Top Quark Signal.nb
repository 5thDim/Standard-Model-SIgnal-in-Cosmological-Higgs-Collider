Cell["\<\
Gamma recurrence and reflection now remove all three K factors. With \
T=Gamma[del]^2 Gamma[2u+del]^2/((u+del)^2 Sin[Pi(u+del)] Gamma[u+del]^2 \
Gamma[A]), their reduced forms are K_minus=u del^2 T Sin[Pi(2u+del)], \
K_plus=-u(2u+del)^2 T Sin[Pi del], K_G=-u del(2u+del) T Sin[Pi del]. The sine \
addition formula then gives the following exact master combination. Only Hdel \
survives as a hypergeometric function.\
\>", "Text",ExpressionUUID->"35ae8dac-4bb3-449a-b5a9-bd4fdddb3c75"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"connectionT", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Gamma", "[", "del", "]"}], "^", "2"}], " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Gamma", "[", 
       RowBox[{
        RowBox[{"2", "u"}], "+", "del"}], "]"}], "^", "2"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"u", "+", "del"}], ")"}], "^", "2"}], " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"Pi", 
         RowBox[{"(", 
          RowBox[{"u", "+", "del"}], ")"}]}], "]"}], " ", 
       RowBox[{
        RowBox[{"Gamma", "[", 
         RowBox[{"u", "+", "del"}], "]"}], "^", "2"}], " ", 
       RowBox[{"Gamma", "[", "aMaster", "]"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kReduced", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"u", " ", 
      RowBox[{"del", "^", "2"}], " ", "connectionT", " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"Pi", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "u"}], "+", "del"}], ")"}]}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"-", "u"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "u"}], "+", "del"}], ")"}], "^", "2"}], " ", 
      "connectionT", " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"Pi", " ", "del"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"-", "u"}], " ", "del", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "u"}], "+", "del"}], ")"}], " ", "connectionT", " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"Pi", " ", "del"}], "]"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mGamma", "=", 
   RowBox[{"2", "u", " ", "I", " ", 
    RowBox[{"2", "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "2"}], "del"}], ")"}]}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", "Pi", 
      RowBox[{"(", 
       RowBox[{"u", "+", "del"}], ")"}]}], "]"}], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"Pi", " ", "u"}], "]"}], " ", 
    RowBox[{
     RowBox[{"Gamma", "[", "del", "]"}], "^", "2"}], " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Gamma", "[", 
       RowBox[{
        RowBox[{"2", "u"}], "+", "del"}], "]"}], "^", "2"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"u", "+", "del"}], ")"}], "^", "2"}], " ", 
       RowBox[{
        RowBox[{"Gamma", "[", 
         RowBox[{"u", "+", "del"}], "]"}], "^", "2"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mHcoef", "=", 
   RowBox[{"I", " ", 
    RowBox[{"2", "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "2"}], "del"}], ")"}]}], " ", 
    RowBox[{"Gamma", "[", "aMaster", "]"}], " ", "2", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"Pi", 
       RowBox[{"(", 
        RowBox[{"u", "+", "del"}], ")"}]}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "u"}], "+", "del"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"1", "+", "u"}], ")"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"fmt", "[", 
  RowBox[{"mGamma", "+", 
   RowBox[{"mHcoef", " ", "hDel"}]}], "]"}]}], "Input",
 ShowCellLabel->False,
 CellTags->
