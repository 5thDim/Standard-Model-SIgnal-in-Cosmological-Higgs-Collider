         RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]}]], "+", 
       RowBox[{"topR2", "[", "nu", "]"}]}]}], "}"}]}]}], ";", 
  RowBox[{"topTemplateSub", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"q00", "\[Rule]", 
      FractionBox[
       RowBox[{
        SuperscriptBox["2", 
         RowBox[{
          RowBox[{"-", "1"}], "-", 
          RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]}]], " ", 
        RowBox[{"Gamma", "[", 
         RowBox[{"1", "+", 
          RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]}], "]"}], " ", 
        "ff"}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]}], ")"}], "2"]]}], ",", 
     RowBox[{"tGamma", "\[Rule]", 
      RowBox[{
       SuperscriptBox["2", 
        RowBox[{
         RowBox[{"-", "1"}], "-", 
         RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]}]], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{"1", "+", 
         RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]}], "]"}]}]}], ",", 
     RowBox[{"eEndpoint", "\[Rule]", 
      RowBox[{
       SuperscriptBox["2", 
        RowBox[{
         RowBox[{"-", "1"}], "-", 
         RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]}]], " ", 
       RowBox[{"topTPaper", "[", "nu", "]"}], " ", "ee"}]}]}], "}"}]}], ";", 
  RowBox[{"topPExactCheck", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p1Template", ",", "p2Template"}], "}"}], "/.", 
        "\[VeryThinSpace]", "topTemplateSub"}], ")"}], "-", "topPReduced"}], ",", 
     RowBox[{"nu", ">", "0"}], ",", 
     RowBox[{"TimeConstraint", "\[Rule]", "15"}]}], "]"}]}], ";", 
  RowBox[{"topPExplicit", "=", 
   RowBox[{"topPReduced", "/.", "\[VeryThinSpace]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ff", "\[Rule]", 
       RowBox[{"topMaster", "[", "nu", "]"}]}], ",", 
      RowBox[{"ee", "\[Rule]", 
       RowBox[{"topEPaper", "[", "nu", "]"}]}]}], "}"}]}]}], ";", 
  RowBox[{"topPFullSimplify", "=", 
   RowBox[{
    RowBox[{"(", 
