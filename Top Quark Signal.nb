              FractionBox["7", "5"], "]"}], " ", 
             RowBox[{"Cos", "[", 
              FractionBox["9", "10"], "]"}]}], ",", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"Sin", "[", 
               FractionBox["2", "5"], "]"}], "2"], " ", 
             SuperscriptBox[
              RowBox[{"Sin", "[", 
               FractionBox["7", "10"], "]"}], "2"], " ", 
             RowBox[{"Cos", "[", 
              FractionBox["9", "5"], "]"}]}]}], "}"}]}]}], ";", 
        RowBox[{"projectedB", "=", 
         RowBox[{
          FractionBox["1", "2"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"cFromLoopTop", "[", 
             RowBox[{"v", ",", 
              FractionBox["\[Pi]", "4"], ",", 
              FractionBox["\[Pi]", "4"], ",", "0"}], "]"}], "-", 
            RowBox[{"cFromLoopTop", "[", 
             RowBox[{"v", ",", 
              FractionBox["\[Pi]", "4"], ",", 
              FractionBox["\[Pi]", "4"], ",", "\[Pi]"}], "]"}]}], ")"}]}]}], ";", 
        RowBox[{"projectedD", "=", 
