            RowBox[{"3", "/", "2"}], "+", "n"}]}]}], "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"I", " ", "a"}], ")"}], "^", "m"}], 
         RowBox[{
