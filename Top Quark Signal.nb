                         {"SetPrecision", "[", RowBox[{"x", ",", 
                          "workingPrecision"}], "]"}]}], ";", RowBox[
                       {"amplitudes", "=", RowBox[{"numericalFinitePart", 
                          "[", RowBox[{"nuValue", ",", "workingPrecision", 
                          ",", "regulatorScale"}], "]"}]}], ";", RowBox[
                       {"Association", "[", RowBox[{RowBox[{"\"nu\"", 
                          "\[Rule]", "nuValue"}], ",", RowBox[{"\"A0S\"", 
                          "\[Rule]", RowBox[{"amplitudes", 
                          "\[LeftDoubleBracket]", "1", 
