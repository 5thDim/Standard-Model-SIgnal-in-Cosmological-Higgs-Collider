                RowBox[{"{", RowBox[{"x", ",", RowBox[{"data", "[", 
                      "\"A0S\"", "]"}], ",", RowBox[{"data", "[", "\"A13S\"", 
                      "]"}]}], "}"}]}], "]"}], ",", 
            RowBox[{"{", RowBox[{"x", ",", "grid"}], "}"}]}], "]"}]}], ";", 
      "\n", RowBox[{RowBox[{"massDependencePlots", "[", "data_List", "]"}], 
