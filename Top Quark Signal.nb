Notebook[{Cell["Top Quark Signal in the Cosmological Higgs Collider", 
   "Title"], 
  Cell["Symmetric soft-line box amplitudes  A0^(S)(nu)  and  A13^(S)(nu)", 
   "Subtitle"], Cell["This self-contained notebook implements Top Quark \
Signal.pdf, Eqs. (65)-(76) and Appendix A, Eqs. (121)-(141). The mass \
variable is nu = m_t/H > 0. Every definition below is an ordinary Mathematica \
Input cell; no external .wl file is loaded.", "Text"], 
  Cell["Conventions and symbols", "Section"], Cell["The f=+ clock branch is \
calculated explicitly. The f=- branch is its complex conjugate. All symbolic \
simplifications assume real positive nu.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", 
        RowBox[{"kSeed", ",", "iSeedCore", ",", "jSeedCore", ",", "iSeed", 
          ",", "jSeed", ",", "aOne", ",", "aTwo", ",", "bOne", ",", "bTwo", 
          ",", "uOne", ",", "uTwo", ",", "vOne", ",", "vTwo", ",", "sOne", 
          ",", "sTwo", ",", "sThree", ",", "sFour", ",", "wOne", ",", "wTwo", 
          ",", "typeOneSeed", ",", "typeOneBarSeed", ",", "typeTwoSeed", ",", 
          "typeThreeSeed", ",", "minusKRotation", ",", "qSeedSum", ",", 
          "qTypeOne", ",", "qTypeOneBar", ",", "qTypeTwo", ",", "qTypeThree", 
          ",", "qCoefficientData", ",", "rZero", ",", "rOne", ",", 
          "kappaPlus", ",", "fZeroBubble", ",", "commonPrefactor", ",", 
          "regulatedAmplitudePair", ",", "a0SRegulated", ",", 
          "a13SRegulated", ",", "a0SExact", ",", "a13SExact", ",", "a0SMass", 
          ",", "a13SMass", ",", "fullySimplifiedAmplitudes", ",", 
          "numericalAmplitudeData", ",", "clearNumericalCache", ",", 
          "topQuarkNumericalCache", ",", "numericalFinitePart", ",", 
          "massDependenceTable", ",", "massDependencePlots", ",", 
          "paperConsistencyChecks"}], "]"}], ";", "\n", 
      RowBox[{"$Assumptions", "=", RowBox[
         {RowBox[{"nu", "\[Element]", TemplateBox[{}, "Reals"]}], "&&", 
          RowBox[{"nu", ">", "0"}]}]}]}]], "Input"], 
  Cell["Closed-form hard fermion seeds", "Section"], 
  Cell["K, I, and J functions", "Subsection"], Cell["Definitions of the \
factorized seed K and the two nested seeds I and J from Eqs. (67)-(69), \
equivalently Eqs. (130), (131), and (140). HypergeometricPFQRegularized is \
Mathematica's regularized 4F3.", "Text"], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"kSeed", "[", RowBox[{"nu_", ",", "p1_", ",", "p2_", 
            ",", "x_", ",", "y_"}], "]"}], ":=", FractionBox[
         RowBox[{RowBox[{"Exp", "[", RowBox[{FractionBox["1", "2"], " ", 
               "\[ImaginaryI]", " ", "\[Pi]", " ", RowBox[{"(", 
                 RowBox[{"p1", "-", "p2"}], ")"}]}], "]"}], " ", 
           RowBox[{"Gamma", "[", RowBox[{"1", "+", "p1", "-", RowBox[
                {"\[ImaginaryI]", " ", "nu"}]}], "]"}], " ", 
           RowBox[{"Gamma", "[", RowBox[{"1", "+", "p1", "+", RowBox[
                {"\[ImaginaryI]", " ", "nu"}]}], "]"}], " ", 
           RowBox[{"Gamma", "[", RowBox[{"1", "+", "p2", "-", RowBox[
                {"\[ImaginaryI]", " ", "nu"}]}], "]"}], " ", 
           RowBox[{"Gamma", "[", RowBox[{"1", "+", "p2", "+", RowBox[
                {"\[ImaginaryI]", " ", "nu"}]}], "]"}]}], 
         RowBox[{SuperscriptBox["2", RowBox[{"2", "+", "p1", "+", "p2"}]], 
           " ", RowBox[{"Gamma", "[", RowBox[{"p1", "+", "x"}], "]"}], " ", 
           RowBox[{"Gamma", "[", RowBox[{"p2", "+", "y"}], "]"}]}]]}], ";", 
      "\n", RowBox[{RowBox[{"iSeedCore", "[", RowBox[{"nu_", ",", "p1_", ",", 
            "p2_", ",", "x_", ",", "y_", ",", "z_"}], "]"}], ":=", 
        FractionBox[RowBox[{RowBox[{"Exp", "[", RowBox[{RowBox[
                {"-", "\[Pi]"}], " ", "nu"}], "]"}], " ", 
           RowBox[{"Gamma", "[", RowBox[{"1", "+", "p1", "-", RowBox[
                {"\[ImaginaryI]", " ", "nu"}]}], "]"}], " ", 
           RowBox[{"Gamma", "[", RowBox[{"2", "+", "p1", "+", "p2", "-", 
               RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]}], "]"}], " ", 
           RowBox[{"HypergeometricPFQRegularized", "[", 
             RowBox[{RowBox[{"{", RowBox[{RowBox[{"2", "+", "p1", "+", 
                     "p2"}], ",", RowBox[{"1", "+", "p1", "-", RowBox[
                      {"\[ImaginaryI]", " ", "nu"}]}], ",", "y", ",", 
                   RowBox[{"2", "+", "p1", "+", "p2", "-", RowBox[{"2", " ", 
                       "\[ImaginaryI]", " ", "nu"}]}]}], "}"}], ",", RowBox[
                {"{", RowBox[{RowBox[{"2", "+", "p1", "-", RowBox[
                      {"\[ImaginaryI]", " ", "nu"}]}], ",", RowBox[{"3", "+", 
                     "p1", "+", "p2", "-", "z"}], ",", RowBox[{"1", "-", 
                     RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]}]}], 
                 "}"}], ",", RowBox[{"-", "1"}]}], "]"}]}], 
         RowBox[{"Gamma", "[", "x", "]"}]]}], ";", "\n", 
      RowBox[{RowBox[{"jSeedCore", "[", RowBox[{"nu_", ",", "p1_", ",", 
            "p2_", ",", "x_", ",", "y_", ",", "z_"}], "]"}], ":=", 
        FractionBox[RowBox[{RowBox[{"Exp", "[", RowBox[{"\[Pi]", " ", "nu"}], 
             "]"}], " ", RowBox[{"Gamma", "[", RowBox[{"1", "+", "p1", "-", 
               RowBox[{"\[ImaginaryI]", " ", "nu"}]}], "]"}], " ", 
           RowBox[{"Gamma", "[", RowBox[{"2", "+", "p1", "+", "p2", "-", 
               RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]}], "]"}], " ", 
           RowBox[{"HypergeometricPFQRegularized", "[", 
             RowBox[{RowBox[{"{", RowBox[{RowBox[{"2", "+", "p1", "+", 
                     "p2"}], ",", RowBox[{"1", "+", "p1", "-", RowBox[
                      {"\[ImaginaryI]", " ", "nu"}]}], ",", "y", ",", 
                   RowBox[{"2", "+", "p1", "+", "p2", "-", RowBox[{"2", " ", 
                       "\[ImaginaryI]", " ", "nu"}]}]}], "}"}], ",", RowBox[
                {"{", RowBox[{RowBox[{"2", "+", "p1", "-", RowBox[
                      {"\[ImaginaryI]", " ", "nu"}]}], ",", RowBox[{"3", "+", 
                     "p1", "+", "p2", "-", "z"}], ",", RowBox[{"1", "-", 
                     RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]}]}], 
                 "}"}], ",", RowBox[{"-", "1"}]}], "]"}]}], 
         RowBox[{"Gamma", "[", "x", "]"}]]}], ";", "\n", 
      RowBox[{RowBox[{"iSeed", "[", RowBox[{"nu_", ",", "p1_", ",", "p2_", 
            ",", "x_", ",", "y_", ",", "z_"}], "]"}], ":=", 
        RowBox[{"\[ImaginaryI]", " ", SuperscriptBox["2", 
           RowBox[{RowBox[{"-", "2"}], "-", "p1", "-", "p2"}]], " ", 
          RowBox[{"Exp", "[", RowBox[{FractionBox["1", "2"], " ", 
              RowBox[{"(", RowBox[{"-", "\[ImaginaryI]"}], ")"}], " ", 
              "\[Pi]", " ", RowBox[{"(", RowBox[{"p1", "+", "p2"}], ")"}]}], 
            "]"}], " ", "\[Pi]", " ", RowBox[{"Csch", "[", 
            RowBox[{"2", " ", "\[Pi]", " ", "nu"}], "]"}], " ", 
          RowBox[{"Gamma", "[", RowBox[{"2", "+", "p1", "+", "p2"}], "]"}], 
          " ", RowBox[{"(", RowBox[{RowBox[{"iSeedCore", "[", RowBox[
                 {"nu", ",", "p1", ",", "p2", ",", "x", ",", "y", ",", "z"}], 
                "]"}], "-", RowBox[{"iSeedCore", "[", RowBox[
                 {RowBox[{"-", "nu"}], ",", "p1", ",", "p2", ",", "x", ",", 
                  "y", ",", "z"}], "]"}]}], ")"}]}]}], ";", "\n", 
      RowBox[{RowBox[{"jSeed", "[", RowBox[{"nu_", ",", "p1_", ",", "p2_", 
            ",", "x_", ",", "y_", ",", "z_"}], "]"}], ":=", 
        RowBox[{"\[ImaginaryI]", " ", SuperscriptBox["2", 
           RowBox[{RowBox[{"-", "2"}], "-", "p1", "-", "p2"}]], " ", 
          RowBox[{"Exp", "[", RowBox[{FractionBox["1", "2"], " ", 
              "\[ImaginaryI]", " ", "\[Pi]", " ", RowBox[{"(", 
                RowBox[{"p1", "+", "p2"}], ")"}]}], "]"}], " ", "\[Pi]", " ", 
          RowBox[{"Csch", "[", RowBox[{"2", " ", "\[Pi]", " ", "nu"}], "]"}], 
          " ", RowBox[{"Gamma", "[", RowBox[{"2", "+", "p1", "+", "p2"}], 
            "]"}], " ", RowBox[{"(", RowBox[{RowBox[{"jSeedCore", "[", 
                RowBox[{"nu", ",", "p1", ",", "p2", ",", "x", ",", "y", ",", 
                  "z"}], "]"}], "-", RowBox[{"jSeedCore", "[", 
                RowBox[{RowBox[{"-", "nu"}], ",", "p1", ",", "p2", ",", "x", 
                  ",", "y", ",", "z"}], "]"}]}], ")"}]}]}]}]], "Input"], 
  Cell["Type-1 and type-2 scalar entries", "Subsection"], 
  Cell["The finite lists A1,A2,B1,B2,U1,U2,V1,V2 and S1,S2,S3,S4,W1,W2 are \
those of Eqs. (70), (71), and Appendix A.", "Text"], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"aOne", "[", RowBox[{"nu_", ",", "p1_", ",", "p2_"}], 
          "]"}], ":=", RowBox[{SuperscriptBox["nu", "2"], " ", 
          RowBox[{"iSeed", "[", RowBox[{"nu", ",", "p1", ",", "p2", ",", 
              RowBox[{"1", "+", RowBox[{"\[ImaginaryI]", " ", "nu"}]}], ",", 
              RowBox[{"1", "-", RowBox[{"\[ImaginaryI]", " ", "nu"}]}], ",", 
              RowBox[{"\[ImaginaryI]", " ", "nu"}]}], "]"}]}]}], ";", "\n", 
      RowBox[{RowBox[{"aTwo", "[", RowBox[{"nu_", ",", "p1_", ",", "p2_"}], 
          "]"}], ":=", RowBox[{"iSeed", "[", RowBox[{"nu", ",", "p1", ",", 
            "p2", ",", RowBox[{"\[ImaginaryI]", " ", "nu"}], ",", 
            RowBox[{RowBox[{"-", "\[ImaginaryI]"}], " ", "nu"}], ",", 
            RowBox[{"1", "+", RowBox[{"\[ImaginaryI]", " ", "nu"}]}]}], 
          "]"}]}], ";", "\n", 
      RowBox[{RowBox[{"bOne", "[", RowBox[{"nu_", ",", "p1_", ",", "p2_"}], 
          "]"}], ":=", RowBox[{"iSeed", "[", RowBox[{"nu", ",", "p2", ",", 
            "p1", ",", RowBox[{"\[ImaginaryI]", " ", "nu"}], ",", 
            RowBox[{RowBox[{"-", "\[ImaginaryI]"}], " ", "nu"}], ",", 
            RowBox[{"1", "+", RowBox[{"\[ImaginaryI]", " ", "nu"}]}]}], 
          "]"}]}], ";", "\n", 
      RowBox[{RowBox[{"bTwo", "[", RowBox[{"nu_", ",", "p1_", ",", "p2_"}], 
          "]"}], ":=", RowBox[{SuperscriptBox["nu", "2"], " ", 
          RowBox[{"iSeed", "[", RowBox[{"nu", ",", "p2", ",", "p1", ",", 
              RowBox[{"1", "+", RowBox[{"\[ImaginaryI]", " ", "nu"}]}], ",", 
              RowBox[{"1", "-", RowBox[{"\[ImaginaryI]", " ", "nu"}]}], ",", 
              RowBox[{"\[ImaginaryI]", " ", "nu"}]}], "]"}]}]}], ";", "\n", 
      RowBox[{RowBox[{"uOne", "[", RowBox[{"nu_", ",", "p1_", ",", "p2_"}], 
          "]"}], ":=", RowBox[{SuperscriptBox["nu", "2"], " ", 
          RowBox[{"kSeed", "[", RowBox[{"nu", ",", "p1", ",", "p2", ",", "2", 
              ",", "2"}], "]"}]}]}], ";", "\n", 
      RowBox[{RowBox[{"uTwo", "[", RowBox[{"nu_", ",", "p1_", ",", "p2_"}], 
          "]"}], ":=", RowBox[{"kSeed", "[", RowBox[{"nu", ",", "p1", ",", 
            "p2", ",", "1", ",", "1"}], "]"}]}], ";", "\n", 
      RowBox[{RowBox[{"vOne", "[", RowBox[{"nu_", ",", "p1_", ",", "p2_"}], 
          "]"}], ":=", RowBox[{RowBox[{"Exp", "[", 
            RowBox[{RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Pi]", " ", 
              RowBox[{"(", RowBox[{"p1", "-", "p2"}], ")"}]}], "]"}], " ", 
          RowBox[{"kSeed", "[", RowBox[{"nu", ",", "p1", ",", "p2", ",", "1", 
              ",", "1"}], "]"}]}]}], ";", "\n", 
      RowBox[{RowBox[{"vTwo", "[", RowBox[{"nu_", ",", "p1_", ",", "p2_"}], 
          "]"}], ":=", RowBox[{SuperscriptBox["nu", "2"], " ", 
          RowBox[{"Exp", "[", RowBox[{RowBox[{"-", "\[ImaginaryI]"}], " ", 
              "\[Pi]", " ", RowBox[{"(", RowBox[{"p1", "-", "p2"}], ")"}]}], 
            "]"}], " ", RowBox[{"kSeed", "[", RowBox[{"nu", ",", "p1", ",", 
              "p2", ",", "2", ",", "2"}], "]"}]}]}], ";", "\n", 
      RowBox[{RowBox[{"sOne", "[", RowBox[{"nu_", ",", "p1_", ",", "p2_"}], 
          "]"}], ":=", RowBox[{"nu", " ", RowBox[{"iSeed", "[", 
            RowBox[{"nu", ",", "p1", ",", "p2", ",", RowBox[{"1", "+", 
                RowBox[{"\[ImaginaryI]", " ", "nu"}]}], ",", RowBox[{"1", 
                "-", RowBox[{"\[ImaginaryI]", " ", "nu"}]}], ",", 
              RowBox[{"1", "+", RowBox[{"\[ImaginaryI]", " ", "nu"}]}]}], 
            "]"}]}]}], ";", "\n", 
      RowBox[{RowBox[{"sTwo", "[", RowBox[{"nu_", ",", "p1_", ",", "p2_"}], 
          "]"}], ":=", RowBox[{"nu", " ", RowBox[{"iSeed", "[", 
            RowBox[{"nu", ",", "p1", ",", "p2", ",", RowBox[{"\[ImaginaryI]", 
                " ", "nu"}], ",", RowBox[{RowBox[{"-", "\[ImaginaryI]"}], 
                " ", "nu"}], ",", RowBox[{"\[ImaginaryI]", " ", "nu"}]}], 
            "]"}]}]}], ";", "\n", 
      RowBox[{RowBox[{"sThree", "[", RowBox[{"nu_", ",", "p1_", ",", "p2_"}], 
          "]"}], ":=", RowBox[{"nu", " ", RowBox[{"jSeed", "[", 
            RowBox[{"nu", ",", "p2", ",", "p1", ",", RowBox[{"\[ImaginaryI]", 
                " ", "nu"}], ",", RowBox[{RowBox[{"-", "\[ImaginaryI]"}], 
                " ", "nu"}], ",", RowBox[{"\[ImaginaryI]", " ", "nu"}]}], 
            "]"}]}]}], ";", "\n", 
      RowBox[{RowBox[{"sFour", "[", RowBox[{"nu_", ",", "p1_", ",", "p2_"}], 
          "]"}], ":=", RowBox[{"nu", " ", RowBox[{"jSeed", "[", 
            RowBox[{"nu", ",", "p2", ",", "p1", ",", RowBox[{"1", "+", 
                RowBox[{"\[ImaginaryI]", " ", "nu"}]}], ",", RowBox[{"1", 
                "-", RowBox[{"\[ImaginaryI]", " ", "nu"}]}], ",", 
              RowBox[{"1", "+", RowBox[{"\[ImaginaryI]", " ", "nu"}]}]}], 
            "]"}]}]}], ";", "\n", 
      RowBox[{RowBox[{"wOne", "[", RowBox[{"nu_", ",", "p1_", ",", "p2_"}], 
          "]"}], ":=", RowBox[{"nu", " ", RowBox[{"kSeed", "[", 
            RowBox[{"nu", ",", "p1", ",", "p2", ",", "2", ",", "1"}], 
            "]"}]}]}], ";", "\n", 
      RowBox[{RowBox[{"wTwo", "[", RowBox[{"nu_", ",", "p1_", ",", "p2_"}], 
          "]"}], ":=", RowBox[{"nu", " ", RowBox[{"kSeed", "[", 
            RowBox[{"nu", ",", "p1", ",", "p2", ",", "1", ",", "2"}], 
            "]"}]}]}]}]], "Input"], Cell["Schwinger-Keldysh seed matrices", 
   "Section"], Cell["Type-1 D and reversed type-1 Dbar", "Subsection"], 
  Cell["These cells implement Eqs. (121)-(123) and the first reversal \
identity in Eq. (66). The pi rotation converts the +z seed into the -z seed \
before transposition.", "Text"], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"typeOneSeed", "[", RowBox[{"1", ",", "1", ",", "p1_", 
            ",", "p2_", ",", "nu_"}], "]"}], ":=", 
        RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{RowBox[{"aOne", 
                    "[", RowBox[{"nu", ",", "p1", ",", "p2"}], "]"}], "-", 
                  RowBox[{"bTwo", "[", RowBox[{"nu", ",", "p1", ",", "p2"}], 
                    "]"}]}], ",", "0"}], "}"}], ",", 
            RowBox[{"{", RowBox[{"0", ",", RowBox[{RowBox[{"aTwo", "[", 
                    RowBox[{"nu", ",", "p1", ",", "p2"}], "]"}], "-", 
                  RowBox[{"bOne", "[", RowBox[{"nu", ",", "p1", ",", "p2"}], 
                    "]"}]}]}], "}"}]}], "}"}]}], ";", "\n", 
      RowBox[{RowBox[{"typeOneSeed", "[", RowBox[{RowBox[{"-", "1"}], ",", 
            "1", ",", "p1_", ",", "p2_", ",", "nu_"}], "]"}], ":=", 
        RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"uOne", "[", 
                  RowBox[{"nu", ",", "p1", ",", "p2"}], "]"}], ",", "0"}], 
              "}"}], ",", RowBox[{"{", RowBox[{"0", ",", RowBox[{"uTwo", "[", 
                  RowBox[{"nu", ",", "p1", ",", "p2"}], "]"}]}], "}"}]}], 
          "}"}]}], ";", "\n", 
      RowBox[{RowBox[{"typeOneSeed", "[", RowBox[{"1", ",", 
            RowBox[{"-", "1"}], ",", "p1_", ",", "p2_", ",", "nu_"}], "]"}], 
        ":=", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[
                 {"-", RowBox[{"vTwo", "[", RowBox[{"nu", ",", "p1", ",", 
                      "p2"}], "]"}]}], ",", "0"}], "}"}], ",", 
            RowBox[{"{", RowBox[{"0", ",", RowBox[{"-", RowBox[{"vOne", "[", 
                    RowBox[{"nu", ",", "p1", ",", "p2"}], "]"}]}]}], "}"}]}], 
          "}"}]}], ";", "\n", 
      RowBox[{RowBox[{"typeOneSeed", "[", RowBox[{RowBox[{"-", "1"}], ",", 
            RowBox[{"-", "1"}], ",", "p1_", ",", "p2_", ",", "nu_"}], "]"}], 
        ":=", RowBox[{"Refine", "[", RowBox[
           {TemplateBox[{RowBox[{"typeOneSeed", "[", RowBox[{"1", ",", "1", 
                  ",", RowBox[{"Conjugate", "[", "p2", "]"}], ",", 
                  RowBox[{"Conjugate", "[", "p1", "]"}], ",", "nu"}], "]"}]}, 
             "ConjugateTranspose", SyntaxForm -> SuperscriptBox], ",", 
            RowBox[{"nu", "\[Element]", TemplateBox[{}, "Reals"]}]}], 
          "]"}]}], ";", "\n", RowBox[{"minusKRotation", "=", 
        RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", RowBox[
                 {"-", "1"}]}], "}"}], ",", RowBox[{"{", RowBox[{"1", ",", 
                "0"}], "}"}]}], "}"}]}], ";", "\n", 
      RowBox[{RowBox[{"typeOneBarSeed", "[", RowBox[{"a_", ",", "b_", ",", 
            "p1_", ",", "p2_", ",", "nu_"}], "]"}], ":=", 
        RowBox[{"-", TemplateBox[{RowBox[{"(", RowBox[{"minusKRotation", ".", 
                RowBox[{"typeOneSeed", "[", RowBox[{"b", ",", "a", ",", "p2", 
                    ",", "p1", ",", "nu"}], "]"}], ".", TemplateBox[
                 {"minusKRotation"}, "ConjugateTranspose", SyntaxForm -> 
                  SuperscriptBox]}], ")"}]}, "Transpose", 
           SyntaxForm -> SuperscriptBox]}]}]}]], "Input"], 
  Cell["Lower-index type-2 and type-3 seeds", "Subsection"], 
  Cell["The type-2 matrices are Eqs. (132)-(139). The type-3 matrix is \
reconstructed from type 2 through Eq. (141), so no additional time integral \
is introduced.", "Text"], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"typeTwoSeed", "[", RowBox[{"1", ",", "1", ",", "p1_", 
            ",", "p2_", ",", "nu_"}], "]"}], ":=", 
        RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", RowBox[
                 {RowBox[{"sOne", "[", RowBox[{"nu", ",", "p1", ",", "p2"}], 
                    "]"}], "+", RowBox[{"sTwo", "[", RowBox[{"nu", ",", "p2", 
                      ",", "p1"}], "]"}]}]}], "}"}], ",", 
            RowBox[{"{", RowBox[{RowBox[{"-", RowBox[{"(", RowBox[
                     {RowBox[{"sOne", "[", RowBox[{"nu", ",", "p2", ",", 
                          "p1"}], "]"}], "+", RowBox[{"sTwo", "[", RowBox[
                         {"nu", ",", "p1", ",", "p2"}], "]"}]}], ")"}]}], 
                ",", "0"}], "}"}]}], "}"}]}], ";", "\n", 
      RowBox[{RowBox[{"typeTwoSeed", "[", RowBox[{RowBox[{"-", "1"}], ",", 
            RowBox[{"-", "1"}], ",", "p1_", ",", "p2_", ",", "nu_"}], "]"}], 
        ":=", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", 
                RowBox[{RowBox[{"sThree", "[", RowBox[{"nu", ",", "p1", ",", 
                      "p2"}], "]"}], "+", RowBox[{"sFour", "[", RowBox[
                     {"nu", ",", "p2", ",", "p1"}], "]"}]}]}], "}"}], ",", 
            RowBox[{"{", RowBox[{RowBox[{"-", RowBox[{"(", RowBox[
                     {RowBox[{"sThree", "[", RowBox[{"nu", ",", "p2", ",", 
                          "p1"}], "]"}], "+", RowBox[{"sFour", "[", RowBox[
                         {"nu", ",", "p1", ",", "p2"}], "]"}]}], ")"}]}], 
                ",", "0"}], "}"}]}], "}"}]}], ";", "\n", 
      RowBox[{RowBox[{"typeTwoSeed", "[", RowBox[{"1", ",", 
            RowBox[{"-", "1"}], ",", "p1_", ",", "p2_", ",", "nu_"}], "]"}], 
        ":=", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", 
                RowBox[{"wOne", "[", RowBox[{"nu", ",", "p1", ",", "p2"}], 
                  "]"}]}], "}"}], ",", RowBox[{"{", RowBox[{RowBox[
                 {"-", RowBox[{"wTwo", "[", RowBox[{"nu", ",", "p1", ",", 
                      "p2"}], "]"}]}], ",", "0"}], "}"}]}], "}"}]}], ";", 
      "\n", RowBox[{RowBox[{"typeTwoSeed", "[", RowBox[{RowBox[{"-", "1"}], 
            ",", "1", ",", "p1_", ",", "p2_", ",", "nu_"}], "]"}], ":=", 
        RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", RowBox[
                 {"wTwo", "[", RowBox[{"nu", ",", "p2", ",", "p1"}], "]"}]}], 
              "}"}], ",", RowBox[{"{", RowBox[{RowBox[{"-", RowBox[
                   {"wOne", "[", RowBox[{"nu", ",", "p2", ",", "p1"}], 
                    "]"}]}], ",", "0"}], "}"}]}], "}"}]}], ";", "\n", 
      RowBox[{RowBox[{"typeThreeSeed", "[", RowBox[{"a_", ",", "b_", ",", 
            "p1_", ",", "p2_", ",", "nu_"}], "]"}], ":=", 
        RowBox[{"-", RowBox[{"Refine", "[", RowBox[{RowBox[{"Conjugate", "[", 
                RowBox[{"typeTwoSeed", "[", RowBox[{RowBox[{"-", "a"}], ",", 
                    RowBox[{"-", "b"}], ",", RowBox[{"Conjugate", "[", "p1", 
                      "]"}], ",", RowBox[{"Conjugate", "[", "p2", "]"}], ",", 
                    "nu"}], "]"}], "]"}], ",", RowBox[{"nu", "\[Element]", 
                TemplateBox[{}, "Reals"]}]}], "]"}]}]}]}]], "Input"], 
  Cell["Yukawa-dressed hard blocks", "Section"], 
  Cell["Equation (65) supplies the four massless-Higgs polynomial terms and \
the outer SK factor a b. A common analytic regulator is kept until the full \
SK sum is assembled, avoiding premature Gamma[0] products. The \
diagonal/off-diagonal entries then give \
q0,q1,qBar0,qBar1,qHat0,qHat1,qCheck0,qCheck1 according to Eqs. (43), (50), \
and (59).", "Text"], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"qSeedSum", "[", RowBox[{"seed_", ",", "nu_", ",", 
            "regulator_"}], "]"}], ":=", RowBox[{"Module", "[", 
          RowBox[{RowBox[{"{", RowBox[{"p", "=", RowBox[{RowBox[{"-", "1"}], 
                  "+", RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", 
                  "regulator"}]}], "}"}], ",", RowBox[{"Sum", "[", 
              RowBox[{RowBox[{"a", " ", "b", " ", RowBox[{"(", RowBox[
                     {RowBox[{"seed", "[", RowBox[{"a", ",", "b", ",", "p", 
                          ",", "p", ",", "nu"}], "]"}], "+", RowBox[
                       {"\[ImaginaryI]", " ", "a", " ", RowBox[{"seed", "[", 
                          RowBox[{"a", ",", "b", ",", RowBox[{"p", "+", 
                          "1"}], ",", "p", ",", "nu"}], "]"}]}], "+", 
                      RowBox[{"\[ImaginaryI]", " ", "b", " ", RowBox[{"seed", 
                          "[", RowBox[{"a", ",", "b", ",", "p", ",", RowBox[
                          {"p", "+", "1"}], ",", "nu"}], "]"}]}], "-", 
                      RowBox[{"a", " ", "b", " ", RowBox[{"seed", "[", 
                          RowBox[{"a", ",", "b", ",", RowBox[{"p", "+", 
                          "1"}], ",", RowBox[{"p", "+", "1"}], ",", "nu"}], 
                          "]"}]}]}], ")"}]}], ",", RowBox[{"{", RowBox[
                   {"a", ",", RowBox[{"{", RowBox[{"1", ",", RowBox[{"-", 
                          "1"}]}], "}"}]}], "}"}], ",", RowBox[
                 {"{", RowBox[{"b", ",", RowBox[{"{", RowBox[{"1", ",", 
                        RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "]"}]}], 
          "]"}]}], ";", "\n", 
      RowBox[{RowBox[{"qTypeOne", "[", RowBox[{"nu_", ",", "regulator_"}], 
          "]"}], ":=", RowBox[{"qSeedSum", "[", RowBox[{"typeOneSeed", ",", 
            "nu", ",", "regulator"}], "]"}]}], ";", "\n", 
      RowBox[{RowBox[{"qTypeOneBar", "[", RowBox[{"nu_", ",", "regulator_"}], 
          "]"}], ":=", RowBox[{"qSeedSum", "[", RowBox[{"typeOneBarSeed", 
            ",", "nu", ",", "regulator"}], "]"}]}], ";", "\n", 
      RowBox[{RowBox[{"qTypeTwo", "[", RowBox[{"nu_", ",", "regulator_"}], 
          "]"}], ":=", RowBox[{"qSeedSum", "[", RowBox[{"typeTwoSeed", ",", 
            "nu", ",", "regulator"}], "]"}]}], ";", "\n", 
      RowBox[{RowBox[{"qTypeThree", "[", RowBox[{"nu_", ",", "regulator_"}], 
          "]"}], ":=", RowBox[{"qSeedSum", "[", RowBox[{"typeThreeSeed", ",", 
            "nu", ",", "regulator"}], "]"}]}], ";", "\n", 
      RowBox[{RowBox[{"qCoefficientData", "[", RowBox[{"nu_", ",", 
            "regulator_"}], "]"}], ":=", RowBox[{"Module", "[", 
          RowBox[{RowBox[{"{", RowBox[{"q", ",", "qBar", ",", "qHat", ",", 
                "qCheck"}], "}"}], ",", RowBox[{RowBox[{"q", "=", 
                RowBox[{"qTypeOne", "[", RowBox[{"nu", ",", "regulator"}], 
                  "]"}]}], ";", RowBox[{"qBar", "=", RowBox[{"qTypeOneBar", 
                  "[", RowBox[{"nu", ",", "regulator"}], "]"}]}], ";", 
              RowBox[{"qHat", "=", RowBox[{"qTypeTwo", "[", RowBox[
                   {"nu", ",", "regulator"}], "]"}]}], ";", RowBox[{"qCheck", 
                "=", RowBox[{"qTypeThree", "[", RowBox[{"nu", ",", 
                    "regulator"}], "]"}]}], ";", RowBox[{"Association", "[", 
                RowBox[{RowBox[{"\"q0\"", "\[Rule]", RowBox[{FractionBox["1", 
                       "2"], " ", RowBox[{"(", RowBox[{RowBox[{"q", 
                          "\[LeftDoubleBracket]", RowBox[{"1", ",", "1"}], 
                          "\[RightDoubleBracket]"}], "+", RowBox[{"q", 
                          "\[LeftDoubleBracket]", RowBox[{"2", ",", "2"}], 
                          "\[RightDoubleBracket]"}]}], ")"}]}]}], ",", 
                  RowBox[{"\"q1\"", "\[Rule]", RowBox[{FractionBox["1", "2"], 
                      " ", RowBox[{"(", RowBox[{RowBox[{"q", 
                          "\[LeftDoubleBracket]", RowBox[{"1", ",", "1"}], 
                          "\[RightDoubleBracket]"}], "-", RowBox[{"q", 
                          "\[LeftDoubleBracket]", RowBox[{"2", ",", "2"}], 
                          "\[RightDoubleBracket]"}]}], ")"}]}]}], ",", 
                  RowBox[{"\"qBar0\"", "\[Rule]", RowBox[{FractionBox["1", 
                       "2"], " ", RowBox[{"(", RowBox[{RowBox[{"qBar", 
                          "\[LeftDoubleBracket]", RowBox[{"1", ",", "1"}], 
                          "\[RightDoubleBracket]"}], "+", RowBox[{"qBar", 
                          "\[LeftDoubleBracket]", RowBox[{"2", ",", "2"}], 
                          "\[RightDoubleBracket]"}]}], ")"}]}]}], ",", 
                  RowBox[{"\"qBar1\"", "\[Rule]", RowBox[{FractionBox["1", 
                       "2"], " ", RowBox[{"(", RowBox[{RowBox[{"qBar", 
                          "\[LeftDoubleBracket]", RowBox[{"2", ",", "2"}], 
                          "\[RightDoubleBracket]"}], "-", RowBox[{"qBar", 
                          "\[LeftDoubleBracket]", RowBox[{"1", ",", "1"}], 
                          "\[RightDoubleBracket]"}]}], ")"}]}]}], ",", 
                  RowBox[{"\"qHat0\"", "\[Rule]", RowBox[{FractionBox["1", 
                       "2"], " ", RowBox[{"(", RowBox[{RowBox[{"qHat", 
                          "\[LeftDoubleBracket]", RowBox[{"1", ",", "2"}], 
                          "\[RightDoubleBracket]"}], "-", RowBox[{"qHat", 
                          "\[LeftDoubleBracket]", RowBox[{"2", ",", "1"}], 
                          "\[RightDoubleBracket]"}]}], ")"}]}]}], ",", 
                  RowBox[{"\"qHat1\"", "\[Rule]", RowBox[{FractionBox["1", 
                       "2"], " ", RowBox[{"(", RowBox[{RowBox[{"qHat", 
                          "\[LeftDoubleBracket]", RowBox[{"1", ",", "2"}], 
                          "\[RightDoubleBracket]"}], "+", RowBox[{"qHat", 
                          "\[LeftDoubleBracket]", RowBox[{"2", ",", "1"}], 
                          "\[RightDoubleBracket]"}]}], ")"}]}]}], ",", 
                  RowBox[{"\"qCheck0\"", "\[Rule]", RowBox[{FractionBox["1", 
                       "2"], " ", RowBox[{"(", RowBox[{RowBox[{"qCheck", 
                          "\[LeftDoubleBracket]", RowBox[{"2", ",", "1"}], 
                          "\[RightDoubleBracket]"}], "-", RowBox[{"qCheck", 
                          "\[LeftDoubleBracket]", RowBox[{"1", ",", "2"}], 
                          "\[RightDoubleBracket]"}]}], ")"}]}]}], ",", 
                  RowBox[{"\"qCheck1\"", "\[Rule]", RowBox[{RowBox[{"-", 
                        FractionBox["1", "2"]}], " ", RowBox[{"(", RowBox[
                         {RowBox[{"qCheck", "\[LeftDoubleBracket]", RowBox[
                          {"1", ",", "2"}], "\[RightDoubleBracket]"}], "+", 
                          RowBox[{"qCheck", "\[LeftDoubleBracket]", RowBox[
                          {"2", ",", "1"}], "\[RightDoubleBracket]"}]}], 
                        ")"}]}]}]}], "]"}]}]}], "]"}]}]}]], "Input"], 
  Cell["Requested amplitudes", "Section"], Cell["R0 and R1 are assembled with \
Eq. (72). The common Gamma-function factor is Eq. (73), and the regulated \
amplitudes implement Eq. (76). Because direct substitution produces Gamma[0] \
times zero, a0SExact and a13SExact extract the regulator-independent Laurent \
coefficient with SeriesCoefficient.", "Text"], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"rZero", "[", RowBox[{"nu_", ",", "regulator_"}], 
          "]"}], ":=", RowBox[{"Module", "[", 
          RowBox[{RowBox[{"{", RowBox[{"q", "=", RowBox[{"qCoefficientData", 
                  "[", RowBox[{"nu", ",", "regulator"}], "]"}]}], "}"}], ",", 
            RowBox[{SuperscriptBox[RowBox[{"q", "[", "\"qHat0\"", "]"}], 
               "2"], "+", SuperscriptBox[RowBox[{"q", "[", "\"qCheck0\"", 
                 "]"}], "2"], "+", RowBox[{"2", " ", RowBox[{"q", "[", 
                  "\"q0\"", "]"}], " ", RowBox[{"q", "[", "\"qBar0\"", 
                  "]"}]}]}]}], "]"}]}], ";", "\n", 
      RowBox[{RowBox[{"rOne", "[", RowBox[{"nu_", ",", "regulator_"}], "]"}], 
        ":=", RowBox[{"Module", "[", RowBox[
           {RowBox[{"{", RowBox[{"q", "=", RowBox[{"qCoefficientData", "[", 
                  RowBox[{"nu", ",", "regulator"}], "]"}]}], "}"}], ",", 
            RowBox[{SuperscriptBox[RowBox[{"q", "[", "\"qHat1\"", "]"}], 
               "2"], "+", SuperscriptBox[RowBox[{"q", "[", "\"qCheck1\"", 
                 "]"}], "2"], "-", RowBox[{"2", " ", RowBox[{"q", "[", 
                  "\"q1\"", "]"}], " ", RowBox[{"q", "[", "\"qBar1\"", 
                  "]"}]}]}]}], "]"}]}], ";", "\n", 
      RowBox[{RowBox[{"kappaPlus", "[", "nu_", "]"}], ":=", 
        RowBox[{"\[ImaginaryI]", " ", SuperscriptBox[
           RowBox[{"(", FractionBox[RowBox[{"Gamma", "[", RowBox[
                 {RowBox[{"-", "2"}], " ", "\[ImaginaryI]", " ", "nu"}], 
                "]"}], RowBox[{"Gamma", "[", RowBox[{RowBox[{"-", 
                    "\[ImaginaryI]"}], " ", "nu"}], "]"}]], ")"}], "2"]}]}], 
      ";", "\n", RowBox[{RowBox[{"fZeroBubble", "[", "nu_", "]"}], ":=", 
        FractionBox[RowBox[{RowBox[{"Gamma", "[", RowBox[{RowBox[
                {"-", FractionBox["3", "2"]}], "-", RowBox[{"2", " ", 
                 "\[ImaginaryI]", " ", "nu"}]}], "]"}], " ", 
           SuperscriptBox[RowBox[{"Gamma", "[", RowBox[{FractionBox["3", 
                 "2"], "+", RowBox[{"\[ImaginaryI]", " ", "nu"}]}], "]"}], 
            "2"]}], RowBox[{RowBox[{"Gamma", "[", RowBox[{"3", "+", RowBox[
                {"2", " ", "\[ImaginaryI]", " ", "nu"}]}], "]"}], " ", 
           SuperscriptBox[RowBox[{"Gamma", "[", RowBox[{RowBox[
                 {"-", "\[ImaginaryI]"}], " ", "nu"}], "]"}], "2"]}]]}], ";", 
      "\n", RowBox[{RowBox[{"commonPrefactor", "[", "nu_", "]"}], ":=", 
        FractionBox[RowBox[{SuperscriptBox["2", RowBox[{"1", "+", 
              RowBox[{"12", " ", "\[ImaginaryI]", " ", "nu"}]}]], " ", 
           SuperscriptBox[RowBox[{"kappaPlus", "[", "nu", "]"}], "2"], " ", 
           RowBox[{"fZeroBubble", "[", "nu", "]"}]}], SuperscriptBox[
          RowBox[{"(", RowBox[{"4", " ", "\[Pi]"}], ")"}], 
          RowBox[{"3", "/", "2"}]]]}], ";", "\n", 
      RowBox[{RowBox[{"regulatedAmplitudePair", "[", 
          RowBox[{"nu_", ",", "regulator_"}], "]"}], ":=", 
        RowBox[{"Module", "[", RowBox[
           {RowBox[{"{", RowBox[{RowBox[{"q", "=", RowBox[
                   {"qCoefficientData", "[", RowBox[{"nu", ",", 
                      "regulator"}], "]"}]}], ",", "rr0", ",", "rr1", ",", 
                "prefactor"}], "}"}], ",", RowBox[{RowBox[{"rr0", "=", 
                RowBox[{SuperscriptBox[RowBox[{"q", "[", "\"qHat0\"", "]"}], 
                   "2"], "+", SuperscriptBox[RowBox[{"q", "[", "\"qCheck0\"", 
                     "]"}], "2"], "+", RowBox[{"2", " ", RowBox[{"q", "[", 
                      "\"q0\"", "]"}], " ", RowBox[{"q", "[", "\"qBar0\"", 
                      "]"}]}]}]}], ";", RowBox[{"rr1", "=", RowBox[
                 {SuperscriptBox[RowBox[{"q", "[", "\"qHat1\"", "]"}], "2"], 
                  "+", SuperscriptBox[RowBox[{"q", "[", "\"qCheck1\"", "]"}], 
                   "2"], "-", RowBox[{"2", " ", RowBox[{"q", "[", "\"q1\"", 
                      "]"}], " ", RowBox[{"q", "[", "\"qBar1\"", "]"}]}]}]}], 
              ";", RowBox[{"prefactor", "=", RowBox[{"commonPrefactor", "[", 
                  "nu", "]"}]}], ";", RowBox[{"{", RowBox[
                 {RowBox[{"prefactor", " ", "rr0"}], ",", RowBox[
                   {"prefactor", " ", "rr1"}]}], "}"}]}]}], "]"}]}], ";", 
      "\n", RowBox[{RowBox[{"a0SRegulated", "[", 
          RowBox[{"nu_", ",", "regulator_"}], "]"}], ":=", 
        RowBox[{RowBox[{"regulatedAmplitudePair", "[", 
            RowBox[{"nu", ",", "regulator"}], "]"}], "\[LeftDoubleBracket]", 
          "1", "\[RightDoubleBracket]"}]}], ";", "\n", 
      RowBox[{RowBox[{"a13SRegulated", "[", RowBox[{"nu_", ",", 
            "regulator_"}], "]"}], ":=", 
        RowBox[{RowBox[{"regulatedAmplitudePair", "[", 
            RowBox[{"nu", ",", "regulator"}], "]"}], "\[LeftDoubleBracket]", 
          "2", "\[RightDoubleBracket]"}]}], ";", "\n", 
      RowBox[{RowBox[{"a0SExact", "[", "nu_", "]"}], ":=", 
        RowBox[{"SeriesCoefficient", "[", RowBox[
           {RowBox[{"a0SRegulated", "[", RowBox[{"nu", ",", 
                "analyticRegulator"}], "]"}], ",", 
            RowBox[{"{", RowBox[{"analyticRegulator", ",", "0", ",", "0"}], 
              "}"}]}], "]"}]}], ";", "\n", 
      RowBox[{RowBox[{"a13SExact", "[", "nu_", "]"}], ":=", 
        RowBox[{"SeriesCoefficient", "[", RowBox[
           {RowBox[{"a13SRegulated", "[", RowBox[{"nu", ",", 
                "analyticRegulator"}], "]"}], ",", 
            RowBox[{"{", RowBox[{"analyticRegulator", ",", "0", ",", "0"}], 
              "}"}]}], "]"}]}], ";", "\n", 
      RowBox[{RowBox[{"a0SMass", "[", RowBox[{"mt_", ",", "hubble_"}], "]"}], 
        ":=", RowBox[{"a0SExact", "[", FractionBox["mt", "hubble"], "]"}]}], 
      ";", "\n", RowBox[{RowBox[{"a13SMass", "[", 
          RowBox[{"mt_", ",", "hubble_"}], "]"}], ":=", 
        RowBox[{"a13SExact", "[", FractionBox["mt", "hubble"], "]"}]}]}]], 
   "Input"], 
  Cell[BoxData[RowBox[{RowBox[{"requestedAmplitudes", "=", 
        RowBox[{"Association", "[", RowBox[{RowBox[{"\"A0S\"", "\[Rule]", 
              TagBox[RowBox[{"a0SExact", "[", "nu", "]"}], HoldForm]}], ",", 
            RowBox[{"\"A13S\"", "\[Rule]", TagBox[RowBox[{"a13SExact", "[", 
                 "nu", "]"}], HoldForm]}]}], "]"}]}], ";", "\n", 
      TagBox[FormBox["requestedAmplitudes", TraditionalForm], 
       TraditionalForm, Editable -> True]}]], "Input"], 
  Cell["Complete symbolic simplification", "Section"], 
  Cell["The first cell defines the simplification pipeline. The second cell \
performs Together, FunctionExpand, and FullSimplify with nu real and \
positive. It is intentionally independent of the numerical plotting section."\
, "Text"], 
  Cell[BoxData[RowBox[{RowBox[{RowBox[{"fullySimplifiedAmplitudes", "[", 
          "var_Symbol", "]"}], ":=", RowBox[{"Module", "[", 
          RowBox[{RowBox[{"{", RowBox[{"assumptions", ",", "transformations", 
                ",", "a0", ",", "a13"}], "}"}], ",", 
            RowBox[{RowBox[{"assumptions", "=", RowBox[{RowBox[{"var", 
                    "\[Element]", TemplateBox[{}, "Reals"]}], "&&", 
                  RowBox[{"var", ">", "0"}]}]}], ";", RowBox[{
                "transformations", "=", RowBox[{"{", RowBox[{"Automatic", 
                    ",", RowBox[{RowBox[{"FunctionExpand", "[", "#1", "]"}], 
                      "&"}]}], "}"}]}], ";", RowBox[{"a0", "=", 
                RowBox[{"FullSimplify", "[", RowBox[{RowBox[{"Together", "[", 
                      RowBox[{"a0SExact", "[", "var", "]"}], "]"}], ",", 
                    RowBox[{"Assumptions", "\[Rule]", "assumptions"}], ",", 
                    RowBox[{"TransformationFunctions", "\[Rule]", 
                      "transformations"}]}], "]"}]}], ";", RowBox[{"a13", 
                "=", RowBox[{"FullSimplify", "[", RowBox[{RowBox[{"Together", 
                      "[", RowBox[{"a13SExact", "[", "var", "]"}], "]"}], 
                    ",", RowBox[{"Assumptions", "\[Rule]", "assumptions"}], 
                    ",", RowBox[{"TransformationFunctions", "\[Rule]", 
                      "transformations"}]}], "]"}]}], ";", 
              RowBox[{"Association", "[", RowBox[{RowBox[{"\"A0S\"", 
                    "\[Rule]", "a0"}], ",", RowBox[{"\"A13S\"", "\[Rule]", 
                    "a13"}]}], "]"}]}]}], "]"}]}]}]], "Input"], 
  Cell[BoxData[RowBox[{RowBox[{"simplifiedAmplitudes", "=", 
        RowBox[{"fullySimplifiedAmplitudes", "[", "nu", "]"}]}], ";", "\n", 
      TagBox[FormBox["simplifiedAmplitudes", TraditionalForm], 
       TraditionalForm, Editable -> True]}]], "Input"], 
  Cell["Analytic consistency checks", "Subsection"], 
  Cell[BoxData[RowBox[{RowBox[{RowBox[{"paperConsistencyChecks", "[", 
          "var_Symbol", "]"}], ":=", RowBox[{"Assuming", "[", 
          RowBox[{RowBox[{RowBox[{RowBox[{"{", RowBox[{"var", ",", 
                    "testRegulator"}], "}"}], "\[Element]", TemplateBox[{}, 
                 "Reals"]}], "&&", RowBox[{"var", ">", "0"}], "&&", 
              RowBox[{"testRegulator", "\[NotEqual]", "0"}]}], ",", 
            RowBox[{"Association", "[", RowBox[{RowBox[
                 {"\"kappa modulus squared\"", "\[Rule]", RowBox[
                   {"FullSimplify", "[", RowBox[{RowBox[{RowBox[{"kappaPlus", 
                          "[", "var", "]"}], " ", RowBox[{"Conjugate", "[", 
                          RowBox[{"kappaPlus", "[", "var", "]"}], "]"}]}], 
                      "\[Equal]", FractionBox["1", RowBox[{"16", " ", 
                         SuperscriptBox[RowBox[{"Cosh", "[", RowBox[{"\[Pi]", 
                          " ", "var"}], "]"}], "2"]}]]}], "]"}]}], ",", 
                RowBox[{"\"type-one structure\"", "\[Rule]", RowBox[
                   {"Simplify", "[", RowBox[{RowBox[{RowBox[{RowBox[
                          {"qTypeOne", "[", RowBox[{"var", ",", 
                          "testRegulator"}], "]"}], "\[LeftDoubleBracket]", 
                          RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], 
                        "\[Equal]", "0"}], "&&", RowBox[{RowBox[{RowBox[
                          {"qTypeOne", "[", RowBox[{"var", ",", 
                          "testRegulator"}], "]"}], "\[LeftDoubleBracket]", 
                          RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}], 
                        "\[Equal]", "0"}]}], "]"}]}], ",", RowBox[
                 {"\"type-two structure\"", "\[Rule]", RowBox[{"Simplify", 
                    "[", RowBox[{RowBox[{RowBox[{RowBox[{"qTypeTwo", "[", 
                          RowBox[{"var", ",", "testRegulator"}], "]"}], 
                          "\[LeftDoubleBracket]", RowBox[{"1", ",", "1"}], 
                          "\[RightDoubleBracket]"}], "\[Equal]", "0"}], "&&", 
                      RowBox[{RowBox[{RowBox[{"qTypeTwo", "[", RowBox[{"var", 
                          ",", "testRegulator"}], "]"}], 
                          "\[LeftDoubleBracket]", RowBox[{"2", ",", "2"}], 
                          "\[RightDoubleBracket]"}], "\[Equal]", "0"}]}], 
                    "]"}]}]}], "]"}]}], "]"}]}]}]], "Input"], 
  Cell[BoxData[RowBox[{"paperConsistencyChecks", "[", "nu", "]"}]], "Input"], 
  Cell["High-precision numerical evaluation", "Section"], 
  Cell["A0 and A13 share the same expensive hard seeds at each mass point. \
The numerical cache therefore computes both amplitudes together. The \
following cell only defines numerical and plotting helpers.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"topQuarkNumericalCache", "=", 
        RowBox[{"Association", "[", "]"}]}], ";", "\n", 
      RowBox[{RowBox[{"numericalFinitePart", "[", 
          RowBox[{RowBox[{"x_", "?", "NumericQ"}], ",", 
            RowBox[{"workingPrecision_Integer", ":", "60"}], ",", 
            RowBox[{"regulatorScale_", ":", FractionBox["1", "1000"]}], ",", 
            RowBox[{"poleOrder_Integer", ":", "4"}], ",", 
            RowBox[{"positiveOrder_Integer", ":", "4"}]}], "]"}], ":=", 
        RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"nuValue", ",", 
                "powers", ",", "regulatorValues", ",", "matrix", ",", 
                "amplitudeValues", ",", "coefficients", ",", 
                "zeroPosition"}], "}"}], ",", RowBox[{RowBox[{"nuValue", "=", 
                RowBox[{"SetPrecision", "[", RowBox[{"x", ",", 
                    "workingPrecision"}], "]"}]}], ";", RowBox[{"powers", 
                "=", RowBox[{"Range", "[", RowBox[{RowBox[{"-", 
                      "poleOrder"}], ",", "positiveOrder"}], "]"}]}], ";", 
              RowBox[{"regulatorValues", "=", RowBox[{"N", "[", RowBox[
                   {RowBox[{"regulatorScale", " ", RowBox[{"Range", "[", 
                        RowBox[{"Length", "[", "powers", "]"}], "]"}]}], ",", 
                    "workingPrecision"}], "]"}]}], ";", RowBox[{"matrix", 
                "=", RowBox[{"Table", "[", RowBox[{SuperscriptBox[RowBox[
                      {"regulatorValues", "\[LeftDoubleBracket]", "row", 
                       "\[RightDoubleBracket]"}], RowBox[{"powers", 
                       "\[LeftDoubleBracket]", "column", 
                       "\[RightDoubleBracket]"}]], ",", RowBox[{"{", 
                      RowBox[{"row", ",", RowBox[{"Length", "[", "powers", 
                          "]"}]}], "}"}], ",", RowBox[{"{", RowBox[{"column", 
                        ",", RowBox[{"Length", "[", "powers", "]"}]}], 
                      "}"}]}], "]"}]}], ";", RowBox[{"amplitudeValues", "=", 
                RowBox[{"N", "[", RowBox[{RowBox[{RowBox[{"(", RowBox[
                         {RowBox[{"regulatedAmplitudePair", "[", RowBox[
                          {"nuValue", ",", "#1"}], "]"}], "&"}], ")"}], "/@", 
                      "regulatorValues"}], ",", "workingPrecision"}], 
                  "]"}]}], ";", RowBox[{"coefficients", "=", RowBox[
                 {"LinearSolve", "[", RowBox[{"matrix", ",", 
                    "amplitudeValues"}], "]"}]}], ";", RowBox[{
                "zeroPosition", "=", RowBox[{"First", "[", RowBox[
                   {"FirstPosition", "[", RowBox[{"powers", ",", "0"}], 
                    "]"}], "]"}]}], ";", RowBox[{"coefficients", 
                "\[LeftDoubleBracket]", "zeroPosition", 
                "\[RightDoubleBracket]"}]}]}], "]"}]}], ";", "\n", 
      RowBox[{RowBox[{"numericalAmplitudeData", "[", 
          RowBox[{RowBox[{"x_", "?", "NumericQ"}], ",", 
            RowBox[{"workingPrecision_Integer", ":", "60"}], ",", 
            RowBox[{"regulatorScale_", ":", FractionBox["1", "1000"]}]}], 
          "]"}], ":=", RowBox[{"Module", "[", 
          RowBox[{RowBox[{"{", RowBox[{"key", ",", "result"}], "}"}], ",", 
            RowBox[{RowBox[{"key", "=", RowBox[{"HoldComplete", "[", 
                  RowBox[{"x", ",", "workingPrecision", ",", 
                    "regulatorScale"}], "]"}]}], ";", RowBox[{"If", "[", 
                RowBox[{RowBox[{"KeyExistsQ", "[", RowBox[
