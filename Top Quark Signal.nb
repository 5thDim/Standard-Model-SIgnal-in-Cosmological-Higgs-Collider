     RowBox[{
     "PlotLabel", 
      "\[Rule]", "\"\<Top-quark angular coefficients - Eq. (59)\>\""}], ",", 
     RowBox[{"PlotLegends", "\[Rule]", 
      RowBox[{"Placed", "[", 
       RowBox[{"coefficientNames", ",", "Right"}], "]"}]}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Directive", "[", 
          RowBox[{"#1", ",", "Thick"}], "]"}], "&"}], ")"}], "/@", 
       "plotColorsTop"}]}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "850"}], ",", 
     RowBox[{"BaseStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
