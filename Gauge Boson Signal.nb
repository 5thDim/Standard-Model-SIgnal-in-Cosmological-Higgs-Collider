                          {"N", "[", RowBox[{RowBox[{RowBox[{"Take", "[",
                          RowBox[{"masterExpressions", ",", "3"}], "]"}],
                          "/.", "\[VeryThinSpace]", RowBox[{"nu", "\[Rule]",
                          "vv"}]}], ",", RowBox[{"prec", "+", "10"}]}],
                          "]"}], ",", RowBox[{"mixedMaster", "[", RowBox[
                          {"v", ",", RowBox[{"prec", "+", "10"}]}], "]"}]}],
                          "]"}]}], ";", RowBox[{"result", "=", RowBox[{"N",
