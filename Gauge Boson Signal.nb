Cell[BoxData[
 RowBox[{
  RowBox[{"tFiniteCore", "=", 
   RowBox[{
    FractionBox[
     RowBox[{"gg", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
