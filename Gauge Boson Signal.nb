Cell[CellGroupData[{

Cell["Triangle coefficient with analytic P2 (primary)", "Subsection",ExpressionUUID->"25eb39eb-4bf0-4e48-9ffa-d17be05c44a3"],

Cell["\<\
CTriSimp uses P2LSimp and P2PMSimp directly and therefore has no regulator \
argument. This is the primary Triangle result.\
\>", "Text",ExpressionUUID->"758fee6e-5f66-d443-b850-3388e5e1da8b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CTriSimp", "[", 
   RowBox[{"n_", ",", "t_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Gamma", "[", 
       RowBox[{
        RowBox[{"-", "I"}], " ", "n"}], "]"}], "^", "4"}], "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"4", " ", "\[Pi]"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"7", "/", "2"}], ")"}]}]}], ")"}], "*", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"P1", "[", "n", "]"}], "*", 
      RowBox[{"P2LSimp", "[", "n", "]"}], "*", 
      RowBox[{"IL", "[", 
       RowBox[{"n", ",", "t"}], "]"}]}], "+", 
     RowBox[{"2", "*", 
      RowBox[{"P1", "[", "n", "]"}], "*", 
      RowBox[{"P2PMSimp", "[", "n", "]"}], "*", 
      RowBox[{"IP", "[", 
       RowBox[{"n", ",", "t"}], "]"}]}]}], ")"}]}]}]], "Input",
 Evaluatable->False,
 CellChangeTimes->{
  3.998016853350439*^9, {3.998016900875061*^9, 3.998016922080206*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"1208b2ce-8ebc-784a-a1c7-1949cd6e6805"]
}, Open  ]],

