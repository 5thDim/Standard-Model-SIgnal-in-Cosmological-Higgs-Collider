                          {"If", "[", RowBox[{RowBox[{RowBox[{RowBox[
                          {"Length", "[", "result", "]"}], "\[Equal]", "2"}],
                          "&&", RowBox[{"VectorQ", "[", RowBox[{"result",
                          ",", "NumericQ"}], "]"}], "&&", RowBox[{"FreeQ",
                          "[", RowBox[{"result", ",", RowBox[
                          {"Indeterminate", "|", RowBox[{"DirectedInfinity",
                          "[", "_", "]"}]}]}], "]"}]}], ",", RowBox[{RowBox[
                          {"AssociateTo", "[", RowBox[{"hardCache", ",",
                          RowBox[{RowBox[{"{", RowBox[{"v", ",", "prec"}],
                          "}"}], "\[Rule]", "result"}]}], "]"}], ";",
                          "result"}], ",", "$Failed"}], "]"}]}]}], "]"}]}],
                  ";", RowBox[{RowBox[{"clearGaugeCache", "[", "]"}], ":=",
                    RowBox[{"(", RowBox[{RowBox[{"hardCache", "=", RowBox[
                          {"Association", "[", "]"}]}], ";", RowBox[
                         {"hardEvaluations", "=", "0"}], ";"}], ")"}]}], ";",
                  RowBox[{"Grid", "[", RowBox[{RowBox[{"Prepend", "[",
