Cell[BoxData[
 RowBox[{
  FractionBox[
   SuperscriptBox[
    RowBox[{"Gamma", "[", 
     RowBox[{"1", "+", 
      RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]}], "]"}], "2"], 
   RowBox[{"4", " ", 
    SuperscriptBox[
     RowBox[{"Gamma", "[", 
      RowBox[{
       FractionBox["3", "2"], "+", 
       RowBox[{"\[ImaginaryI]", " ", "nu"}]}], "]"}], "2"]}]], "-", 
  FractionBox[
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "2"}], " ", "nu", " ", "\[Pi]"}]], " ", 
    SuperscriptBox[
     RowBox[{"Gamma", "[", 
      RowBox[{"1", "+", 
       RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]}], "]"}], "2"]}], 
   RowBox[{"4", " ", 
    SuperscriptBox[
     RowBox[{"Gamma", "[", 
      RowBox[{
       FractionBox["3", "2"], "+", 
       RowBox[{"\[ImaginaryI]", " ", "nu"}]}], "]"}], "2"]}]], "+", 
  FractionBox[
   RowBox[{"\[ImaginaryI]", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "nu"}], " ", "\[Pi]"}]], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"2", "+", 
      RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      RowBox[{"HypergeometricPFQ", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], "-", 
           RowBox[{"\[ImaginaryI]", " ", "nu"}]}], ",", 
          RowBox[{"1", "+", 
           RowBox[{"2", " ", "\[ImaginaryI]", " ", "nu"}]}]}], "}"}], ",", 
        RowBox[{"{", "1", "}"}], ",", "1"}], "]"}]}], ")"}]}], 
   RowBox[{"2", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], "+", 
       RowBox[{"2", " ", "nu"}]}], ")"}], "2"]}]], "-", 
  RowBox[{
   FractionBox["1", "4"], " ", "\[ImaginaryI]", " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"nu", " ", "\[Pi]"}]], " ", 
   SuperscriptBox[
    RowBox[{"Gamma", "[", 
