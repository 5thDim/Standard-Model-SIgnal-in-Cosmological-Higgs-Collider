Cell[BoxData[RowBox[{RowBox[{"clearGaugeCache",
                 "[", "]"}], ";", RowBox[{RowBox[{"{", RowBox[{"scanSeconds",
                     ",", "massData"}], "}"}], "=", RowBox[{"AbsoluteTiming",
                   "[", RowBox[{"Table", "[", RowBox[{RowBox[{"Prepend", "[",
