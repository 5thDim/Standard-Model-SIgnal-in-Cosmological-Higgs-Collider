   SuperscriptBox[
    RowBox[{"Sinh", "[", 
     RowBox[{"\[Pi]", " ", "x"}], "]"}], "2"]}], 
  RowBox[{"256", " ", 
   SuperscriptBox["\[Pi]", 
    RowBox[{"7", "/", "2"}]], " ", 
   SuperscriptBox["x", "2"], " ", 
