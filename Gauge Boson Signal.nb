Cell["4. One mass scan, shared by every plot", "Section",ExpressionUUID->"e8020ca8-9db7-1745-84d6-1cf8eb0caf1a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"clearGaugeCache", "[", "]"}], ";", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"scanSeconds", ",", "massData"}], "}"}], "=", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{"coefficientValues", "[", 
         RowBox[{"v", ",", "wp"}], "]"}], ",", "v"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"v", ",", "massGrid"}], "}"}]}], "]"}], "]"}]}], ";", 
  RowBox[{"cacheScanCount", "=", "hardEvaluations"}], ";", 
  RowBox[{"scanFinite", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Dimensions", "[", "massData", "]"}], "\[Equal]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Length", "[", "massGrid", "]"}], ",", "8"}], "}"}]}], "&&", 
    RowBox[{"And", "@@", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"VectorQ", "[", 
         RowBox[{"#1", ",", "NumericQ"}], "]"}], "&"}], ")"}], "/@", 
      "massData"}]}], "&&", 
    RowBox[{"FreeQ", "[", 
     RowBox[{"massData", ",", 
      RowBox[{"Indeterminate", "|", 
       RowBox[{"DirectedInfinity", "[", "_", "]"}]}]}], "]"}]}]}], ";", 
  TagBox[GridBox[{
     {"\"\<mass points\>\"", 
      RowBox[{"Length", "[", "massData", "]"}]},
     {"\"\<requested digits\>\"", "wp"},
     {"\"\<hard-integral evaluations\>\"", "hardEvaluations"},
     {"\"\<scan time (seconds)\>\"", "scanSeconds"},
     {"\"\<finite numerical results\>\"", "scanFinite"}
    },
    AutoDelete->False,
    GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
   "Grid"]}]], "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"7811d84a-83aa-1f41-8962-f54e239d0e4a"],

