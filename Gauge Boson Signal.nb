          TraditionalForm,
          Editable->True]},
        {"\<\"r3\"\>", 
         TagBox[
          FormBox[
           RowBox[{"-", 
            FractionBox[
             RowBox[{"\[ImaginaryI]", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"u", " ", 
                 SuperscriptBox["w", "2"]}], "-", "u", "+", 
                RowBox[{"2", " ", 
                 SuperscriptBox["w", "2"]}]}], ")"}]}], 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", " ", "u"}], "+", "1"}], ")"}], " ", "w"}]]}],
           TraditionalForm],
          TraditionalForm,
          Editable->True]}
       },
       AutoDelete->False,
       GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
       GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
      "Grid"]},
    {"\<\"P_L = beta P_T + DeltaR + c F3\"\>"},
    {
     TagBox[GridBox[{
        {"\<\"beta\"\>", 
         TagBox[
          FormBox[
           FractionBox[
            RowBox[{
             RowBox[{"2", " ", "u"}], "+", "1"}], 
            RowBox[{"1", "-", 
             RowBox[{"2", " ", "u"}]}]],
           TraditionalForm],
          TraditionalForm,
          Editable->True]},
        {"\<\"c\"\>", 
         TagBox[
          FormBox[
           FractionBox[
            RowBox[{"2", " ", "\[ImaginaryI]", " ", "gg", " ", "u", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", " ", "u"}], "+", "1"}], ")"}]}], 
            RowBox[{
             RowBox[{"(", 
