Cell[CellGroupData[{
Cell["Gauge Boson Signal", "Title",ExpressionUUID->"80d27a78-2537-694b-a978-7efa86e37335"],

Cell["\<\
Optimized analytic coefficients, validation and mass dependence\
\>", "Subtitle",ExpressionUUID->"0ea3e186-fff1-8344-8a64-c9799a018cda"],

Cell["\<\
\:672c\:6587\:4ef6\:4fdd\:7559\:539f gauge notebook \:7684\:5f52\:4e00\:5316\
\:548c\:6b63\:9891\:8f6f\:652f\:7ea6\:5b9a\:3002\:4e3b\:6d41\:7a0b\:4f9d\:6b21\
\:7ed9\:51fa\:5b9a\:4e49\:3001\:516c\:5171\:8f6f\:79ef\:5206\:3001\:7cbe\:7b80\
\:540e\:7684\:65f6\:95f4\:79ef\:5206\:3001\:4e03\:4e2a\:7cfb\:6570\:53ca\:5176\
\:8d28\:91cf\:4f9d\:8d56\:3002\:539f\:63a8\:5bfc\:548c\:56fe\:4fdd\:5b58\:5728\
\:672b\:5c3e\:7684\:53ea\:8bfb\:5f52\:6863\:4e2d\:ff1b\:539f\:6587\:4ef6\:53e6\
\:6709\:5b8c\:6574\:5907\:4efd\:3002\:8bf7\:4ece\:5934\:5728\:65b0 kernel \
\:4e2d\:6c42\:503c\:3002\
\>", "Text",ExpressionUUID->"a447cba1-e831-4c43-8675-3c12f93d0e3e"],

Cell["\<\
nu = Sqrt[(mA/H)^2 - 1/4] > 0 is the vector mass index, not mA/H. The default \
grid reproduces the old range 0.01 <= nu <= 1. The physical mass is \
Sqrt[nu^2+1/4]. Overall couplings, diagram multiplicities and momentum \
factors retain the original notebook conventions; this optimization does not \
perform a new normalization audit.\
\>", "Text",ExpressionUUID->"37747d59-7326-8744-8fff-f03236125913"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BeginPackage", "[", "\"\<GaugeBosonSignal`\>\"", "]"}], ";", 
