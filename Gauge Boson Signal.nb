Cell["The names \
bubbleP1, bubblePolarizationSum, and bubbleCoefficient distinguish the vertex \
factor, the nine-polarization sum, and the final bubble coefficient.",
            "Text", ExpressionUUID ->
             "ccc357dd-a3b2-c84d-896a-4c291c566a55"],

Cell[BoxData[RowBox[{RowBox[{"(*", " ", RowBox[{RowBox[{"===",
                     RowBox[{"==", "\:7b2c\:4e09\:6b65"}]}], "\:ff1a",
                   RowBox[{RowBox[{"\:5b9a\:4e49", " ", RowBox[{"C", "^",
                         "Bub"}], RowBox[{"(", "\[Nu]", ")"}]}], "===",
                     "=="}]}], "*)"}], RowBox[{"(*", RowBox[
                  {RowBox[{"\:8f85\:52a9", " ", RowBox[{"P", "^", RowBox[
                        {"(", "1", ")"}]}], RowBox[{"(", "\[Nu]", ")"}], " ",
                     "\:516c\:5f0f", " ", RowBox[{"(", "48", ")"}], " ",
                     "\:53d6", " ", "c"}], "=", "+"}], "*)"}], RowBox[
                {RowBox[{RowBox[{"bubbleP1", "[", "x_", "]"}], ":=",
                   RowBox[{RowBox[{RowBox[{"(", RowBox[{"2", "+", " ",
                          RowBox[{"I", " ", "x"}]}], ")"}], "/", RowBox[
                        {"(", RowBox[{"2", " ", "I", " ", "x"}], ")"}]}],
                     "*", "I", "*", RowBox[{"Sinh", "[", RowBox[{"\[Pi]",
                         " ", "x"}], "]"}], " ", "*", " ", RowBox[{"Gamma",
                       "[", RowBox[{"2", "+", RowBox[{"2", " ", "I", " ",
                          "x"}]}], "]"}]}]}], "\[IndentingNewLine]",
                 "\[IndentingNewLine]", RowBox[{"(*", RowBox[
                    {"\:6240\:6709\:4e5d\:4e2a", " ", "g", " ",
                     "\:6c42\:548c"}], "*)"}], "\n", RowBox[
                  {RowBox[{"bubblePolarizationSum", "[", "\[Nu]_", "]"}],
                   ":=", RowBox[{RowBox[{"bubbleILL", "[", "\[Nu]", "]"}],
                     "+", RowBox[{"bubbleILP", "[", "\[Nu]", "]"}], "+",
                     RowBox[{"bubbleILM", "[", "\[Nu]", "]"}], "+",
                     RowBox[{"bubbleIPL", "[", "\[Nu]", "]"}], "+",
                     RowBox[{"bubbleIPP", "[", "\[Nu]", "]"}], "+",
