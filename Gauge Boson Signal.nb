Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"gaugeExplicitChecks", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"vv", "=", 
          RowBox[{"N", "[", 
           RowBox[{"v", ",", "50"}], "]"}]}], ",", "pv", ",", "mv", ",", "td",
          ",", "newP", ",", "newC", ",", "oldC"}], "}"}], ",", 
       RowBox[{
        RowBox[{"mv", "=", 
         RowBox[{"Append", "[", 
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Take", "[", 
               RowBox[{"masterExpressions", ",", "3"}], "]"}], "/.", 
              "\[VeryThinSpace]", 
              RowBox[{"nu", "\[Rule]", "vv"}]}], ",", "40"}], "]"}], ",", 
           RowBox[{"mixedMaster", "[", 
            RowBox[{"v", ",", "40"}], "]"}]}], "]"}]}], ";", 
        RowBox[{"td", "=", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"tFiniteCore", ",", "dFiniteCore"}], "}"}], "/.", 
             "\[VeryThinSpace]", 
             RowBox[{"commonRules", "[", "vv", "]"}]}], "/.", 
            "\[VeryThinSpace]", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"master", "[", "j", "]"}], "\[Rule]", 
               RowBox[{
               "mv", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]}],
               ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "4"}], "}"}]}], "]"}]}], ",", "35"}], 
          "]"}]}], ";", 
        RowBox[{"newP", "=", 
         RowBox[{
          RowBox[{"Gamma", "[", 
           RowBox[{"2", " ", "\[ImaginaryI]", " ", "vv"}], "]"}], " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             FractionBox[
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{"2", " ", "\[ImaginaryI]", " ", "vv"}]}], ")"}], " ", 
               RowBox[{
               "td", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
              RowBox[{"1", "-", 
               RowBox[{"2", " ", "\[ImaginaryI]", " ", "vv"}]}]], "+", 
             RowBox[{
             "td", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], ",", 
            RowBox[{
            "td", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
           "}"}]}]}], ";", 
        RowBox[{"pv", "=", 
         RowBox[{"hardValues", "[", 
          RowBox[{"v", ",", "40"}], "]"}]}], ";", 
        RowBox[{"newC", "=", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"gaugeNPaper", "[", "vv", "]"}], " ", 
            RowBox[{"(", 
             RowBox[{"gaugeAngularPolynomial", "/.", "\[VeryThinSpace]", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"nu", "\[Rule]", "vv"}], ",", 
                RowBox[{"tg", "\[Rule]", 
                 RowBox[{
                 "td", "\[LeftDoubleBracket]", "1", 
                  "\[RightDoubleBracket]"}]}], ",", 
                RowBox[{"dg", "\[Rule]", 
                 RowBox[{
                 "td", "\[LeftDoubleBracket]", "2", 
                  "\[RightDoubleBracket]"}]}]}], "}"}]}], ")"}]}], ",", 
           "35"}], "]"}]}], ";", 
        RowBox[{"oldC", "=", 
         RowBox[{"Drop", "[", 
          RowBox[{
           RowBox[{"coefficientValues", "[", 
            RowBox[{"v", ",", "40"}], "]"}], ",", "2"}], "]"}]}], ";", 
        RowBox[{"{", 
         RowBox[{"v", ",", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            FractionBox[
             RowBox[{"newP", "-", "pv"}], "pv"], "]"}], "]"}], ",", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            FractionBox[
             RowBox[{"newC", "-", "oldC"}], "oldC"], "]"}], "]"}]}], 
         "}"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"v", ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", "100"], ",", 
         FractionBox["1", "10"], ",", 
         FractionBox["3", "5"], ",", "1"}], "}"}]}], "}"}]}], "]"}]}], ";", 
  RowBox[{"gaugeExplicitValidation", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<Exact finite P\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"gaugeFinitePCheck", "\[Equal]", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"\"\<Exact five angular polynomials\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"gaugeAngularCheck", "\[Equal]", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", "5"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"\"\<Common Gamma normalization\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"gaugeNCheck", "\[Equal]", "1"}], "]"}]}], ",", 
     RowBox[{"\"\<Numerical finite P\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"gaugeExplicitChecks", "\[LeftDoubleBracket]", 
          RowBox[{"All", ",", "2"}], "\[RightDoubleBracket]"}], "]"}], "<", 
        FractionBox["1", 
         SuperscriptBox["10", "25"]]}], "]"}]}], ",", 
     RowBox[{"\"\<Numerical angular coefficients\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"gaugeExplicitChecks", "\[LeftDoubleBracket]", 
          RowBox[{"All", ",", "3"}], "\[RightDoubleBracket]"}], "]"}], "<", 
        FractionBox["1", 
         SuperscriptBox["10", "25"]]}], "]"}]}], ",", 
     RowBox[{"\"\<No P functions in explicit angles\>\"", "\[Rule]", 
      RowBox[{"FreeQ", "[", 
       RowBox[{"gaugeAngularFullySubstituted", ",", 
        RowBox[{"P2LGauge", "|", "P2TGauge", "|", "pl", "|", "pt"}]}], 
       "]"}]}]}], "]"}]}], ";", 
  TagBox[GridBox[{
     {
      RowBox[{"Grid", "[", 
       RowBox[{
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"gaugeExplicitChecks", ",", "6"}], "]"}], ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<nu\>\"", ",", "\"\<P relative error\>\"", 
            ",", "\"\<angular relative error\>\""}], "}"}]}], "]"}], ",", 
        RowBox[{"Frame", "\[Rule]", "All"}]}], "]"}]},
     {
      RowBox[{"Grid", "[", 
       RowBox[{
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
          "gaugeExplicitValidation"}], "]"}], ",", 
        RowBox[{"Frame", "\[Rule]", "All"}]}], "]"}]}
    },
    DefaultBaseStyle->"Column",
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
   "Column"]}]], "Input",ExpressionUUID->"3b409e6b-cad0-48ca-b9fb-\
27f684568fe4"],

