   SuperscriptBox[
    RowBox[{"Gamma", "[", 
     RowBox[{
      FractionBox["5", "2"], "+", 
      RowBox[{"\[ImaginaryI]", " ", "x"}]}], "]"}], "2"], " ", 
   RowBox[{"Gamma", "[", 
    RowBox[{
     RowBox[{"-", 
