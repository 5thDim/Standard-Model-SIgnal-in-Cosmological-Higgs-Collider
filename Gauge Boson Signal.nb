    RowBox[{"\:6240\:6709\:4e5d\:4e2a", " ", "g", " ", "\:6c42\:548c"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"bubblePolarizationSum", "[", "\[Nu]_", "]"}], ":=", 
    RowBox[{
     RowBox[{"bubbleILL", "[", "\[Nu]", "]"}], "+", 
     RowBox[{"bubbleILP", "[", "\[Nu]", "]"}], "+", 
     RowBox[{"bubbleILM", "[", "\[Nu]", "]"}], "+", 
     RowBox[{"bubbleIPL", "[", "\[Nu]", "]"}], "+", 
     RowBox[{"bubbleIPP", "[", "\[Nu]", "]"}], "+", 
     RowBox[{"bubbleIPM", "[", "\[Nu]", "]"}], "+", 
     RowBox[{"bubbleIML", "[", "\[Nu]", "]"}], "+", 
     RowBox[{"bubbleIMP", "[", "\[Nu]", "]"}], "+", 
     RowBox[{"bubbleIMM", "[", "\[Nu]", "]"}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"C", "^", "Bub"}], " ", "\:5b9a\:4e49"}], "\:ff0c", 
     RowBox[{"\:516c\:5f0f", " ", 
      RowBox[{"(", "52", ")"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"bubbleCoefficient", "[", "\[Nu]_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Gamma", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", "\[Nu]"}], "]"}], "^", "4"}], "/", 
       RowBox[{
        RowBox[{"(", 
