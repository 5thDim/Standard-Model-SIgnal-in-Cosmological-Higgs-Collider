Cell["Triangle coefficient with regulated P2 (cross-check)",
            "Subsection", ExpressionUUID ->
             "23c972f7-60fe-824a-bce2-7fb61ab44c39"],

Cell[BoxData[RowBox[{RowBox[{"CTri", "[", RowBox[{"n_", ",",
                   "reg_", ",", "t_"}], "]"}], ":=", RowBox[
                {RowBox[{"(", RowBox[{RowBox[{RowBox[{"Gamma", "[", RowBox[
                          {RowBox[{"-", "I"}], " ", "n"}], "]"}], "^", "4"}],
                     "/", RowBox[{RowBox[{"(", RowBox[{"4", " ", "\[Pi]"}],
                         ")"}], "^", RowBox[{"(", RowBox[{"7", "/", "2"}],
                         ")"}]}]}], ")"}], "*", RowBox[{"(", RowBox[
                    {RowBox[{RowBox[{"P1", "[", "n", "]"}], "*", RowBox[
                        {"P2L", "[", RowBox[{"n", ",", "reg"}], "]"}], "*",
                       RowBox[{"IL", "[", RowBox[{"n", ",", "t"}], "]"}]}],
                     "+", RowBox[{"2", "*", RowBox[{"P1", "[", "n", "]"}],
                       "*", RowBox[{"P2PM", "[", RowBox[{"n", ",", "reg"}],
                         "]"}], "*", RowBox[{"IP", "[", RowBox[{"n", ",",
                          "t"}], "]"}]}]}], ")"}]}]}]], "Input",
