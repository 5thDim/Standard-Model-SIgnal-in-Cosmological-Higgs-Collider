Cell[CellGroupData[{

Cell["Exact consistency check: inline finite parts vs common basis", \
"Subsubsection",
 CellTags->
  "P2Compare-start",ExpressionUUID->"b7a570e6-4e35-44da-a202-d1dac52420a4"],

Cell["\<\
Compare {P2LReg0[nu], P2PMReg0[nu]} from the inline Laurent calculation with \
{P2LGauge[nu], P2TGauge[nu]} from the original common basis, for real nu > 0. \
Direct FullSimplify of the unprepared difference did not finish within 15 \
seconds per polarization in this run. The cells below instead align the four \
hypergeometric masters and use Gamma/polygamma identities to compare every \
coefficient exactly. No external script or saved analytic expression is \
imported.\
\>", "Text",
 CellTags->
  "P2Compare-intro",ExpressionUUID->"bf7cd121-8891-418a-af4f-8daaf5ee434f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"p2FinitePair", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"P2LReg0", "[", "nu", "]"}], ",", 
     RowBox[{"P2PMReg0", "[", "nu", "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p2Canonical", "[", "expr_", "]"}], ":=", 
   RowBox[{"expr", "/.", "\[VeryThinSpace]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"HoldPattern", "[", 
        RowBox[{
         SuperscriptBox["HypergeometricPFQRegularized", 
          TagBox[
           RowBox[{"(", 
            RowBox[{"aa_List", ",", "bb_List", ",", "0"}], ")"}],
           Derivative],
          MultilineFunction->None], "[", 
         RowBox[{"a_List", ",", "b_List", ",", "1"}], "]"}], "]"}], "\[RuleDelayed]", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"o", "=", 
           RowBox[{"Ordering", "[", 
            TemplateBox[{
              RowBox[{"{", 
                RowBox[{"b", ",", "bb"}], "}"}]},
             "Transpose"], "]"}]}], "}"}], ",", 
         RowBox[{
          SuperscriptBox["HypergeometricPFQRegularized", 
           TagBox[
            RowBox[{"(", 
             RowBox[{"aa", ",", 
              RowBox[{
              "bb", "\[LeftDoubleBracket]", "o", "\[RightDoubleBracket]"}], ",",
               "0"}], ")"}],
            Derivative],
           MultilineFunction->None], "[", 
          RowBox[{"a", ",", 
           RowBox[{
           "b", "\[LeftDoubleBracket]", "o", "\[RightDoubleBracket]"}], ",", 
           "1"}], "]"}]}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"HoldPattern", "[", 
        RowBox[{"HypergeometricPFQRegularized", "[", 
         RowBox[{"a_List", ",", "b_List", ",", "1"}], "]"}], "]"}], "\[RuleDelayed]", 
       RowBox[{"HypergeometricPFQRegularized", "[", 
        RowBox[{"a", ",", 
         RowBox[{"Sort", "[", "b", "]"}], ",", "1"}], "]"}]}]}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p2GaussDerivative", "[", 
    RowBox[{"oa_", ",", "ob_", ",", "a_", ",", "b_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"zz", "=", 
        RowBox[{"Array", "[", 
         RowBox[{"p2Shift", ",", "5"}], "]"}]}], ",", "ap", ",", "bp", ",", 
       "pairs", ",", "ia", ",", "ib", ",", "gamma"}], "}"}], ",", 
     RowBox[{
      RowBox[{"ap", "=", 
       RowBox[{"a", "+", 
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{"zz", ",", "3"}], "]"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"#1", "\[Equal]", "0"}], ",", "0", ",", "1"}], "]"}], 
            "&"}], ")"}], "/@", "oa"}]}]}]}], ";", 
      RowBox[{"bp", "=", 
       RowBox[{"b", "+", 
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{"zz", ",", 
           RowBox[{"-", "2"}]}], "]"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"#1", "\[Equal]", "0"}], ",", "0", ",", "1"}], "]"}], 
            "&"}], ")"}], "/@", "ob"}]}]}]}], ";", 
      RowBox[{"pairs", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Tuples", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Range", "[", "3", "]"}], ",", 
            RowBox[{"Range", "[", "2", "]"}]}], "}"}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"ap", "\[LeftDoubleBracket]", 
            RowBox[{
            "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
            "\[RightDoubleBracket]"}], "===", 
           RowBox[{"bp", "\[LeftDoubleBracket]", 
            RowBox[{
            "#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
            "\[RightDoubleBracket]"}]}], "&"}]}], "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"pairs", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{
          SuperscriptBox["HypergeometricPFQRegularized", 
           TagBox[
            RowBox[{"(", 
             RowBox[{"oa", ",", "ob", ",", "0"}], ")"}],
            Derivative],
           MultilineFunction->None], "[", 
          RowBox[{"a", ",", "b", ",", "1"}], "]"}], "]"}]}], "]"}], ";", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ia", ",", "ib"}], "}"}], "=", 
       RowBox[{"First", "[", "pairs", "]"}]}], ";", 
      RowBox[{"gamma", "=", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"up", "=", 
            RowBox[{"Delete", "[", 
             RowBox[{"ap", ",", "ia"}], "]"}]}], ",", 
           RowBox[{"lo", "=", 
            RowBox[{"First", "[", 
             RowBox[{"Delete", "[", 
              RowBox[{"bp", ",", "ib"}], "]"}], "]"}]}]}], "}"}], ",", 
         FractionBox[
          RowBox[{
           RowBox[{"Gamma", "[", "lo", "]"}], " ", 
           RowBox[{"Gamma", "[", 
            RowBox[{"lo", "-", 
             RowBox[{"Total", "[", "up", "]"}]}], "]"}]}], 
          RowBox[{
           RowBox[{"Times", "@@", 
            RowBox[{"Gamma", "[", 
             RowBox[{"lo", "-", "up"}], "]"}]}], " ", 
           RowBox[{"Times", "@@", 
            RowBox[{"Gamma", "[", "bp", "]"}]}]}]]}], "]"}]}], ";", 
      RowBox[{
       RowBox[{"Fold", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           SubscriptBox["\[PartialD]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
              "#2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
              RowBox[{
              "#2", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
             "}"}]], "#1"}], "&"}], ",", "gamma", ",", 
         TemplateBox[{
           RowBox[{"{", 
             RowBox[{"zz", ",", 
               RowBox[{"Join", "[", 
                 RowBox[{"oa", ",", "ob"}], "]"}]}], "}"}]},
          "Transpose"]}], "]"}], "/.", "\[VeryThinSpace]", 
       RowBox[{"Thread", "[", 
        RowBox[{"zz", "\[Rule]", "0"}], "]"}]}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 ShowCellLabel->False,
 CellTags->
  "P2Compare-setup",ExpressionUUID->"538a0609-b09d-45a6-b4ca-785dc785fcd9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"p2CanonicalFinite", "=", 
   RowBox[{"p2Canonical", "[", "p2FinitePair", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2HyperObjects", "=", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"Cases", "[", 
     RowBox[{"p2CanonicalFinite", ",", 
      RowBox[{
       RowBox[{
        SuperscriptBox["HypergeometricPFQRegularized", 
         TagBox[
          RowBox[{"(", 
           RowBox[{"_", ",", "_", ",", "0"}], ")"}],
          Derivative],
         MultilineFunction->None], "[", 
        RowBox[{"_", ",", "_", ",", "1"}], "]"}], "|", 
       "_HypergeometricPFQRegularized", "|", "_HypergeometricPFQ"}], ",", 
      "\[Infinity]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2GaussRules", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"#1", "\[Rule]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"FreeQ", "[", 
