Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"p2IntegerFactor", "[", 
    RowBox[{"z_", ",", "n_Integer"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"n", "\[GreaterEqual]", "0"}], ",", 
     RowBox[{
      UnderoverscriptBox["\[Product]", 
       RowBox[{"j", "=", "0"}], 
       RowBox[{"n", "-", "1"}]], 
      RowBox[{"(", 
       RowBox[{"z", "+", "j"}], ")"}]}], ",", 
     FractionBox["1", 
      RowBox[{
       UnderoverscriptBox["\[Product]", 
        RowBox[{"j", "=", "n"}], 
        RowBox[{"-", "1"}]], 
       RowBox[{"(", 
        RowBox[{"z", "+", "j"}], ")"}]}]]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p2PolyGammaShift", "[", 
    RowBox[{"k_", ",", "z_", ",", "n_Integer"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"PolyGamma", "[", 
     RowBox[{"k", ",", "z"}], "]"}], "+", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "k"], " ", 
     RowBox[{"k", "!"}], " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"n", "\[GreaterEqual]", "0"}], ",", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], 
         RowBox[{"n", "-", "1"}]], 
        FractionBox["1", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"z", "+", "j"}], ")"}], 
          RowBox[{"k", "+", "1"}]]]}], ",", 
       RowBox[{"-", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"j", "=", "n"}], 
          RowBox[{"-", "1"}]], 
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"z", "+", "j"}], ")"}], 
           RowBox[{"k", "+", "1"}]]]}]}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p2NormalizeCoefficients", "[", "coeff_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "ee", "}"}], ",", 
     RowBox[{
      RowBox[{"ee", "=", 
       RowBox[{"coeff", "/.", "\[VeryThinSpace]", 
        RowBox[{"nu", "\[Rule]", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "u"}]}]}]}], ";", 
      RowBox[{"ee", "=", 
       RowBox[{"ee", "/.", "\[VeryThinSpace]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Gamma", "[", "a_", "]"}], "\[RuleDelayed]", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"c", "=", 
               RowBox[{"a", "/.", "\[VeryThinSpace]", 
                RowBox[{"u", "\[Rule]", "0"}]}]}], "}"}], ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"IntegerQ", "[", 
                RowBox[{"2", " ", "c"}], "]"}], ",", 
               RowBox[{"With", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"n", "=", 
                   RowBox[{"Floor", "[", "c", "]"}]}], "}"}], ",", 
                 RowBox[{
                  RowBox[{"Gamma", "[", 
                   RowBox[{"a", "-", "n"}], "]"}], " ", 
                  RowBox[{"p2IntegerFactor", "[", 
                   RowBox[{
                    RowBox[{"a", "-", "n"}], ",", "n"}], "]"}]}]}], "]"}], ",", 
               RowBox[{"Gamma", "[", "a", "]"}]}], "]"}]}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"PolyGamma", "[", 
            RowBox[{"k_Integer", ",", "a_"}], "]"}], "\[RuleDelayed]", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"c", "=", 
               RowBox[{"a", "/.", "\[VeryThinSpace]", 
                RowBox[{"u", "\[Rule]", "0"}]}]}], "}"}], ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"IntegerQ", "[", 
                RowBox[{"2", " ", "c"}], "]"}], ",", 
               RowBox[{"With", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"n", "=", 
                   RowBox[{"Floor", "[", "c", "]"}]}], "}"}], ",", 
                 RowBox[{"p2PolyGammaShift", "[", 
                  RowBox[{"k", ",", 
                   RowBox[{"a", "-", "n"}], ",", "n"}], "]"}]}], "]"}], ",", 
               RowBox[{"PolyGamma", "[", 
                RowBox[{"k", ",", "a"}], "]"}]}], "]"}]}], "]"}]}]}], 
         "}"}]}]}], ";", 
      RowBox[{"ee", "=", 
       RowBox[{"ee", "/.", "\[VeryThinSpace]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Gamma", "[", 
            RowBox[{
             RowBox[{"-", "2"}], " ", "u"}], "]"}], "\[Rule]", 
           RowBox[{"-", 
            FractionBox["\[Pi]", 
             RowBox[{"2", " ", "u", " ", 
              RowBox[{"Sin", "[", 
               RowBox[{"2", " ", "\[Pi]", " ", "u"}], "]"}], " ", 
              RowBox[{"Gamma", "[", 
               RowBox[{"2", " ", "u"}], "]"}]}]]}]}], ",", 
          RowBox[{
           RowBox[{"Gamma", "[", 
            RowBox[{"-", "u"}], "]"}], "\[Rule]", 
           RowBox[{"-", 
            FractionBox["\[Pi]", 
             RowBox[{"u", " ", 
              RowBox[{"Sin", "[", 
               RowBox[{"\[Pi]", " ", "u"}], "]"}], " ", 
              RowBox[{"Gamma", "[", "u", "]"}]}]]}]}], ",", 
          RowBox[{
           RowBox[{"Gamma", "[", 
            RowBox[{
             FractionBox["1", "2"], "-", "u"}], "]"}], "\[Rule]", 
           FractionBox["\[Pi]", 
            RowBox[{
             RowBox[{"Cos", "[", 
              RowBox[{"\[Pi]", " ", "u"}], "]"}], " ", 
             RowBox[{"Gamma", "[", 
              RowBox[{
               FractionBox["1", "2"], "+", "u"}], "]"}]}]]}], ",", 
          RowBox[{
           RowBox[{"PolyGamma", "[", 
            RowBox[{"0", ",", 
             RowBox[{
              RowBox[{"-", "2"}], " ", "u"}]}], "]"}], "\[Rule]", 
           RowBox[{
            RowBox[{"PolyGamma", "[", 
             RowBox[{"0", ",", 
              RowBox[{"2", " ", "u"}]}], "]"}], "+", 
            RowBox[{"\[Pi]", " ", 
             RowBox[{"Cot", "[", 
              RowBox[{"2", " ", "\[Pi]", " ", "u"}], "]"}]}], "+", 
            FractionBox["1", 
             RowBox[{"2", " ", "u"}]]}]}], ",", 
          RowBox[{
           RowBox[{"PolyGamma", "[", 
            RowBox[{"0", ",", 
             RowBox[{"-", "u"}]}], "]"}], "\[Rule]", 
           RowBox[{
            RowBox[{"PolyGamma", "[", 
             RowBox[{"0", ",", "u"}], "]"}], "+", 
            RowBox[{"\[Pi]", " ", 
             RowBox[{"Cot", "[", 
              RowBox[{"\[Pi]", " ", "u"}], "]"}]}], "+", 
            FractionBox["1", "u"]}]}], ",", 
          RowBox[{
           RowBox[{"PolyGamma", "[", 
            RowBox[{"0", ",", 
             RowBox[{
              FractionBox["1", "2"], "-", "u"}]}], "]"}], "\[Rule]", 
           RowBox[{
            RowBox[{"PolyGamma", "[", 
             RowBox[{"0", ",", 
              RowBox[{
               FractionBox["1", "2"], "+", "u"}]}], "]"}], "-", 
            RowBox[{"\[Pi]", " ", 
             RowBox[{"Tan", "[", 
              RowBox[{"\[Pi]", " ", "u"}], "]"}]}]}]}], ",", 
          RowBox[{
           RowBox[{"PolyGamma", "[", 
            RowBox[{"1", ",", 
             RowBox[{
              RowBox[{"-", "2"}], " ", "u"}]}], "]"}], "\[Rule]", 
           RowBox[{
            RowBox[{
             SuperscriptBox["\[Pi]", "2"], " ", 
             SuperscriptBox[
              RowBox[{"Csc", "[", 
               RowBox[{"2", " ", "\[Pi]", " ", "u"}], "]"}], "2"]}], "-", 
            RowBox[{"PolyGamma", "[", 
             RowBox[{"1", ",", 
              RowBox[{"2", " ", "u"}]}], "]"}], "+", 
            FractionBox["1", 
             RowBox[{"4", " ", 
              SuperscriptBox["u", "2"]}]]}]}], ",", 
          RowBox[{
           RowBox[{"PolyGamma", "[", 
            RowBox[{"1", ",", 
             RowBox[{"-", "u"}]}], "]"}], "\[Rule]", 
           RowBox[{
            RowBox[{
             SuperscriptBox["\[Pi]", "2"], " ", 
             SuperscriptBox[
              RowBox[{"Csc", "[", 
               RowBox[{"\[Pi]", " ", "u"}], "]"}], "2"]}], "-", 
            RowBox[{"PolyGamma", "[", 
             RowBox[{"1", ",", "u"}], "]"}], "+", 
            FractionBox["1", 
             SuperscriptBox["u", "2"]]}]}], ",", 
          RowBox[{
           RowBox[{"PolyGamma", "[", 
            RowBox[{"1", ",", 
             RowBox[{
              FractionBox["1", "2"], "-", "u"}]}], "]"}], "\[Rule]", 
           RowBox[{
            RowBox[{
             SuperscriptBox["\[Pi]", "2"], " ", 
             SuperscriptBox[
              RowBox[{"Sec", "[", 
               RowBox[{"\[Pi]", " ", "u"}], "]"}], "2"]}], "-", 
            RowBox[{"PolyGamma", "[", 
             RowBox[{"1", ",", 
              RowBox[{
               FractionBox["1", "2"], "+", "u"}]}], "]"}]}]}]}], "}"}]}]}], ";", 
      RowBox[{"ee", "=", 
       RowBox[{"ee", "/.", "\[VeryThinSpace]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Gamma", "[", "u", "]"}], "\[Rule]", 
           FractionBox[
            RowBox[{
             SuperscriptBox["2", 
              RowBox[{"1", "-", 
               RowBox[{"2", " ", "u"}]}]], " ", 
             SqrtBox["\[Pi]"], " ", 
             RowBox[{"Gamma", "[", 
              RowBox[{"2", " ", "u"}], "]"}]}], 
            RowBox[{"Gamma", "[", 
             RowBox[{
              FractionBox["1", "2"], "+", "u"}], "]"}]]}], ",", 
          RowBox[{
           RowBox[{"PolyGamma", "[", 
            RowBox[{"0", ",", "u"}], "]"}], "\[Rule]", 
           RowBox[{
            RowBox[{"2", " ", 
             RowBox[{"PolyGamma", "[", 
              RowBox[{"0", ",", 
               RowBox[{"2", " ", "u"}]}], "]"}]}], "-", 
            RowBox[{"2", " ", 
             RowBox[{"Log", "[", "2", "]"}]}], "-", 
            RowBox[{"PolyGamma", "[", 
             RowBox[{"0", ",", 
              RowBox[{
               FractionBox["1", "2"], "+", "u"}]}], "]"}]}]}], ",", 
          RowBox[{
           RowBox[{"PolyGamma", "[", 
            RowBox[{"1", ",", "u"}], "]"}], "\[Rule]", 
           RowBox[{
            RowBox[{"4", " ", 
             RowBox[{"PolyGamma", "[", 
              RowBox[{"1", ",", 
               RowBox[{"2", " ", "u"}]}], "]"}]}], "-", 
            RowBox[{"PolyGamma", "[", 
             RowBox[{"1", ",", 
              RowBox[{
               FractionBox["1", "2"], "+", "u"}]}], "]"}]}]}]}], "}"}]}]}], ";", 
      RowBox[{"ee", "=", 
       RowBox[{"ee", "/.", "\[VeryThinSpace]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Gamma", "[", 
            RowBox[{"2", " ", "u"}], "]"}], "\[Rule]", "gg"}], ",", 
          RowBox[{
           RowBox[{"Gamma", "[", 
            RowBox[{
             FractionBox["1", "2"], "+", "u"}], "]"}], "\[Rule]", "hh"}], ",", 
          RowBox[{
           RowBox[{"PolyGamma", "[", 
            RowBox[{"0", ",", 
             RowBox[{"2", " ", "u"}]}], "]"}], "\[Rule]", "ps"}], ",", 
          RowBox[{
           RowBox[{"PolyGamma", "[", 
            RowBox[{"0", ",", 
             RowBox[{
              FractionBox["1", "2"], "+", "u"}]}], "]"}], "\[Rule]", "qh"}], ",", 
          RowBox[{
           RowBox[{"PolyGamma", "[", 
            RowBox[{"1", ",", 
             RowBox[{"2", " ", "u"}]}], "]"}], "\[Rule]", "ps1"}], ",", 
          RowBox[{
           RowBox[{"PolyGamma", "[", 
            RowBox[{"1", ",", 
             RowBox[{
              FractionBox["1", "2"], "+", "u"}]}], "]"}], "\[Rule]", 
           "qh1"}]}], "}"}]}]}], ";", 
      RowBox[{"ee", "=", 
       RowBox[{"TrigToExp", "[", "ee", "]"}]}], ";", 
      RowBox[{"ee", "=", 
       RowBox[{"ee", "/.", "\[VeryThinSpace]", 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", "a_"], "\[RuleDelayed]", 
         SuperscriptBox["w", 
          RowBox[{"Simplify", "[", 
           RowBox[{"-", 
            FractionBox["a", 
             RowBox[{"\[ImaginaryI]", " ", "\[Pi]", " ", "u"}]]}], 
           "]"}]]}]}]}], ";", 
      RowBox[{"ee", "/.", "\[VeryThinSpace]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Log", "[", "4", "]"}], "\[Rule]", 
          RowBox[{"2", " ", 
           RowBox[{"Log", "[", "2", "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"Log", "[", "16", "]"}], "\[Rule]", 
          RowBox[{"4", " ", 
           RowBox[{"Log", "[", "2", "]"}]}]}]}], "}"}]}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2NormalizedCoefficients", "=", 
   RowBox[{"p2NormalizeCoefficients", "[", "p2CollectedCoefficients", "]"}]}],
