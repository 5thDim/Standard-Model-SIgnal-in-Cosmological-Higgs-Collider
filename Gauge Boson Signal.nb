Cell[CellGroupData[{

Cell["Box coefficient with regulated P2 (cross-check)", "Subsection",ExpressionUUID->"7e0df9cf-733d-0d40-accc-1473123d1466"],

Cell["\<\
CBox retains the finite-regulator P2L and P2PM functions for comparison only.\
\>", "Text",ExpressionUUID->"2cabe613-2a26-b24a-b921-d08333ee154a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CBox", "[", 
   RowBox[{"n_", ",", "t1_", ",", "t3_", ",", "p_", ",", "reg_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Gamma", "[", 
       RowBox[{
        RowBox[{"-", "I"}], " ", "n"}], "]"}], "^", "4"}], "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"4", " ", "\[Pi]"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"7", "/", "2"}], ")"}]}]}], ")"}], "*", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"P2L", "[", 
        RowBox[{"n", ",", "reg"}], "]"}], "^", "2"}], "*", 
      RowBox[{"SLL", "[", 
       RowBox[{"n", ",", "t1", ",", "t3", ",", "p"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{
       RowBox[{"P2PM", "[", 
        RowBox[{"n", ",", "reg"}], "]"}], "^", "2"}], "*", 
      RowBox[{"SHH", "[", 
       RowBox[{"n", ",", "t1", ",", "t3", ",", "p"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"P2L", "[", 
       RowBox[{"n", ",", "reg"}], "]"}], "*", 
      RowBox[{"P2PM", "[", 
       RowBox[{"n", ",", "reg"}], "]"}], "*", 
      RowBox[{"SLH", "[", 
       RowBox[{"n", ",", "t1", ",", "t3", ",", "p"}], "]"}]}]}], 
    ")"}]}]}]], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.9972633832748604`*^9, 3.997263448202137*^9}, {
  3.997263497222904*^9, 3.997263596946911*^9}},
