Cell[CellGroupData[{

Cell["Boltzmann-removed mass scans", "Section",ExpressionUUID->"7302369a-1116-4913-b113-bd9aefc3c5e6"],

Cell["\<\
For each original mass scan, the red curve below is Log|C(x)| + 2 Pi x = \
Log|Exp[2 Pi x] C(x)|, with x equal to the mass index used in the original \
scan. The coefficient and phase are unchanged. The cached plots use the \
original numerical points; reevaluate the input cells after changing \
definitions.\
\>", "Text",ExpressionUUID->"c9b00631-e783-41c3-ae27-1e5070d2d2a9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"BubbleDeboltzmannData", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"N", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"bubbleCoefficient", "[", "x", "]"}], "]"}], "]"}], "]"}], 
        " ", "+", " ", 
        RowBox[{"2", " ", "Pi", " ", "x"}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "0.01", ",", " ", "1", ",", " ", "0.01"}], 
      "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"BubbleDeboltzmannData", ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<x = mass index\>\"", ",", " ", "\"\<Log|C| + 2 Pi x\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", " ", "\"\<Bubble: Boltzmann factor removed\>\""}], 
   ",", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", "Red"}], ",", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "]"}]}], "Input",
 Evaluatable->False,
 CellLabel->"In[19]:=",ExpressionUUID->"04a4cde6-8b98-4ad2-a6cb-f1eedec7ed38"],

