                          "\[Nu]"}], "]"}], "^", "4"}], "/", RowBox[
                          {RowBox[{"(", RowBox[{"4", " ", "\[Pi]"}], ")"}],
                          "^", RowBox[{"(", RowBox[{"7", "/", "2"}],
                          ")"}]}]}], ")"}], "*", RowBox[{"(", RowBox[
                        {RowBox[{"bubbleP1", "[", "\[Nu]", "]"}], "^", "2"}],
