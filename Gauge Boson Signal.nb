                          "\[ImaginaryI]", " ", "j"}], "nn"]}], "]"}]}],
                          SuperscriptBox[RowBox[{"Gamma", "[", RowBox[{"1",
                          "+", "z"}], "]"}], "2"]]}], "]"}], ",", RowBox[
                          {"{", RowBox[{"j", ",", "0", ",", RowBox[{"nn",
                          "-", "1"}]}], "}"}]}], "]"}]}], ";", RowBox[
                        {"gauss", "=", FractionBox[RowBox[{"Gamma", "[",
