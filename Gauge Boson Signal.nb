            RowBox[{"x", ",", " ", "0"}], "]"}], "]"}], "]"}], "]"}], " ", "+",
         " ", 
        RowBox[{"2", " ", "Pi", " ", "x"}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{"1", "/", "100"}], ",", " ", "1", ",", " ", 
       RowBox[{"1", "/", "100"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
