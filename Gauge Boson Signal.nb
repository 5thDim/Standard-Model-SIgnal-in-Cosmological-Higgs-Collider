      RowBox[{"(", 
       RowBox[{"7", "/", "2"}], ")"}]}]}], ")"}], "*", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"P1", "[", "n", "]"}], "*", 
      RowBox[{"P2L", "[", 
       RowBox[{"n", ",", "reg"}], "]"}], "*", 
      RowBox[{"IL", "[", 
       RowBox[{"n", ",", "t"}], "]"}]}], "+", 
     RowBox[{"2", "*", 
      RowBox[{"P1", "[", "n", "]"}], "*", 
      RowBox[{"P2PM", "[", 
       RowBox[{"n", ",", "reg"}], "]"}], "*", 
      RowBox[{"IP", "[", 
       RowBox[{"n", ",", "t"}], "]"}]}]}], ")"}]}]}]], "Input",
