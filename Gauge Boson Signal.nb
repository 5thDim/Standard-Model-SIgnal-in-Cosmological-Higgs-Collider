           RowBox[{"FunctionExpand", "[", 
            RowBox[{"#1", ",", 
             RowBox[{"nu", ">", "0"}]}], "]"}], ",", "3", ",", "#1"}], "]"}], 
         ",", 
         RowBox[{"#1", "/.", "\[VeryThinSpace]", 
          RowBox[{
           RowBox[{"HoldPattern", "[", 
            RowBox[{
             SuperscriptBox["HypergeometricPFQRegularized", 
              TagBox[
               RowBox[{"(", 
                RowBox[{"oa_List", ",", "ob_List", ",", "0"}], ")"}],
               Derivative],
              MultilineFunction->None], "[", 
             RowBox[{"a_List", ",", "b_List", ",", "1"}], "]"}], "]"}], "\[RuleDelayed]", 
           RowBox[{"p2GaussDerivative", "[", 
