Cell[CellGroupData[{

Cell["Assembled bubble coefficient", "Subsection",ExpressionUUID->"84335014-c657-e74c-b422-08a94af32acd"],

Cell["\<\
The names bubbleP1, bubblePolarizationSum, and bubbleCoefficient distinguish \
the vertex factor, the nine-polarization sum, and the final bubble \
coefficient.\
\>", "Text",ExpressionUUID->"ccc357dd-a3b2-c84d-896a-4c291c566a55"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"===", 
     RowBox[{"==", "\:7b2c\:4e09\:6b65"}]}], "\:ff1a", 
    RowBox[{
     RowBox[{"\:5b9a\:4e49", " ", 
      RowBox[{"C", "^", "Bub"}], 
      RowBox[{"(", "\[Nu]", ")"}]}], "===", "=="}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"\:8f85\:52a9", " ", 
     RowBox[{"P", "^", 
      RowBox[{"(", "1", ")"}]}], 
     RowBox[{"(", "\[Nu]", ")"}], " ", "\:516c\:5f0f", " ", 
     RowBox[{"(", "48", ")"}], " ", "\:53d6", " ", "c"}], "=", "+"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"bubbleP1", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "+", " ", 
        RowBox[{"I", " ", "x"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "I", " ", "x"}], ")"}]}], "*", "I", "*", 
     RowBox[{"Sinh", "[", 
      RowBox[{"\[Pi]", " ", "x"}], "]"}], " ", "*", " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{"2", "+", 
       RowBox[{"2", " ", "I", " ", "x"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"\:6240\:6709\:4e5d\:4e2a", " ", "g", " ", "\:6c42\:548c"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bubblePolarizationSum", "[", "\[Nu]_", "]"}], ":=", 
    RowBox[{
     RowBox[{"bubbleILL", "[", "\[Nu]", "]"}], "+", 
     RowBox[{"bubbleILP", "[", "\[Nu]", "]"}], "+", 
     RowBox[{"bubbleILM", "[", "\[Nu]", "]"}], "+", 
     RowBox[{"bubbleIPL", "[", "\[Nu]", "]"}], "+", 
     RowBox[{"bubbleIPP", "[", "\[Nu]", "]"}], "+", 
     RowBox[{"bubbleIPM", "[", "\[Nu]", "]"}], "+", 
     RowBox[{"bubbleIML", "[", "\[Nu]", "]"}], "+", 
     RowBox[{"bubbleIMP", "[", "\[Nu]", "]"}], "+", 
     RowBox[{"bubbleIMM", "[", "\[Nu]", "]"}]}]}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"C", "^", "Bub"}], " ", "\:5b9a\:4e49"}], "\:ff0c", 
     RowBox[{"\:516c\:5f0f", " ", 
      RowBox[{"(", "52", ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bubbleCoefficient", "[", "\[Nu]_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Gamma", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", "\[Nu]"}], "]"}], "^", "4"}], "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"4", " ", "\[Pi]"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"7", "/", "2"}], ")"}]}]}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"bubbleP1", "[", "\[Nu]", "]"}], "^", "2"}], ")"}], "*", 
     RowBox[{"bubblePolarizationSum", "[", "\[Nu]", "]"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.9944969359346085`*^9, 3.9944969359346085`*^9}, {
  3.995008206047025*^9, 3.9950082575566626`*^9}, {3.995266934591462*^9, 
  3.995266989594633*^9}, {3.996790999490906*^9, 3.996791010001032*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"0194f549-e954-4ddd-a947-361288a1a5ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"bubbleCoefficient", "[", "x", "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.9950099725021815`*^9, 3.99500997913515*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"16a9acec-29ac-4970-88d7-0c0dd0621d93"],

Cell[BoxData[
 FractionBox[
  RowBox[{"3", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], "+", "x"}], ")"}], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], " ", "\[ImaginaryI]"}], "+", "x"}], ")"}], "4"], " ", 
   SuperscriptBox[
    RowBox[{"Gamma", "[", 
     RowBox[{
      RowBox[{"-", "2"}], "-", 
      RowBox[{"\[ImaginaryI]", " ", "x"}]}], "]"}], "2"], " ", 
   SuperscriptBox[
    RowBox[{"Gamma", "[", 
     RowBox[{
      FractionBox["5", "2"], "+", 
      RowBox[{"\[ImaginaryI]", " ", "x"}]}], "]"}], "2"], " ", 
   RowBox[{"Gamma", "[", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["3", "2"]}], "-", 
     RowBox[{"2", " ", "\[ImaginaryI]", " ", "x"}]}], "]"}], " ", 
   RowBox[{"Gamma", "[", 
    RowBox[{"1", "+", 
     RowBox[{"2", " ", "\[ImaginaryI]", " ", "x"}]}], "]"}], " ", 
   SuperscriptBox[
    RowBox[{"Sinh", "[", 
     RowBox[{"\[Pi]", " ", "x"}], "]"}], "2"]}], 
  RowBox[{"256", " ", 
   SuperscriptBox["\[Pi]", 
    RowBox[{"7", "/", "2"}]], " ", 
   SuperscriptBox["x", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], "+", 
     RowBox[{"2", " ", "x"}]}], ")"}]}]]], "Output",
 CellChangeTimes->{3.9950099855758185`*^9, 3.995267025689834*^9, 
  3.9952672507498446`*^9, 3.995267363934346*^9, 3.9967910284412956`*^9},
 CellLabel->"Out[24]=",ExpressionUUID->"c9fd6649-e3f7-bb46-a646-df2bb963db97"]
