                          RowBox[{"prec", "+", "8"}], RowBox[{"8", " ",
                          RowBox[{"Log", "[", RowBox[{"10", ",", "64"}],
                          "]"}]}]], "]"}]}], ",", "n"}], "]"}]}], ";",
                       RowBox[{"vals", "=", RowBox[{"Table", "[", RowBox[
                          {RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[
                          {"z", "=", RowBox[{"N", "[", RowBox[{RowBox[{"rad",
                          " ", RowBox[{"Exp", "[", FractionBox[RowBox[{"2",
