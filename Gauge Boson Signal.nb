Cell["\<\
The coefficient matrix has rows {P_L, P_T} and columns {1, F1, F2, F3, F4}. \
All ten coefficient differences are exactly zero. Thus the two analytic \
finite parts agree with the original common-basis functions for real nu > 0; \
this conclusion does not rely on numerical sampling.\
\>", "Text",
 CellTags->
  "P2Compare-symbolic-conclusion",ExpressionUUID->"beae18cc-7878-4433-a8b3-\
fca57d915b92"],

Cell["\<\
Independent numerical cross-check: evaluate the unreduced Laurent finite \
parts directly at 35-digit precision, and compare with the original stable \
common-basis implementation hardValues. Numerical zeros in the table mean \
agreement at the working precision; the exact identity is established by the \
symbolic coefficient check above.\
\>", "Text",
 CellTags->
  "P2Compare-numeric-note",ExpressionUUID->"f79703f7-c793-4475-8232-\
2bef77d6433c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"p2NumericalComparison", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "b"}], "}"}], ",", 
       RowBox[{
        RowBox[{"a", "=", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"P2LReg0", "[", "v", "]"}], ",", 
             RowBox[{"P2PMReg0", "[", "v", "]"}]}], "}"}], ",", "35"}], 
          "]"}]}], ";", 
        RowBox[{"b", "=", 
         RowBox[{"hardValues", "[", 
          RowBox[{"v", ",", "35"}], "]"}]}], ";", 
        RowBox[{"{", 
         RowBox[{"v", ",", 
          RowBox[{"Sequence", "@@", 
           RowBox[{"Abs", "[", 
            FractionBox[
             RowBox[{"a", "-", "b"}], "b"], "]"}]}]}], "}"}]}]}], "]"}], ",", 
     
     RowBox[{"{", 
      RowBox[{"v", ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", "100"], ",", 
         FractionBox["1", "10"], ",", 
         FractionBox["3", "5"], ",", "1", ",", "2"}], "}"}]}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"N", "[", 
