Cell[CellGroupData[{

Cell["Stable numerical evaluation of the mixed derivative",
            "Subsection", ExpressionUUID ->
             "29d15b91-86a0-054b-af83-32c9fa67b545"],

Cell["For F4, let F(z) \
= regularized 3F2({2 I nu,1/2-I nu,1};{1+z,1+z};1). Symmetry gives F4 = [z^2] \
F(z) - d_c^2 regularized 2F1(2 I nu,1/2-I nu;c;1)|c=1. The second term \
follows from Gauss summation. The first is evaluated by a discrete Cauchy \
integral on |z|=1/128. Sample count grows with requested precision; \
convergence and agreement with the original derivative are tested below. This \
evaluates an analytic parameter derivative, not a finite-regulator \
approximation to P.", "Text", ExpressionUUID ->
             "a9510dbb-8b4e-ee4c-bb51-5d1278aff660"],

Cell[BoxData[RowBox[{RowBox[{RowBox[{"mixedMaster", "[",
                   RowBox[{RowBox[{"v_", "?", "NumericQ"}], ",",
                     "prec_Integer", ",", RowBox[{"n_Integer", ":", "0"}]}],
                   "]"}], ":=", RowBox[{"Module", "[", RowBox[
                    {RowBox[{"{", RowBox[{RowBox[{"vv", "=", RowBox[{"N",
                          "[", RowBox[{"v", ",", RowBox[{"prec", "+",
                          "20"}]}], "]"}]}], ",", "a", ",", "b", ",",
                         RowBox[{"rad", "=", FractionBox["1", "128"]}], ",",
                         "nn", ",", "vals", ",", "gauss", ",", "pure"}],
                       "}"}], ",", RowBox[{RowBox[{"a", "=", RowBox[{"2",
                          " ", "\[ImaginaryI]", " ", "vv"}]}], ";", RowBox[
                        {"b", "=", RowBox[{FractionBox["1", "2"], "-",
                          RowBox[{"\[ImaginaryI]", " ", "vv"}]}]}], ";",
                       RowBox[{"nn", "=", RowBox[{"If", "[", RowBox[
                          {RowBox[{"n", "\[Equal]", "0"}], ",", RowBox[
                          {"8", " ", RowBox[{"Ceiling", "[", FractionBox[
                          RowBox[{"prec", "+", "8"}], RowBox[{"8", " ",
                          RowBox[{"Log", "[", RowBox[{"10", ",", "64"}],
                          "]"}]}]], "]"}]}], ",", "n"}], "]"}]}], ";",
                       RowBox[{"vals", "=", RowBox[{"Table", "[", RowBox[
                          {RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[
                          {"z", "=", RowBox[{"N", "[", RowBox[{RowBox[{"rad",
                          " ", RowBox[{"Exp", "[", FractionBox[RowBox[{"2",
                          " ", "\[Pi]", " ", "\[ImaginaryI]", " ", "j"}],
                          "nn"], "]"}]}], ",", RowBox[{"prec", "+", "20"}]}],
                          "]"}]}], "}"}], ",", FractionBox[RowBox[{RowBox[
                          {"HypergeometricPFQ", "[", RowBox[{RowBox[{"{",
                          RowBox[{"a", ",", "b", ",", "1"}], "}"}], ",",
                          RowBox[{"{", RowBox[{RowBox[{"1", "+", "z"}], ",",
                          RowBox[{"1", "+", "z"}]}], "}"}], ",", "1"}],
                          "]"}], " ", RowBox[{"Exp", "[", RowBox[{"-",
                          FractionBox[RowBox[{"4", " ", "\[Pi]", " ",
                          "\[ImaginaryI]", " ", "j"}], "nn"]}], "]"}]}],
                          SuperscriptBox[RowBox[{"Gamma", "[", RowBox[{"1",
                          "+", "z"}], "]"}], "2"]]}], "]"}], ",", RowBox[
                          {"{", RowBox[{"j", ",", "0", ",", RowBox[{"nn",
                          "-", "1"}]}], "}"}]}], "]"}]}], ";", RowBox[
                        {"gauss", "=", FractionBox[RowBox[{"Gamma", "[",
                          RowBox[{"1", "-", "a", "-", "b"}], "]"}], RowBox[
                          {RowBox[{"Gamma", "[", RowBox[{"1", "-", "a"}],
                          "]"}], " ", RowBox[{"Gamma", "[", RowBox[{"1", "-",
                          "b"}], "]"}]}]]}], ";", RowBox[{"pure", "=",
                         RowBox[{"gauss", " ", RowBox[{"(", RowBox[
                          {SuperscriptBox[RowBox[{"(", RowBox[{RowBox[
                          {"PolyGamma", "[", RowBox[{"0", ",", RowBox[{"1",
                          "-", "a", "-", "b"}]}], "]"}], "-", RowBox[
                          {"PolyGamma", "[", RowBox[{"0", ",", RowBox[{"1",
                          "-", "a"}]}], "]"}], "-", RowBox[{"PolyGamma", "[",
                          RowBox[{"0", ",", RowBox[{"1", "-", "b"}]}],
                          "]"}]}], ")"}], "2"], "+", RowBox[{"PolyGamma",
                          "[", RowBox[{"1", ",", RowBox[{"1", "-", "a", "-",
                          "b"}]}], "]"}], "-", RowBox[{"PolyGamma", "[",
                          RowBox[{"1", ",", RowBox[{"1", "-", "a"}]}], "]"}],
                          "-", RowBox[{"PolyGamma", "[", RowBox[{"1", ",",
                          RowBox[{"1", "-", "b"}]}], "]"}]}], ")"}]}]}], ";",
                       RowBox[{"N", "[", RowBox[{RowBox[{FractionBox[RowBox[
                          {"Total", "[", "vals", "]"}], RowBox[{"nn", " ",
                          SuperscriptBox["rad", "2"]}]], "-", "pure"}], ",",
                          "prec"}], "]"}]}]}], "]"}]}], ";"}]], "Input",
            CellLabel -> "In[7]:=", ExpressionUUID ->
             "ef3422aa-7f6f-ae48-b502-313fd3552cb4"],

Cell[CellGroupData[{

Cell[BoxData[RowBox[{RowBox[{"hardCache", "=",
                    RowBox[{"Association", "[", "]"}]}], ";", RowBox[
                   {"hardEvaluations", "=", "0"}], ";", RowBox[
                   {RowBox[{"hardValues", "[", RowBox[{RowBox[{"v_", "?",
                          "NumericQ"}], ",", RowBox[{"prec_Integer", ":",
                          "30"}]}], "]"}], ":=", RowBox[{"Module", "[",
                      RowBox[{RowBox[{"{", RowBox[{RowBox[{"vv", "=", RowBox[
                          {"N", "[", RowBox[{"v", ",", RowBox[{"prec", "+",
                          "30"}]}], "]"}]}], ",", "mv", ",", "result"}],
                          "}"}], ",", RowBox[{RowBox[{"If", "[", RowBox[
                          {RowBox[{"KeyExistsQ", "[", RowBox[{"hardCache",
                          ",", RowBox[{"{", RowBox[{"v", ",", "prec"}],
                          "}"}]}], "]"}], ",", RowBox[{"Return", "[", RowBox[
                          {"hardCache", "[", RowBox[{"{", RowBox[{"v", ",",
                          "prec"}], "}"}], "]"}], "]"}]}], "]"}], ";",
                          RowBox[{"hardEvaluations", "++"}], ";", RowBox[
