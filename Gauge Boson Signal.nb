      RowBox[{"p2PMDummy", ",", 
       RowBox[{"{", 
        RowBox[{"reg0", ",", "0", ",", "k"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", 
       RowBox[{"-", "3"}], ",", 
       RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
