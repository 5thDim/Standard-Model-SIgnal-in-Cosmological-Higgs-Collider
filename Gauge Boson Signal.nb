        "]"}]}], "&"}], ")"}], "/@", "p2HyperObjects"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2ReducedFinite", "=", 
   RowBox[{"p2Canonical", "[", 
