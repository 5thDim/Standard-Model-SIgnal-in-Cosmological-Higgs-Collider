                          {"{", RowBox[{FractionBox["1", "100"], ",",
                          FractionBox["1", "10"], ",", FractionBox["3", "5"],
                          ",", "1"}], "}"}]}], "}"}]}], "]"}], ",", RowBox[
                          {"{", RowBox[{"\"nu\"", ",", "\"P_L\"", ",",
                          "\"P_T\""}], "}"}]}], "]"}], ",", RowBox[{"Frame",
                        "\[Rule]", "All"}]}], "]"}]}]], "Input", CellLabel ->
                "In[8]:=", ExpressionUUID ->
                "426f88c0-4ee5-8247-ae3b-1945634628e7"],

