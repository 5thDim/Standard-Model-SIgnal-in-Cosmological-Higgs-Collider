Cell[CellGroupData[{

Cell["Longitudinal seed check", "Subsection",ExpressionUUID->"ca5ca7e2-00c3-1b41-90cb-991fcc9df7dc"],

Cell["\<\
SL is the original reduced longitudinal expression used as a consistency \
check before assembling the full Box angular factors.\
\>", "Text",ExpressionUUID->"cf8fe471-1d41-414a-9f0c-9dc0ab69d5bf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\:53ef\:9760\:6027\:68c0\:9a8c", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"SL", "[", 
    RowBox[{"nu_", ",", "theta1_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"s1", "=", 
        RowBox[{"Sin", "[", "theta1", "]"}]}], ",", 
       RowBox[{"c1", "=", 
        RowBox[{"Cos", "[", "theta1", "]"}]}], ",", 
       RowBox[{"x", "=", 
        RowBox[{
         RowBox[{"-", "I"}], " ", "nu"}]}], ",", "beta"}], "}"}], ",", 
     RowBox[{
      RowBox[{"beta", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "1"}], "/", "2"}], "+", 
            RowBox[{"I", " ", "nu"}]}], ")"}], "^", "2"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"nu", "^", "2"}], "+", 
          RowBox[{"1", "/", "4"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
      "(*", "\:6309\:8868\:8fbe\:5f0f\:9010\:9879\:76f8\:52a0", "*)"}], 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"s1", "^", "2"}], "/", "2"}], ")"}], "*", 
        RowBox[{"J0", "[", 
         RowBox[{"0", ",", "0", ",", "x"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"beta", " ", 
           RowBox[{"c1", "^", "2"}]}], "+", 
          RowBox[{"beta", " ", 
           RowBox[{
            RowBox[{"s1", "^", "2"}], "/", "2"}]}]}], ")"}], "*", 
        RowBox[{"J0", "[", 
         RowBox[{"0", ",", "2", ",", "x"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"beta", "^", "2"}], " ", 
           RowBox[{"c1", "^", "2"}]}], "-", 
          RowBox[{"beta", " ", 
           RowBox[{"c1", "^", "2"}]}], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"beta", " ", 
             RowBox[{"s1", "^", "2"}]}], ")"}], "/", "2"}], "+", 
          RowBox[{
           RowBox[{"s1", "^", "2"}], "/", "2"}]}], ")"}], "*", 
        RowBox[{"J2", "[", 
         RowBox[{"0", ",", "2", ",", "x"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"beta", "^", "2"}], " ", 
           RowBox[{"c1", "^", "2"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"beta", "^", "2"}], " ", 
             RowBox[{"s1", "^", "2"}]}], ")"}], "/", "2"}], "+", 
          RowBox[{"c1", "^", "2"}], "+", 
          RowBox[{
           RowBox[{"s1", "^", "2"}], "/", "2"}]}], ")"}], "*", 
        RowBox[{"J1", "[", 
         RowBox[{"1", ",", "2", ",", "x"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"beta", "^", "2"}], " ", 
           RowBox[{"c1", "^", "2"}]}], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"beta", "^", "2"}], " ", 
             RowBox[{"s1", "^", "2"}]}], ")"}], "/", "2"}], "-", 
          RowBox[{"c1", "^", "2"}], "+", 
          RowBox[{
           RowBox[{"s1", "^", "2"}], "/", "2"}]}], ")"}], "*", 
        RowBox[{"J3", "[", 
         RowBox[{"1", ",", "2", ",", "x"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"beta", "^", "2"}], " ", 
             RowBox[{"s1", "^", "2"}]}], ")"}], "/", "2"}], "+", 
          RowBox[{"c1", "^", "2"}]}], ")"}], "*", 
        RowBox[{"J0", "[", 
         RowBox[{"2", ",", "2", ",", "x"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"beta", "^", "2"}], " ", 
           RowBox[{"c1", "^", "2"}]}], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"beta", "^", "2"}], " ", 
             RowBox[{"s1", "^", "2"}]}], ")"}], "/", "2"}], "-", 
          RowBox[{"c1", "^", "2"}], "+", 
          RowBox[{
           RowBox[{"s1", "^", "2"}], "/", "2"}]}], ")"}], "*", 
        RowBox[{"J2", "[", 
         RowBox[{"2", ",", "2", ",", "x"}], "]"}]}]}]}]}], "]"}]}]}]], "Input",
