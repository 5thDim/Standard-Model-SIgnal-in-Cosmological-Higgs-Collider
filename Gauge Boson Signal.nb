Cell[CellGroupData[{

Cell["3. Bubble, triangle and the five box angular coefficients", "Section",ExpressionUUID->"4d36857b-6649-754a-b7db-4b7095b5cd5e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"commonLoop", "[", "v_", "]"}], ":=", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"Gamma", "[", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "v"}], "]"}], "4"], " ", 
     RowBox[{"gSoft", "[", "v", "]"}]}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"4", " ", "\[Pi]"}], ")"}], 
     RowBox[{"7", "/", "2"}]]]}], ";", 
  RowBox[{"boxTemplate", "=", 
   RowBox[{"Factor", "/@", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"pl", "-", "pt"}], ")"}], "2"], " ", "loopMatrix"}], "+", 
       RowBox[{
        FractionBox["1", "3"], " ", "pt", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "pl"}], "+", "pt"}], ")"}], " ", "rBubble", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}]}]}], ",",
       "assumptions"}], "]"}]}]}], ";", 
  RowBox[{"coefficientNames", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Bubble\>\"", ",", "\"\<Triangle\>\"", ",", "\"\<A1\>\"", 
     ",", "\"\<A2\>\"", ",", "\"\<A3\>\"", ",", "\"\<B\>\"", 
     ",", "\"\<D\>\""}], "}"}]}], ";", 
  RowBox[{"allTemplates", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SuperscriptBox["pOne", "2"], " ", "rBubble"}], ",", 
       RowBox[{
        FractionBox["1", "3"], " ", "pOne", " ", 
        RowBox[{"(", 
         RowBox[{"pl", "+", 
          RowBox[{"2", " ", "pt"}]}], ")"}], " ", "rBubble"}]}], "}"}], ",", 
     "boxTemplate"}], "]"}]}], ";", 
  RowBox[{"Grid", "[", 
   RowBox[{
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#1", ",", 
         RowBox[{"formGauge", "[", "#2", "]"}]}], "}"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"coefficientNames", ",", "allTemplates"}], "}"}]}], "]"}], ",", 
    RowBox[{"Frame", "\[Rule]", "All"}]}], "]"}]}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"f4529294-8c46-2f45-a245-358014346ff2"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Bubble\"\>", 
     TagBox[
      FormBox[
       FractionBox[
        RowBox[{"3", " ", 
         SuperscriptBox[
          RowBox[{"(", 
