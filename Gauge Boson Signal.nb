Cell[CellGroupData[{

Cell["7. Seven coefficients: magnitude and phase", "Section",
 CellChangeTimes->{{4.0034518975611763`*^9, 4.0034519007654552`*^9}},
 CellTags->
  "SevenCoefficients-section",ExpressionUUID->"639a8488-4f60-4596-bbf9-\
3b1682529e63"],

Cell["\<\
The seven coefficients are ordered C^Bub, C^Tri, A1, A2, A3, B and D. Both \
figures use the original mass grid 0.01 <= nu <= 1 and a shared \
blue-to-orange color gradient. The magnitude is shown as ln|C|, as in the \
individual plots. Principal phases are split at their branch jumps so no \
artificial connecting lines are drawn.\
\>", "Text",
 CellTags->
  "SevenCoefficients-note",ExpressionUUID->"de50f85b-cd98-4c84-9e14-\
2e566d7a222f"],

