                       RowBox[{"{", RowBox[{"v", ",", "massGrid"}], "}"}]}],
                     "]"}], "]"}]}], ";", RowBox[{"cacheScanCount", "=",
                 "hardEvaluations"}], ";", RowBox[{"scanFinite", "=",
                 RowBox[{RowBox[{RowBox[{"Dimensions", "[", "massData",
