Cell[BoxData[RowBox[{RowBox[{RowBox[
                     {"regulatorExtrapolate", "[", RowBox[{"v_", ",",
                        "levels_Integer"}], "]"}], ":=", RowBox[{"Module",
                      "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"vv", "=",
                          RowBox[{"N", "[", RowBox[{"v", ",", "55"}],
                          "]"}]}], ",", "deltas", ",", "values", ",",
                          "weights"}], "}"}], ",", RowBox[{RowBox[{"deltas",
                          "=", RowBox[{"Table", "[", RowBox[{FractionBox["1",
                          RowBox[{"1000", " ", SuperscriptBox["2", "j"]}]],
                          ",", RowBox[{"{", RowBox[{"j", ",", "0", ",",
                          RowBox[{"levels", "-", "1"}]}], "}"}]}], "]"}]}],
                          ";", RowBox[{"values", "=", RowBox[{"Table", "[",
                          RowBox[{RowBox[{"N", "[", RowBox[{RowBox[{"{",
                          RowBox[{RowBox[{"P2L", "[", RowBox[{"vv", ",",
                          RowBox[{"N", "[", RowBox[{"d", ",", "55"}],
                          "]"}]}], "]"}], ",", RowBox[{"P2PM", "[", RowBox[
                          {"vv", ",", RowBox[{"N", "[", RowBox[{"d", ",",
                          "55"}], "]"}]}], "]"}]}], "}"}], ",", "40"}],
                          "]"}], ",", RowBox[{"{", RowBox[{"d", ",",
                          "deltas"}], "}"}]}], "]"}]}], ";", RowBox[
                          {"weights", "=", RowBox[{"Table", "[", RowBox[
                          {RowBox[{UnderoverscriptBox["\[Product]", "k",
                          "levels"], RowBox[{"If", "[", RowBox[{RowBox[{"k",
                          "\[Equal]", "j"}], ",", "1", ",", RowBox[{"-",
                          FractionBox[RowBox[{"deltas",
                          "\[LeftDoubleBracket]", "k",
                          "\[RightDoubleBracket]"}], RowBox[{RowBox[
                          {"deltas", "\[LeftDoubleBracket]", "j",
                          "\[RightDoubleBracket]"}], "-", RowBox[{"deltas",
                          "\[LeftDoubleBracket]", "k",
                          "\[RightDoubleBracket]"}]}]]}]}], "]"}]}], ",",
                          RowBox[{"{", RowBox[{"j", ",", "levels"}], "}"}]}],
                          "]"}]}], ";", RowBox[{"weights", ".",
                          "values"}]}]}], "]"}]}], ";", RowBox[
                   {"regulatorCheck", "=", RowBox[{"Module", "[", RowBox[
                       {RowBox[{"{", RowBox[{RowBox[{"lo", "=", RowBox[
                          {"regulatorExtrapolate", "[", RowBox[{FractionBox[
                          "3", "5"], ",", "4"}], "]"}]}], ",", RowBox[{"hi",
                          "=", RowBox[{"regulatorExtrapolate", "[", RowBox[
                          {FractionBox["3", "5"], ",", "5"}], "]"}]}], ",",
                          RowBox[{"target", "=", RowBox[{"hardValues", "[",
                          RowBox[{FractionBox["3", "5"], ",", "40"}],
                          "]"}]}]}], "}"}], ",", RowBox[{"{", RowBox[
                          {RowBox[{"relativeError", "[", RowBox[{"lo", ",",
                          "hi"}], "]"}], ",", RowBox[{"relativeError", "[",
                          RowBox[{"hi", ",", "target"}], "]"}]}], "}"}]}],
                      "]"}]}], ";", TagBox[GridBox[
