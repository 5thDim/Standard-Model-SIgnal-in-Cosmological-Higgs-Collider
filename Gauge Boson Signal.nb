Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"term", "[", 
    RowBox[{"a_", ",", "n_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"2", " ", "I", " ", "n"}], "]"}], "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"I", " ", "a"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"2", " ", "I", " ", "n"}], ")"}]}]}], "+", 
    RowBox[{"I", " ", "a", " ", 
     RowBox[{
      RowBox[{"Gamma", "[", 
       RowBox[{
        RowBox[{"2", " ", "I", " ", "n"}], "+", "1"}], "]"}], "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"I", " ", "a"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "I", " ", "n"}], "+", "1"}], ")"}]}]}]}], "-", 
    RowBox[{
     RowBox[{"1", "/", "4"}], " ", 
     RowBox[{
      RowBox[{"Gamma", "[", 
       RowBox[{"2", "+", 
        RowBox[{"2", " ", "I", " ", "n"}]}], "]"}], "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"I", " ", "a"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"2", "+", 
         RowBox[{"2", " ", "I", " ", "n"}]}], ")"}]}]}]}]}]}], ";"}], "\n", 
 RowBox[{"result", "=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{"I", " ", "a", "*", 
     RowBox[{"term", "[", 
      RowBox[{"a", ",", "n"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"a", ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "]"}]}]}], "Input",
 Evaluatable->False,
