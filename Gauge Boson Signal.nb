Cell[BoxData[
 FractionBox[
  RowBox[{"3", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], "+", "x"}], ")"}], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], " ", "\[ImaginaryI]"}], "+", "x"}], ")"}], "4"], " ", 
   SuperscriptBox[
    RowBox[{"Gamma", "[", 
     RowBox[{
      RowBox[{"-", "2"}], "-", 
