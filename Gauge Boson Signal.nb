        Cell["Each expression in the preceding table multiplies K(nu) = \
Gamma(-I nu)^4 G(nu)/(4 Pi)^(7/2). The box angular basis is displayed in \
Section 1. B and D denote the coefficients of that basis, with no residual \
angle factors. All seven coefficients share one pair of P_L,P_T values at \
each mass. In particular A3 = -3 A2.", "Text", ExpressionUUID ->
          "4b8dafb7-e3ea-6f4b-a14c-d822c6696037"],
        Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[
                {RowBox[{"coefficientsAnalytic", "[", "v_", "]"}], ":=",
                 RowBox[{RowBox[{"commonLoop", "[", "v", "]"}], " ",
                   RowBox[{"(", RowBox[{"allTemplates", "/.",
                       "\[VeryThinSpace]", RowBox[{"{", RowBox[{RowBox[
                          {"nu", "\[Rule]", "v"}], ",", RowBox[{"pOne",
                          "\[Rule]", RowBox[{"p1Gauge", "[", "v", "]"}]}],
                          ",", RowBox[{"pl", "\[Rule]", RowBox[{"P2LGauge",
                          "[", "v", "]"}]}], ",", RowBox[{"pt", "\[Rule]",
                          RowBox[{"P2TGauge", "[", "v", "]"}]}]}], "}"}]}],
                     ")"}]}]}], ";", RowBox[{RowBox[{"coefficientValues",
                   "[", RowBox[{RowBox[{"v_", "?", "NumericQ"}], ",",
                     RowBox[{"prec_Integer", ":", "30"}]}], "]"}], ":=",
                 RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                        {RowBox[{"vv", "=", RowBox[{"N", "[", RowBox[{"v",
                          ",", RowBox[{"prec", "+", "30"}]}], "]"}]}], ",",
                         RowBox[{"pv", "=", RowBox[{"hardValues", "[",
                          RowBox[{"v", ",", RowBox[{"prec", "+", "10"}]}],
                          "]"}]}]}], "}"}], ",", RowBox[{RowBox[{"If", "[",
                         RowBox[{RowBox[{RowBox[{"!", RowBox[{"VectorQ", "[",
                          RowBox[{"pv", ",", "NumericQ"}], "]"}]}], "||",
                          RowBox[{RowBox[{"Length", "[", "pv", "]"}],
                          "\[NotEqual]", "2"}]}], ",", RowBox[{"Return", "[",
                          "$Failed", "]"}]}], "]"}], ";", RowBox[{"N", "[",
                         RowBox[{RowBox[{RowBox[{"commonLoop", "[", "vv",
                          "]"}], " ", RowBox[{"(", RowBox[{"allTemplates",
                          "/.", "\[VeryThinSpace]", RowBox[{"{", RowBox[
                          {RowBox[{"nu", "\[Rule]", "vv"}], ",", RowBox[
                          {"pOne", "\[Rule]", RowBox[{"p1Gauge", "[", "vv",
                          "]"}]}], ",", RowBox[{"pl", "\[Rule]", RowBox[
                          {"pv", "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}]}], ",", RowBox[{"pt",
                          "\[Rule]", RowBox[{"pv", "\[LeftDoubleBracket]",
                          "2", "\[RightDoubleBracket]"}]}]}], "}"}]}],
                          ")"}]}], ",", "prec"}], "]"}]}]}], "]"}]}], ";",
               RowBox[{RowBox[{"cBoxGauge", "[", RowBox[{"v_", ",", "a_",
                     ",", "b_", ",", "c_"}], "]"}], ":=", RowBox[
                  {RowBox[{"Drop", "[", RowBox[{RowBox[
                        {"coefficientsAnalytic", "[", "v", "]"}], ",", "2"}],
                     "]"}], ".", RowBox[{"(", RowBox[{"angularBasis", "/.",
                       "\[VeryThinSpace]", RowBox[{"{", RowBox[{RowBox[
                          {"t1", "\[Rule]", "a"}], ",", RowBox[{"t3",
                          "\[Rule]", "b"}], ",", RowBox[{"ph", "\[Rule]",
                          "c"}]}], "}"}]}], ")"}]}]}], ";", RowBox[
                {"a3Identity", "=", RowBox[{"FullSimplify", "[", RowBox[
                    {RowBox[{RowBox[{"boxTemplate", "\[LeftDoubleBracket]",
                         "3", "\[RightDoubleBracket]"}], "+", RowBox[
                        {"3", " ", RowBox[{"boxTemplate",
                          "\[LeftDoubleBracket]", "2",
                          "\[RightDoubleBracket]"}]}]}], ",",
                     "assumptions"}], "]"}]}], ";", RowBox[{"formGauge", "[",
                 "a3Identity", "]"}]}]], "Input", CellLabel -> "In[17]:=",
