Cell[BoxData[{
 RowBox[{
  RowBox[{"TriangleSimpDeboltzmannData", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"N", "[", 
