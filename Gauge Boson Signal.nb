Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"logData", "[", "j_Integer", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
        ",", 
        RowBox[{"Log", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"#1", "\[LeftDoubleBracket]", 
           RowBox[{"j", "+", "1"}], "\[RightDoubleBracket]"}], "]"}], "]"}]}],
        "}"}], "&"}], ")"}], "/@", "massData"}]}], ";", 
  RowBox[{
   RowBox[{"phaseData", "[", "j_Integer", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
        ",", 
        RowBox[{"Arg", "[", 
         RowBox[{"#1", "\[LeftDoubleBracket]", 
          RowBox[{"j", "+", "1"}], "\[RightDoubleBracket]"}], "]"}]}], "}"}], 
      "&"}], ")"}], "/@", "massData"}]}], ";", 
  RowBox[{
   RowBox[{"phaseSegments", "[", "j_Integer", "]"}], ":=", 
   RowBox[{"Split", "[", 
    RowBox[{
     RowBox[{"phaseData", "[", "j", "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"#2", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
          "-", 
         RowBox[{
         "#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
        "]"}], "<", "\[Pi]"}], "&"}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"deboltzmannData", "[", "j_Integer", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
        ",", 
        RowBox[{
         RowBox[{"#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
          "+", 
         RowBox[{"2", " ", "\[Pi]", " ", 
          RowBox[{
          "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}]}], 
       "}"}], "&"}], ")"}], "/@", 
    RowBox[{"logData", "[", "j", "]"}]}]}], ";", 
  RowBox[{
   RowBox[{"physicalMassData", "[", "j_Integer", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        SqrtBox[
         RowBox[{
          SuperscriptBox[
           RowBox[{
           "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "2"],
           "+", 
          FractionBox["1", "4"]}]], ",", 
        RowBox[{
        "#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], "}"}],
       "&"}], ")"}], "/@", 
    RowBox[{"logData", "[", "j", "]"}]}]}], ";", 
  RowBox[{"plotColors", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Darker", "[", "Red", "]"}], ",", "Blue", ",", 
     RowBox[{"Darker", "[", "Green", "]"}], ",", "Purple", ",", "Orange", ",",
      "Brown", ",", "Black"}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"magPlot", "[", "j_Integer", "]"}], ":=", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"logData", "[", "j", "]"}], ",", 
     RowBox[{"Frame", "\[Rule]", "True"}], ",", 
     RowBox[{"Axes", "\[Rule]", "False"}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<nu\>\"", ",", "\"\<ln |C|\>\""}], "}"}]}], ",", 
     RowBox[{"PlotLabel", "\[Rule]", 
      RowBox[{
      "coefficientNames", "\[LeftDoubleBracket]", "j", 
       "\[RightDoubleBracket]"}]}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{
      "plotColors", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]}], 
     ",", 
     RowBox[{"ImageSize", "\[Rule]", "430"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"phasePlot", "[", "j_Integer", "]"}], ":=", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"phaseSegments", "[", "j", "]"}], ",", 
     RowBox[{"Frame", "\[Rule]", "True"}], ",", 
     RowBox[{"Axes", "\[Rule]", "False"}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<nu\>\"", ",", "\"\<Arg C (rad)\>\""}], "}"}]}], ",", 
     RowBox[{"PlotLabel", "\[Rule]", 
      RowBox[{
      "coefficientNames", "\[LeftDoubleBracket]", "j", 
       "\[RightDoubleBracket]"}]}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{
      "plotColors", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]}], 
     ",", 
     RowBox[{"ImageSize", "\[Rule]", "430"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"All", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}]}], "}"}]}]}], "]"}]}],
   ";"}]], "Input",
 CellLabel->"In[20]:=",ExpressionUUID->"b6300155-0d14-5547-a753-31ba50e8f0b7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"overview", "=", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"logData", "[", "j", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "3", ",", "7"}], "}"}]}], "]"}], ",", 
     RowBox[{"Frame", "\[Rule]", "True"}], ",", 
     RowBox[{"Axes", "\[Rule]", "False"}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<nu\>\"", ",", "\"\<ln |C|\>\""}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "\[Rule]", 
      RowBox[{"Drop", "[", 
       RowBox[{"coefficientNames", ",", "2"}], "]"}]}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"Drop", "[", 
       RowBox[{"plotColors", ",", "2"}], "]"}]}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "780"}]}], "]"}]}], ";", 
  "overview"}]], "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"f85bbfc5-fa85-154d-b9ab-2fa37c17ab40"],

