Cell[CellGroupData[{

Cell["Explicit finite coefficients for Appendices A.3.2 and A.4.2", "Section",ExpressionUUID->"1585bf9f-eddb-49eb-89e8-994a84110273"],

Cell["\<\
The finite hard coefficients are reduced to four exact hypergeometric \
functions (three include parameter derivatives). No regulator limit remains \
in these formulas. FullSimplify and FunctionExpand are attempted below; the \
remaining special functions are retained exactly. The five box coefficients \
are then simplified together, with all P symbols substituted.\
\>", "Text",ExpressionUUID->"e0ef570e-9e7c-4211-a483-bcfb0e632ce9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BeginPackage", "[", "\"\<GaugeBosonSignal`\>\"", "]"}], 
  ";"}]], "Input",ExpressionUUID->"915621ae-51ba-4fee-b479-40e557bb970d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"gaugeFurtherReduction", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"TimeConstrained", "[", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{
          RowBox[{"FunctionExpand", "[", "#1", "]"}], ",", 
          RowBox[{"nu", ">", "0"}], ",", 
          RowBox[{"TimeConstraint", "\[Rule]", "12"}]}], "]"}], ",", "30", ",",
         "#1"}], "]"}], "&"}], ")"}], "/@", "masterExpressions"}]}], ";", 
  RowBox[{"Grid", "[", 
   RowBox[{
    RowBox[{"MapIndexed", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<F\>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"First", "[", "#2", "]"}], "]"}]}], ",", 
         RowBox[{"formGauge", "[", "#1", "]"}]}], "}"}], "&"}], ",", 
      "gaugeFurtherReduction"}], "]"}], ",", 
    RowBox[{"Frame", "\[Rule]", "All"}], ",", 
    RowBox[{"Alignment", "\[Rule]", "Left"}]}], "]"}]}]], "Input",ExpressionUU\
ID->"a0acc9fe-ce41-4d6d-9419-a2a5a2f122fc"],

