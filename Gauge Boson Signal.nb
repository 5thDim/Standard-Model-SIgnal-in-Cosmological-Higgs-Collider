Cell[BoxData[
 RowBox[{
  RowBox[{"CTri", "[", 
   RowBox[{"n_", ",", "reg_", ",", "t_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Gamma", "[", 
       RowBox[{
        RowBox[{"-", "I"}], " ", "n"}], "]"}], "^", "4"}], "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"4", " ", "\[Pi]"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"7", "/", "2"}], ")"}]}]}], ")"}], "*", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"P1", "[", "n", "]"}], "*", 
      RowBox[{"P2L", "[", 
       RowBox[{"n", ",", "reg"}], "]"}], "*", 
      RowBox[{"IL", "[", 
       RowBox[{"n", ",", "t"}], "]"}]}], "+", 
     RowBox[{"2", "*", 
      RowBox[{"P1", "[", "n", "]"}], "*", 
      RowBox[{"P2PM", "[", 
       RowBox[{"n", ",", "reg"}], "]"}], "*", 
      RowBox[{"IP", "[", 
       RowBox[{"n", ",", "t"}], "]"}]}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.9967984441628056`*^9, 3.9967985159025*^9}, {
  3.996798565079199*^9, 3.9967986023388195`*^9}, {3.9967986613419647`*^9, 
