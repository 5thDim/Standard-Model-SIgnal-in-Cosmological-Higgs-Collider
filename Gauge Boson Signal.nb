      SuperscriptBox[
       RowBox[{"Sin", "[", "t1", "]"}], "2"], " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", "t3", "]"}], "2"], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", "ph"}], "]"}]}]}], "}"}]}], ";", 
  RowBox[{"loopReconstruction", "=", 
