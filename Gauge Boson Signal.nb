Cell[CellGroupData[{

Cell["Box coefficient with analytic P2 (primary)", "Subsection",ExpressionUUID->"e2479aef-f4bd-e146-ba47-315f9d7ff75e"],

Cell["\<\
CBoxSimp combines P2LSimp and P2PMSimp with SLLSimp, SHHSimp, and SLHSimp. It \
has no regulator argument and is the primary Box result.\
\>", "Text",ExpressionUUID->"37097783-91ed-fa4c-a570-4dfda47e1406"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CBoxSimp", "[", 
   RowBox[{"n_", ",", "t1_", ",", "t3_", ",", "p_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Gamma", "[", 
       RowBox[{
        RowBox[{"-", "I"}], " ", "n"}], "]"}], "^", "4"}], "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"4", " ", "\[Pi]"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"7", "/", "2"}], ")"}]}]}], ")"}], "*", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"P2LSimp", "[", "n", "]"}], "^", "2"}], "*", 
      RowBox[{"SLLSimp", "[", 
       RowBox[{"n", ",", "t1", ",", "t3", ",", "p"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{
       RowBox[{"P2PMSimp", "[", "n", "]"}], "^", "2"}], "*", 
      RowBox[{"SHHSimp", "[", 
       RowBox[{"n", ",", "t1", ",", "t3", ",", "p"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"P2LSimp", "[", "n", "]"}], "*", 
      RowBox[{"P2PMSimp", "[", "n", "]"}], "*", 
      RowBox[{"SLHSimp", "[", 
       RowBox[{"n", ",", "t1", ",", "t3", ",", "p"}], "]"}]}]}], 
    ")"}]}]}]], "Input",
 CellChangeTimes->{{3.9973408242553196`*^9, 3.9973408404160175`*^9}, {
  3.9973412055797443`*^9, 3.9973412630331535`*^9}},
 CellLabel->"In[70]:=",ExpressionUUID->"f100fab6-62e2-574e-8861-b65e91f84be3"]
}, Open  ]],

