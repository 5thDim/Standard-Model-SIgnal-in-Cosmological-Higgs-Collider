       RowBox[{"2", " ", "I", " ", "x"}], ")"}]}], "*", "I", "*", 
     RowBox[{"Sinh", "[", 
      RowBox[{"\[Pi]", " ", "x"}], "]"}], " ", "*", " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{"2", "+", 
       RowBox[{"2", " ", "I", " ", "x"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
