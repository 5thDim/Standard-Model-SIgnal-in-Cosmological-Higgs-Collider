Cell["5. Regression checks against the original notebook", "Section",ExpressionUUID->"af64600a-dcfa-2f43-afc1-6d66055afabc"],

Cell["\<\
The following reference definitions are copied from the original notebook. \
They are used only for validation, not for the mass scan. The original full \
derivation and saved outputs remain in the closed archive below. Full \
physical normalization and diagram counting are outside the scope of these \
implementation checks.\
\>", "Text",ExpressionUUID->"4b9eee8b-be2c-e345-9f38-e2eda0d3c269"],

Cell[CellGroupData[{

Cell["Original reference definitions (validation only)", "Subsection",ExpressionUUID->"8a51bed5-3c35-c44b-b33d-eaac377578e6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"bubbleILL", "[", "\[Nu]_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", "=", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Nu]"}]}], "}"}], ",", 
     FractionBox[
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", "2"]}], "+", 
          RowBox[{"\[ImaginaryI]", " ", "\[Nu]"}]}], ")"}], "4"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"f0", "[", 
          RowBox[{
           RowBox[{"x", "+", "1"}], ",", 
           RowBox[{"x", "+", "1"}]}], "]"}], "+", 
         RowBox[{"2", " ", 
          RowBox[{"f0", "[", 
           RowBox[{
            RowBox[{"x", "-", "1"}], ",", 
            RowBox[{"x", "+", "1"}]}], "]"}]}], "+", 
         RowBox[{"2", " ", 
          RowBox[{"f0", "[", 
           RowBox[{"x", ",", "x"}], "]"}]}], "-", 
         RowBox[{"2", " ", 
          RowBox[{"f0", "[", 
           RowBox[{"x", ",", 
            RowBox[{"x", "+", "1"}]}], "]"}]}], "-", 
         RowBox[{"2", " ", 
          RowBox[{"f0", "[", 
           RowBox[{
            RowBox[{"x", "+", "1"}], ",", "x"}], "]"}]}]}], ")"}]}], 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["\[Nu]", "2"], "+", 
          FractionBox["1", "4"]}], ")"}], "2"], " ", "4"}]]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"bubbleIPP", "[", "\[Nu]_", "]"}], ":=", 
