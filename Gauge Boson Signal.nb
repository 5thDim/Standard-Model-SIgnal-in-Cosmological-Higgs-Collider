Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Mab", "[", 
    RowBox[{"a_", ",", "b_", ",", "p1_", ",", "p2_", ",", "nu_"}], "]"}], ":=", 
   RowBox[{"Switch", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "b"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"+", "1"}], ",", 
       RowBox[{"+", "1"}]}], "}"}], ",", 
     RowBox[{"Mpp", "[", 
      RowBox[{"p1", ",", "p2", ",", "nu"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "1"}]}], "}"}], ",", 
     RowBox[{"Mmm", "[", 
      RowBox[{"p1", ",", "p2", ",", "nu"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"+", "1"}], ",", 
       RowBox[{"-", "1"}]}], "}"}], ",", 
     RowBox[{"Mpm", "[", 
      RowBox[{"p1", ",", "p2", ",", "nu"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", 
       RowBox[{"+", "1"}]}], "}"}], ",", 
     RowBox[{"Mmp", "[", 
      RowBox[{"p1", ",", "p2", ",", "nu"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Part2P2L", "[", 
    RowBox[{"d_", ",", "nu_", ",", "reg_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"p0", "=", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["5", "2"]}], "+", 
         RowBox[{"\[ImaginaryI]", " ", "d", " ", "nu"}], "+", "reg"}]}], ",", 
       
       RowBox[{"prefactor", "=", 
        FractionBox[
         SuperscriptBox["2", 
          RowBox[{"2", " ", "\[ImaginaryI]", " ", "d", " ", "nu"}]], 
         RowBox[{
          SuperscriptBox["nu", "2"], "+", 
          FractionBox["1", "4"]}]]}], ",", "sum"}], "}"}], ",", 
     RowBox[{
      RowBox[{"sum", "=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ia", "=", 
              RowBox[{"\[ImaginaryI]", " ", "a"}]}], ",", 
             RowBox[{"ib", "=", 
              RowBox[{"\[ImaginaryI]", " ", "b"}]}], ",", 
             RowBox[{"ab", "=", 
              RowBox[{"a", " ", "b"}]}]}], "}"}], ",", 
           RowBox[{
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                FractionBox["1", "2"], "+", 
                RowBox[{"\[ImaginaryI]", " ", "d", " ", "nu"}]}], ")"}], "2"],
              " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Mab", "[", 
                RowBox[{"a", ",", "b", ",", "p0", ",", "p0", ",", "nu"}], 
                "]"}], "+", 
               RowBox[{"ia", " ", 
                RowBox[{"Mab", "[", 
                 RowBox[{"a", ",", "b", ",", 
                  RowBox[{"p0", "+", "1"}], ",", "p0", ",", "nu"}], "]"}]}], "+", 
               RowBox[{"ib", " ", 
                RowBox[{"Mab", "[", 
                 RowBox[{"a", ",", "b", ",", "p0", ",", 
                  RowBox[{"p0", "+", "1"}], ",", "nu"}], "]"}]}], "-", 
               RowBox[{"ab", " ", 
                RowBox[{"Mab", "[", 
                 RowBox[{"a", ",", "b", ",", 
                  RowBox[{"p0", "+", "1"}], ",", 
                  RowBox[{"p0", "+", "1"}], ",", "nu"}], "]"}]}]}], ")"}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               FractionBox["1", "2"], "+", 
               RowBox[{"\[ImaginaryI]", " ", "d", " ", "nu"}]}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Mab", "[", 
                RowBox[{"a", ",", "b", ",", 
                 RowBox[{"p0", "+", "2"}], ",", "p0", ",", "nu"}], "]"}], "+", 
               RowBox[{"ib", " ", 
                RowBox[{"Mab", "[", 
                 RowBox[{"a", ",", "b", ",", 
                  RowBox[{"p0", "+", "2"}], ",", 
                  RowBox[{"p0", "+", "1"}], ",", "nu"}], "]"}]}], "+", 
               RowBox[{"Mab", "[", 
                RowBox[{"a", ",", "b", ",", "p0", ",", 
                 RowBox[{"p0", "+", "2"}], ",", "nu"}], "]"}], "+", 
               RowBox[{"ia", " ", 
                RowBox[{"Mab", "[", 
                 RowBox[{"a", ",", "b", ",", 
                  RowBox[{"p0", "+", "1"}], ",", 
                  RowBox[{"p0", "+", "2"}], ",", "nu"}], "]"}]}]}], ")"}]}], "+", 
            RowBox[{"Mab", "[", 
             RowBox[{"a", ",", "b", ",", 
              RowBox[{"p0", "+", "2"}], ",", 
              RowBox[{"p0", "+", "2"}], ",", "nu"}], "]"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"a", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"-", "1"}]}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"b", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "]"}]}], ";", 
      RowBox[{"prefactor", " ", "sum"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"P2L", "[", 
    RowBox[{"nu_", ",", "reg_"}], "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{"P1", "[", "nu", "]"}], 
     RowBox[{
      SuperscriptBox["nu", "2"], "+", 
      FractionBox["1", "4"]}]], "+", 
    RowBox[{"Part2P2L", "[", 
     RowBox[{"1", ",", "nu", ",", "reg"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 ShowCellLabel->False,
 CellTags->
  "InlineP2-longitudinal-definition",ExpressionUUID->"0c3e9265-8915-4a0d-ab00-\
293aa6e45452"],

Cell["\<\
Inline Laurent routine: hypergeometric functions are temporarily replaced by \
inert one-variable functions, the finite and pole coefficients are extracted \
exactly with SeriesCoefficient, and the original hypergeometric functions are \
restored. The obsolete numerical examples in the source file's final comment \
are not copied; the numerical output below is computed in this run.\
\>", "Text",
 CellTags->
  "InlineP2-algorithm-description",ExpressionUUID->"11c488dd-c2bd-4716-8317-\
988de83329b0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "reg0", ",", "nu0", ",", "hPM", ",", "hL", ",", "P2PMReg0", ",", "P2LReg0",
     ",", "p2PMExpression", ",", "p2LExpression", ",", "p2PMHyper", ",", 
    "p2LHyper", ",", "p2PMDummy", ",", "p2LDummy", ",", 
    "p2PMFiniteCoefficient", ",", "p2LFiniteCoefficient", ",", 
    "P2PMPoleCoefficients", ",", "P2LPoleCoefficients"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2PMExpression", "=", 
   RowBox[{"Expand", "[", 
    RowBox[{"P2PM", "[", 
     RowBox[{"nu0", ",", "reg0"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2LExpression", "=", 
   RowBox[{"Expand", "[", 
    RowBox[{"P2L", "[", 
     RowBox[{"nu0", ",", "reg0"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2PMHyper", "=", 
   RowBox[{"Cases", "[", 
    RowBox[{"p2PMExpression", ",", 
     RowBox[{"_HypergeometricPFQ", "|", "_HypergeometricPFQRegularized"}], ",",
      "\[Infinity]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2LHyper", "=", 
   RowBox[{"Cases", "[", 
    RowBox[{"p2LExpression", ",", 
     RowBox[{"_HypergeometricPFQ", "|", "_HypergeometricPFQRegularized"}], ",",
      "\[Infinity]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"j", "=", "0"}], "}"}], ",", 
    RowBox[{"p2PMDummy", "=", 
     RowBox[{"p2PMExpression", "/.", "\[VeryThinSpace]", 
      RowBox[{
       RowBox[{"_HypergeometricPFQ", "|", "_HypergeometricPFQRegularized"}], "\[RuleDelayed]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"++", "j"}], ";", 
         RowBox[{
          RowBox[{"hPM", "[", "j", "]"}], "[", "reg0", "]"}]}], ")"}]}]}]}]}],
    "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"j", "=", "0"}], "}"}], ",", 
    RowBox[{"p2LDummy", "=", 
     RowBox[{"p2LExpression", "/.", "\[VeryThinSpace]", 
      RowBox[{
       RowBox[{"_HypergeometricPFQ", "|", "_HypergeometricPFQRegularized"}], "\[RuleDelayed]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"++", "j"}], ";", 
         RowBox[{
          RowBox[{"hL", "[", "j", "]"}], "[", "reg0", "]"}]}], ")"}]}]}]}]}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2PMFiniteCoefficient", "=", 
   RowBox[{"SeriesCoefficient", "[", 
    RowBox[{"p2PMDummy", ",", 
     RowBox[{"{", 
      RowBox[{"reg0", ",", "0", ",", "0"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2LFiniteCoefficient", "=", 
   RowBox[{"SeriesCoefficient", "[", 
    RowBox[{"p2LDummy", ",", 
     RowBox[{"{", 
      RowBox[{"reg0", ",", "0", ",", "0"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"P2PMPoleCoefficients", "=", 
   RowBox[{"Table", "[", 
