Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["2", 
    RowBox[{
     RowBox[{"-", "4"}], "-", 
     RowBox[{"4", " ", "\[ImaginaryI]", " ", "x"}]}]], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"3", " ", "\[ImaginaryI]"}], "-", 
      RowBox[{"2", " ", "x"}]}], ")"}], "2"], " ", 
   RowBox[{"Gamma", "[", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["3", "2"]}], "-", 
     RowBox[{"2", " ", "\[ImaginaryI]", " ", "x"}]}], "]"}], " ", 
   RowBox[{"Gamma", "[", 
    RowBox[{"3", "+", 
     RowBox[{"2", " ", "\[ImaginaryI]", " ", "x"}]}], "]"}], " ", 
   SuperscriptBox[
    RowBox[{"Sinh", "[", 
     RowBox[{"\[Pi]", " ", "x"}], "]"}], "2"]}], 
  RowBox[{"\[Pi]", " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"3", " ", "\[ImaginaryI]"}], "-", 
         RowBox[{"2", " ", "x"}]}], ")"}], " ", "x"}]}], ")"}], 
    "2"]}]]], "Output",
 CellChangeTimes->{3.997176447972452*^9},
 CellLabel->"Out[8]=",ExpressionUUID->"d498addb-fe6d-9d47-b8d1-34fa96246ac4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Longitudinal-longitudinal channel", "Subsection",ExpressionUUID->"6ed18d58-fe31-df4e-9744-600b7418fc18"],

Cell["\<\
