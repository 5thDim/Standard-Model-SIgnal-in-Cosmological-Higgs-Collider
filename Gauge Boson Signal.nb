Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gSoft", "[", "v_", "]"}], ":=", 
   RowBox[{"f0", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "v"}], ",", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "v"}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"shiftRatio", "[", 
    RowBox[{"j_Integer", ",", "k_Integer", ",", "x_"}], "]"}], ":=", 
   RowBox[{"FunctionExpand", "[", 
    FractionBox[
     RowBox[{
      RowBox[{"Pochhammer", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"2", " ", "x"}], "-", 
         FractionBox["3", "2"]}], ",", 
        RowBox[{"j", "+", "k"}]}], "]"}], " ", 
      RowBox[{"Pochhammer", "[", 
       RowBox[{
        RowBox[{
         FractionBox["3", "2"], "-", "x"}], ",", 
        RowBox[{"-", "j"}]}], "]"}], " ", 
      RowBox[{"Pochhammer", "[", 
       RowBox[{
        RowBox[{
         FractionBox["3", "2"], "-", "x"}], ",", 
        RowBox[{"-", "k"}]}], "]"}]}], 
     RowBox[{
      RowBox[{"Pochhammer", "[", 
       RowBox[{
        RowBox[{"3", "-", 
         RowBox[{"2", " ", "x"}]}], ",", 
        RowBox[{
         RowBox[{"-", "j"}], "-", "k"}]}], "]"}], " ", 
      RowBox[{"Pochhammer", "[", 
       RowBox[{"x", ",", "j"}], "]"}], " ", 
      RowBox[{"Pochhammer", "[", 
       RowBox[{"x", ",", "k"}], "]"}]}]], "]"}]}], ";", 
  RowBox[{"gSoftSimp", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"gSoft", "[", "nu", "]"}], ",", "assumptions", ",", 
     RowBox[{"TimeConstraint", "\[Rule]", "5"}]}], "]"}]}], ";", 
  RowBox[{"formGauge", "[", "gSoftSimp", "]"}]}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"08bcbeb8-78ac-624d-a002-33d774c7f196"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{
    SuperscriptBox[
     TemplateBox[{
       RowBox[{
         RowBox[{"\[ImaginaryI]", " ", "\[Nu]"}], "+", 
         FractionBox["3", "2"]}]},
      "Gamma"], "2"], " ", 
    TemplateBox[{
      RowBox[{
        RowBox[{
          RowBox[{"-", "2"}], " ", "\[ImaginaryI]", " ", "\[Nu]"}], "-", 
        FractionBox["3", "2"]}]},
     "Gamma"]}], 
   RowBox[{
    TemplateBox[{
      RowBox[{
        RowBox[{"2", " ", "\[ImaginaryI]", " ", "\[Nu]"}], "+", "3"}]},
     "Gamma"], " ", 
    SuperscriptBox[
     TemplateBox[{
       RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Nu]"}]},
      "Gamma"], "2"]}]], TraditionalForm]], "Output",
 CellChangeTimes->{4.0017229881047707`*^9},
 CellLabel->
